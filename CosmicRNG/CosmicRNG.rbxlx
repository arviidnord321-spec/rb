		CFrame = CFrame.new(center + Vector3.new(0, size.Y / 2, 0)),
		Color = GOLD,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = lounge,
	})
end

local wallY = 1 + WALL_HEIGHT / 2
-- north / south / east walls are solid
