    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">CombatAnim</string>
        <string name="Source"><![CDATA[-- CombatAnim (ModuleScript in ReplicatedStorage) - used by LocalScripts only
-- Fight animations made purely in code (no uploaded animation assets).
-- It bends the R15 joints (Motor6D.C0) on top of Roblox's normal walk/idle
-- animations, so punches, kicks, casting poses, hit reactions, blocking
-- and a fighting stance all blend smoothly. Every client animates every
-- fighter itself, so it looks smooth for players AND spectators.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))

local CombatAnim = {}

local I = CFrame.identity
local rad = math.rad

-- R15 joint name -> the body part it lives in
local JOINTS = {
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
}

-- a pose offset: rotation in degrees (x = forward/back, y = twist, z = sideways) + optional move
local function P(rx, ry, rz, px, py, pz)
	return CFrame.new(px or 0, py or 0, pz or 0) * CFrame.Angles(rad(rx or 0), rad(ry or 0), rad(rz or 0))
end

---------------------------------------------------------------------
-- CLIPS: one-shot moves. Keys = { time, { Joint = P(...) } }
-- Trail = which limb glows while the move plays.
---------------------------------------------------------------------
local CLIPS = {
	-- 1st combo hit: a fast LEAD JAB with the left hand
	JabLeft = {
		Duration = 0.38,
		Trail = "LeftHand",
		Keys = {
			{ 0, {} },
			-- load up: elbow tucks back, shoulder turns a little
			{ 0.07, { LeftShoulder = P(58, 0, 16), LeftElbow = P(128), Waist = P(-6, -12, 0) } },
			-- SNAP: arm shoots straight out, body turns into it, small step forward
			{ 0.14, { LeftShoulder = P(94, 0, -10), LeftElbow = P(2), Waist = P(-10, -34, 0), Root = P(-9, 0, 0, 0, -0.25, -0.35), LeftHip = P(30), LeftKnee = P(-12), RightKnee = P(-22), Neck = P(-12, 26, 0), RightShoulder = P(50, 0, -30), RightElbow = P(108) } },
			{ 0.21, { LeftShoulder = P(92, 0, -8), LeftElbow = P(6), Waist = P(-9, -30, 0), Root = P(-8, 0, 0, 0, -0.25, -0.3), LeftHip = P(26), Neck = P(-10, 22, 0), RightShoulder = P(50, 0, -30), RightElbow = P(108) } },
			-- pull the hand back to the face
			{ 0.38, {} },
		},
	},
	-- 2nd combo hit: a heavier REAR CROSS with the right hand
	CrossRight = {
		Duration = 0.44,
		Trail = "RightHand",
		Keys = {
			{ 0, {} },
			-- coil: right shoulder pulls back, weight on the back foot
			{ 0.09, { RightShoulder = P(48, 0, 12), RightElbow = P(132), Waist = P(-4, -30, 0), Root = P(4, -8, 0, 0, -0.3, 0.1), RightKnee = P(-30) } },
			-- the punch: hips and shoulders whip around, arm fully extended
			{ 0.17, { RightShoulder = P(96, 0, -14), RightElbow = P(0), Waist = P(-12, 40, 0), Root = P(-12, 18, 0, 0, -0.3, -0.4), RightHip = P(-22), RightKnee = P(-28), LeftHip = P(22), LeftKnee = P(-18), Neck = P(-12, -32, 0), LeftShoulder = P(62, 0, 28), LeftElbow = P(96) } },
			{ 0.25, { RightShoulder = P(94, 0, -12), RightElbow = P(4), Waist = P(-10, 36, 0), Root = P(-10, 16, 0, 0, -0.3, -0.35), RightHip = P(-20), LeftHip = P(20), Neck = P(-10, -28, 0), LeftShoulder = P(62, 0, 28), LeftElbow = P(96) } },
			{ 0.44, {} },
		},
	},
	-- (kept for bots/extra variety)
	JabRight = {
		Duration = 0.36,
		Trail = "RightHand",
		Keys = {
			{ 0, {} },
			{ 0.07, { RightShoulder = P(50, 0, 14), RightElbow = P(128), Waist = P(0, -14, 0) } },
			{ 0.14, { RightShoulder = P(95, 0, -10), RightElbow = P(2), Waist = P(-8, 30, 0), Root = P(-9, 0, 0, 0, -0.25, -0.3), Neck = P(-10, -24, 0) } },
			{ 0.36, {} },
		},
	},
	-- 3rd combo hit: chambered ROUNDHOUSE KICK
	Roundhouse = {
		Duration = 0.66,
		Trail = "RightFoot",
		Keys = {
			{ 0, {} },
			-- chamber: knee comes up high, foot tucked
			{ 0.15, { RightHip = P(80, 0, 30), RightKnee = P(-115), Root = P(-4, 15, 0, 0, -0.15, 0), Waist = P(-4, -12, 0), LeftKnee = P(-18), LeftShoulder = P(62, 0, 28), LeftElbow = P(96), RightShoulder = P(50, 0, -30), RightElbow = P(108) } },
			-- snap the leg out while the hips turn through
			{ 0.28, { RightHip = P(92, 0, 40), RightKnee = P(-4), Root = P(-10, 48, 0, 0, -0.1, 0), Waist = P(-6, -22, 0), LeftKnee = P(-22), RightShoulder = P(-35, 0, 40), RightElbow = P(40), LeftShoulder = P(62, 0, 28), LeftElbow = P(96), Neck = P(-6, -34, 0) } },
			{ 0.42, { RightHip = P(88, 0, 38), RightKnee = P(-12), Root = P(-8, 45, 0, 0, -0.1, 0), Waist = P(-5, -20, 0), LeftKnee = P(-22), RightShoulder = P(-30, 0, 38), LeftShoulder = P(62, 0, 28), LeftElbow = P(96), Neck = P(-6, -32, 0) } },
			-- re-chamber and step back down
			{ 0.52, { RightHip = P(60, 0, 20), RightKnee = P(-95), Root = P(-2, 18, 0, 0, -0.2, 0), LeftKnee = P(-18) } },
			{ 0.66, {} },
		},
	},
	CastForward = { -- beams, projectiles, drains, freezes, pulls
		Duration = 0.58,
		Trail = "BothHands",
		Keys = {
			{ 0, {} },
			-- gather energy at the hip
			{ 0.13, { RightShoulder = P(20, 0, 30), LeftShoulder = P(20, 0, -30), RightElbow = P(110), LeftElbow = P(110), Root = P(6, 20, 0, 0, -0.3, 0.1), Waist = P(0, 25, 0), RightKnee = P(-25), LeftKnee = P(-25) } },
			-- PUSH both palms forward
			{ 0.23, { RightShoulder = P(96, 0, -14), LeftShoulder = P(96, 0, 14), RightElbow = P(0), LeftElbow = P(0), Root = P(-10, 0, 0, 0, -0.3, -0.3), Waist = P(-8, 0, 0), LeftHip = P(25), LeftKnee = P(-15), RightHip = P(-15), RightKnee = P(-25), Neck = P(-8) } },
			{ 0.38, { RightShoulder = P(92, 0, -12), LeftShoulder = P(92, 0, 12), Root = P(6, 0, 0, 0, -0.25, 0.15), Neck = P(-6) } },
			{ 0.58, {} },
		},
	},
	CastUp = { -- meteors, heals, shields
		Duration = 0.72,
		Trail = "BothHands",
		Keys = {
			{ 0, {} },
			{ 0.2, { RightShoulder = P(172, 0, -18), LeftShoulder = P(172, 0, 18), RightElbow = P(12), LeftElbow = P(12), Neck = P(24), Root = P(6, 0, 0, 0, 0.1, 0) } },
			{ 0.5, { RightShoulder = P(168, 0, -24), LeftShoulder = P(168, 0, 24), RightElbow = P(18), LeftElbow = P(18), Neck = P(20), Root = P(5, 0, 0, 0, 0.1, 0) } },
			{ 0.72, {} },
		},
	},
	Slam = { -- bursts / explosions: jump up and smash the ground
		Duration = 0.66,
		Trail = "BothHands",
		Keys = {
			{ 0, {} },
			{ 0.18, { RightShoulder = P(165, 0, -10), LeftShoulder = P(165, 0, 10), RightElbow = P(20), LeftElbow = P(20), Root = P(8, 0, 0, 0, 0.25, 0), Neck = P(18) } },
			{ 0.3, { RightShoulder = P(40, 0, -12), LeftShoulder = P(40, 0, 12), RightElbow = P(8), LeftElbow = P(8), Root = P(-28, 0, 0, 0, -0.55, 0), RightKnee = P(-50), LeftKnee = P(-50), RightHip = P(38), LeftHip = P(38), Neck = P(-12) } },
			{ 0.46, { RightShoulder = P(36, 0, -12), LeftShoulder = P(36, 0, 12), RightElbow = P(10), LeftElbow = P(10), Root = P(-22, 0, 0, 0, -0.5, 0), RightKnee = P(-45), LeftKnee = P(-45), RightHip = P(32), LeftHip = P(32) } },
			{ 0.66, {} },
		},
	},
	DashLean = {
		Duration = 0.4,
		Trail = "BothHands",
		Keys = {
			{ 0, {} },
			{ 0.08, { Root = P(-35, 0, 0, 0, -0.2, 0), RightShoulder = P(-55, 0, 20), LeftShoulder = P(-55, 0, -20), RightElbow = P(30), LeftElbow = P(30), Neck = P(14), RightHip = P(25), RightKnee = P(-40), LeftHip = P(-30) } },
			{ 0.28, { Root = P(-30, 0, 0, 0, -0.2, 0), RightShoulder = P(-50, 0, 20), LeftShoulder = P(-50, 0, -20), Neck = P(12) } },
			{ 0.4, {} },
		},
	},
	Dodge = { -- duck and slip to the side, hands still up
		Duration = 0.42,
		Keys = {
			{ 0, {} },
			{ 0.08, { Root = P(-22, 0, 18, 0, -0.45, 0), RightKnee = P(-55), LeftKnee = P(-55), RightHip = P(42), LeftHip = P(42), RightShoulder = P(70, 0, -20), LeftShoulder = P(70, 0, 20), RightElbow = P(130), LeftElbow = P(130), Neck = P(-10) } },
			{ 0.28, { Root = P(-15, 0, 12, 0, -0.35, 0), RightKnee = P(-40), LeftKnee = P(-40), RightHip = P(30), LeftHip = P(30), RightShoulder = P(65, 0, -18), LeftShoulder = P(65, 0, 18), RightElbow = P(125), LeftElbow = P(125) } },
			{ 0.42, {} },
		},
	},
	HitLight = { -- head snaps back, hands loosen
		Duration = 0.3,
		Keys = {
			{ 0, {} },
			{ 0.05, { Neck = P(28, 12, 0), Waist = P(15, 8, 4), Root = P(8, 0, 0, 0, -0.2, 0.25), RightShoulder = P(35, 0, 28), LeftShoulder = P(40, 0, -28), RightElbow = P(70), LeftElbow = P(70) } },
			{ 0.3, {} },
		},
	},
	HitHeavy = { -- knocked off balance, arms flung out
		Duration = 0.58,
		Keys = {
			{ 0, {} },
			{ 0.07, { Root = P(26, 0, 12, 0, -0.3, 0.55), Waist = P(22, 10, 0), Neck = P(32, 0, -12), RightShoulder = P(-30, 0, 65), LeftShoulder = P(-25, 0, -65), RightElbow = P(25), LeftElbow = P(25), RightKnee = P(-28), LeftKnee = P(-28), RightHip = P(-10), LeftHip = P(20) } },
			{ 0.26, { Root = P(16, 0, 6, 0, -0.25, 0.35), Waist = P(14, 5, 0), Neck = P(16), RightShoulder = P(10, 0, 40), LeftShoulder = P(10, 0, -40), RightKnee = P(-20), LeftKnee = P(-20) } },
			{ 0.58, {} },
		},
	},
	BlockHit = { -- the guard gets pushed back a bit
		Duration = 0.22,
		Keys = {
			{ 0, {} },
			{ 0.05, { Root = P(10, 0, 0, 0, -0.35, 0.3), Waist = P(8), Neck = P(-18) } },
			{ 0.22, {} },
		},
	},
	Victory = { -- fist pump!
		Duration = 1.6,
		Trail = "RightHand",
		Keys = {
			{ 0, {} },
			{ 0.22, { RightShoulder = P(172, 0, -12), RightElbow = P(25), LeftShoulder = P(-12, 0, -18), LeftElbow = P(95), Neck = P(20), Root = P(4, 0, 0, 0, 0.2, 0) } },
			{ 0.45, { RightShoulder = P(150, 0, -12), RightElbow = P(70), LeftShoulder = P(-12, 0, -18), LeftElbow = P(95), Neck = P(12), Root = P(0) } },
			{ 0.7, { RightShoulder = P(172, 0, -12), RightElbow = P(25), LeftShoulder = P(-12, 0, -18), LeftElbow = P(95), Neck = P(20), Root = P(4, 0, 0, 0, 0.2, 0) } },
			{ 0.95, { RightShoulder = P(150, 0, -12), RightElbow = P(70), Neck = P(12) } },
			{ 1.6, {} },
		},
	},
}
CombatAnim.Clips = CLIPS

-- Which casting pose each power type uses
CombatAnim.PowerPose = {
	Projectile = "CastForward",
	Beam = "CastForward",
	Drain = "CastForward",
	Freeze = "CastForward",
	Pull = "CastForward",
	Meteor = "CastUp",
	Heal = "CastUp",
	Shield = "CastUp",
	Burst = "Slam",
	Dash = "DashLean",
	Teleport = "DashLean",
}

---------------------------------------------------------------------
-- LOOPS: poses held while something is true (stance, block, stun)
---------------------------------------------------------------------
local LOOPS = {
	Stance = function(t) -- boxing guard: left side forward, fists up by the face
		local bob = math.sin(t * 5)
		return {
			RightShoulder = P(50 + bob * 3, 0, -30),
			RightElbow = P(108),
			LeftShoulder = P(62 - bob * 3, 0, 28),
			LeftElbow = P(96),
			Waist = P(-6, -20, 0),
			Root = P(0, 0, 0, 0, -0.25 + bob * 0.05, 0),
			Neck = P(-8, 16, 0),
			LeftHip = P(16),
			RightHip = P(-12),
			LeftKnee = P(-18),
			RightKnee = P(-22),
		}
	end,
	Block = function(t) -- high guard: both forearms up in front of the face, chin tucked
		local shake = math.sin(t * 14) * 1.5
		return {
			RightShoulder = P(86 + shake, 0, -52),
			RightElbow = P(92),
			LeftShoulder = P(90 - shake, 0, 50),
			LeftElbow = P(92),
			Waist = P(-14),
			Root = P(0, 0, 0, 0, -0.38, 0),
			Neck = P(-18),
			RightHip = P(14),
			LeftHip = P(18),
			RightKnee = P(-26),
			LeftKnee = P(-26),
		}
	end,
	Stun = function(t) -- dizzy: head lolls, arms hang
		return {
			Neck = P(math.sin(t * 9) * 16, math.sin(t * 5) * 20, 0),
			Waist = P(8, math.sin(t * 6) * 10, math.cos(t * 6) * 8),
			RightShoulder = P(10, 0, 20 + math.sin(t * 7) * 10),
			LeftShoulder = P(10, 0, -20 - math.sin(t * 7) * 10),
			RightElbow = P(15),
			LeftElbow = P(15),
			RightKnee = P(-15),
			LeftKnee = P(-15),
		}
	end,
}

---------------------------------------------------------------------
-- Rigs we are animating
---------------------------------------------------------------------
local rigs = {} -- [model] = rig

local function smooth(a)
	return a * a * (3 - 2 * a)
end

local function sampleClip(clip, elapsed)
	local keys = clip.Keys
	local previous, nextKey = keys[1], keys[#keys]
	for i = 1, #keys - 1 do
		if elapsed >= keys[i][1] and elapsed <= keys[i + 1][1] then
			previous, nextKey = keys[i], keys[i + 1]
			break
		end
	end
	local span = nextKey[1] - previous[1]
	local alpha = (span > 0) and smooth(math.clamp((elapsed - previous[1]) / span, 0, 1)) or 1
	local pose = {}
	for joint in pairs(clip.Joints) do
		local a = previous[2][joint] or I
		local b = nextKey[2][joint] or I
		pose[joint] = a:Lerp(b, alpha)
	end
	return pose
end

-- remember every joint each clip touches
for _, clip in pairs(CLIPS) do
	clip.Joints = {}
	for _, key in ipairs(clip.Keys) do
		for joint in pairs(key[2]) do
			clip.Joints[joint] = true
		end
	end
end

local function makeTrail(part, color0, color1)
	local a0 = Instance.new("Attachment")
	a0.Name = "CombatTrailA"
	a0.Position = Vector3.new(0, 0.35, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Name = "CombatTrailB"
	a1.Position = Vector3.new(0, -0.35, 0)
	a1.Parent = part
	local trail = Instance.new("Trail")
	trail.Name = "CombatTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.18
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) })
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 1) })
	trail.Color = ColorSequence.new(color0, color1)
	trail.Enabled = false
	trail.Parent = part
	return trail
end

local function getRig(model)
	local rig = rigs[model]
	if rig then
		return rig
	end
	local motors, baseC0 = {}, {}
	for joint, partName in pairs(JOINTS) do
		local holder = model:FindFirstChild(partName)
		local motor = holder and holder:FindFirstChild(joint)
		if motor and motor:IsA("Motor6D") then
			motors[joint] = motor
			baseC0[joint] = motor.C0
		end
	end
	if not motors.RightShoulder or not motors.Root then
		return nil -- not an R15 body; skip
	end
	local aura = AuraData.Get(model:GetAttribute("Aura") or "")
	local c0 = aura and aura.Colors[1] or Color3.fromRGB(220, 220, 255)
	local c1 = aura and aura.Colors[2] or Color3.fromRGB(150, 150, 255)
	local trails = {}
	for _, limb in ipairs({ "RightHand", "LeftHand", "RightFoot" }) do
		local part = model:FindFirstChild(limb)
		if part then
			trails[limb] = makeTrail(part, c0:Lerp(Color3.new(1, 1, 1), 0.2), c1)
		end
	end
	rig = {
		Model = model,
		Motors = motors,
		BaseC0 = baseC0,
		Clips = {}, -- { Clip, Start, Speed }
		Loops = {}, -- [name] = target weight (0 or 1)
		LoopWeights = {},
		Trails = trails,
		LastPosition = nil,
		WalkPhase = 0,
	}
	rigs[model] = rig
	return rig
end

local function restore(rig)
	for joint, motor in pairs(rig.Motors) do
		if motor.Parent then
			motor.C0 = rig.BaseC0[joint]
		end
	end
	for _, trail in pairs(rig.Trails) do
		if trail.Parent then
			trail.Enabled = false
		end
	end
end

---------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------
-- Play a one-shot move on a model. speed = 1 is normal.
function CombatAnim.Play(model, clipName, speed)
	local clip = CLIPS[clipName]
	local rig = model and getRig(model)
	if not clip or not rig then
		return
	end
	-- a new move of the same kind restarts instead of stacking
	for i = #rig.Clips, 1, -1 do
		if rig.Clips[i].Clip == clip then
			table.remove(rig.Clips, i)
		end
	end
	table.insert(rig.Clips, { Clip = clip, Start = os.clock(), Speed = speed or 1 })
end

-- Turn a held pose on/off: "Stance", "Block", "Stun"
function CombatAnim.SetLoop(model, loopName, on)
	local rig = model and getRig(model)
	if rig then
		rig.Loops[loopName] = on and 1 or 0
	end
end

-- Stop animating a model and put its joints back
function CombatAnim.Release(model)
	local rig = rigs[model]
	if rig then
		restore(rig)
		rigs[model] = nil
	end
end

function CombatAnim.IsAnimating(model)
	return rigs[model] ~= nil
end

---------------------------------------------------------------------
-- Every frame
---------------------------------------------------------------------
local TRAIL_LIMBS = {
	RightHand = { "RightHand" },
	LeftHand = { "LeftHand" },
	RightFoot = { "RightFoot" },
	BothHands = { "RightHand", "LeftHand" },
}

RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	for model, rig in pairs(rigs) do
		if not model.Parent or not rig.Motors.Root.Parent then
			rigs[model] = nil
			continue
		end
		local offsets = {}
		local driven = {}
		local trailsOn = {}

		-- one-shot clips (they win over held poses for the joints they use)
		for i = #rig.Clips, 1, -1 do
			local playing = rig.Clips[i]
			local clip = playing.Clip
			local elapsed = (now - playing.Start) * playing.Speed
			if elapsed >= clip.Duration then
				table.remove(rig.Clips, i)
			else
				local pose = sampleClip(clip, elapsed)
				for joint, cf in pairs(pose) do
					offsets[joint] = (offsets[joint] or I) * cf
					driven[joint] = true
				end
				if clip.Trail and elapsed < clip.Duration * 0.75 then
					for _, limb in ipairs(TRAIL_LIMBS[clip.Trail] or {}) do
						trailsOn[limb] = true
					end
				end
			end
		end

		-- held poses fade in/out smoothly
		for name, poseFn in pairs(LOOPS) do
			local target = rig.Loops[name] or 0
			local weight = rig.LoopWeights[name] or 0
			weight += math.clamp(target - weight, -dt * 8, dt * 8)
			rig.LoopWeights[name] = weight
			if weight > 0.001 then
				for joint, cf in pairs(poseFn(now)) do
					if not driven[joint] then
						offsets[joint] = (offsets[joint] or I) * I:Lerp(cf, weight)
					end
				end
			end
		end

		-- bots have no walk animation of their own: swing their legs and arms
		if model:GetAttribute("IsDuelBot") then
			local root = model:FindFirstChild("HumanoidRootPart")
			if root then
				local velocity = root.AssemblyLinearVelocity
				local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
				rig.WalkPhase += dt * speed * 0.55
				local amount = math.clamp(speed / 16, 0, 1)
				local swing = math.sin(rig.WalkPhase) * 38 * amount
				local walk = {
					RightHip = P(swing),
					LeftHip = P(-swing),
					RightKnee = P(-math.max(0, -math.sin(rig.WalkPhase)) * 40 * amount),
					LeftKnee = P(-math.max(0, math.sin(rig.WalkPhase)) * 40 * amount),
					RightShoulder = P(-swing * 0.6),
					LeftShoulder = P(swing * 0.6),
				}
				for joint, cf in pairs(walk) do
					if not driven[joint] then
						offsets[joint] = (offsets[joint] or I) * cf
					end
				end
			end
		end

		for joint, motor in pairs(rig.Motors) do
			motor.C0 = rig.BaseC0[joint] * (offsets[joint] or I)
		end
		for limb, trail in pairs(rig.Trails) do
			trail.Enabled = trailsOn[limb] == true
		end
	end
end)

return CombatAnim
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name">CosmicConfig</string>
        <string name="Source"><![CDATA[-- CosmicConfig (ModuleScript in ReplicatedStorage)
-- All the numbers you might want to tweak live here.

local Config = {}

---------------------------------------------------------------------
-- GAME PASSES
-- Create each pass on the Creator Dashboard (Monetization > Passes),
-- then paste its ID here.
-- While an ID is 0, the pass is FREE in Roblox Studio so you can test,
-- and nobody owns it in the live game.
---------------------------------------------------------------------
Config.GamePasses = {
	AutoRoll = 0, -- unlocks the Auto Roll button
	QuickRoll = 0, -- faster rolling (see QuickRollCooldown)
	DoubleLuck = 0, -- permanent x2 luck
	VIP = 0, -- x1.25 luck and a gold VIP tag
	MultiRoll = 0, -- every roll rolls 3 auras at once
	LuckyCharm = 0, -- lucky roll every 5 rolls instead of every 10
}
Config.FreePassesInStudio = true

-- What the store shows for each pass (order = position in the store)
Config.PassInfo = {
	{ Key = "AutoRoll", Icon = "🔁", Name = "Auto Roll", Description = "Rolls for you automatically, even while you're AFK." },
	{ Key = "QuickRoll", Icon = "⚡", Name = "Quick Roll", Description = "Roll twice as fast." },
	{ Key = "DoubleLuck", Icon = "🍀", Name = "2x Luck", Description = "Permanently doubles your luck on every roll." },
	{ Key = "MultiRoll", Icon = "🎲", Name = "Triple Roll", Description = "Every roll gives you 3 auras at once." },
	{ Key = "LuckyCharm", Icon = "✨", Name = "Lucky Charm", Description = "Lucky roll every 5 rolls instead of every 10." },
	{ Key = "VIP", Icon = "👑", Name = "VIP", Description = "x1.25 luck on every roll and a gold VIP tag." },
}

---------------------------------------------------------------------
-- DEVELOPER PRODUCTS (can be bought many times)
-- Create them on the Creator Dashboard (Monetization > Developer Products).
---------------------------------------------------------------------
Config.Products = {
	PersonalLuck = 0, -- x2 luck for you
	ServerLuck = 0, -- x2 luck for everyone in the server
	-- LIMITED OFFER packs (set the price to 399 Robux or more on the dashboard)
	LimitedAura = 0,
	LimitedLuck = 0,
	LimitedPet = 0,
}
Config.ProductInfo = {
	{ Key = "PersonalLuck", Icon = "🧪", Name = "Luck Potion", Description = "x2 luck for 10 minutes. Stacks time if you buy more." },
	{ Key = "ServerLuck", Icon = "🌌", Name = "Server Luck", Description = "x2 luck for EVERYONE in the server for 15 minutes." },
}

---------------------------------------------------------------------
-- LIMITED OFFER: on sale for the first 7 days after the game goes live.
-- The 7 days start automatically the first time a live server starts
-- (saved in a DataStore). Each player can buy ONE pack.
-- To pick the start yourself, set StartTime to a Unix time (e.g. from
-- https://www.unixtimestamp.com), or leave it 0 for automatic.
---------------------------------------------------------------------
Config.LimitedOffer = {
	Days = 7,
	StartTime = 0,
	PriceText = "399", -- shown on the button (the real price is set on the dashboard)
	Packs = {
		{
			Key = "LimitedAura", Icon = "🌌", Name = "Legend Aura Pack", Color = Color3.fromRGB(255, 80, 140),
			Gives = { "Cosmic Rift aura (1 in 500,000)", "Black Hole aura (1 in 100,000)", "x2 luck potion for 2 hours" },
		},
		{
			Key = "LimitedLuck", Icon = "🍀", Name = "Infinite Luck Pack", Color = Color3.fromRGB(120, 255, 170),
			Gives = { "x2 luck FOREVER", "5 Cosmic Rolls (x50 luck each)", "x2 luck potion for 1 hour" },
		},
		{
			Key = "LimitedPet", Icon = "🐉", Name = "Overlord Pet Pack", Color = Color3.fromRGB(255, 200, 70),
			Gives = { "Cosmic Overlord pet (+300% luck, only here)", "Void Wisp pet (+100% luck)", "3 Cosmic Rolls (x50 luck each)" },
		},
	},
}

---------------------------------------------------------------------
-- COSMIC DROP: every few minutes a Cosmic Roll appears somewhere on the
-- main island or Lucky Isle. The first player to grab it gets a huge luck
-- boost on their next roll (one use).
---------------------------------------------------------------------
Config.Drop = {
	IntervalMinutes = 15,
	BoostMultiplier = 50,
	LuckyIsleChance = 0.3, -- chance it lands on Lucky Isle instead of the main island
}

---------------------------------------------------------------------
-- LUCK
---------------------------------------------------------------------
Config.BaseLuck = 1 -- 1 = normal odds, 2 = everything twice as likely
Config.LuckMultipliers = {
	DoubleLuck = 2,
	VIP = 1.25,
	PersonalBoost = 2,
	ServerBoost = 2,
}
Config.PersonalBoostMinutes = 10
Config.ServerBoostMinutes = 15

---------------------------------------------------------------------
-- ROLLING
---------------------------------------------------------------------
Config.RollCooldown = 1.2 -- seconds between rolls (server enforced)
Config.QuickRollCooldown = 0.6 -- with the Quick Roll pass
Config.LuckyRollEvery = 10 -- every Nth roll gets bonus luck
Config.LuckyCharmEvery = 5 -- with the Lucky Charm pass
Config.LuckyRollMultiplier = 2
Config.MultiRollCount = 3 -- with the Triple Roll pass

-- Rolls at or above these odds get special treatment
Config.AnnounceAtChance = 1000 -- whole server gets a message
Config.CutsceneAtChance = 10000 -- dramatic reveal on the roller's screen
Config.ShowcaseAtChance = 10000 -- camera spins around you to show it off
Config.SkyShiftAtChance = 1000000 -- sky changes for everyone (secret auras)

---------------------------------------------------------------------
-- SAVING + LEADERBOARD
---------------------------------------------------------------------
Config.DataStoreName = "CosmicRNG_Data_v1"
Config.LeaderboardStoreName = "CosmicRNG_TopRolls_v1"
Config.AutosaveInterval = 120
Config.LeaderboardRefresh = 90 -- seconds

---------------------------------------------------------------------
-- WORLD
---------------------------------------------------------------------
Config.RemoveDefaultBaseplate = true -- deletes the part named "Baseplate"

-- Where things are on the main island (every script uses these)
Config.MainIslandRadius = 115
Config.Places = {
	Core = Vector3.new(0, 0, -52), -- Cosmic Core altar
	PortalPlaza = Vector3.new(54, 0, 46), -- portal to Lucky Isle
	Board = Vector3.new(-52, 0, 18), -- Top Rollers board
	Pond = Vector3.new(-46, 0, -42), -- cosmic pool
	StarstepStart = Vector3.new(-104, 0, -6), -- medium parkour
	VoidTowerStart = Vector3.new(72, 0, -80), -- hard parkour
	DuelIsland = Vector3.new(0, 0, 215), -- center of the duel island
	DuelIslandRadius = 46,
	RebirthGate = Vector3.new(-62, 0, 54), -- 3 portals to the rebirth islands
	Hatchery = Vector3.new(62, 0, -18), -- the pet eggs of the main island
}

-- Lucky Isle: the island you reach through the portal
Config.LuckyIsland = {
	Center = Vector3.new(0, 30, 1000), -- middle of the island's ground
	Radius = 75,
	LuckMultiplier = 2, -- extra luck while you stand on it
	RequireVIP = false, -- true = only VIP pass owners may use the portal
}

---------------------------------------------------------------------
-- REBIRTH
-- Rebirthing needs rolls (since your last rebirth) AND one rare aura rolled
-- since your last rebirth. Both get harder every time. You KEEP your auras.
-- Every rebirth: more luck forever, faster rolling and a new star.
---------------------------------------------------------------------
Config.Rebirth = {
	BaseRolls = 150, -- rolls needed for the 1st rebirth
	RollGrowth = 2.2, -- each rebirth needs 2.2x more rolls (150, 330, 726, ...)
	BaseRarity = 100, -- 1st rebirth: roll an aura of 1 in 100 or rarer
	RarityGrowth = 4, -- then 1 in 400, 1 in 1,600, ...
	MaxRarity = 1000000,
	LuckPerRebirth = 0.25, -- +25% luck per rebirth (x1.25, x1.5, x1.75 ...)
	RollSpeedPerRebirth = 0.06, -- 6% shorter roll cooldown per rebirth
	MaxRollSpeed = 0.42, -- never more than 42% faster
	-- Unlocks (Rebirths = how many you need)
	Perks = {
		{ Rebirths = 1, Icon = "❄️", Name = "Frostfall Isle", Description = "A frozen island with x2.5 luck and the Glacier Climb." },
		{ Rebirths = 2, Icon = "🔥", Name = "Ember Isle", Description = "A volcano island with x3 luck and the Magma Run." },
		{ Rebirths = 2, Icon = "🦘", Name = "Double Jump", Description = "Press jump again in the air (not on parkour courses)." },
		{ Rebirths = 3, Icon = "💠", Name = "Neon Nexus", Description = "A neon city island with x4 luck and the Pulse Grid." },
		{ Rebirths = 3, Icon = "🌠", Name = "Rebirth Trail", Description = "A glowing trail follows you everywhere." },
		{ Rebirths = 4, Icon = "🎯", Name = "Lucky Streak", Description = "Lucky roll every 8 rolls instead of 10." },
		{ Rebirths = 5, Icon = "🔁", Name = "Free Auto Roll", Description = "Auto Roll unlocked for free, forever." },
	},
	LuckyEveryAt4 = 8,
}

-- The rebirth islands (reached through the Rebirth Gate on the main island)
Config.RebirthIslands = {
	{
		Key = "Frostfall", Name = "Frostfall Isle", Icon = "❄️", Rebirths = 1,
		Center = Vector3.new(-1000, 30, 0), Radius = 100, LuckMultiplier = 2.5,
		Hatchery = Vector3.new(50, 0, 36), -- where the eggs stand (from the island center)
		Color = Color3.fromRGB(140, 220, 255),
	},
	{
		Key = "Ember", Name = "Ember Isle", Icon = "🔥", Rebirths = 2,
		Center = Vector3.new(1000, 30, 0), Radius = 100, LuckMultiplier = 3,
		Hatchery = Vector3.new(46, 0, -34),
		Color = Color3.fromRGB(255, 120, 40),
	},
	{
		Key = "Nexus", Name = "Neon Nexus", Icon = "💠", Rebirths = 3,
		Center = Vector3.new(0, 30, -1000), Radius = 100, LuckMultiplier = 4,
		Hatchery = Vector3.new(56, 0, -40),
		Color = Color3.fromRGB(255, 70, 220),
	},
}

---------------------------------------------------------------------
-- MOVEMENT (hold Shift to sprint)
---------------------------------------------------------------------
Config.Movement = {
	WalkSpeed = 16,
	SprintSpeed = 26,
	DuelSprintMultiplier = 1.4, -- in duels sprint is a bit weaker
	MaxStamina = 100,
	StaminaDrain = 20, -- per second while sprinting
	StaminaRegen = 16, -- per second while not sprinting
	RegenDelay = 0.8, -- seconds before stamina starts coming back
}

---------------------------------------------------------------------
-- PARKOUR (finish a course = temporary luck boost)
---------------------------------------------------------------------
Config.Parkour = {
	Starstep = { Name = "Starstep Trail", LuckMultiplier = 1.75, BoostMinutes = 5, CooldownMinutes = 10 },
	VoidTower = { Name = "Void Tower", LuckMultiplier = 2.5, BoostMinutes = 6, CooldownMinutes = 10 },
	-- rebirth island courses (harder, bigger rewards)
	GlacierClimb = { Name = "Glacier Climb", LuckMultiplier = 3, BoostMinutes = 6, CooldownMinutes = 12 },
	MagmaRun = { Name = "Magma Run", LuckMultiplier = 4, BoostMinutes = 7, CooldownMinutes = 12 },
	PulseGrid = { Name = "Pulse Grid", LuckMultiplier = 5, BoostMinutes = 8, CooldownMinutes = 12 },
}

---------------------------------------------------------------------
-- DUELS
---------------------------------------------------------------------
Config.Duel = {
	CountdownSeconds = 3,
	TimeLimit = 90, -- seconds; when time runs out the higher HP % wins
	ChallengeTimeout = 15, -- seconds to accept a challenge
	AttackCooldown = 0.55, -- basic attack
	AttackRange = 8, -- studs
	FinisherSeconds = 4.6, -- length of the knockout cutscene
	-- combos: attack again within ComboWindow to chain jab, jab, KICK
	ComboWindow = 0.9,
	ComboDamage = { 1, 1.1, 1.8 }, -- damage multiplier for hit 1, 2, 3
	HeavyRecovery = 0.75, -- pause after the kick
	HeavyKnockback = 45,
	-- blocking (hold G): uses up a guard meter
	BlockBasic = 0.2, -- basic hits do 20% damage into a block
	BlockPower = 0.5, -- powers do 50%
	BlockSpeed = 0.45, -- you move slower while blocking
	GuardMax = 100,
	GuardDrain = 22, -- per second while blocking
	GuardHitCost = 18, -- extra per blocked hit
	GuardRegen = 25, -- per second when not blocking
	GuardBreakStun = 1, -- seconds stunned when your guard breaks
	-- dodge roll (E)
	DodgeCooldown = 2.2,
	DodgeInvincible = 0.35, -- seconds you can't be hit
	DodgeSpeed = 58,
	PowerWindup = 0.2, -- powers fire this long after you press (matches the animation)
	NoAuraTier = "Common", -- stats used if you have no aura equipped
	-- Bots: which aura they use and how sharp they are
	Bots = {
		{ Key = "Easy", Name = "Rookie Bot", Aura = "Moonbeam", Reaction = 1.1, Accuracy = 0.55, Speed = 13 },
		{ Key = "Normal", Name = "Cosmic Bot", Aura = "Pulsar", Reaction = 0.8, Accuracy = 0.7, Speed = 15 },
		{ Key = "Hard", Name = "Nova Bot", Aura = "Supernova", Reaction = 0.55, Accuracy = 0.85, Speed = 16 },
		{ Key = "Nightmare", Name = "Void Bot", Aura = "Black Hole", Reaction = 0.4, Accuracy = 0.95, Speed = 17 },
	},
}

---------------------------------------------------------------------
-- PARTICLE TEXTURES (built into Roblox, always available)
-- You can swap these for your own uploaded decal IDs later.
---------------------------------------------------------------------
Config.Textures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Spark = "rbxasset://textures/particles/fire_sparks_main.dds",
	Glow = "rbxasset://textures/particles/forcefield_glow_main.dds", -- soft round glow (fireflies, motes)
	Vortex = "rbxasset://textures/particles/forcefield_vortex_main.dds", -- swirl
	Shockwave = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
}

---------------------------------------------------------------------
-- SOUNDS
-- The game makes its sounds from Roblox's built-in sound files, so they
-- always work. To use a better sound, find one in the Creator Store
-- (Toolbox > Audio), copy its ID and paste it here, e.g.
--   RevealLegendary = "rbxassetid://1234567890",
-- Leave "" to keep the built-in version.
---------------------------------------------------------------------
Config.SoundOverrides = {
	Tick = "", -- each name flicking past while rolling
	Click = "", -- pressing buttons
	Hover = "", -- mouse over buttons
	Whoosh = "", -- panels opening
	Pop = "", -- common/uncommon reveal
	RevealRare = "",
	RevealEpic = "",
	RevealLegendary = "",
	RevealMythic = "", -- mythic + secret
	Heartbeat = "", -- rare roll cutscene
	Rumble = "", -- rare roll cutscene background
	Equip = "",
	Purchase = "",
	Punch = "", -- duel basic attack
	Hit = "", -- duel damage
	Swoosh = "", -- duel dash / swing
	Zap = "", -- duel beams
	Freeze = "", -- duel freeze
}
Config.AmbientMusic = "" -- background music ID, "" = soft space hum
Config.AmbientVolume = 0.25
Config.MasterVolume = 1

return Config
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">Luck</string>
        <string name="Source"><![CDATA[-- Luck (ModuleScript in ReplicatedStorage)
-- One place that works out a player's luck, used by BOTH the server
-- (for real rolls) and the screen (to show "Luck x5"), so they always match.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local Luck = {}

-- Same clock on server and clients (seconds since 1970)
function Luck.Now()
	return workspace:GetServerTimeNow()
end

-- Returns a list of active bonuses: { Name, Multiplier, EndsAt (or nil) }
function Luck.GetBonuses(player)
	local bonuses = {}
	local m = Config.LuckMultipliers
	local now = Luck.Now()

	if player:GetAttribute("Pass_DoubleLuck") then
		table.insert(bonuses, { Name = "2x Luck", Multiplier = m.DoubleLuck })
	end
	if player:GetAttribute("Pass_VIP") then
		table.insert(bonuses, { Name = "VIP", Multiplier = m.VIP })
	end

	local personalEnd = player:GetAttribute("PersonalLuckEnd") or 0
	if personalEnd > now then
		table.insert(bonuses, { Name = "Potion", Multiplier = m.PersonalBoost, EndsAt = personalEnd })
	end

	local serverEnd = ReplicatedStorage:GetAttribute("ServerLuckEnd") or 0
	if serverEnd > now then
		table.insert(bonuses, { Name = "Server", Multiplier = m.ServerBoost, EndsAt = serverEnd })
	end

	-- Standing on Lucky Isle (the server sets this, so it can't be faked)
	if player:GetAttribute("OnLuckyIsland") then
		table.insert(bonuses, { Name = "Lucky Isle", Multiplier = Config.LuckyIsland.LuckMultiplier, Show = true, Island = true })
	end

	-- Rebirths: permanent luck
	local rebirths = player:GetAttribute("Rebirths") or 0
	if rebirths > 0 then
		table.insert(bonuses, { Name = "Rebirth", Multiplier = 1 + rebirths * Config.Rebirth.LuckPerRebirth })
	end

	-- Standing on a rebirth island (set by the RebirthIslands script)
	local islandKey = player:GetAttribute("OnRebirthIsland")
	if islandKey then
		for _, islandInfo in ipairs(Config.RebirthIslands) do
			if islandInfo.Key == islandKey then
				table.insert(bonuses, { Name = islandInfo.Name, Icon = islandInfo.Icon, Multiplier = islandInfo.LuckMultiplier, Show = true, Island = true })
			end
		end
	end

	-- Parkour reward (finish a course)
	local parkourEnd = player:GetAttribute("ParkourLuckEnd") or 0
	if parkourEnd > now then
		table.insert(bonuses, { Name = "Parkour", Multiplier = player:GetAttribute("ParkourLuckMultiplier") or 1.5, EndsAt = parkourEnd })
	end

	-- Equipped pets (the server works this out and sets it)
	local petLuck = player:GetAttribute("PetLuck") or 1
	if petLuck > 1 then
		table.insert(bonuses, { Name = "Pets", Multiplier = petLuck, Show = true })
	end

	-- Permanent luck (Limited Offer)
	local permanent = player:GetAttribute("PermanentLuck") or 1
	if permanent > 1 then
		table.insert(bonuses, { Name = "Forever", Multiplier = permanent })
	end

	-- Cosmic Roll from the Cosmic Drop: huge luck on the NEXT roll only
	if (player:GetAttribute("BoostRolls") or 0) > 0 then
		table.insert(bonuses, { Name = "Cosmic Roll", Multiplier = Config.Drop.BoostMultiplier, Show = true, NextRoll = true })
	end

	-- Reserved for events in a later part
	local eventLuck = ReplicatedStorage:GetAttribute("EventLuck")
	if eventLuck and eventLuck > 1 then
		table.insert(bonuses, { Name = "Event", Multiplier = eventLuck })
	end

	return bonuses
end

function Luck.Get(player)
	local total = Config.BaseLuck
	for _, bonus in ipairs(Luck.GetBonuses(player)) do
		total *= bonus.Multiplier
	end
	return total
end

function Luck.LuckyEvery(player)
	if player:GetAttribute("Pass_LuckyCharm") then
		return Config.LuckyCharmEvery
	end
	if (player:GetAttribute("Rebirths") or 0) >= 4 then
		return Config.Rebirth.LuckyEveryAt4
	end
	return Config.LuckyRollEvery
end

-- The island bonus (Lucky Isle or a rebirth island) you're standing on, or nil.
-- Islands multiply ALL your other luck: x30 luck on an x2 island = x60.
function Luck.IslandBonus(player)
	for _, bonus in ipairs(Luck.GetBonuses(player)) do
		if bonus.Island then
			return bonus
		end
	end
	return nil
end

function Luck.Format(n)
	if math.abs(n - math.floor(n + 0.5)) < 0.001 then
		return tostring(math.floor(n + 0.5))
	end
	local text = string.format("%.2f", n):gsub("0+$", ""):gsub("%.$", "")
	return text
end

-- 125 -> "2:05"
function Luck.FormatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

return Luck
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="7">
      <Properties>
        <string name="Name">PetData</string>
        <string name="Source"><![CDATA[-- PetData (ModuleScript in ReplicatedStorage)
-- Every pet and every egg. There are no coins: you pay for eggs with AURAS
-- from your inventory. Each island has 3 eggs; the further you get
-- (rebirth islands), the pricier the eggs and the better the pets.
-- Pets give luck: every equipped pet adds its Luck (0.25 = +25%).

local PetData = {}

PetData.MaxEquipped = 3

PetData.Rarities = {
	Common = { Order = 1, Color = Color3.fromRGB(200, 205, 220) },
	Uncommon = { Order = 2, Color = Color3.fromRGB(110, 230, 140) },
	Rare = { Order = 3, Color = Color3.fromRGB(90, 170, 255) },
	Epic = { Order = 4, Color = Color3.fromRGB(190, 110, 255) },
	Legendary = { Order = 5, Color = Color3.fromRGB(255, 200, 70) },
	Mythic = { Order = 6, Color = Color3.fromRGB(255, 80, 140) },
	Exclusive = { Order = 7, Color = Color3.fromRGB(255, 255, 255) },
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Shape = how the pet is built (see PetClient): Blob, Cat, Bunny, Bird,
-- Fish, Jelly, Dragon, Star, Wisp
PetData.List = {
	-- COSMIC ISLAND ---------------------------------------------------
	{ Name = "Pebble Blob", Rarity = "Common", Luck = 0.03, Shape = "Blob", Colors = { rgb(150, 140, 190), rgb(220, 210, 255) } },
	{ Name = "Star Kitten", Rarity = "Common", Luck = 0.05, Shape = "Cat", Colors = { rgb(240, 230, 255), rgb(170, 180, 255) } },
	{ Name = "Moon Bunny", Rarity = "Uncommon", Luck = 0.08, Shape = "Bunny", Colors = { rgb(210, 230, 255), rgb(140, 170, 230) } },
	{ Name = "Comet Pup", Rarity = "Rare", Luck = 0.14, Shape = "Cat", Colors = { rgb(120, 200, 255), rgb(255, 255, 255) } },
	{ Name = "Nebula Jelly", Rarity = "Rare", Luck = 0.18, Shape = "Jelly", Colors = { rgb(190, 110, 255), rgb(255, 140, 220) } },
	{ Name = "Aurora Bird", Rarity = "Epic", Luck = 0.28, Shape = "Bird", Colors = { rgb(100, 255, 190), rgb(120, 170, 255) } },
	{ Name = "Galaxy Cat", Rarity = "Epic", Luck = 0.38, Shape = "Cat", Colors = { rgb(60, 40, 140), rgb(255, 120, 230) } },
	{ Name = "Solar Dragon", Rarity = "Legendary", Luck = 0.65, Shape = "Dragon", Colors = { rgb(255, 150, 40), rgb(255, 230, 120) } },
	{ Name = "Void Wisp", Rarity = "Mythic", Luck = 1.0, Shape = "Wisp", Colors = { rgb(20, 10, 40), rgb(255, 40, 120) } },

	-- FROSTFALL -----------------------------------------------------
	{ Name = "Snow Blob", Rarity = "Uncommon", Luck = 0.12, Shape = "Blob", Colors = { rgb(240, 248, 255), rgb(170, 220, 255) } },
	{ Name = "Frost Bunny", Rarity = "Rare", Luck = 0.2, Shape = "Bunny", Colors = { rgb(200, 235, 255), rgb(90, 180, 255) } },
	{ Name = "Ice Penguin", Rarity = "Rare", Luck = 0.26, Shape = "Bird", Colors = { rgb(30, 40, 70), rgb(240, 250, 255) } },
	{ Name = "Glacier Fox", Rarity = "Epic", Luck = 0.42, Shape = "Cat", Colors = { rgb(170, 225, 255), rgb(255, 255, 255) } },
	{ Name = "Aurora Owl", Rarity = "Epic", Luck = 0.55, Shape = "Bird", Colors = { rgb(90, 255, 180), rgb(190, 160, 255) } },
	{ Name = "Frost Dragon", Rarity = "Legendary", Luck = 0.9, Shape = "Dragon", Colors = { rgb(120, 200, 255), rgb(230, 250, 255) } },
	{ Name = "Polar Spirit", Rarity = "Mythic", Luck = 1.5, Shape = "Wisp", Colors = { rgb(200, 245, 255), rgb(120, 255, 210) } },

	-- EMBER ISLE ----------------------------------------------------
	{ Name = "Ember Blob", Rarity = "Rare", Luck = 0.3, Shape = "Blob", Colors = { rgb(255, 120, 50), rgb(255, 210, 90) } },
	{ Name = "Magma Fish", Rarity = "Epic", Luck = 0.5, Shape = "Fish", Colors = { rgb(255, 80, 30), rgb(255, 190, 60) } },
	{ Name = "Cinder Cat", Rarity = "Epic", Luck = 0.65, Shape = "Cat", Colors = { rgb(60, 30, 30), rgb(255, 120, 40) } },
	{ Name = "Phoenix Chick", Rarity = "Legendary", Luck = 1.0, Shape = "Bird", Colors = { rgb(255, 160, 40), rgb(255, 60, 40) } },
	{ Name = "Lava Dragon", Rarity = "Legendary", Luck = 1.4, Shape = "Dragon", Colors = { rgb(200, 40, 20), rgb(255, 170, 40) } },
	{ Name = "Inferno Spirit", Rarity = "Mythic", Luck = 2.5, Shape = "Wisp", Colors = { rgb(255, 90, 20), rgb(255, 240, 150) } },

	-- NEON NEXUS ----------------------------------------------------
	{ Name = "Pixel Blob", Rarity = "Epic", Luck = 0.7, Shape = "Blob", Colors = { rgb(60, 230, 255), rgb(255, 70, 220) } },
	{ Name = "Synth Fish", Rarity = "Epic", Luck = 0.9, Shape = "Fish", Colors = { rgb(255, 70, 220), rgb(60, 230, 255) } },
	{ Name = "Neon Jelly", Rarity = "Legendary", Luck = 1.3, Shape = "Jelly", Colors = { rgb(255, 90, 230), rgb(120, 255, 255) } },
	{ Name = "Cyber Dragon", Rarity = "Legendary", Luck = 2.0, Shape = "Dragon", Colors = { rgb(30, 20, 60), rgb(60, 230, 255) } },
	{ Name = "Hologram Star", Rarity = "Mythic", Luck = 3.0, Shape = "Star", Colors = { rgb(140, 255, 255), rgb(255, 120, 240) } },
	{ Name = "Nexus Overmind", Rarity = "Mythic", Luck = 4.0, Shape = "Wisp", Colors = { rgb(255, 255, 255), rgb(200, 80, 255) } },

	-- EXCLUSIVE (Limited Offer) ---------------------------------------
	{ Name = "Cosmic Overlord", Rarity = "Exclusive", Luck = 3.0, Shape = "Dragon", Colors = { rgb(255, 230, 120), rgb(150, 80, 255) } },
}

-- Eggs: Cost = { Aura = name, Count = how many of that aura it takes }
-- Pets = { { Name, Weight } } (weights don't have to add up to 100)
PetData.Eggs = {
	-- COSMIC ISLAND (everyone)
	{ Key = "StardustEgg", Name = "Stardust Egg", Island = "Main", Slot = 1, Color = rgb(220, 215, 255),
		Cost = { Aura = "Stardust", Count = 4 },
		Pets = { { "Pebble Blob", 50 }, { "Star Kitten", 32 }, { "Moon Bunny", 15 }, { "Comet Pup", 3 } } },
	{ Key = "CometEgg", Name = "Comet Egg", Island = "Main", Slot = 2, Color = rgb(120, 200, 255),
		Cost = { Aura = "Comet", Count = 2 },
		Pets = { { "Comet Pup", 45 }, { "Nebula Jelly", 35 }, { "Aurora Bird", 17 }, { "Galaxy Cat", 3 } } },
	{ Key = "NebulaEgg", Name = "Nebula Egg", Island = "Main", Slot = 3, Color = rgb(190, 110, 255),
		Cost = { Aura = "Nebula", Count = 1 },
		Pets = { { "Aurora Bird", 45 }, { "Galaxy Cat", 35 }, { "Solar Dragon", 17 }, { "Void Wisp", 3 } } },

	-- FROSTFALL (rebirth 1)
	{ Key = "SnowEgg", Name = "Snow Egg", Island = "Frostfall", Slot = 1, Color = rgb(235, 245, 255),
		Cost = { Aura = "Aurora", Count = 3 },
		Pets = { { "Snow Blob", 50 }, { "Frost Bunny", 32 }, { "Ice Penguin", 15 }, { "Glacier Fox", 3 } } },
	{ Key = "GlacierEgg", Name = "Glacier Egg", Island = "Frostfall", Slot = 2, Color = rgb(140, 210, 255),
		Cost = { Aura = "Pulsar", Count = 2 },
		Pets = { { "Ice Penguin", 45 }, { "Glacier Fox", 35 }, { "Aurora Owl", 17 }, { "Frost Dragon", 3 } } },
	{ Key = "AuroraEgg", Name = "Aurora Egg", Island = "Frostfall", Slot = 3, Color = rgb(120, 255, 200),
		Cost = { Aura = "Solar Flare", Count = 1 },
		Pets = { { "Glacier Fox", 45 }, { "Aurora Owl", 35 }, { "Frost Dragon", 17 }, { "Polar Spirit", 3 } } },

	-- EMBER ISLE (rebirth 2)
	{ Key = "CinderEgg", Name = "Cinder Egg", Island = "Ember", Slot = 1, Color = rgb(120, 80, 70),
		Cost = { Aura = "Frostmoon", Count = 2 },
		Pets = { { "Ember Blob", 50 }, { "Magma Fish", 32 }, { "Cinder Cat", 15 }, { "Phoenix Chick", 3 } } },
	{ Key = "MagmaEgg", Name = "Magma Egg", Island = "Ember", Slot = 2, Color = rgb(255, 110, 40),
		Cost = { Aura = "Starfall", Count = 1 },
		Pets = { { "Magma Fish", 45 }, { "Cinder Cat", 35 }, { "Phoenix Chick", 17 }, { "Lava Dragon", 3 } } },
	{ Key = "PhoenixEgg", Name = "Phoenix Egg", Island = "Ember", Slot = 3, Color = rgb(255, 200, 60),
		Cost = { Aura = "Supernova", Count = 1 },
		Pets = { { "Cinder Cat", 45 }, { "Phoenix Chick", 35 }, { "Lava Dragon", 17 }, { "Inferno Spirit", 3 } } },

	-- NEON NEXUS (rebirth 3)
	{ Key = "PixelEgg", Name = "Pixel Egg", Island = "Nexus", Slot = 1, Color = rgb(60, 230, 255),
		Cost = { Aura = "Quasar", Count = 1 },
		Pets = { { "Pixel Blob", 50 }, { "Synth Fish", 32 }, { "Neon Jelly", 15 }, { "Cyber Dragon", 3 } } },
	{ Key = "SynthEgg", Name = "Synth Egg", Island = "Nexus", Slot = 2, Color = rgb(255, 70, 220),
		Cost = { Aura = "Celestial", Count = 1 },
		Pets = { { "Synth Fish", 45 }, { "Neon Jelly", 35 }, { "Cyber Dragon", 17 }, { "Hologram Star", 3 } } },
	{ Key = "OvermindEgg", Name = "Overmind Egg", Island = "Nexus", Slot = 3, Color = rgb(200, 120, 255),
		Cost = { Aura = "Black Hole", Count = 1 },
		Pets = { { "Neon Jelly", 45 }, { "Cyber Dragon", 35 }, { "Hologram Star", 17 }, { "Nexus Overmind", 3 } } },
}

PetData.ByName = {}
for index, pet in ipairs(PetData.List) do
	pet.Index = index
	PetData.ByName[pet.Name] = pet
end
PetData.EggByKey = {}
for _, egg in ipairs(PetData.Eggs) do
	PetData.EggByKey[egg.Key] = egg
	local total = 0
	for _, entry in ipairs(egg.Pets) do
		total += entry[2]
	end
	egg.TotalWeight = total
end

---------------------------------------------------------------------
-- MERGING: 3 of the same pet -> 1 GOLDEN pet, 3 golden -> 1 RAINBOW pet.
-- Merged pets are saved as "Golden:Star Kitten" / "Rainbow:Star Kitten".
---------------------------------------------------------------------
PetData.MergeCount = 3
PetData.Variants = {
	Golden = { Order = 2, Icon = "✨", Multiplier = 1.25, Next = "Rainbow" }, -- 24% luck -> 30%
	Rainbow = { Order = 3, Icon = "🌈", Multiplier = 1.6 }, -- 24% luck -> 38%
}
local GOLD_COLORS = { Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 245, 170) }

local variantCache = {}

-- "Golden:Star Kitten" -> "Golden", "Star Kitten"   ("Star Kitten" -> nil, "Star Kitten")
function PetData.SplitKey(key)
	local variant, base = string.match(key, "^(%a+):(.+)$")
	if variant and PetData.Variants[variant] then
		return variant, base
	end
	return nil, key
end

-- Works for normal pets AND merged pets. For a merged pet you get a copy
-- with the boosted Luck, Name = the saved key, DisplayName = "Golden Star Kitten".
function PetData.Get(key)
	if type(key) ~= "string" then
		return nil
	end
	local plain = PetData.ByName[key]
	if plain then
		return plain
	end
	if variantCache[key] then
		return variantCache[key]
	end
	local variant, baseName = PetData.SplitKey(key)
	local base = variant and PetData.ByName[baseName]
	if not base then
		return nil
	end
	local info = PetData.Variants[variant]
	local pet = table.clone(base)
	pet.Name = key
	pet.BaseName = base.Name
	pet.DisplayName = variant .. " " .. base.Name
	pet.Variant = variant
	pet.Luck = math.floor(base.Luck * info.Multiplier * 1000 + 0.5) / 1000
	if variant == "Golden" then
		pet.Colors = GOLD_COLORS
	end
	variantCache[key] = pet
	return pet
end

-- the name to show on screen
function PetData.Display(key)
	local pet = PetData.Get(key)
	return pet and (pet.DisplayName or pet.Name) or tostring(key)
end

-- what 3 of this pet merge into (nil if it can't merge any further)
function PetData.MergeResult(key)
	local variant, baseName = PetData.SplitKey(key)
	if not PetData.ByName[baseName] then
		return nil
	end
	if not variant then
		return "Golden:" .. baseName
	end
	local nextVariant = PetData.Variants[variant].Next
	return nextVariant and (nextVariant .. ":" .. baseName) or nil
end

function PetData.RarityOf(name)
	local pet = PetData.Get(name)
	return pet and PetData.Rarities[pet.Rarity]
end

-- Picks a pet from an egg
function PetData.Hatch(egg, rng)
	rng = rng or Random.new()
	local pick = rng:NextNumber() * egg.TotalWeight
	for _, entry in ipairs(egg.Pets) do
		pick -= entry[2]
		if pick <= 0 then
			return entry[1]
		end
	end
	return egg.Pets[1][1]
end

-- Chance text for an egg entry, e.g. "17%"
function PetData.ChanceText(egg, weight)
	local percent = weight / egg.TotalWeight * 100
	if percent < 1 then
		return ("%.1f%%"):format(percent)
	end
	return ("%d%%"):format(math.floor(percent + 0.5))
end

-- Luck from a list of equipped pet names: 1 + sum of their Luck
function PetData.LuckFrom(names)
	local total = 1
	for _, name in ipairs(names or {}) do
		local pet = PetData.Get(name)
		if pet then
			total += pet.Luck
		end
	end
	return total
end

-- "A,B,C" <-> { "A", "B", "C" } (pets are shared with everyone as a player attribute)
function PetData.Split(text)
	local list = {}
	if type(text) == "string" then
		for name in text:gmatch("[^,]+") do
			table.insert(list, name)
		end
	end
	return list
end

return PetData
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="8">
      <Properties>
        <string name="Name">QuestData</string>
        <string name="Source"><![CDATA[-- QuestData (ModuleScript in ReplicatedStorage)
-- Daily login rewards + daily quests. Everything resets at midnight UTC.
--   * DAILY REWARD: log in every day for a 7-day reward streak (miss a day
--     and the streak starts over; after day 7 it loops back to day 1)
--   * DAILY QUESTS: 3 new quests every day (everyone gets the same ones),
--     each with its own reward, plus a bonus chest for finishing all 3
--
-- Reward fields (mix them as you like):
--   Potion = minutes of x2 luck        BoostRolls = Cosmic Rolls (x50 next roll)
--   Aura = "Name", Count = how many    (auras are used to buy pet eggs)

local QuestData = {}

QuestData.DailyRewards = {
	{ Potion = 5 },
	{ Aura = "Comet", Count = 3 },
	{ BoostRolls = 1 },
	{ Potion = 15 },
	{ Aura = "Nebula", Count = 2 },
	{ BoostRolls = 2 },
	{ BoostRolls = 3, Potion = 30, Aura = "Solar Flare", Count = 1 }, -- the big one
}

-- Kinds of quests (what counts):
--   Rolls      = rolls anywhere
--   LuckyRolls = rolls while standing on Lucky Isle or a rebirth island
--   Rarity     = roll an aura at least this rare (Threshold), Goal = how many
--   Parkour    = finish any parkour course
--   DuelWin    = win duels (players or bots)
--   Hatch      = hatch eggs
--   Merge      = merge pets
QuestData.Pool = {
	-- slot 1 is always a rolling quest
	{ Id = "Roll150", Slot = 1, Kind = "Rolls", Goal = 150, Text = "Roll 150 times", Reward = { Potion = 10 } },
	{ Id = "Roll400", Slot = 1, Kind = "Rolls", Goal = 400, Text = "Roll 400 times", Reward = { BoostRolls = 1, Potion = 5 } },
	{ Id = "IslandRolls", Slot = 1, Kind = "LuckyRolls", Goal = 75, Text = "Roll 75 times on a luck island", Reward = { BoostRolls = 1 } },
	-- slots 2 and 3: everything else
	{ Id = "Rare500", Kind = "Rarity", Threshold = 500, Goal = 1, Text = "Roll a 1 in 500 aura or rarer", Reward = { Aura = "Comet", Count = 3 } },
	{ Id = "Rare2500", Kind = "Rarity", Threshold = 2500, Goal = 1, Text = "Roll a 1 in 2,500 aura or rarer", Reward = { BoostRolls = 2 } },
	{ Id = "Rare128x3", Kind = "Rarity", Threshold = 128, Goal = 3, Text = "Roll 3 auras of 1 in 128 or rarer", Reward = { Potion = 15 } },
	{ Id = "Parkour1", Kind = "Parkour", Goal = 1, Text = "Finish a parkour course", Reward = { Potion = 10 } },
	{ Id = "Parkour2", Kind = "Parkour", Goal = 2, Text = "Finish 2 parkour courses", Reward = { BoostRolls = 1, Aura = "Pulsar", Count = 1 } },
	{ Id = "Duel2", Kind = "DuelWin", Goal = 2, Text = "Win 2 duels (players or bots)", Reward = { Aura = "Nebula", Count = 1 } },
	{ Id = "Duel5", Kind = "DuelWin", Goal = 5, Text = "Win 5 duels (players or bots)", Reward = { BoostRolls = 2 } },
	{ Id = "Hatch3", Kind = "Hatch", Goal = 3, Text = "Hatch 3 pet eggs", Reward = { Potion = 10, Aura = "Stardust", Count = 6 } },
	{ Id = "Hatch8", Kind = "Hatch", Goal = 8, Text = "Hatch 8 pet eggs", Reward = { BoostRolls = 1, Aura = "Comet", Count = 2 } },
	{ Id = "Merge1", Kind = "Merge", Goal = 1, Text = "Merge 3 pets into a Golden pet", Reward = { BoostRolls = 1 } },
}
QuestData.ById = {}
for _, quest in ipairs(QuestData.Pool) do
	QuestData.ById[quest.Id] = quest
end

-- finishing all 3 quests of the day
QuestData.Bonus = { BoostRolls = 2, Potion = 15 }

-- Today's number (changes at midnight UTC)
function QuestData.Today(now)
	return math.floor((now or os.time()) / 86400)
end

-- seconds until the next reset
function QuestData.SecondsToReset(now)
	now = now or os.time()
	return 86400 - (now % 86400)
end

-- The 3 quests for a day: the same for everybody on that day
function QuestData.QuestsFor(day)
	local rng = Random.new(day * 7919 + 13)
	local slotOne, others = {}, {}
	for _, quest in ipairs(QuestData.Pool) do
		table.insert(quest.Slot == 1 and slotOne or others, quest)
	end
	local picked = { slotOne[rng:NextInteger(1, #slotOne)].Id }
	while #picked < 3 do
		local quest = others[rng:NextInteger(1, #others)]
		local kindTaken = false
		for _, id in ipairs(picked) do
			if QuestData.ById[id].Kind == quest.Kind then
				kindTaken = true
			end
		end
		if not kindTaken then
			table.insert(picked, quest.Id)
		end
	end
	return picked
end

-- "x2 luck 10 min + 1 Cosmic Roll + 3x Comet"
function QuestData.RewardText(reward)
	local parts = {}
	if reward.Potion then
		table.insert(parts, ("🧪 %d min x2 luck"):format(reward.Potion))
	end
	if reward.BoostRolls then
		table.insert(parts, ("🎲 %d Cosmic Roll%s"):format(reward.BoostRolls, reward.BoostRolls == 1 and "" or "s"))
	end
	if reward.Aura then
		table.insert(parts, ("✨ %dx %s"):format(reward.Count or 1, reward.Aura))
	end
	return table.concat(parts, " + ")
end

-- the main icon for a reward tile
function QuestData.RewardIcon(reward)
	if reward.BoostRolls and reward.Potion then
		return "🎁"
	elseif reward.BoostRolls then
		return "🎲"
	elseif reward.Aura then
		return "✨"
	end
	return "🧪"
end

return QuestData
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="9">
      <Properties>
        <string name="Name">Rebirth</string>
        <string name="Source"><![CDATA[-- Rebirth (ModuleScript in ReplicatedStorage)
-- The rebirth rules in one place, used by the server (to check and grant
-- rebirths) and by the screen (to show progress), so they always match.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local R = Config.Rebirth
local Rebirth = {}

-- What rebirth number n+1 costs when you have n rebirths
function Rebirth.Cost(n)
	n = n or 0
	local rolls = math.floor(R.BaseRolls * R.RollGrowth ^ n / 10 + 0.5) * 10
	local rarity = math.min(R.MaxRarity, R.BaseRarity * R.RarityGrowth ^ n)
	return { Rolls = rolls, Rarity = rarity }
end

-- Permanent luck from rebirths (1 = none)
function Rebirth.LuckMultiplier(n)
	return 1 + (n or 0) * R.LuckPerRebirth
end

-- Roll cooldown is multiplied by this (1 = normal, 0.7 = 30% faster)
function Rebirth.CooldownScale(n)
	return 1 - math.min(R.MaxRollSpeed, (n or 0) * R.RollSpeedPerRebirth)
end

function Rebirth.HasPerk(n, perkName)
	for _, perk in ipairs(R.Perks) do
		if perk.Name == perkName then
			return (n or 0) >= perk.Rebirths
		end
	end
	return false
end

-- Perks you get on exactly this rebirth number
function Rebirth.PerksAt(n)
	local list = {}
	for _, perk in ipairs(R.Perks) do
		if perk.Rebirths == n then
			table.insert(list, perk)
		end
	end
	return list
end

-- Progress for the screen: rolls done / needed, best aura since last rebirth
function Rebirth.Progress(player)
	local n = player:GetAttribute("Rebirths") or 0
	local cost = Rebirth.Cost(n)
	local rolls = player:GetAttribute("RebirthRolls") or 0
	local best = player:GetAttribute("RebirthBest") or 0
	return {
		Rebirths = n,
		Cost = cost,
		Rolls = rolls,
		Best = best,
		RollsDone = rolls >= cost.Rolls,
		RarityDone = best >= cost.Rarity,
		Ready = rolls >= cost.Rolls and best >= cost.Rarity,
	}
end

-- ⭐ text for name tags: "★3"
function Rebirth.Stars(n)
	if not n or n <= 0 then
		return ""
	end
	if n <= 3 then
		return string.rep("★", n)
	end
	return "★" .. n
end

-- Each rebirth level gets its own color (tags, trail)
local COLORS = {
	Color3.fromRGB(140, 220, 255), -- 1 ice
	Color3.fromRGB(255, 140, 50), -- 2 ember
	Color3.fromRGB(255, 80, 220), -- 3 neon
	Color3.fromRGB(120, 255, 150), -- 4 emerald
	Color3.fromRGB(255, 215, 80), -- 5+ gold
}
function Rebirth.Color(n)
	if not n or n <= 0 then
		return Color3.new(1, 1, 1)
	end
	return COLORS[math.min(n, #COLORS)]
end

return Rebirth
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="10">
      <Properties>
        <string name="Name">SoundFX</string>
        <string name="Source"><![CDATA[-- SoundFX (ModuleScript in ReplicatedStorage) - used by LocalScripts only
-- A small sound designer. Roblox only ships a handful of sound files with
-- every client, so each game sound is a RECIPE that stacks 1-4 layers of
-- those files, cuts out just the useful part, re-pitches them and runs them
-- through effects (distortion, compression, reverb, flange...). Every play
-- gets a tiny random pitch change so hits never sound copy-pasted.
--
-- Want a real sound instead? Put a Creator Store ID in
-- CosmicConfig.SoundOverrides for that name and it replaces the recipe.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local SoundFX = {}
local rand = Random.new()

-- The sound files every Roblox player has
local FILES = {
	Tick = "rbxasset://sounds/volume_slider.ogg", -- short click
	Boom = "rbxasset://sounds/impact_explosion_03.mp3", -- explosion
	Wind = "rbxasset://sounds/action_falling.ogg", -- rushing air
	Thud = "rbxasset://sounds/action_jump_land.mp3", -- body landing
	Jump = "rbxasset://sounds/action_jump.mp3", -- quick "hup" swoosh
	Water = "rbxasset://sounds/impact_water.mp3", -- splash (great for ice/shimmer)
	Steps = "rbxasset://sounds/action_footsteps_plastic.mp3", -- footsteps
	Ouch = "rbxasset://sounds/ouch.ogg", -- hurt voice
	Oof = "rbxasset://sounds/oof.ogg", -- hurt voice 2
}

-- Effect settings
local EFFECTS = {
	Reverb = { Class = "ReverbSoundEffect", Props = { DecayTime = 1.6, Density = 1, Diffusion = 1, DryLevel = 0, WetLevel = -5 } },
	BigReverb = { Class = "ReverbSoundEffect", Props = { DecayTime = 4, Density = 1, Diffusion = 1, DryLevel = -2, WetLevel = 0 } },
	Echo = { Class = "EchoSoundEffect", Props = { Delay = 0.22, Feedback = 0.35, DryLevel = 0, WetLevel = -6 } },
	ShortEcho = { Class = "EchoSoundEffect", Props = { Delay = 0.06, Feedback = 0.3, DryLevel = 0, WetLevel = -4 } },
	Bass = { Class = "EqualizerSoundEffect", Props = { LowGain = 9, MidGain = 0, HighGain = -4 } },
	Muffle = { Class = "EqualizerSoundEffect", Props = { LowGain = 6, MidGain = -16, HighGain = -45 } },
	Bright = { Class = "EqualizerSoundEffect", Props = { LowGain = -10, MidGain = 0, HighGain = 5 } },
	Thin = { Class = "EqualizerSoundEffect", Props = { LowGain = -30, MidGain = -2, HighGain = 4 } },
	Distort = { Class = "DistortionSoundEffect", Props = { Level = 0.55 } },
	Crunch = { Class = "DistortionSoundEffect", Props = { Level = 0.3 } },
	Compress = { Class = "CompressorSoundEffect", Props = { Attack = 0.005, Release = 0.15, Ratio = 6, Threshold = -18, GainMakeup = 6 } },
	Flange = { Class = "FlangeSoundEffect", Props = { Depth = 0.6, Mix = 0.7, Rate = 4 } },
	Chorus = { Class = "ChorusSoundEffect", Props = { Depth = 0.4, Mix = 0.6, Rate = 1.5 } },
	Tremolo = { Class = "TremoloSoundEffect", Props = { Depth = 1, Duty = 0.5, Frequency = 22 } },
	OctaveDown = { Class = "PitchShiftSoundEffect", Props = { Octave = 0.5 } },
}

-- Layer fields: S = file, Speed = pitch, Volume, Fx = effects,
-- From/To = only play that part (seconds), Delay = start later,
-- Jitter = random pitch range (default 0.06), Loop = loop it
local RECIPES = {
	-- UI + rolling ----------------------------------------------------
	Tick = { { S = "Tick", Speed = 1, Volume = 0.3, Jitter = 0, Fx = { "Muffle" } } },
	Click = { { S = "Tick", Speed = 1.35, Volume = 0.5 }, { S = "Thud", Speed = 2.6, Volume = 0.15, From = 0, To = 0.1 } },
	Hover = { { S = "Tick", Speed = 1.9, Volume = 0.15 } },
	Whoosh = { { S = "Wind", Speed = 1.8, Volume = 0.35, From = 0, To = 0.45, Fx = { "Bright" } } },
	-- reveals are soft bells + sparkles, not bangs (rarer = deeper and longer)
	Pop = { { S = "Tick", Speed = 1.5, Volume = 0.22, Fx = { "Reverb" } }, { S = "Water", Speed = 2.6, Volume = 0.1, Fx = { "Bright", "Reverb" } } },
	RevealRare = { { S = "Tick", Speed = 1.2, Volume = 0.3, Fx = { "Reverb", "Chorus" } }, { S = "Water", Speed = 2.2, Volume = 0.14, Fx = { "Reverb", "Bright" } } },
	RevealEpic = {
		{ S = "Tick", Speed = 0.95, Volume = 0.32, Fx = { "BigReverb", "Chorus" } },
		{ S = "Water", Speed = 1.8, Volume = 0.16, Fx = { "Chorus", "Reverb" } },
		{ S = "Boom", Speed = 0.9, Volume = 0.08, Fx = { "Muffle", "Reverb" } },
	},
	RevealLegendary = {
		{ S = "Tick", Speed = 0.72, Volume = 0.36, Fx = { "BigReverb", "Chorus" } },
		{ S = "Water", Speed = 1.4, Volume = 0.18, Fx = { "BigReverb", "Chorus" } },
		{ S = "Boom", Speed = 0.7, Volume = 0.12, Fx = { "Muffle", "BigReverb" } },
	},
	RevealMythic = {
		{ S = "Tick", Speed = 0.5, Volume = 0.4, Fx = { "BigReverb", "Flange" } },
		{ S = "Water", Speed = 1.1, Volume = 0.2, Fx = { "BigReverb", "Chorus" } },
		{ S = "Boom", Speed = 0.5, Volume = 0.16, Fx = { "Muffle", "BigReverb", "Bass" } },
	},
	-- a soft swell when you join the game
	IntroSwell = {
		{ S = "Wind", Speed = 0.55, Volume = 0.22, From = 0, To = 2.5, Fx = { "BigReverb", "Muffle" } },
		{ S = "Water", Speed = 1.2, Volume = 0.12, Fx = { "BigReverb", "Chorus" } },
	},
	Heartbeat = { { S = "Boom", Speed = 0.33, Volume = 0.55, From = 0, To = 0.5, Fx = { "Muffle", "Compress" } } },
	Rumble = { { S = "Wind", Speed = 0.45, Volume = 0.6, Loop = true, Fx = { "Muffle" } } },
	Equip = { { S = "Boom", Speed = 2, Volume = 0.18, From = 0, To = 0.6, Fx = { "Bright" } }, { S = "Water", Speed = 2.4, Volume = 0.2, Fx = { "Reverb" } } },
	Purchase = { { S = "Tick", Speed = 1.5, Volume = 0.5, Fx = { "Reverb" }, Jitter = 0 } },
	Thud = { { S = "Thud", Speed = 0.8, Volume = 0.5 } },

	-- FIGHTING ---------------------------------------------------------
	SwingLight = {
		{ S = "Wind", Speed = 3.4, Volume = 0.5, From = 0, To = 0.28, Fx = { "Bright" } },
		{ S = "Jump", Speed = 1.7, Volume = 0.25, Fx = { "Thin" } },
	},
	SwingHeavy = {
		{ S = "Wind", Speed = 2.1, Volume = 0.85, From = 0, To = 0.5 },
		{ S = "Jump", Speed = 1.05, Volume = 0.45 },
	},
	Jab = { -- a crisp punch landing
		{ S = "Thud", Speed = 1.9, Volume = 1, Fx = { "Bass", "Compress" } },
		{ S = "Boom", Speed = 3.6, Volume = 0.3, From = 0, To = 0.18, Fx = { "Bright" } },
		{ S = "Tick", Speed = 2.6, Volume = 0.35 },
	},
	HeavyHit = { -- a big smash
		{ S = "Thud", Speed = 1.15, Volume = 1, Fx = { "Bass", "Crunch" } },
		{ S = "Boom", Speed = 1.7, Volume = 0.7, From = 0, To = 0.55, Fx = { "Distort", "Bass" } },
		{ S = "Boom", Speed = 0.75, Volume = 0.35, From = 0, To = 1.2, Fx = { "Reverb", "Muffle" } },
		{ S = "Tick", Speed = 1.4, Volume = 0.4, Fx = { "ShortEcho" } },
	},
	Block = { -- metallic clang
		{ S = "Tick", Speed = 3.4, Volume = 0.9, Fx = { "ShortEcho", "Flange" } },
		{ S = "Boom", Speed = 4, Volume = 0.3, From = 0, To = 0.15, Fx = { "Bright" } },
		{ S = "Thud", Speed = 2.3, Volume = 0.45 },
	},
	GuardBreak = { -- shield shattering
		{ S = "Boom", Speed = 2.2, Volume = 0.75, From = 0, To = 0.4, Fx = { "Distort" } },
		{ S = "Water", Speed = 2.8, Volume = 0.6, Fx = { "Bright", "ShortEcho" } },
		{ S = "Tick", Speed = 0.6, Volume = 0.8, Fx = { "Flange", "Echo" } },
	},
	Dodge = {
		{ S = "Wind", Speed = 2.7, Volume = 0.65, From = 0, To = 0.32, Fx = { "Bright" } },
		{ S = "Steps", Speed = 1.7, Volume = 0.35, From = 0, To = 0.22 },
	},
	HurtLight = { { S = "Ouch", Speed = 1.05, Volume = 0.4, Jitter = 0.1 } },
	HurtHeavy = { { S = "Oof", Speed = 0.95, Volume = 0.5, Jitter = 0.1 } },
	Shoot = {
		{ S = "Tick", Speed = 1.8, Volume = 0.6, Fx = { "Echo" } },
		{ S = "Wind", Speed = 4, Volume = 0.4, From = 0, To = 0.2, Fx = { "Bright" } },
	},
	BeamFire = {
		{ S = "Tick", Speed = 0.45, Volume = 1, Fx = { "Echo", "Flange" } },
		{ S = "Wind", Speed = 3.5, Volume = 0.6, From = 0, To = 0.7, Fx = { "Flange" } },
		{ S = "Boom", Speed = 2.4, Volume = 0.45, From = 0, To = 0.3, Fx = { "Crunch" } },
	},
	Explosion = {
		{ S = "Boom", Speed = 0.85, Volume = 1, Fx = { "Bass", "Compress" } },
		{ S = "Boom", Speed = 0.5, Volume = 0.6, Fx = { "Reverb", "OctaveDown" } },
		{ S = "Water", Speed = 0.6, Volume = 0.35, Delay = 0.05 },
	},
	IceShatter = {
		{ S = "Water", Speed = 2.9, Volume = 0.75, Fx = { "Reverb", "Bright" } },
		{ S = "Tick", Speed = 0.3, Volume = 0.8, Fx = { "Reverb" } },
		{ S = "Tick", Speed = 5, Volume = 0.3, Delay = 0.08 },
	},
	HealShimmer = {
		{ S = "Water", Speed = 1.7, Volume = 0.35, Fx = { "Reverb", "Chorus" } },
		{ S = "Tick", Speed = 1.5, Volume = 0.4, Fx = { "Reverb" } },
		{ S = "Tick", Speed = 1.89, Volume = 0.35, Delay = 0.08, Fx = { "Reverb" } },
		{ S = "Tick", Speed = 2.25, Volume = 0.3, Delay = 0.16, Fx = { "Reverb" } },
	},
	TeleportZap = {
		{ S = "Water", Speed = 3.6, Volume = 0.5, Fx = { "Flange" } },
		{ S = "Tick", Speed = 0.8, Volume = 0.7, Fx = { "Echo" } },
		{ S = "Wind", Speed = 4, Volume = 0.4, From = 0, To = 0.15 },
	},
	BurnCrackle = { { S = "Wind", Speed = 4.5, Volume = 0.3, From = 0, To = 0.22, Fx = { "Tremolo", "Bright" } } },
	Vacuum = {
		{ S = "Wind", Speed = 0.75, Volume = 0.85, From = 0, To = 0.9, Fx = { "Flange" } },
		{ S = "Boom", Speed = 0.6, Volume = 0.5, From = 0, To = 0.8, Fx = { "Muffle" }, Delay = 0.3 },
	},
	ShieldUp = {
		{ S = "Tick", Speed = 0.7, Volume = 0.7, Fx = { "Chorus", "Reverb" } },
		{ S = "Water", Speed = 2.2, Volume = 0.35, Fx = { "Flange" } },
	},
	Beep = { { S = "Tick", Speed = 1, Volume = 1, Fx = { "ShortEcho" }, Jitter = 0 }, { S = "Tick", Speed = 2, Volume = 0.4, Jitter = 0 } },
	Gong = { -- "FIGHT!"
		{ S = "Boom", Speed = 0.45, Volume = 1, Fx = { "BigReverb", "Bass" }, Jitter = 0 },
		{ S = "Tick", Speed = 0.25, Volume = 0.8, Fx = { "BigReverb", "Chorus" }, Jitter = 0 },
		{ S = "Boom", Speed = 1.2, Volume = 0.5, From = 0, To = 0.6, Jitter = 0 },
	},

	-- old names kept so nothing else breaks
	Punch = { { S = "Thud", Speed = 1.5, Volume = 0.7, Fx = { "Bass" } } },
	Hit = { { S = "Boom", Speed = 2.8, Volume = 0.3, From = 0, To = 0.3, Fx = { "Bright" } } },
	Swoosh = { { S = "Wind", Speed = 2.4, Volume = 0.4, From = 0, To = 0.25, Fx = { "Bright" } } },
	Zap = { { S = "Tick", Speed = 0.5, Volume = 0.8, Fx = { "Echo" } } },
	Freeze = { { S = "Tick", Speed = 0.35, Volume = 0.9, Fx = { "Reverb", "Bright" } }, { S = "Water", Speed = 2.6, Volume = 0.4, Fx = { "Reverb" } } },

	-- drum kit for the duel beat
	Kick = { { S = "Boom", Speed = 0.38, Volume = 0.8, From = 0, To = 0.28, Fx = { "Muffle", "Compress" }, Jitter = 0.02 } },
	Snare = {
		{ S = "Thud", Speed = 1.45, Volume = 0.55, Jitter = 0.03 },
		{ S = "Boom", Speed = 2.6, Volume = 0.3, From = 0, To = 0.12, Fx = { "Bright" }, Jitter = 0.03 },
	},
	HatClosed = { { S = "Tick", Speed = 3.2, Volume = 0.2, Fx = { "Thin" }, Jitter = 0.03 } },
	HatOpen = { { S = "Wind", Speed = 5, Volume = 0.14, From = 0, To = 0.14, Fx = { "Thin" }, Jitter = 0.03 } },
}
SoundFX.Recipes = RECIPES

-- All game sounds go through one group so they can be muted together
local group = SoundService:FindFirstChild("CosmicSFX")
if not group then
	group = Instance.new("SoundGroup")
	group.Name = "CosmicSFX"
	group.Volume = Config.MasterVolume
	group.Parent = SoundService
end
local musicGroup = SoundService:FindFirstChild("CosmicMusic")
if not musicGroup then
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "CosmicMusic"
	musicGroup.Volume = 1
	musicGroup.Parent = SoundService
end
SoundFX.MusicGroup = musicGroup

local muted = false
local DEFAULT_JITTER = 0.06

local function addEffects(sound, list)
	for priority, effectName in ipairs(list or {}) do
		local recipe = EFFECTS[effectName]
		if recipe then
			local effect = Instance.new(recipe.Class)
			for key, value in pairs(recipe.Props) do
				effect[key] = value
			end
			effect.Priority = priority
			effect.Parent = sound
		end
	end
end

local function place(sound, opts)
	if opts.Parent then
		-- 3D sound that comes from a place in the world
		sound.RollOffMinDistance = 10
		sound.RollOffMaxDistance = opts.MaxDistance or 150
		sound.Parent = opts.Parent
	else
		sound.Parent = SoundService
	end
end

local function buildLayer(layer, opts)
	local sound = Instance.new("Sound")
	sound.Name = "SFX"
	sound.SoundId = FILES[layer.S] or FILES.Tick
	local jitter = opts.NoJitter and 0 or (layer.Jitter or DEFAULT_JITTER)
	sound.PlaybackSpeed = layer.Speed * (opts.Speed or 1) * (1 + rand:NextNumber(-jitter, jitter))
	sound.Volume = layer.Volume * (opts.Volume or 1)
	sound.Looped = layer.Loop == true
	sound.SoundGroup = opts.Music and musicGroup or group
	if layer.From then
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(layer.From, layer.To or (layer.From + 1))
	end
	addEffects(sound, layer.Fx)
	place(sound, opts)
	return sound
end

local function lifetime(layer, speed)
	if layer.To then
		return (layer.To - (layer.From or 0)) / math.max(speed, 0.05) + 1.5
	end
	return 6
end

local function buildOverride(id, opts)
	local sound = Instance.new("Sound")
	sound.Name = "SFX"
	sound.SoundId = id
	sound.Volume = 0.5 * (opts.Volume or 1)
	sound.PlaybackSpeed = opts.Speed or 1
	sound.SoundGroup = opts.Music and musicGroup or group
	place(sound, opts)
	return sound
end

-- Play a sound by name. opts: { Speed, Volume, Parent = part (3D), MaxDistance, NoJitter }
-- Returns the first layer's Sound.
function SoundFX.Play(name, opts)
	opts = opts or {}
	local override = Config.SoundOverrides[name]
	if override ~= nil and override ~= "" then
		local sound = buildOverride(override, opts)
		sound:Play()
		Debris:AddItem(sound, 8)
		return sound
	end
	local recipe = RECIPES[name]
	if not recipe then
		warn("[SoundFX] unknown sound", name)
		return nil
	end
	local first
	for _, layer in ipairs(recipe) do
		local function go()
			if opts.Parent and not opts.Parent.Parent then
				return -- the thing making the sound is gone
			end
			local sound = buildLayer(layer, opts)
			sound:Play()
			if not sound.Looped then
				Debris:AddItem(sound, lifetime(layer, sound.PlaybackSpeed))
			end
			return sound
		end
		if layer.Delay then
			task.delay(layer.Delay, go)
		else
			local sound = go()
			first = first or sound
		end
	end
	return first
end

-- Start a looping sound (fades in). Stop it with SoundFX.FadeOut.
function SoundFX.Loop(name, fadeIn, opts)
	opts = opts or {}
	local recipe = RECIPES[name]
	if not recipe then
		return nil
	end
	local layer = table.clone(recipe[1])
	layer.Loop = true
	layer.From, layer.To = nil, nil
	local sound = buildLayer(layer, opts)
	local target = sound.Volume
	sound.Volume = 0
	sound:Play()
	TweenService:Create(sound, TweenInfo.new(fadeIn or 0.5), { Volume = target }):Play()
	return sound
end

function SoundFX.FadeOut(sound, duration)
	if not sound then
		return
	end
	duration = duration or 0.5
	TweenService:Create(sound, TweenInfo.new(duration), { Volume = 0 }):Play()
	Debris:AddItem(sound, duration + 0.1)
end

-- A rising "charging up" whoosh that lasts `duration` seconds
function SoundFX.Riser(duration, opts)
	opts = opts or {}
	local sound = buildLayer({ S = "Wind", Speed = 0.5, Volume = 0.7, Loop = true, Fx = { "Flange", "Bright" }, Jitter = 0 }, opts)
	sound.Volume = 0.1 * (opts.Volume or 1)
	sound:Play()
	TweenService:Create(sound, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		PlaybackSpeed = 2.2,
		Volume = 0.8 * (opts.Volume or 1),
	}):Play()
	task.delay(duration, function()
		SoundFX.FadeOut(sound, 0.15)
	end)
	return sound
end

-- Notes made from the click sound. steps = list of pitch ratios.
function SoundFX.Notes(steps, gap, opts)
	opts = opts or {}
	task.spawn(function()
		for _, ratio in ipairs(steps) do
			if type(ratio) == "table" then -- a chord: several notes at once
				for _, r in ipairs(ratio) do
					SoundFX.Play("Purchase", { Speed = r / 1.5, Volume = (opts.Volume or 0.8) * 0.7, NoJitter = true, Parent = opts.Parent })
				end
			else
				SoundFX.Play("Purchase", { Speed = ratio / 1.5, Volume = opts.Volume or 0.8, NoJitter = true, Parent = opts.Parent })
			end
			task.wait(gap or 0.08)
		end
	end)
end

-- Quick rising "ding ding ding" (new best, purchases)
function SoundFX.Chime(baseSpeed, notes)
	baseSpeed = baseSpeed or 1
	local scale = { 1, 1.26, 1.5, 2, 2.52 }
	local steps = {}
	for i = 1, math.min(notes or 4, #scale) do
		steps[i] = scale[i] * baseSpeed
	end
	SoundFX.Notes(steps, 0.07)
end

-- Short tunes
function SoundFX.Jingle(name)
	if name == "Victory" then
		SoundFX.Notes({ 1, 1.26, 1.5, 2, 1.5, 2, { 2, 2.52, 3 } }, 0.1, { Volume = 0.9 })
		task.delay(0.65, function()
			SoundFX.Play("Gong", { Volume = 0.6, Speed = 1.4 })
		end)
	elseif name == "Defeat" then
		SoundFX.Notes({ 1.5, 1.33, 1.19, 1, { 0.75, 0.89, 1.12 } }, 0.16, { Volume = 0.8 })
		task.delay(0.7, function()
			SoundFX.Play("Heartbeat", { Volume = 1 })
		end)
	elseif name == "Rebirth" then
		-- rising riser, a big boom, then a bright fanfare
		SoundFX.Riser(1.1, { Volume = 0.9 })
		task.delay(1.1, function()
			SoundFX.Play("Explosion", { Volume = 0.7, Speed = 0.8 })
			SoundFX.Play("Gong", { Volume = 0.8, Speed = 1.1 })
			SoundFX.Play("RevealMythic", { Volume = 0.7 })
			SoundFX.Notes({ 1, 1.26, 1.5, 2, { 1.5, 2, 2.52 }, 2.52, { 2, 2.52, 3 } }, 0.09, { Volume = 0.9 })
		end)
	elseif name == "Countdown" then
		SoundFX.Play("Beep")
	end
end

-- Volume levels from the sound settings (0 = silent, 1 = normal)
local sfxLevel, musicLevel = 1, 1
local function applyVolumes()
	group.Volume = muted and 0 or Config.MasterVolume * sfxLevel
	musicGroup.Volume = muted and 0 or musicLevel
end

function SoundFX.SetMuted(value)
	muted = value
	applyVolumes()
end

-- sfx = sound effects, music = background music (both 0 to 1)
function SoundFX.SetVolumes(sfx, music)
	if type(sfx) == "number" then
		sfxLevel = math.clamp(sfx, 0, 1)
	end
	if type(music) == "number" then
		musicLevel = math.clamp(music, 0, 1)
	end
	applyVolumes()
end

function SoundFX.GetVolumes()
	return sfxLevel, musicLevel
end

function SoundFX.IsMuted()
	return muted
end

-- Background ambience: your music if set, otherwise a soft space hum
local ambient
function SoundFX.StartAmbient()
	if ambient then
		return
	end
	ambient = Instance.new("Sound")
	ambient.Name = "CosmicAmbient"
	ambient.Looped = true
	ambient.SoundGroup = musicGroup
	if Config.AmbientMusic ~= "" then
		ambient.SoundId = Config.AmbientMusic
		ambient.Volume = Config.AmbientVolume
	else
		ambient.SoundId = FILES.Wind
		ambient.PlaybackSpeed = 0.22
		ambient.Volume = Config.AmbientVolume * 0.35
		addEffects(ambient, { "Muffle" })
	end
	ambient.Parent = SoundService
	ambient:Play()
end

function SoundFX.SetAmbientVolume(fraction, duration)
	if ambient then
		local base = (Config.AmbientMusic ~= "") and Config.AmbientVolume or Config.AmbientVolume * 0.35
		TweenService:Create(ambient, TweenInfo.new(duration or 1), { Volume = base * fraction }):Play()
	end
end

return SoundFX
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="11">
      <Properties>
        <string name="Name">UIKit</string>
        <string name="Source"><![CDATA[-- UIKit (ModuleScript in ReplicatedStorage) - used by LocalScripts only
-- Shared look + helpers for every screen in the game: colors, fonts,
-- buttons with bounce + sound, particle bursts, confetti, toasts and
-- "only one panel open at a time".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))

local UIKit = {}

UIKit.Theme = {
	Panel = Color3.fromRGB(18, 14, 34),
	PanelLight = Color3.fromRGB(34, 28, 62),
	Accent = Color3.fromRGB(150, 110, 255),
	Accent2 = Color3.fromRGB(80, 190, 255),
	Gold = Color3.fromRGB(255, 200, 70),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(190, 180, 225),
	Good = Color3.fromRGB(90, 220, 130),
	Bad = Color3.fromRGB(240, 80, 100),
}
UIKit.TitleFont = Enum.Font.FredokaOne
UIKit.BodyFont = Enum.Font.GothamBold

local THEME = UIKit.Theme
local rand = Random.new()

---------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------
function UIKit.new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = UIKit.new

function UIKit.corner(radius)
	return new("UICorner", { CornerRadius = radius or UDim.new(0, 12) })
end

-- Outline around a frame/button (named "Border" so it is easy to find)
function UIKit.stroke(color, thickness, transparency)
	return new("UIStroke", {
		Name = "Border",
		Color = color,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- Black outline around text
function UIKit.textStroke(thickness)
	return new("UIStroke", {
		Name = "TextOutline",
		Color = Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UIKit.gradient(c1, c2, rotation)
	return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90 })
end

function UIKit.tween(inst, duration, props, style, direction)
	local tw = TweenService:Create(
		inst,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end
local tween = UIKit.tween

function UIKit.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UIKit.BodyFont,
		TextColor3 = THEME.Text,
		TextSize = 18,
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	return new("TextLabel", defaults)
end

-- Very dark colors are unreadable as text; this brightens them.
function UIKit.readable(color, minValue)
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s, math.max(v, minValue or 0.6))
end

-- Hover/press bounce + sounds for any button
function UIKit.addButtonFeel(button, noSound)
	local scale = button:FindFirstChild("FeelScale") or new("UIScale", { Name = "FeelScale", Parent = button })
	button.MouseEnter:Connect(function()
		tween(scale, 0.12, { Scale = 1.06 })
		if not noSound then
			SoundFX.Play("Hover")
		end
	end)
	button.MouseLeave:Connect(function()
		tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		tween(scale, 0.06, { Scale = 0.92 })
	end)
	button.MouseButton1Up:Connect(function()
		tween(scale, 0.18, { Scale = 1.06 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		if not noSound then
			SoundFX.Play("Click")
		end
	end)
end

-- Shrinks UI on small screens (phones). Returns the UIScale.
function UIKit.addAutoScale(guiObject, baseHeight)
	local camera = workspace.CurrentCamera
	local scale = new("UIScale", { Name = "ScreenScale", Parent = guiObject })
	local function update()
		scale.Scale = math.clamp(camera.ViewportSize.Y / (baseHeight or 820), 0.55, 1.1)
	end
	update()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	return scale
end

-- A ScreenGui for this player
function UIKit.screen(name, displayOrder)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	return new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		Parent = playerGui,
	})
end

---------------------------------------------------------------------
-- Effects layer (bursts, confetti, toasts) on top of everything
---------------------------------------------------------------------
local fxGui
local function getFxGui()
	if not fxGui or not fxGui.Parent then
		fxGui = UIKit.screen("CosmicFX", 50)
	end
	return fxGui
end

local STAR_GLYPHS = { "✦", "✧", "★", "✶" }

-- Stars and dots flying out from a point (origin in screen scale 0-1)
function UIKit.burst(colors, count, power, origin)
	local layer = getFxGui()
	origin = origin or Vector2.new(0.5, 0.4)
	power = power or 1
	for _ = 1, count do
		local angle = rand:NextNumber(0, math.pi * 2)
		local dist = rand:NextNumber(120, 380) * power
		local color = colors[rand:NextInteger(1, #colors)]
		local startPos = UDim2.fromScale(origin.X, origin.Y)
		local endPos = UDim2.new(origin.X, math.cos(angle) * dist, origin.Y, math.sin(angle) * dist)
		local duration = rand:NextNumber(0.6, 1.2)
		local piece
		if rand:NextNumber() < 0.5 then
			local size = rand:NextInteger(6, 14)
			piece = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = startPos, Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = color, BorderSizePixel = 0, Parent = layer,
			}, { UIKit.corner(UDim.new(1, 0)) })
			tween(piece, duration, { Position = endPos, Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)
		else
			piece = UIKit.label({
				AnchorPoint = Vector2.new(0.5, 0.5), Position = startPos, Size = UDim2.fromOffset(40, 40),
				Text = STAR_GLYPHS[rand:NextInteger(1, #STAR_GLYPHS)], TextColor3 = color,
				TextSize = rand:NextInteger(18, 36), Font = Enum.Font.GothamBlack,
				Rotation = rand:NextNumber(0, 360), Parent = layer,
			})
			tween(piece, duration, {
				Position = endPos, TextTransparency = 1, Rotation = piece.Rotation + rand:NextNumber(-270, 270),
			}, Enum.EasingStyle.Quart)
		end
		Debris:AddItem(piece, duration + 0.1)
	end
end

-- Confetti raining from the top of the screen
function UIKit.confetti(colors, count)
	local layer = getFxGui()
	for _ = 1, count or 60 do
		local x = rand:NextNumber(0, 1)
		local w, h = rand:NextInteger(6, 12), rand:NextInteger(10, 18)
		local piece = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(x, 0, 0, -20),
			Size = UDim2.fromOffset(w, h),
			Rotation = rand:NextNumber(0, 360),
			BackgroundColor3 = colors[rand:NextInteger(1, #colors)],
			BorderSizePixel = 0,
			Parent = layer,
		}, { UIKit.corner(UDim.new(0, 2)) })
		local duration = rand:NextNumber(1.6, 2.8)
		task.delay(rand:NextNumber(0, 0.5), function()
			tween(piece, duration, {
				Position = UDim2.new(x + rand:NextNumber(-0.15, 0.15), 0, 1, 40),
				Rotation = piece.Rotation + rand:NextNumber(-540, 540),
			}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		end)
		Debris:AddItem(piece, duration + 0.7)
	end
end

-- Little message that slides up near the bottom of the screen
local toastLabel, toastStroke, toastToken = nil, nil, 0
function UIKit.toast(text, color)
	local layer = getFxGui()
	if not toastLabel or toastLabel.Parent ~= layer then
		toastLabel = UIKit.label({
			Name = "Toast",
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -175), Size = UDim2.fromOffset(700, 34),
			Text = "", Font = UIKit.TitleFont, TextSize = 24, TextTransparency = 1, Parent = layer,
		})
		toastStroke = UIKit.textStroke(2)
		toastStroke.Transparency = 1
		toastStroke.Parent = toastLabel
	end
	toastToken += 1
	local token = toastToken
	toastLabel.Text = text
	toastLabel.TextColor3 = color or THEME.Text
	toastLabel.Position = UDim2.new(0.5, 0, 1, -150)
	toastLabel.TextTransparency = 0
	toastStroke.Transparency = 0.3
	tween(toastLabel, 0.25, { Position = UDim2.new(0.5, 0, 1, -175) }, Enum.EasingStyle.Back)
	task.delay(2.5, function()
		if token == toastToken then
			tween(toastLabel, 0.4, { TextTransparency = 1 })
			tween(toastStroke, 0.4, { Transparency = 1 })
		end
	end)
end

---------------------------------------------------------------------
-- Panels: open one and the others close
---------------------------------------------------------------------
local panelEvent = Instance.new("BindableEvent")
UIKit.PanelOpened = panelEvent.Event -- fires with the panel's name

function UIKit.announcePanel(name)
	panelEvent:Fire(name)
end

-- Big "your luck just got multiplied" popup when you arrive on an island:
--   LUCKY ISLE / ALL YOUR LUCK x2 / x30 -> x60 (the last number counts up)
local function shortNumber(n)
	if n >= 1000 then
		local withCommas = tostring(math.floor(n + 0.5)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
		return withCommas
	end
	local text = string.format("%.2f", n):gsub("0+$", ""):gsub("%.$", "")
	return text
end
local boostToken = 0
function UIKit.luckBoost(icon, placeName, multiplier, before, after, color)
	local layer = getFxGui()
	boostToken += 1
	local token = boostToken
	local old = layer:FindFirstChild("LuckBoost")
	if old then
		old:Destroy()
	end
	local card = new("Frame", {
		Name = "LuckBoost", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -160), Size = UDim2.fromOffset(520, 128),
		BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.12, Parent = layer,
	}, { UIKit.corner(UDim.new(0, 18)), UIKit.stroke(color, 2.5, 0) })
	UIKit.addAutoScale(card)
	local title = UIKit.label({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 28), Text = icon .. " " .. placeName:upper(),
		Font = UIKit.TitleFont, TextSize = 26, TextColor3 = color, Parent = card })
	UIKit.textStroke(2).Parent = title
	UIKit.label({ Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 0, 22), Text = ("ALL YOUR LUCK IS MULTIPLIED x%s"):format(shortNumber(multiplier)),
		Font = UIKit.TitleFont, TextSize = 18, TextColor3 = THEME.Text, Parent = card })
	local numbers = UIKit.label({ Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 56), RichText = true, Text = "",
		Font = UIKit.TitleFont, TextSize = 42, Parent = card })
	UIKit.textStroke(2.5).Parent = numbers
	tween(card, 0.45, { Position = UDim2.new(0.5, 0, 0, 96) }, Enum.EasingStyle.Back)
	SoundFX.Chime(1, 5)
	task.spawn(function()
		-- count up from your old luck to the new luck
		local steps = 24
		for i = 0, steps do
			if token ~= boostToken or not card.Parent then
				return
			end
			local f = i / steps
			local value = before + (after - before) * (1 - (1 - f) ^ 3)
			numbers.Text = ("<font color='#bfb4e1'>x%s</font>  →  <font color='#78ffaa'>x%s</font>"):format(shortNumber(before), shortNumber(value))
			if i % 4 == 0 then
				SoundFX.Play("Tick", { Speed = 1 + f, Volume = 0.6 })
			end
			task.wait(0.04)
		end
		UIKit.burst({ color, THEME.Good, Color3.new(1, 1, 1) }, 24, 0.8, Vector2.new(0.5, 0.2))
		task.wait(3.2)
		if token == boostToken and card.Parent then
			tween(card, 0.4, { Position = UDim2.new(0.5, 0, 0, -160) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.wait(0.45)
			card:Destroy()
		end
	end)
end

-- Pop-in animation for a panel (needs a UIScale named "PopScale")
function UIKit.popIn(guiObject)
	local pop = guiObject:FindFirstChild("PopScale") or new("UIScale", { Name = "PopScale", Parent = guiObject })
	pop.Scale = 0.8
	tween(pop, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
	SoundFX.Play("Whoosh")
end

return UIKit
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">DropService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- DropService (Script in ServerScriptService)
-- THE COSMIC DROP: every 15 minutes (Config.Drop) a Cosmic Roll appears
-- somewhere on the main island or Lucky Isle. The first player to touch it
-- gets x50 luck on their NEXT roll (one use, saved until used).
-- Everyone sees the countdown at the top of the screen (DropClient).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local DROP = Config.Drop
local INTERVAL = DROP.IntervalMinutes * 60
local PICKUP_RANGE = 7
local rand = Random.new()

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local AnnounceRemote = remotes:WaitForChild("Announce")

-- RollService listens to this to hand out the Cosmic Roll
local events = ServerStorage:FindFirstChild("CosmicServerEvents")
if not events then
	events = Instance.new("Folder")
	events.Name = "CosmicServerEvents"
	events.Parent = ServerStorage
end
local grant = events:FindFirstChild("GrantBoostRoll")
if not grant then
	grant = Instance.new("BindableEvent")
	grant.Name = "GrantBoostRoll"
	grant.Parent = events
end

---------------------------------------------------------------------
-- Where can it land?
---------------------------------------------------------------------
local P = Config.Places
local AVOID = { -- big builds the drop shouldn't land inside
	{ Vector3.zero, 10 }, { P.Core, 13 }, { P.Board, 9 }, { P.PortalPlaza, 13 }, { P.Pond, 12 },
	{ P.RebirthGate, 14 }, { P.Hatchery, 20 },
}

local function pickSpot()
	if rand:NextNumber() < DROP.LuckyIsleChance then
		local lucky = Config.LuckyIsland
		local a = rand:NextNumber(0, math.pi * 2)
		local r = rand:NextNumber(16, lucky.Radius - 12)
		return lucky.Center + Vector3.new(math.cos(a) * r, 3.5, math.sin(a) * r), "Lucky Isle"
	end
	for _ = 1, 50 do
		local a = rand:NextNumber(0, math.pi * 2)
		local r = rand:NextNumber(14, Config.MainIslandRadius - 10)
		local spot = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local ok = math.abs(spot.X) > 7 or spot.Z < 40 -- not on the duel bridge path
		for _, zone in ipairs(AVOID) do
			if (spot - Vector3.new(zone[1].X, 0, zone[1].Z)).Magnitude < zone[2] then
				ok = false
			end
		end
		if ok then
			return spot + Vector3.new(0, 3.5, 0), "Cosmic Island"
		end
	end
	return Vector3.new(0, 3.5, -20), "Cosmic Island"
end

---------------------------------------------------------------------
-- The drop itself: a glowing spinning die under a beam of light
---------------------------------------------------------------------
local current -- { Model, Position }

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	for key, value in pairs(props) do
		p[key] = value
	end
	p.Parent = parent
	return p
end

local GOLD = Color3.fromRGB(255, 215, 90)
local PURPLE = Color3.fromRGB(170, 110, 255)

local function buildDrop(position)
	local model = Instance.new("Model")
	model.Name = "CosmicDrop"
	local die = part({
		Name = "Die",
		Size = Vector3.one * 2.6,
		CFrame = CFrame.new(position),
		Color = Color3.fromRGB(255, 250, 235),
		Material = Enum.Material.Neon,
	}, model)
	-- dots on every face
	local faces = {
		{ Vector3.new(0, 0, -1), { Vector2.new(0, 0) } },
		{ Vector3.new(0, 0, 1), { Vector2.new(-0.5, -0.5), Vector2.new(0.5, 0.5) } },
		{ Vector3.new(1, 0, 0), { Vector2.new(-0.5, -0.5), Vector2.new(0, 0), Vector2.new(0.5, 0.5) } },
		{ Vector3.new(-1, 0, 0), { Vector2.new(-0.5, -0.5), Vector2.new(0.5, -0.5), Vector2.new(-0.5, 0.5), Vector2.new(0.5, 0.5) } },
		{ Vector3.new(0, 1, 0), { Vector2.new(-0.5, -0.5), Vector2.new(0.5, -0.5), Vector2.new(0, 0), Vector2.new(-0.5, 0.5), Vector2.new(0.5, 0.5) } },
		{ Vector3.new(0, -1, 0), { Vector2.new(-0.5, -0.6), Vector2.new(0.5, -0.6), Vector2.new(-0.5, 0), Vector2.new(0.5, 0), Vector2.new(-0.5, 0.6), Vector2.new(0.5, 0.6) } },
	}
	for _, face in ipairs(faces) do
		local normal = face[1]
		local right = (math.abs(normal.Y) > 0.5) and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0):Cross(normal)
		local up = normal:Cross(right)
		for _, dot in ipairs(face[2]) do
			part({
				Name = "Dot",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.45,
				CFrame = CFrame.new(position + normal * 1.3 + right * dot.X * 1.3 + up * dot.Y * 1.3),
				Color = PURPLE,
				Material = Enum.Material.Neon,
			}, model)
		end
	end
	local glow = part({
		Name = "Glow",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 5,
		CFrame = CFrame.new(position),
		Color = GOLD,
		Material = Enum.Material.Neon,
		Transparency = 0.75,
	}, model)
	local light = Instance.new("PointLight")
	light.Color = GOLD
	light.Range = 30
	light.Brightness = 4
	light.Parent = glow
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = Config.Textures.Sparkle
	sparkle.Rate = 30
	sparkle.Lifetime = NumberRange.new(1, 2)
	sparkle.Speed = NumberRange.new(2, 6)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	sparkle.LightEmission = 1
	sparkle.Color = ColorSequence.new(GOLD, PURPLE)
	sparkle.Parent = glow
	-- a beam of light so everybody can find it from far away
	part({
		Name = "Beam",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(400, 2.4, 2.4),
		CFrame = CFrame.new(position + Vector3.new(0, 200, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = GOLD,
		Material = Enum.Material.Neon,
		Transparency = 0.45,
	}, model)
	part({
		Name = "GroundRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 9, 9),
		CFrame = CFrame.new(position - Vector3.new(0, 3.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = PURPLE,
		Material = Enum.Material.Neon,
		Transparency = 0.3,
	}, model)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 60)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 500
	gui.LightInfluence = 0
	gui.Parent = die
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = ("🎲 COSMIC ROLL\nx%d LUCK"):format(DROP.BoostMultiplier)
	label.TextColor3 = GOLD
	label.Parent = gui
	local outline = Instance.new("UIStroke")
	outline.Thickness = 2.5
	outline.Parent = label
	model.PrimaryPart = die
	model:SetAttribute("DropCenter", position)
	model.Parent = workspace
	return model
end

local function clearDrop()
	if current then
		current.Model:Destroy()
		current = nil
	end
	ReplicatedStorage:SetAttribute("DropActive", false)
end

local function spawnDrop()
	clearDrop()
	local position, where = pickSpot()
	current = { Model = buildDrop(position), Position = position }
	ReplicatedStorage:SetAttribute("DropPosition", position)
	ReplicatedStorage:SetAttribute("DropWhere", where)
	ReplicatedStorage:SetAttribute("DropActive", true)
	AnnounceRemote:FireAllClients({ Type = "DropSpawned", Where = where })
end

local function grab(player)
	if not current then
		return
	end
	local position = current.Position
	clearDrop()
	grant:Fire(player, 1)
	AnnounceRemote:FireAllClients({ Type = "DropGrabbed", PlayerName = player.DisplayName, UserId = player.UserId, Position = position })
end

---------------------------------------------------------------------
-- The clock
---------------------------------------------------------------------
ReplicatedStorage:SetAttribute("DropActive", false)
ReplicatedStorage:SetAttribute("DropNextAt", workspace:GetServerTimeNow() + INTERVAL)

task.spawn(function()
	while true do
		task.wait(0.15)
		local now = workspace:GetServerTimeNow()
		local nextAt = ReplicatedStorage:GetAttribute("DropNextAt") or now
		if now >= nextAt then
			ReplicatedStorage:SetAttribute("DropNextAt", nextAt + INTERVAL)
			spawnDrop()
		end
		if current then
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if root and humanoid and humanoid.Health > 0 and not character:GetAttribute("InDuel")
					and (root.Position - current.Position).Magnitude < PICKUP_RANGE then
					grab(player)
					break
				end
			end
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">DuelService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- DuelService (Script in ServerScriptService)
-- 1v1 DUELS. Builds Duel Island (south of the main island, over the bridge)
-- with two arenas, and runs every fight on the server so nobody can cheat.
--
--   * Challenge a player (they accept/decline) or fight a bot (4 levels)
--   * Your EQUIPPED AURA decides your duel stats: rarer tier = more HP and
--     harder hits, and every aura's own power (AuraData.Power) is usable
--   * Basic attack: click / ATTACK button.  Power: Q / POWER button.
--   * First to 0 HP loses. When time runs out, the higher HP % wins.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))

local DUEL = Config.Duel
local P = Config.Places
local ISLAND_CENTER = P.DuelIsland
local ISLAND_RADIUS = P.DuelIslandRadius
local FLAT = CFrame.Angles(0, 0, math.rad(90))
local rng = Random.new()

---------------------------------------------------------------------
-- Remotes + a server-only event that RollService uses to count wins
---------------------------------------------------------------------
local remotes = ReplicatedStorage:FindFirstChild("CosmicRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "CosmicRemotes"
	remotes.Parent = ReplicatedStorage
end
local function getRemote(className, name, parent)
	parent = parent or remotes
	local remote = parent:FindFirstChild(name)
	if not remote then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = parent
	end
	return remote
end
local DuelRequest = getRemote("RemoteEvent", "DuelRequest") -- client -> server
local DuelEvent = getRemote("RemoteEvent", "DuelEvent") -- server -> one player
local DuelFX = getRemote("RemoteEvent", "DuelFX") -- server -> everyone (visuals)
local AnnounceRemote = getRemote("RemoteEvent", "Announce")

local serverEvents = ServerStorage:FindFirstChild("CosmicServerEvents")
if not serverEvents then
	serverEvents = Instance.new("Folder")
	serverEvents.Name = "CosmicServerEvents"
	serverEvents.Parent = ServerStorage
end
local DuelWinEvent = getRemote("BindableEvent", "DuelWin", serverEvents)

---------------------------------------------------------------------
-- BUILD DUEL ISLAND
---------------------------------------------------------------------
local old = workspace:FindFirstChild("DuelIsland")
if old then
	old:Destroy()
end
local island = Instance.new("Model")
island.Name = "DuelIsland"
island.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

local CRIMSON = Color3.fromRGB(255, 70, 90)
local STEEL = Color3.fromRGB(55, 45, 70)
local STEEL_DARK = Color3.fromRGB(32, 26, 44)
local GOLD = Color3.fromRGB(255, 200, 70)

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent or island
	return p
end

local function disc(name, center, radius, thickness, topY, color3, material, extra)
	local props = {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(center.X, topY - thickness / 2, center.Z) * FLAT,
		Color = color3,
		Material = material,
	}
	for key, value in pairs(extra or {}) do
		props[key] = value
	end
	return part(props)
end

local function addLight(target, color3, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color3
	light.Range = range
	light.Brightness = brightness
	light.Parent = target
end

local function addFire(target)
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = Config.Textures.Fire
	fire.Rate = 24
	fire.Lifetime = NumberRange.new(0.4, 0.9)
	fire.Speed = NumberRange.new(1, 3)
	fire.Acceleration = Vector3.new(0, 5, 0)
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) })
	fire.LightEmission = 1
	fire.LightInfluence = 0
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 200, 120), Color3.fromRGB(255, 60, 60))
	fire.Parent = target
end

local function textGui(target, face, text, color3, pixelsPerStud)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 40
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextWrapped = true
	label.Text = text
	label.TextColor3 = color3
	label.Parent = gui
	return label
end

-- ground
disc("Ground", ISLAND_CENTER, ISLAND_RADIUS, 4, 0, STEEL, Enum.Material.Slate)
disc("EdgeGlow", ISLAND_CENTER, ISLAND_RADIUS + 0.6, 0.6, -0.2, CRIMSON, Enum.Material.Neon, { CanCollide = false })
for i, layer in ipairs({ { 6, -4, 6 }, { 16, -10, 7 }, { 28, -17, 8 }, { 38, -25, 9 } }) do
	disc("Underside" .. i, ISLAND_CENTER, ISLAND_RADIUS - layer[1], layer[3], layer[2], (i % 2 == 0) and STEEL_DARK or Color3.fromRGB(70, 30, 45), Enum.Material.Slate, { CanCollide = false })
end

-- the two arenas
local ARENA_RADIUS = 15
local FLOOR_Y = 1
local arenas = {}
for index, offsetX in ipairs({ -21, 21 }) do
	local center = ISLAND_CENTER + Vector3.new(offsetX, 0, 4)
	local model = Instance.new("Model")
	model.Name = "Arena" .. index
	model.Parent = island

	disc("ArenaBase", center, ARENA_RADIUS + 1.2, 1.2, FLOOR_Y - 0.2, STEEL_DARK, Enum.Material.Slate, { Parent = model })
	disc("ArenaFloor", center, ARENA_RADIUS, 1, FLOOR_Y, Color3.fromRGB(45, 38, 60), Enum.Material.Marble, { Parent = model })
	for _, ring in ipairs({ { 6, 0.35 }, { 12, 0.35 } }) do
		local segments = math.floor(ring[1] * 4)
		for s = 1, segments do
			local a = (s / segments) * math.pi * 2
			local p = center + Vector3.new(math.cos(a) * ring[1], FLOOR_Y + 0.03, math.sin(a) * ring[1])
			part({
				Name = "FloorRing",
				Size = Vector3.new(ring[2], 0.1, (2 * math.pi * ring[1] / segments) * 1.05),
				CFrame = CFrame.lookAt(p, Vector3.new(center.X, p.Y, center.Z)) * CFrame.Angles(0, math.pi / 2, 0),
				Color = CRIMSON,
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
				Parent = model,
			})
		end
	end
	for b = 0, 3 do -- star emblem in the middle
		part({
			Name = "Emblem",
			Size = Vector3.new(0.4, 0.1, 9),
			CFrame = CFrame.new(center.X, FLOOR_Y + 0.04, center.Z) * CFrame.Angles(0, b * math.pi / 4, 0),
			Color = GOLD,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			Parent = model,
		})
	end

	-- force-field wall that keeps fighters in (and everyone else out)
	local wallSegments = 40
	for s = 1, wallSegments do
		local a = (s / wallSegments) * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * (ARENA_RADIUS + 0.6), FLOOR_Y + 4, math.sin(a) * (ARENA_RADIUS + 0.6))
		part({
			Name = "ArenaWall",
			Size = Vector3.new(0.6, 8, (2 * math.pi * (ARENA_RADIUS + 0.6) / wallSegments) * 1.05),
			CFrame = CFrame.lookAt(p, Vector3.new(center.X, p.Y, center.Z)) * CFrame.Angles(0, math.pi / 2, 0),
			Color = CRIMSON,
			Material = Enum.Material.ForceField,
			Transparency = 0.3,
			Parent = model,
		})
		part({
			Name = "WallTop",
			Size = Vector3.new(0.4, 0.4, (2 * math.pi * (ARENA_RADIUS + 0.6) / wallSegments) * 1.05),
			CFrame = CFrame.lookAt(p + Vector3.new(0, 4.2, 0), Vector3.new(center.X, p.Y + 4.2, center.Z)) * CFrame.Angles(0, math.pi / 2, 0),
			Color = CRIMSON,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			Parent = model,
		})
	end

	-- braziers
	for k = 1, 4 do
		local a = (k / 4) * math.pi * 2 + math.pi / 4
		local p = center + Vector3.new(math.cos(a) * (ARENA_RADIUS + 3.4), 0, math.sin(a) * (ARENA_RADIUS + 3.4))
		part({ Name = "BrazierPost", Size = Vector3.new(1.4, 6, 1.4), CFrame = CFrame.new(p + Vector3.new(0, 3, 0)), Color = STEEL_DARK, Material = Enum.Material.Metal, Parent = model })
		local bowl = part({ Name = "Brazier", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.2, CFrame = CFrame.new(p + Vector3.new(0, 6.4, 0)), Color = Color3.fromRGB(255, 120, 80), Material = Enum.Material.Neon, CanCollide = false, Parent = model })
		addFire(bowl)
		addLight(bowl, Color3.fromRGB(255, 120, 90), 22, 1.8)
	end

	-- spectator stands on the far side
	for row = 1, 3 do
		local radius = ARENA_RADIUS + 4 + row * 2.4
		local segments = 14
		for s = 0, segments - 1 do
			local a = math.rad(50) + (s + 0.5) / segments * math.rad(80)
			local p = center + Vector3.new(math.cos(a) * radius, row * 1.2 - 0.6, math.sin(a) * radius)
			part({
				Name = "Stand",
				Size = Vector3.new(2.4, row * 1.2, (radius * math.rad(80) / segments) * 1.05),
				CFrame = CFrame.lookAt(p, Vector3.new(center.X, p.Y, center.Z)) * CFrame.Angles(0, math.pi / 2, 0),
				Color = (row % 2 == 0) and STEEL or Color3.fromRGB(80, 40, 60),
				Material = Enum.Material.Slate,
				Parent = model,
			})
		end
	end

	-- scoreboard floating above the arena
	local boardAnchor = part({
		Name = "Scoreboard",
		Size = Vector3.one * 0.2,
		CFrame = CFrame.new(center + Vector3.new(0, 15, 0)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = model,
	})
	local board = Instance.new("BillboardGui")
	board.Size = UDim2.fromOffset(460, 90)
	board.MaxDistance = 200
	board.LightInfluence = 0
	board.Parent = boardAnchor
	local boardText = Instance.new("TextLabel")
	boardText.BackgroundTransparency = 1
	boardText.Size = UDim2.fromScale(1, 1)
	boardText.Font = Enum.Font.FredokaOne
	boardText.TextScaled = true
	boardText.RichText = true
	boardText.TextColor3 = Color3.new(1, 1, 1)
	boardText.Parent = board
	local outline = Instance.new("UIStroke")
	outline.Thickness = 2.5
	outline.Parent = boardText

	local spawnA = CFrame.lookAt(center + Vector3.new(0, FLOOR_Y + 3, -9), center + Vector3.new(0, FLOOR_Y + 3, 0))
	local spawnB = CFrame.lookAt(center + Vector3.new(0, FLOOR_Y + 3, 9), center + Vector3.new(0, FLOOR_Y + 3, 0))
	arenas[index] = {
		Name = "Arena " .. index,
		Center = Vector3.new(center.X, FLOOR_Y, center.Z),
		Spawns = { spawnA, spawnB },
		Busy = false,
		BoardText = boardText,
	}
end

local function setBoard(arena, text)
	arena.BoardText.Text = text
end
for _, arena in ipairs(arenas) do
	setBoard(arena, ("⚔ %s\n<font color='#9fe8a0'>OPEN</font>"):format(string.upper(arena.Name)))
end

-- lobby sign near the bridge
local LOBBY = ISLAND_CENTER + Vector3.new(0, 0, -30)
local signPart = part({
	Name = "DuelSign",
	Size = Vector3.new(16, 7, 0.6),
	CFrame = CFrame.lookAt(LOBBY + Vector3.new(0, 6, 6), LOBBY + Vector3.new(0, 6, -20)),
	Color = STEEL_DARK,
	Material = Enum.Material.SmoothPlastic,
})
textGui(signPart, Enum.NormalId.Front,
	"⚔ DUEL ISLAND ⚔\nOpen the DUEL menu to challenge a player or a bot.\nRarer aura = more HP + harder hits!", Color3.fromRGB(255, 200, 200), 30)
for _, side in ipairs({ -1, 1 }) do
	local post = part({ Name = "SignPost", Size = Vector3.new(0.8, 10, 0.8), CFrame = CFrame.new(LOBBY + Vector3.new(side * 8.6, 5, 6)), Color = CRIMSON, Material = Enum.Material.Neon, CanCollide = false })
	addLight(post, CRIMSON, 14, 1.2)
end
local LOBBY_EXIT = CFrame.lookAt(LOBBY + Vector3.new(0, 3, 0), LOBBY + Vector3.new(0, 3, 30))

local botFolder = workspace:FindFirstChild("DuelBots") or Instance.new("Folder")
botFolder.Name = "DuelBots"
botFolder.Parent = workspace

island.Parent = workspace

---------------------------------------------------------------------
-- FIGHTERS
-- A fighter is a player or a bot taking part in a duel.
---------------------------------------------------------------------
local duels = {} -- list of active duels
local fighterOf = {} -- [player or bot model] = fighter
local pending = {} -- [targetPlayer] = { From = player, Expires = time }

local function auraFor(name)
	return AuraData.Get(name or "") or nil
end

local function statsFor(auraName)
	local aura = auraFor(auraName)
	local tier = AuraData.Tiers[aura and aura.Tier or DUEL.NoAuraTier]
	return aura, tier
end

local function isPlayerBusy(player)
	return fighterOf[player] ~= nil
end

local function setFighterAttributes(fighter)
	local model = fighter.Model
	model:SetAttribute("DuelHP", math.max(0, math.floor(fighter.HP + 0.5)))
	model:SetAttribute("DuelMaxHP", fighter.MaxHP)
	model:SetAttribute("DuelShield", math.floor(fighter.Shield + 0.5))
	model:SetAttribute("DuelGuard", math.floor((fighter.Guard or 0) + 0.5))
	model:SetAttribute("DuelBlocking", fighter.Blocking == true)
end

local function newFighter(kind, player, model, auraName, displayName)
	local aura, tier = statsFor(auraName)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local fighter = {
		Kind = kind,
		Player = player,
		Model = model,
		Humanoid = humanoid,
		Root = model:FindFirstChild("HumanoidRootPart"),
		Aura = aura,
		Tier = tier,
		Name = displayName,
		HP = tier.MaxHealth,
		MaxHP = tier.MaxHealth,
		Shield = 0,
		ShieldEnd = 0,
		NextAttack = 0,
		PowerReady = 0,
		StunnedUntil = 0,
		SlowUntil = 0,
		SlowAmount = 0,
		BaseSpeed = humanoid and humanoid.WalkSpeed or 16,
		BaseJumpPower = humanoid and humanoid.JumpPower or 50,
		BaseJumpHeight = humanoid and humanoid.JumpHeight or 7.2,
		Combo = 0,
		LastAttack = 0,
		Blocking = false,
		Guard = DUEL.GuardMax,
		NextDodge = 0,
	}
	return fighter
end

local function fighterKey(fighter)
	return fighter.Player or fighter.Model
end

local function sendTo(fighter, payload)
	if fighter.Player then
		DuelEvent:FireClient(fighter.Player, payload)
	end
end

local function flatDirection(from, to)
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	if d.Magnitude < 0.01 then
		return Vector3.new(0, 0, -1)
	end
	return d.Unit
end

---------------------------------------------------------------------
-- BOTS
---------------------------------------------------------------------
local function botSettings(key)
	for _, bot in ipairs(DUEL.Bots) do
		if bot.Key == key then
			return bot
		end
	end
	return nil
end

local function buildSimpleBot()
	-- fallback body if Roblox can't make a full avatar
	local model = Instance.new("Model")
	local rootPart = Instance.new("Part")
	rootPart.Name = "HumanoidRootPart"
	rootPart.Size = Vector3.new(2, 2, 1)
	rootPart.Transparency = 1
	rootPart.Parent = model
	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2, 2, 1)
	torso.Color = Color3.fromRGB(60, 50, 90)
	torso.Parent = model
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.2, 1.2, 1.2)
	head.Color = Color3.fromRGB(200, 190, 255)
	head.Parent = model
	local w1 = Instance.new("WeldConstraint")
	w1.Part0 = rootPart
	w1.Part1 = torso
	w1.Parent = rootPart
	head.CFrame = rootPart.CFrame * CFrame.new(0, 1.6, 0)
	local w2 = Instance.new("WeldConstraint")
	w2.Part0 = rootPart
	w2.Part1 = head
	w2.Parent = rootPart
	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = 2
	humanoid.Parent = model
	model.PrimaryPart = rootPart
	return model
end

local function spawnBot(settings, spawnCFrame)
	local model
	local ok = pcall(function()
		local description = Instance.new("HumanoidDescription")
		local skin = Color3.fromRGB(150, 140, 200)
		description.HeadColor = skin
		description.TorsoColor = Color3.fromRGB(60, 50, 90)
		description.LeftArmColor = skin
		description.RightArmColor = skin
		description.LeftLegColor = Color3.fromRGB(40, 35, 60)
		description.RightLegColor = Color3.fromRGB(40, 35, 60)
		model = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		model = buildSimpleBot()
	end
	model.Name = settings.Name
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = "🤖 " .. settings.Name
	humanoid.WalkSpeed = settings.Speed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 50
	model:SetAttribute("Aura", settings.Aura)
	model:SetAttribute("IsDuelBot", true)
	model:PivotTo(spawnCFrame)
	model.Parent = botFolder
	local rootPart = model:FindFirstChild("HumanoidRootPart")
	if rootPart then
		pcall(function()
			rootPart:SetNetworkOwner(nil) -- the server moves bots
		end)
	end
	return model
end

---------------------------------------------------------------------
-- DUEL LIFECYCLE
---------------------------------------------------------------------
local endDuel -- defined below

local function freeze(fighter, frozen)
	local humanoid = fighter.Humanoid
	if not humanoid then
		return
	end
	if frozen then
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
	else
		humanoid.WalkSpeed = fighter.BaseSpeed
		humanoid.JumpPower = fighter.BaseJumpPower
		humanoid.JumpHeight = fighter.BaseJumpHeight
	end
end

local function describe(fighter)
	return {
		Name = fighter.Name,
		Aura = fighter.Aura and fighter.Aura.Name or nil,
		Tier = fighter.Aura and fighter.Aura.Tier or DUEL.NoAuraTier,
		MaxHP = fighter.MaxHP,
		Damage = fighter.Tier.AttackDamage,
		Power = fighter.Aura and fighter.Aura.Power or nil,
		Model = fighter.Model,
		IsBot = fighter.Kind == "Bot",
	}
end

local function freeArena()
	for _, arena in ipairs(arenas) do
		if not arena.Busy then
			return arena
		end
	end
	return nil
end

local function startDuel(fighterA, fighterB, arena)
	arena.Busy = true
	local duel = {
		Arena = arena,
		A = fighterA,
		B = fighterB,
		State = "Countdown",
		EndsAt = math.huge,
	}
	fighterA.Opponent = fighterB
	fighterB.Opponent = fighterA
	fighterA.Duel = duel
	fighterB.Duel = duel
	fighterA.Spawn = arena.Spawns[1]
	fighterB.Spawn = arena.Spawns[2]
	table.insert(duels, duel)

	for _, fighter in ipairs({ fighterA, fighterB }) do
		fighterOf[fighterKey(fighter)] = fighter
		fighter.Model:SetAttribute("InDuel", true)
		fighter.Model:SetAttribute("DuelName", fighter.Name)
		if fighter.Player then
			fighter.Player:SetAttribute("InDuel", true)
			fighter.Player:SetAttribute("Checkpoint", nil)
		end
		setFighterAttributes(fighter)
		fighter.Root.AssemblyLinearVelocity = Vector3.zero
		fighter.Model:PivotTo(fighter.Spawn)
		freeze(fighter, true)
	end

	setBoard(arena, ("⚔ <font color='#ffd76a'>%s</font> vs <font color='#ffd76a'>%s</font>"):format(fighterA.Name, fighterB.Name))
	sendTo(fighterA, { Type = "Start", Me = describe(fighterA), Opponent = describe(fighterB), Countdown = DUEL.CountdownSeconds, TimeLimit = DUEL.TimeLimit })
	sendTo(fighterB, { Type = "Start", Me = describe(fighterB), Opponent = describe(fighterA), Countdown = DUEL.CountdownSeconds, TimeLimit = DUEL.TimeLimit })
	DuelFX:FireAllClients({ Type = "DuelStart", A = fighterA.Model, B = fighterB.Model, Center = arena.Center })

	task.delay(DUEL.CountdownSeconds, function()
		if duel.State ~= "Countdown" then
			return
		end
		duel.State = "Fight"
		duel.EndsAt = os.clock() + DUEL.TimeLimit
		freeze(fighterA, false)
		freeze(fighterB, false)
		sendTo(fighterA, { Type = "Fight", EndsIn = DUEL.TimeLimit })
		sendTo(fighterB, { Type = "Fight", EndsIn = DUEL.TimeLimit })
	end)
	return duel
end

local function releaseFighter(fighter)
	fighterOf[fighterKey(fighter)] = nil
	local model = fighter.Model
	if fighter.Kind == "Bot" then
		if model then
			model:Destroy()
		end
		return
	end
	local player = fighter.Player
	if player then
		player:SetAttribute("InDuel", nil)
	end
	if model and model.Parent then
		model:SetAttribute("InDuel", nil)
		model:SetAttribute("DuelHP", nil)
		model:SetAttribute("DuelMaxHP", nil)
		model:SetAttribute("DuelShield", nil)
		model:SetAttribute("DuelName", nil)
		freeze(fighter, false)
		if fighter.Root and fighter.Root.Parent then
			fighter.Root.AssemblyLinearVelocity = Vector3.zero
			model:PivotTo(LOBBY_EXIT * CFrame.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-2, 2)))
		end
	end
end

endDuel = function(duel, winner, reason)
	if duel.State == "Over" then
		return
	end
	duel.State = "Over"
	local a, b = duel.A, duel.B
	freeze(a, true)
	freeze(b, true)

	for _, fighter in ipairs({ a, b }) do
		local result = (winner == nil) and "Draw" or (winner == fighter and "Win" or "Lose")
		sendTo(fighter, { Type = "End", Result = result, Reason = reason, Opponent = fighter.Opponent.Name })
	end
	DuelFX:FireAllClients({ Type = "DuelEnd", Winner = winner and winner.Model or nil, A = a.Model, B = b.Model })

	if winner then
		setBoard(duel.Arena, ("🏆 <font color='#ffd76a'>%s</font> WINS!"):format(winner.Name))
		-- only player-vs-player wins count (and are announced)
		local loser = winner.Opponent
		-- quests count every win, bots included
		if winner.Player then
			local questEvent = serverEvents:FindFirstChild("QuestEvent")
			if questEvent then
				questEvent:Fire(winner.Player, "DuelWin", 1)
			end
		end
		if winner.Player and loser.Kind == "Player" then
			DuelWinEvent:Fire(winner.Player)
			AnnounceRemote:FireAllClients({
				Type = "Duel",
				Winner = winner.Name,
				Loser = loser.Name,
				WinnerAura = winner.Aura and winner.Aura.Name or nil,
			})
		end
	else
		setBoard(duel.Arena, "⚔ DRAW!")
	end

	task.delay(3.5, function()
		releaseFighter(a)
		releaseFighter(b)
		local index = table.find(duels, duel)
		if index then
			table.remove(duels, index)
		end
		duel.Arena.Busy = false
		setBoard(duel.Arena, ("⚔ %s\n<font color='#9fe8a0'>OPEN</font>"):format(string.upper(duel.Arena.Name)))
	end)
end

---------------------------------------------------------------------
-- FINISHER: the knockout cutscene both fighters (and spectators) see
---------------------------------------------------------------------
local function startFinisher(duel, winner)
	if duel.State ~= "Fight" then
		return
	end
	duel.State = "Finisher"
	local loser = winner.Opponent
	for _, fighter in ipairs({ winner, loser }) do
		freeze(fighter, true)
		if fighter.Root and fighter.Root.Parent then
			fighter.Root.AssemblyLinearVelocity = Vector3.zero
		end
	end
	-- the winner turns to face the loser
	if winner.Root and loser.Root then
		local from, to = winner.Root.Position, loser.Root.Position
		winner.Model:PivotTo(CFrame.lookAt(from, Vector3.new(to.X, from.Y, to.Z)))
	end
	local aura = winner.Aura
	local payload = {
		Type = "Finisher",
		Winner = winner.Model,
		Loser = loser.Model,
		WinnerName = winner.Name,
		LoserName = loser.Name,
		AuraName = aura and aura.Name or nil,
		Colors = aura and aura.Colors or { Color3.new(1, 1, 1), Color3.fromRGB(255, 80, 100) },
		Special = aura and aura.Special or nil,
		Order = winner.Tier.Order,
		Duration = DUEL.FinisherSeconds,
	}
	DuelFX:FireAllClients(payload)
	sendTo(winner, payload)
	sendTo(loser, payload)
	task.delay(DUEL.FinisherSeconds, function()
		endDuel(duel, winner, "KO")
	end)
end

---------------------------------------------------------------------
-- DAMAGE + STATUS EFFECTS
---------------------------------------------------------------------
local function canAct(fighter)
	local duel = fighter.Duel
	return duel and duel.State == "Fight" and os.clock() >= fighter.StunnedUntil
		and fighter.Root and fighter.Root.Parent ~= nil
end

-- opts: { Pierce = ignore shields, NoReflect = can't be reflected, Kind = "Burn"/... }
local function damage(target, amount, source, opts)
	opts = opts or {}
	local duel = target.Duel
	if not duel or duel.State ~= "Fight" then
		return
	end
	local now = os.clock()
	if now < (target.DodgeUntil or 0) then
		DuelFX:FireAllClients({ Type = "Dodge", Target = target.Model })
		return
	end
	-- blocking soaks up most of the hit (but uses guard). Heavy hits break it.
	if target.Blocking and opts.Kind ~= "Burn" and opts.Kind ~= "Reflect" then
		if opts.Kind == "Heavy" or target.Guard <= DUEL.GuardHitCost then
			target.Blocking = false
			target.Guard = 0
			target.StunnedUntil = math.max(target.StunnedUntil, now + DUEL.GuardBreakStun)
			DuelFX:FireAllClients({ Type = "GuardBreak", Target = target.Model })
			amount *= 0.6
		else
			target.Guard -= DUEL.GuardHitCost
			amount *= (opts.Kind == "Basic") and DUEL.BlockBasic or DUEL.BlockPower
			opts.Blocked = true
			DuelFX:FireAllClients({ Type = "Block", Target = target.Model, Attacker = source and source.Model or nil })
		end
	end
	amount = math.max(1, math.floor(amount + 0.5))
	local absorbed = 0
	if not opts.Pierce and target.Shield > 0 and now < target.ShieldEnd then
		absorbed = math.min(target.Shield, amount)
		target.Shield -= absorbed
	end
	-- Moon Shield style reflect: part of the hit bounces back
	if source and source ~= target and not opts.NoReflect and now < (target.ReflectUntil or 0) then
		local reflected = math.floor(amount * (target.ReflectAmount or 0) + 0.5)
		if reflected > 0 then
			task.defer(damage, source, reflected, target, { NoReflect = true, Kind = "Reflect" })
		end
	end
	local taken = amount - absorbed
	target.HP = math.max(0, target.HP - taken)
	setFighterAttributes(target)
	DuelFX:FireAllClients({
		Type = "Damage",
		Target = target.Model,
		Amount = taken,
		Blocked = absorbed,
		Color = source and source.Aura and source.Aura.Colors[1] or Color3.new(1, 1, 1),
		Kind = opts.Kind,
		Heavy = opts.Kind == "Heavy",
		WasBlocked = opts.Blocked == true,
		Attacker = source and source.Model or nil,
	})
	if target.HP <= 0 then
		startFinisher(duel, target.Opponent)
	end
end

-- damage over time (Burn)
local function burn(target, source, spec)
	task.spawn(function()
		for _ = 1, spec.Ticks or 3 do
			task.wait(spec.Interval or 0.5)
			if not target.Duel or target.Duel.State ~= "Fight" then
				return
			end
			DuelFX:FireAllClients({ Type = "Burn", Target = target.Model })
			damage(target, spec.Damage, source, { NoReflect = true, Kind = "Burn" })
		end
	end)
end

local function heal(fighter, amount)
	fighter.HP = math.min(fighter.MaxHP, fighter.HP + amount)
	setFighterAttributes(fighter)
	DuelFX:FireAllClients({ Type = "Heal", Target = fighter.Model, Amount = amount })
end

-- healing over time (Regen)
local function regen(fighter, spec)
	task.spawn(function()
		for _ = 1, spec.Ticks or 4 do
			task.wait(spec.Interval or 1)
			if not fighter.Duel or fighter.Duel.State ~= "Fight" then
				return
			end
			heal(fighter, spec.Amount)
		end
	end)
end

-- every power can carry extra effects that trigger when it hits
local function onPowerHit(fighter, target, power)
	if power.Burn then
		burn(target, fighter, power.Burn)
	end
end

local function giveShield(fighter, amount, duration)
	fighter.Shield = amount
	fighter.ShieldEnd = os.clock() + duration
	setFighterAttributes(fighter)
	DuelFX:FireAllClients({ Type = "Shield", Target = fighter.Model, Duration = duration, Color = fighter.Aura and fighter.Aura.Colors[1] or Color3.new(1, 1, 1) })
end

local function stun(fighter, seconds)
	fighter.StunnedUntil = math.max(fighter.StunnedUntil, os.clock() + seconds)
	DuelFX:FireAllClients({ Type = "Stun", Target = fighter.Model, Duration = seconds })
end

local function slow(fighter, amount, seconds)
	fighter.SlowAmount = amount
	fighter.SlowUntil = os.clock() + seconds
end

local function knockback(fighter, direction, strength)
	local velocity = direction * strength + Vector3.new(0, strength * 0.45, 0)
	if fighter.Kind == "Bot" then
		fighter.Root.AssemblyLinearVelocity = velocity
	else
		sendTo(fighter, { Type = "Knockback", Velocity = velocity })
	end
end

-- keep a point inside the arena floor
local function clampToArena(fighter, position)
	local center = fighter.Duel.Arena.Center
	local offset = Vector3.new(position.X - center.X, 0, position.Z - center.Z)
	if offset.Magnitude > ARENA_RADIUS - 2 then
		offset = offset.Unit * (ARENA_RADIUS - 2)
	end
	return Vector3.new(center.X + offset.X, center.Y + 3, center.Z + offset.Z)
end

local function distanceToSegment(point, a, b)
	local ab = b - a
	local t = math.clamp((point - a):Dot(ab) / math.max(ab:Dot(ab), 1e-6), 0, 1)
	return (point - (a + ab * t)).Magnitude
end

---------------------------------------------------------------------
-- ATTACKS
---------------------------------------------------------------------
-- Aim: the direction the player is looking. If the opponent is close to
-- that direction we "snap" to them (aim assist), otherwise it can miss.
local function resolveAim(fighter, aim)
	local opponent = fighter.Opponent
	local toOpponent = flatDirection(fighter.Root.Position, opponent.Root.Position)
	if typeof(aim) ~= "Vector3" or aim.Magnitude < 0.1 then
		aim = fighter.Root.CFrame.LookVector
	end
	aim = Vector3.new(aim.X, 0, aim.Z)
	aim = (aim.Magnitude > 0.01) and aim.Unit or toOpponent
	if aim:Dot(toOpponent) > math.cos(math.rad(30)) then
		return toOpponent
	end
	return aim
end

local function basicAttack(fighter, aim)
	local now = os.clock()
	if not canAct(fighter) or fighter.Blocking or now < fighter.NextAttack then
		return
	end
	-- combo: jab, jab, KICK (if you keep attacking quickly)
	if now - fighter.LastAttack <= DUEL.ComboWindow then
		fighter.Combo = (fighter.Combo % 3) + 1
	else
		fighter.Combo = 1
	end
	fighter.LastAttack = now
	local combo = fighter.Combo
	local heavy = combo == 3
	fighter.NextAttack = now + (heavy and DUEL.HeavyRecovery or DUEL.AttackCooldown)
	local direction = resolveAim(fighter, aim)
	DuelFX:FireAllClients({
		Type = "Swing",
		Attacker = fighter.Model,
		Direction = direction,
		Combo = combo,
		Heavy = heavy,
		Color = fighter.Aura and fighter.Aura.Colors[1] or Color3.new(1, 1, 1),
	})
	sendTo(fighter, { Type = "Combo", Combo = combo })

	-- the hit lands when the fist/foot connects in the animation
	task.delay(heavy and 0.27 or 0.12, function()
		if not canAct(fighter) then
			return
		end
		local opponent = fighter.Opponent
		local toOpponent = opponent.Root.Position - fighter.Root.Position
		local reach = DUEL.AttackRange + (heavy and 1.5 or 0)
		local facing = flatDirection(fighter.Root.Position, opponent.Root.Position)
		if toOpponent.Magnitude <= reach and direction:Dot(facing) > math.cos(math.rad(75)) then
			local multiplier = DUEL.ComboDamage[combo] or 1
			damage(opponent, fighter.Tier.AttackDamage * multiplier * rng:NextNumber(0.92, 1.08), fighter, {
				Kind = heavy and "Heavy" or "Basic",
			})
			if heavy and opponent.Duel and opponent.Duel.State == "Fight" then
				knockback(opponent, facing, DUEL.HeavyKnockback)
			end
		end
	end)
end

-- Blocking on/off
local function setBlocking(fighter, on)
	if on and (not canAct(fighter) or fighter.Guard < DUEL.GuardHitCost) then
		return
	end
	if fighter.Blocking ~= on then
		fighter.Blocking = on
		setFighterAttributes(fighter)
	end
end

-- Dodge roll: a quick dash with a moment of invincibility
local function dodge(fighter, direction)
	local now = os.clock()
	if not canAct(fighter) or fighter.Blocking or now < fighter.NextDodge then
		return
	end
	fighter.NextDodge = now + DUEL.DodgeCooldown
	fighter.DodgeUntil = now + DUEL.DodgeInvincible
	if typeof(direction) ~= "Vector3" or direction.Magnitude < 0.1 then
		direction = fighter.Root.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	direction = (direction.Magnitude > 0.01) and direction.Unit or Vector3.new(0, 0, -1)
	DuelFX:FireAllClients({ Type = "DodgeRoll", Target = fighter.Model, Direction = direction, Colors = fighter.Aura and fighter.Aura.Colors or nil })
	sendTo(fighter, { Type = "DodgeUsed", Cooldown = DUEL.DodgeCooldown })
	if fighter.Kind == "Bot" then
		fighter.Root.AssemblyLinearVelocity = direction * DUEL.DodgeSpeed + Vector3.new(0, 6, 0)
	end
end

local projectileId = 0
local function fireProjectile(fighter, direction, power)
	projectileId += 1
	local id = projectileId
	local opponent = fighter.Opponent
	local origin = fighter.Root.Position + Vector3.new(0, 1, 0) + direction * 2
	local speed = power.Speed or 80
	local range = 60
	DuelFX:FireAllClients({
		Type = "Projectile",
		Id = id,
		Origin = origin,
		Direction = direction,
		Speed = speed,
		Range = range,
		Colors = fighter.Aura.Colors,
	})
	task.spawn(function()
		local travelled = 0
		local position = origin
		local step = 1 / 30
		while travelled < range do
			task.wait(step)
			if not fighter.Duel or fighter.Duel.State ~= "Fight" then
				break
			end
			local move = speed * step
			local nextPosition = position + direction * move
			if distanceToSegment(opponent.Root.Position, position, nextPosition) < 3.2 then
				DuelFX:FireAllClients({ Type = "ProjectileHit", Id = id, Position = opponent.Root.Position })
				damage(opponent, power.Damage, fighter)
				onPowerHit(fighter, opponent, power)
				return
			end
			position = nextPosition
			travelled += move
		end
		DuelFX:FireAllClients({ Type = "ProjectileHit", Id = id, Position = position, Miss = true })
	end)
end

local function rotateY(direction, degrees)
	local r = math.rad(degrees)
	local c, s = math.cos(r), math.sin(r)
	return Vector3.new(direction.X * c - direction.Z * s, 0, direction.X * s + direction.Z * c)
end

-- Every power type. Returns false if it couldn't be used (e.g. out of range).
local POWERS = {}

POWERS.Projectile = function(fighter, power, aim)
	local count = power.Count or 1
	local spread = power.Spread or 0
	for i = 1, count do
		local offset = (count == 1) and 0 or (i - (count + 1) / 2) * spread
		fireProjectile(fighter, rotateY(aim, offset), power)
	end
	return true
end

POWERS.Dash = function(fighter, power, aim)
	local start = fighter.Root.Position
	local finish = clampToArena(fighter, start + aim * (power.Distance or 20))
	local opponent = fighter.Opponent
	local hit = distanceToSegment(opponent.Root.Position, start, finish) < 4.5
	fighter.Model:PivotTo(CFrame.lookAt(finish, finish + aim))
	DuelFX:FireAllClients({ Type = "Dash", From = start, To = finish, Colors = fighter.Aura.Colors })
	if power.Dodge then
		fighter.DodgeUntil = os.clock() + power.Dodge
		DuelFX:FireAllClients({ Type = "Afterimage", Target = fighter.Model, Duration = power.Dodge, Colors = fighter.Aura.Colors })
	end
	if hit then
		damage(opponent, power.Damage, fighter)
		onPowerHit(fighter, opponent, power)
	end
	return true
end

POWERS.Shield = function(fighter, power)
	giveShield(fighter, power.Amount, power.Duration or 4)
	if power.Reflect then
		fighter.ReflectUntil = os.clock() + (power.Duration or 4)
		fighter.ReflectAmount = power.Reflect
	end
	return true
end

POWERS.Heal = function(fighter, power)
	heal(fighter, power.Amount)
	if power.Shield then
		giveShield(fighter, power.Shield, power.Duration or 5)
	end
	if power.Regen then
		regen(fighter, power.Regen)
	end
	return true
end

POWERS.Burst = function(fighter, power)
	local opponent = fighter.Opponent
	local distance = (opponent.Root.Position - fighter.Root.Position).Magnitude
	DuelFX:FireAllClients({ Type = "Burst", Position = fighter.Root.Position, Radius = power.Radius, Colors = fighter.Aura.Colors })
	if distance <= power.Radius then
		damage(opponent, power.Damage, fighter)
		onPowerHit(fighter, opponent, power)
		if power.Slow then
			slow(opponent, power.Slow, power.SlowDuration or 3)
		end
		if power.Knockback then
			knockback(opponent, flatDirection(fighter.Root.Position, opponent.Root.Position), power.Knockback)
		end
	end
	return true
end

POWERS.Meteor = function(fighter, power)
	local opponent = fighter.Opponent
	local count = power.Count or 1
	for i = 1, count do
		local target = opponent.Root.Position - Vector3.new(0, 2.8, 0)
		if i > 1 then
			target += Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
		end
		local delayTime = (power.Delay or 0.8) + (i - 1) * 0.3
		DuelFX:FireAllClients({ Type = "Meteor", Target = target, Radius = power.Radius, Delay = delayTime, Colors = fighter.Aura.Colors })
		task.delay(delayTime, function()
			if fighter.Duel and fighter.Duel.State == "Fight" then
				local flat = Vector3.new(opponent.Root.Position.X - target.X, 0, opponent.Root.Position.Z - target.Z)
				if flat.Magnitude <= power.Radius then
					damage(opponent, power.Damage, fighter)
					onPowerHit(fighter, opponent, power)
				end
			end
		end)
	end
	return true
end

local function inRange(fighter, range)
	return (fighter.Opponent.Root.Position - fighter.Root.Position).Magnitude <= range
end

POWERS.Freeze = function(fighter, power)
	if not inRange(fighter, power.Range or 40) then
		return false
	end
	local opponent = fighter.Opponent
	DuelFX:FireAllClients({ Type = "Freeze", From = fighter.Root.Position, Target = opponent.Model, Duration = power.Duration, Colors = fighter.Aura.Colors })
	damage(opponent, power.Damage, fighter)
	stun(opponent, power.Duration or 1.5)
	return true
end

POWERS.Drain = function(fighter, power)
	if not inRange(fighter, power.Range or 40) then
		return false
	end
	local opponent = fighter.Opponent
	DuelFX:FireAllClients({ Type = "Drain", From = opponent.Root.Position, To = fighter.Model, Colors = fighter.Aura.Colors })
	local before = opponent.HP
	damage(opponent, power.Damage, fighter)
	heal(fighter, math.max(0, before - opponent.HP) * (power.Lifesteal or 0.5))
	return true
end

POWERS.Beam = function(fighter, power, aim)
	local start = fighter.Root.Position + Vector3.new(0, 1, 0)
	local finish = start + aim * (power.Range or 60)
	DuelFX:FireAllClients({ Type = "Beam", From = start, To = finish, Colors = fighter.Aura.Colors })
	if distanceToSegment(fighter.Opponent.Root.Position, start, finish) < 3.5 then
		damage(fighter.Opponent, power.Damage, fighter, { Pierce = power.Pierce })
		onPowerHit(fighter, fighter.Opponent, power)
	end
	return true
end

POWERS.Pull = function(fighter, power)
	if not inRange(fighter, power.Range or 50) then
		return false
	end
	local opponent = fighter.Opponent
	local look = flatDirection(fighter.Root.Position, opponent.Root.Position)
	local landing = clampToArena(fighter, fighter.Root.Position + look * 4)
	DuelFX:FireAllClients({ Type = "Pull", From = opponent.Root.Position, To = landing, Colors = fighter.Aura.Colors })
	opponent.Root.AssemblyLinearVelocity = Vector3.zero
	opponent.Model:PivotTo(CFrame.lookAt(landing, fighter.Root.Position * Vector3.new(1, 0, 1) + Vector3.new(0, landing.Y, 0)))
	damage(opponent, power.Damage, fighter)
	if power.Stun then
		stun(opponent, power.Stun)
	end
	return true
end

POWERS.Teleport = function(fighter, power)
	if not inRange(fighter, power.Range or 60) then
		return false
	end
	local opponent = fighter.Opponent
	local behind = clampToArena(fighter, (opponent.Root.CFrame * CFrame.new(0, 0, 4)).Position)
	local from = fighter.Root.Position
	fighter.Model:PivotTo(CFrame.lookAt(behind, opponent.Root.Position * Vector3.new(1, 0, 1) + Vector3.new(0, behind.Y, 0)))
	DuelFX:FireAllClients({ Type = "Teleport", From = from, To = behind, Colors = fighter.Aura.Colors })
	damage(opponent, power.Damage, fighter)
	if power.Stun and opponent.Duel and opponent.Duel.State == "Fight" then
		stun(opponent, power.Stun)
	end
	return true
end

local TARGETED = { Freeze = true, Drain = true, Pull = true, Teleport = true }

local function usePower(fighter, aim)
	if not canAct(fighter) or not fighter.Aura or fighter.Blocking then
		return
	end
	local now = os.clock()
	if now < fighter.PowerReady then
		return
	end
	local power = fighter.Aura.Power
	local handler = POWERS[power.Type]
	if not handler then
		return
	end
	if TARGETED[power.Type] and not inRange(fighter, power.Range or 40) then
		sendTo(fighter, { Type = "OutOfRange" })
		return
	end
	local direction = resolveAim(fighter, aim)
	fighter.PowerReady = now + power.Cooldown
	DuelFX:FireAllClients({
		Type = "PowerCast",
		Caster = fighter.Model,
		Name = power.Name,
		PowerType = power.Type,
		Windup = DUEL.PowerWindup,
		Colors = fighter.Aura.Colors,
	})
	sendTo(fighter, { Type = "PowerUsed", Cooldown = power.Cooldown })
	-- the power fires when the casting animation reaches its peak
	task.delay(DUEL.PowerWindup, function()
		if fighter.Duel and fighter.Duel.State == "Fight" and fighter.Root and fighter.Root.Parent then
			-- re-aim at the moment of release (aim assist still applies)
			handler(fighter, power, resolveAim(fighter, direction))
			-- attack powers can also heal you over time (Heal powers do it themselves)
			if power.Regen and power.Type ~= "Heal" then
				regen(fighter, power.Regen)
			end
		end
	end)
end

---------------------------------------------------------------------
-- BOT BRAIN
---------------------------------------------------------------------
local DEFENSIVE = { Heal = true, Shield = true }

local function botThink(bot)
	if not canAct(bot) then
		return
	end
	local opponent = bot.Opponent
	local settings = bot.Settings
	local now = os.clock()
	local myPosition = bot.Root.Position
	local theirPosition = opponent.Root.Position
	local distance = (theirPosition - myPosition).Magnitude
	local toThem = flatDirection(myPosition, theirPosition)

	local function faceThem()
		bot.Root.CFrame = CFrame.lookAt(myPosition, Vector3.new(theirPosition.X, myPosition.Y, theirPosition.Z))
	end

	-- react to the opponent's attacks: harder bots block or dodge more often
	local theirSwing = opponent.LastAttack or 0
	if now - theirSwing < 0.12 and bot.LastReactedTo ~= theirSwing and distance < DUEL.AttackRange + 2 then
		bot.LastReactedTo = theirSwing
		local roll = rng:NextNumber()
		local skill = settings.Accuracy
		if roll < skill * 0.25 then
			dodge(bot, rotateY(toThem, (rng:NextNumber() < 0.5) and 90 or -90))
		elseif roll < skill * 0.55 then
			setBlocking(bot, true)
			task.delay(rng:NextNumber(0.5, 0.9), function()
				setBlocking(bot, false)
			end)
		end
	end
	if bot.Blocking then
		return
	end

	-- decide every "Reaction" seconds
	if now >= (bot.NextThink or 0) then
		bot.NextThink = now + settings.Reaction * rng:NextNumber(0.7, 1.3)
		local power = bot.Aura and bot.Aura.Power
		if power and now >= bot.PowerReady then
			local want
			if DEFENSIVE[power.Type] then
				want = bot.HP < bot.MaxHP * 0.65
			elseif power.Range then
				want = distance <= power.Range * 0.9
			elseif power.Radius and power.Type == "Burst" then
				want = distance <= power.Radius * 0.85
			else
				want = distance <= 35
			end
			if want then
				local aim = toThem
				if rng:NextNumber() > settings.Accuracy then
					aim = rotateY(toThem, rng:NextNumber(-40, 40))
				end
				faceThem()
				usePower(bot, aim)
			end
		end
		-- pick where to stand: close in, but circle around a bit
		local strafe = rotateY(toThem, (rng:NextNumber() < 0.5) and 90 or -90) * rng:NextNumber(2, 6)
		local wanted = theirPosition - toThem * rng:NextNumber(3, 6) + strafe
		bot.MoveTarget = clampToArena(bot, wanted)
		if rng:NextNumber() < 0.12 then
			bot.Humanoid.Jump = true
		end
	end

	if bot.MoveTarget then
		bot.Humanoid:MoveTo(bot.MoveTarget)
	end
	if distance <= DUEL.AttackRange - 0.5 and now >= bot.NextAttack then
		local aim = toThem
		if rng:NextNumber() > settings.Accuracy then
			aim = rotateY(toThem, 85) -- whiff
		end
		faceThem()
		basicAttack(bot, aim)
		bot.NextAttack = now + DUEL.AttackCooldown * (1.6 - settings.Accuracy * 0.6)
	end
end

---------------------------------------------------------------------
-- MAIN LOOP: timers, speed effects, falling out, bots
---------------------------------------------------------------------
RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for _, duel in ipairs(duels) do
		if duel.State == "Fight" then
			for _, fighter in ipairs({ duel.A, duel.B }) do
				-- left the game / character gone / died
				if not fighter.Root or not fighter.Root.Parent or not fighter.Humanoid or fighter.Humanoid.Health <= 0 then
					endDuel(duel, fighter.Opponent, "Left")
					break
				end
				-- guard meter: drains while blocking, refills otherwise
				local guardBefore = math.floor(fighter.Guard)
				if fighter.Blocking then
					fighter.Guard = math.max(0, fighter.Guard - DUEL.GuardDrain * (1 / 60))
					if fighter.Guard <= 0 or now < fighter.StunnedUntil then
						fighter.Blocking = false
					end
				else
					fighter.Guard = math.min(DUEL.GuardMax, fighter.Guard + DUEL.GuardRegen * (1 / 60))
				end
				if math.floor(fighter.Guard) ~= guardBefore then
					setFighterAttributes(fighter)
				end
				-- shield runs out
				if fighter.Shield > 0 and now >= fighter.ShieldEnd then
					fighter.Shield = 0
					setFighterAttributes(fighter)
				end
				-- movement speed from stun / slow
				local humanoid = fighter.Humanoid
				if now < fighter.StunnedUntil then
					humanoid.WalkSpeed = 0
					humanoid.JumpPower = 0
					humanoid.JumpHeight = 0
				else
					local speed = fighter.BaseSpeed
					if fighter.Blocking then
						speed *= DUEL.BlockSpeed
					elseif fighter.Player and fighter.Player:GetAttribute("Sprinting") then
						speed *= Config.Movement.DuelSprintMultiplier
					end
					if now < fighter.SlowUntil then
						speed *= (1 - fighter.SlowAmount)
					end
					humanoid.WalkSpeed = speed
					humanoid.JumpPower = fighter.BaseJumpPower
					humanoid.JumpHeight = fighter.BaseJumpHeight
				end
				-- fell out of the arena: back to your spawn (and lose a little HP)
				local center = duel.Arena.Center
				local position = fighter.Root.Position
				local flat = Vector3.new(position.X - center.X, 0, position.Z - center.Z)
				if position.Y < center.Y - 8 or flat.Magnitude > ARENA_RADIUS + 6 then
					fighter.Root.AssemblyLinearVelocity = Vector3.zero
					fighter.Model:PivotTo(fighter.Spawn)
					damage(fighter, 10, fighter.Opponent)
				end
			end
			if duel.State == "Fight" and now >= duel.EndsAt then
				-- time's up: higher HP % wins
				local a, b = duel.A, duel.B
				local pa, pb = a.HP / a.MaxHP, b.HP / b.MaxHP
				if math.abs(pa - pb) < 0.005 then
					endDuel(duel, nil, "Time")
				else
					endDuel(duel, (pa > pb) and a or b, "Time")
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.1)
		for _, duel in ipairs(duels) do
			for _, fighter in ipairs({ duel.A, duel.B }) do
				if fighter.Kind == "Bot" and duel.State == "Fight" then
					local ok, err = pcall(botThink, fighter)
					if not ok then
						warn("[DuelService] bot error:", err)
					end
				end
			end
		end
	end
end)

---------------------------------------------------------------------
-- REQUESTS FROM PLAYERS
---------------------------------------------------------------------
local function playerFighter(player)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local auraName = player:GetAttribute("EquippedAura")
	local fighter = newFighter("Player", player, character, auraName, player.DisplayName)
	fighter.BaseSpeed = Config.Movement.WalkSpeed
	return fighter
end

local lastRequest = {}

local function challenge(player, targetUserId)
	local target = Players:GetPlayerByUserId(tonumber(targetUserId) or 0)
	if not target or target == player then
		return
	end
	if isPlayerBusy(player) or isPlayerBusy(target) then
		DuelEvent:FireClient(player, { Type = "Notice", Text = "That player is busy right now." })
		return
	end
	if pending[target] and pending[target].Expires > os.clock() then
		DuelEvent:FireClient(player, { Type = "Notice", Text = target.DisplayName .. " already has a challenge waiting." })
		return
	end
	pending[target] = { From = player, Expires = os.clock() + DUEL.ChallengeTimeout }
	DuelEvent:FireClient(target, {
		Type = "Challenge",
		FromUserId = player.UserId,
		FromName = player.DisplayName,
		FromAura = player:GetAttribute("EquippedAura"),
		Timeout = DUEL.ChallengeTimeout,
	})
	DuelEvent:FireClient(player, { Type = "Notice", Text = "Challenge sent to " .. target.DisplayName .. "!" })
	task.delay(DUEL.ChallengeTimeout, function()
		local entry = pending[target]
		if entry and entry.From == player and entry.Expires <= os.clock() + 0.05 then
			pending[target] = nil
			if player.Parent then
				DuelEvent:FireClient(player, { Type = "Notice", Text = target.DisplayName .. " didn't answer." })
			end
		end
	end)
end

local function respond(player, fromUserId, accept)
	local entry = pending[player]
	local challenger = Players:GetPlayerByUserId(tonumber(fromUserId) or 0)
	if not entry or entry.From ~= challenger or entry.Expires < os.clock() then
		DuelEvent:FireClient(player, { Type = "Notice", Text = "That challenge has expired." })
		return
	end
	pending[player] = nil
	if not accept then
		DuelEvent:FireClient(challenger, { Type = "Notice", Text = player.DisplayName .. " declined your duel." })
		return
	end
	if isPlayerBusy(player) or isPlayerBusy(challenger) then
		DuelEvent:FireClient(player, { Type = "Notice", Text = "Someone is already in a duel." })
		return
	end
	local arena = freeArena()
	if not arena then
		DuelEvent:FireClient(player, { Type = "Notice", Text = "Both arenas are busy - try again in a moment!" })
		DuelEvent:FireClient(challenger, { Type = "Notice", Text = "Both arenas are busy - try again in a moment!" })
		return
	end
	local a, b = playerFighter(challenger), playerFighter(player)
	if not a or not b then
		return
	end
	startDuel(a, b, arena)
end

local function fightBot(player, difficulty)
	if isPlayerBusy(player) then
		return
	end
	local settings = botSettings(difficulty)
	if not settings then
		return
	end
	local arena = freeArena()
	if not arena then
		DuelEvent:FireClient(player, { Type = "Notice", Text = "Both arenas are busy - try again in a moment!" })
		return
	end
	local me = playerFighter(player)
	if not me then
		return
	end
	arena.Busy = true -- reserve while the bot loads
	local model = spawnBot(settings, arena.Spawns[2])
	arena.Busy = false
	local bot = newFighter("Bot", nil, model, settings.Aura, settings.Name)
	bot.Settings = settings
	bot.BaseSpeed = settings.Speed
	if not bot.Root or not bot.Humanoid then
		model:Destroy()
		return
	end
	startDuel(me, bot, arena)
end

DuelRequest.OnServerEvent:Connect(function(player, request)
	if type(request) ~= "table" then
		return
	end
	local action = request.Action
	-- light spam protection for menu actions
	if action == "Challenge" or action == "Respond" or action == "Bot" then
		if os.clock() - (lastRequest[player] or 0) < 0.5 then
			return
		end
		lastRequest[player] = os.clock()
	end

	if action == "Challenge" then
		challenge(player, request.Target)
	elseif action == "Respond" then
		respond(player, request.From, request.Accept == true)
	elseif action == "Bot" then
		fightBot(player, request.Difficulty)
	elseif action == "Attack" then
		local fighter = fighterOf[player]
		if fighter then
			basicAttack(fighter, request.Aim)
		end
	elseif action == "Power" then
		local fighter = fighterOf[player]
		if fighter then
			usePower(fighter, request.Aim)
		end
	elseif action == "Block" then
		local fighter = fighterOf[player]
		if fighter then
			setBlocking(fighter, request.On == true)
		end
	elseif action == "Dodge" then
		local fighter = fighterOf[player]
		if fighter then
			dodge(fighter, request.Direction)
		end
	elseif action == "Forfeit" then
		local fighter = fighterOf[player]
		if fighter and fighter.Duel then
			endDuel(fighter.Duel, fighter.Opponent, "Forfeit")
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	local fighter = fighterOf[player]
	if fighter and fighter.Duel then
		endDuel(fighter.Duel, fighter.Opponent, "Left")
	end
	pending[player] = nil
	lastRequest[player] = nil
	for target, entry in pairs(pending) do
		if entry.From == player then
			pending[target] = nil
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="15">
      <Properties>
        <string name="Name">Leaderboard</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Leaderboard (Script in ServerScriptService)
-- Fills the "TOP ROLLERS" board on the island with the top 10 players
-- of ALL servers (needs saving enabled, see README).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))

local island = workspace:WaitForChild("CosmicIsland")
local board = island:WaitForChild("LeaderboardBoard")
local list = board:WaitForChild("Gui"):WaitForChild("Panel"):WaitForChild("List")
local status = board.Gui.Panel:WaitForChild("Status")

local ok, orderedStore = pcall(function()
	return DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
end)
if not ok then
	orderedStore = nil
end

local nameCache = {}
local function getName(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local success, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = success and name or ("Player " .. userId)
	return nameCache[userId]
end

local RANK_COLORS = {
	Color3.fromRGB(255, 210, 80), -- gold
	Color3.fromRGB(210, 220, 235), -- silver
	Color3.fromRGB(230, 150, 90), -- bronze
}

local function makeRow(rank, name, rolls)
	local row = Instance.new("Frame")
	row.Name = "Row" .. rank
	row.LayoutOrder = rank
	row.Size = UDim2.new(1, 0, 0, 52)
	row.BackgroundColor3 = (rank % 2 == 0) and Color3.fromRGB(34, 28, 62) or Color3.fromRGB(26, 21, 48)
	row.BackgroundTransparency = 0.15
	row.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = row

	local function text(value, x, width, align, color, font)
		local labelObj = Instance.new("TextLabel")
		labelObj.BackgroundTransparency = 1
		labelObj.Position = UDim2.new(x, 0, 0, 0)
		labelObj.Size = UDim2.new(width, 0, 1, 0)
		labelObj.Font = font or Enum.Font.GothamBold
		labelObj.TextScaled = true
		labelObj.TextColor3 = color or Color3.new(1, 1, 1)
		labelObj.TextXAlignment = align
		labelObj.Text = value
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 10)
		pad.PaddingBottom = UDim.new(0, 10)
		pad.PaddingLeft = UDim.new(0, 12)
		pad.PaddingRight = UDim.new(0, 12)
		pad.Parent = labelObj
		labelObj.Parent = row
	end

	text("#" .. rank, 0, 0.18, Enum.TextXAlignment.Left, RANK_COLORS[rank] or Color3.fromRGB(190, 180, 225), Enum.Font.FredokaOne)
	text(name, 0.16, 0.5, Enum.TextXAlignment.Left)
	text(AuraData.FormatNumber(rolls), 0.62, 0.38, Enum.TextXAlignment.Right, Color3.fromRGB(140, 220, 255), Enum.Font.FredokaOne)
	row.Parent = list
end

local function clearRows()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
end

-- Fallback when saving is off: show players in this server
local function showLocal()
	clearRows()
	local players = Players:GetPlayers()
	table.sort(players, function(a, b)
		return (a:GetAttribute("Rolls") or 0) > (b:GetAttribute("Rolls") or 0)
	end)
	for rank = 1, math.min(10, #players) do
		makeRow(rank, players[rank].DisplayName, players[rank]:GetAttribute("Rolls") or 0)
	end
	status.Text = "This server (enable saving for global)"
end

local function refresh()
	if not orderedStore then
		showLocal()
		return
	end
	-- 1) push current players' roll counts
	for _, player in ipairs(Players:GetPlayers()) do
		local rolls = player:GetAttribute("Rolls")
		if rolls and rolls > 0 then
			pcall(function()
				orderedStore:SetAsync(tostring(player.UserId), rolls)
			end)
		end
	end
	-- 2) read the top 10
	local success, pages = pcall(function()
		return orderedStore:GetSortedAsync(false, 10)
	end)
	if not success then
		showLocal()
		return
	end
	clearRows()
	for rank, entry in ipairs(pages:GetCurrentPage()) do
		makeRow(rank, getName(tonumber(entry.key)), entry.value)
	end
	status.Text = "All servers • updates every " .. Config.LeaderboardRefresh .. "s"
end

Players.PlayerRemoving:Connect(function(player)
	local rolls = player:GetAttribute("Rolls")
	if orderedStore and rolls and rolls > 0 then
		pcall(function()
			orderedStore:SetAsync(tostring(player.UserId), rolls)
		end)
	end
end)

task.wait(5) -- let players load first
while true do
	refresh()
	task.wait(Config.LeaderboardRefresh)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">LuckyIsland</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- LuckyIsland (Script in ServerScriptService)
-- Builds LUCKY ISLE and runs its portals:
--   * walk into the portal on the main island (or press E) to come here
--   * standing on the island gives extra luck (Config.LuckyIsland.LuckMultiplier)
--   * the return portal takes you back
--   * if Config.LuckyIsland.RequireVIP is true, only VIP pass owners may come
-- Same vibe as the main island, but white marble + gold, rose and teal.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local LUCKY = Config.LuckyIsland
local CENTER = LUCKY.Center
local RADIUS = LUCKY.Radius
local rand = Random.new(7)

local MARBLE = Color3.fromRGB(238, 232, 220)
local MARBLE_DARK = Color3.fromRGB(205, 196, 182)
local GOLD = Color3.fromRGB(255, 200, 70)
local ROSE = Color3.fromRGB(255, 130, 190)
local TEAL = Color3.fromRGB(80, 230, 205)
local WINE = Color3.fromRGB(95, 35, 70)
local WINE_DARK = Color3.fromRGB(60, 20, 45)
local FLAT = CFrame.Angles(0, 0, math.rad(90))

-- where you arrive (next to the return portal, looking at the island)
local ARRIVAL = CFrame.lookAt(CENTER + Vector3.new(0, 4, -46), CENTER + Vector3.new(0, 4, 0))

---------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------
local remotes = ReplicatedStorage:FindFirstChild("CosmicRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "CosmicRemotes"
	remotes.Parent = ReplicatedStorage
end
local PortalFXRemote = remotes:FindFirstChild("PortalFX")
if not PortalFXRemote then
	PortalFXRemote = Instance.new("RemoteEvent")
	PortalFXRemote.Name = "PortalFX"
	PortalFXRemote.Parent = remotes
end

---------------------------------------------------------------------
-- Build helpers
---------------------------------------------------------------------
local old = workspace:FindFirstChild("LuckyIsland")
if old then
	old:Destroy()
end
local island = Instance.new("Model")
island.Name = "LuckyIsland"
island.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent or island
	return p
end

local function at(offset)
	return CENTER + offset
end

local function disc(name, radius, thickness, topY, color3, material, extra)
	local props = {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(at(Vector3.new(0, topY - thickness / 2, 0))) * FLAT,
		Color = color3,
		Material = material,
	}
	for key, value in pairs(extra or {}) do
		props[key] = value
	end
	return part(props)
end

local function column(position, height, radius, parent)
	part({
		Name = "Column",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * FLAT,
		Color = MARBLE,
		Material = Enum.Material.Marble,
		Parent = parent,
	})
	part({
		Name = "ColumnBase",
		Size = Vector3.new(radius * 2.6, 0.8, radius * 2.6),
		CFrame = CFrame.new(position + Vector3.new(0, 0.4, 0)),
		Color = GOLD,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Name = "ColumnCap",
		Size = Vector3.new(radius * 2.8, 0.8, radius * 2.8),
		CFrame = CFrame.new(position + Vector3.new(0, height + 0.2, 0)),
		Color = GOLD,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
end

local function addLight(target, color3, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color3
	light.Range = range
	light.Brightness = brightness
	light.Parent = target
	return light
end

local function addSparkles(target, color3, rate, size)
	local e = Instance.new("ParticleEmitter")
	e.Texture = Config.Textures.Sparkle
	e.Rate = rate
	e.Lifetime = NumberRange.new(1.5, 3)
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.5, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Color = ColorSequence.new(color3)
	e.Parent = target
	return e
end

-- flat ring of neon pieces as its own Model (WorldFX spins some of these)
local function ringModel(name, center, radius, segments, thickness, color3, parent, material)
	local model = Instance.new("Model")
	model.Name = name
	local length = (2 * math.pi * radius / segments) * 1.06
	for i = 1, segments do
		local a = (i / segments) * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
		part({
			Name = "Segment",
			Size = Vector3.new(thickness, thickness, length),
			CFrame = CFrame.lookAt(p, center) * CFrame.Angles(0, math.pi / 2, 0),
			Color = color3,
			Material = material or Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
			Parent = model,
		})
	end
	model.WorldPivot = CFrame.new(center)
	model.Parent = parent or island
	return model
end

-- vertical ring facing portalCF's look direction
local function portalRing(name, portalCF, radius, segments, thickness, color3, parent)
	local model = Instance.new("Model")
	model.Name = name
	local length = (2 * math.pi * radius / segments) * 1.08
	for i = 1, segments do
		local a = (i / segments) * math.pi * 2
		local radial = Vector3.new(math.cos(a), math.sin(a), 0)
		part({
			Name = "Segment",
			Size = Vector3.new(thickness, thickness, length),
			CFrame = portalCF * CFrame.fromMatrix(radial * radius, radial, Vector3.new(0, 0, 1)),
			Color = color3,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
			Parent = model,
		})
	end
	model.WorldPivot = portalCF
	model.Parent = parent or island
	return model
end

local function crystalCluster(position, color3)
	local count = rand:NextInteger(3, 5)
	for i = 1, count do
		local height = (i == 1) and rand:NextNumber(8, 12) or rand:NextNumber(3, 7)
		local width = height * 0.22
		local offset = (i == 1) and Vector3.zero or Vector3.new(rand:NextNumber(-2.5, 2.5), 0, rand:NextNumber(-2.5, 2.5))
		local crystal = part({
			Name = "Crystal",
			Size = Vector3.new(width, height, width),
			CFrame = CFrame.new(position + offset + Vector3.new(0, height * 0.4, 0))
				* CFrame.Angles(rand:NextNumber(-0.35, 0.35), rand:NextNumber(0, math.pi), rand:NextNumber(-0.35, 0.35)),
			Color = color3,
			Material = Enum.Material.Neon,
			Transparency = 0.1,
			CanCollide = (i == 1),
		})
		if i == 1 then
			addLight(crystal, color3, 18, 1.4)
			addSparkles(crystal, color3, 3, 0.4)
		end
	end
end

local function billboard(target, text, color3, offset, size)
	local gui = Instance.new("BillboardGui")
	gui.Size = size or UDim2.fromOffset(420, 70)
	gui.StudsOffset = offset or Vector3.new(0, 6, 0)
	gui.MaxDistance = 220
	gui.LightInfluence = 0
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color3
	label.Parent = gui
	local outline = Instance.new("UIStroke")
	outline.Thickness = 2.5
	outline.Transparency = 0.2
	outline.Parent = label
end

