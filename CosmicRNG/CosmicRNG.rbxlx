    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">AuraData</string>
        <string name="Source"><![CDATA[-- AuraData (ModuleScript in ReplicatedStorage)
-- Every aura in the game: odds, tier, colors and its duel power.
-- To add an aura, copy one entry and change it. Names must be unique.

local AuraData = {}

---------------------------------------------------------------------
-- TIERS: how strong/flashy each rarity group is.
-- Duel stats scale with the tier, so rarer auras = stronger in 1v1s.
---------------------------------------------------------------------
AuraData.Tiers = {
	Common    = { Order = 1, Color = Color3.fromRGB(200, 205, 220), MaxHealth = 100, AttackDamage = 6 },
	Uncommon  = { Order = 2, Color = Color3.fromRGB(110, 230, 140), MaxHealth = 115, AttackDamage = 7 },
	Rare      = { Order = 3, Color = Color3.fromRGB(90, 170, 255), MaxHealth = 130, AttackDamage = 8 },
	Epic      = { Order = 4, Color = Color3.fromRGB(190, 110, 255), MaxHealth = 150, AttackDamage = 10 },
	Legendary = { Order = 5, Color = Color3.fromRGB(255, 200, 70), MaxHealth = 175, AttackDamage = 12 },
	Mythic    = { Order = 6, Color = Color3.fromRGB(255, 80, 140), MaxHealth = 210, AttackDamage = 14 },
	Secret    = { Order = 7, Color = Color3.fromRGB(255, 255, 255), MaxHealth = 260, AttackDamage = 17 },
}

---------------------------------------------------------------------
-- POWER TYPES (the duel code in a later part reads these):
--  Projectile : fires Count orbs (Spread degrees apart) that deal Damage
--  Dash       : dashes Distance studs forward, damages anyone hit
--  Shield     : absorbs Amount damage for Duration seconds
--  Heal       : heals Amount (and optional Shield amount)
--  Burst      : explosion around you, Radius studs, optional Knockback
--  Meteor     : drops Count meteors on the enemy after a short delay
--  Freeze     : hits the enemy and stuns them for Duration seconds
--  Drain      : damages and heals you for Lifesteal (0-1) of the damage
--  Beam       : instant laser of Range studs
--  Pull       : drags the enemy toward you, then damages (+ optional Stun)
--  Teleport   : blinks behind the enemy and strikes
---------------------------------------------------------------------

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Ordered from most common to rarest.
AuraData.List = {
	-- COMMON ---------------------------------------------------------
	{
		Name = "Stardust", Chance = 2, Tier = "Common",
		Colors = { rgb(235, 235, 255), rgb(170, 180, 255) },
		Power = { Name = "Star Toss", Type = "Projectile", Damage = 8, Count = 1, Speed = 70, Cooldown = 3,
			Description = "Throws a small star at your opponent." },
	},
	{
		Name = "Moonbeam", Chance = 4, Tier = "Common",
		Colors = { rgb(210, 230, 255), rgb(140, 170, 230) },
		Power = { Name = "Moon Shield", Type = "Shield", Amount = 15, Duration = 4, Cooldown = 8,
			Description = "A pale moon barrier blocks 15 damage." },
	},
	{
		Name = "Twilight", Chance = 8, Tier = "Common",
		Colors = { rgb(255, 150, 120), rgb(120, 80, 170) },
		Power = { Name = "Dusk Dash", Type = "Dash", Damage = 10, Distance = 22, Cooldown = 5,
			Description = "Dashes forward, hurting anyone in the way." },
	},

	-- UNCOMMON -------------------------------------------------------
	{
		Name = "Comet", Chance = 16, Tier = "Uncommon",
		Colors = { rgb(120, 220, 255), rgb(255, 255, 255) },
		Power = { Name = "Comet Strike", Type = "Projectile", Damage = 14, Count = 1, Speed = 120, Cooldown = 4,
			Description = "A very fast comet that is hard to dodge." },
	},
	{
		Name = "Aurora", Chance = 32, Tier = "Uncommon",
		Colors = { rgb(90, 255, 170), rgb(150, 110, 255) },
		Power = { Name = "Aurora Mend", Type = "Heal", Amount = 22, Cooldown = 9,
			Description = "Northern lights heal you for 22 HP." },
	},
	{
		Name = "Meteor", Chance = 64, Tier = "Uncommon",
		Colors = { rgb(255, 130, 50), rgb(120, 60, 40) },
		Power = { Name = "Meteor Drop", Type = "Meteor", Damage = 22, Count = 1, Radius = 8, Delay = 0.8, Cooldown = 7,
			Description = "Calls a meteor down on your opponent." },
	},

	-- RARE -----------------------------------------------------------
	{
		Name = "Nebula", Chance = 128, Tier = "Rare",
		Colors = { rgb(255, 90, 200), rgb(90, 120, 255) },
		Power = { Name = "Nebula Cloud", Type = "Burst", Damage = 18, Radius = 14, Slow = 0.5, SlowDuration = 3, Cooldown = 7,
			Description = "A gas cloud bursts out, damaging and slowing." },
	},
	{
		Name = "Pulsar", Chance = 256, Tier = "Rare",
		Colors = { rgb(80, 200, 255), rgb(30, 60, 200) },
		Power = { Name = "Pulse Wave", Type = "Burst", Damage = 22, Radius = 16, Knockback = 60, Cooldown = 6,
			Description = "A shockwave that blasts enemies away." },
	},
	{
		Name = "Frostmoon", Chance = 512, Tier = "Rare", Special = "Snow",
		Colors = { rgb(200, 240, 255), rgb(90, 170, 255) },
		Power = { Name = "Frost Lock", Type = "Freeze", Damage = 15, Duration = 1.5, Range = 40, Cooldown = 9,
			Description = "Freezes your opponent solid for 1.5s." },
	},

	-- EPIC -----------------------------------------------------------
	{
		Name = "Solar Flare", Chance = 1000, Tier = "Epic", Special = "Fire",
		Colors = { rgb(255, 210, 60), rgb(255, 90, 20) },
		Power = { Name = "Flare Beam", Type = "Beam", Damage = 35, Range = 60, Cooldown = 8,
			Description = "A searing beam of sunlight." },
	},
	{
		Name = "Eclipse", Chance = 2500, Tier = "Epic", Special = "Dark",
		Colors = { rgb(30, 20, 40), rgb(255, 170, 60) },
		Power = { Name = "Shadow Drain", Type = "Drain", Damage = 30, Lifesteal = 0.5, Range = 40, Cooldown = 8,
			Description = "Steals 30 HP, healing you for half." },
	},
	{
		Name = "Starfall", Chance = 5000, Tier = "Epic",
		Colors = { rgb(255, 240, 150), rgb(120, 140, 255) },
		Power = { Name = "Star Rain", Type = "Meteor", Damage = 15, Count = 3, Radius = 7, Delay = 0.6, Cooldown = 9,
			Description = "Three falling stars rain on your opponent." },
	},

	-- LEGENDARY ------------------------------------------------------
	{
		Name = "Supernova", Chance = 10000, Tier = "Legendary", Special = "Fire",
		Colors = { rgb(255, 250, 200), rgb(255, 120, 40) },
		Power = { Name = "Nova Burst", Type = "Burst", Damage = 45, Radius = 22, Knockback = 80, Cooldown = 9,
			Description = "You explode like a dying star." },
	},
	{
		Name = "Quasar", Chance = 25000, Tier = "Legendary",
		Colors = { rgb(120, 255, 255), rgb(200, 80, 255) },
		Power = { Name = "Quasar Lance", Type = "Beam", Damage = 50, Range = 90, Cooldown = 8,
			Description = "A long-range lance of pure energy." },
	},
	{
		Name = "Celestial", Chance = 50000, Tier = "Legendary",
		Colors = { rgb(255, 245, 210), rgb(255, 215, 120) },
		Power = { Name = "Divine Light", Type = "Heal", Amount = 40, Shield = 30, Duration = 5, Cooldown = 12,
			Description = "Heals 40 HP and grants a 30 HP shield." },
	},

	-- MYTHIC ---------------------------------------------------------
	{
		Name = "Black Hole", Chance = 100000, Tier = "Mythic", Special = "Inward",
		Colors = { rgb(10, 0, 20), rgb(170, 60, 255) },
		Power = { Name = "Event Horizon", Type = "Pull", Damage = 55, Range = 50, Cooldown = 10,
			Description = "Sucks your opponent in and crushes them." },
	},
	{
		Name = "Galaxy", Chance = 250000, Tier = "Mythic", Special = "Rainbow",
		Colors = { rgb(255, 100, 220), rgb(80, 200, 255) },
		Power = { Name = "Galactic Barrage", Type = "Projectile", Damage = 14, Count = 5, Spread = 12, Speed = 100, Cooldown = 9,
			Description = "Fires a fan of five star orbs." },
	},
	{
		Name = "Cosmic Rift", Chance = 500000, Tier = "Mythic",
		Colors = { rgb(255, 40, 120), rgb(40, 255, 220) },
		Power = { Name = "Rift Step", Type = "Teleport", Damage = 60, Range = 60, Cooldown = 9,
			Description = "Tears through space and strikes from behind." },
	},

	-- SECRET ---------------------------------------------------------
	{
		Name = "Big Bang", Chance = 1000000, Tier = "Secret", Special = "Rainbow",
		Colors = { rgb(255, 255, 255), rgb(255, 200, 80) },
		Power = { Name = "Big Bang", Type = "Burst", Damage = 90, Radius = 30, Knockback = 120, Cooldown = 14,
			Description = "Recreates the birth of the universe." },
	},
	{
		Name = "Void Sovereign", Chance = 5000000, Tier = "Secret", Special = "Inward",
		Colors = { rgb(0, 0, 0), rgb(255, 0, 80) },
		Power = { Name = "Void Collapse", Type = "Pull", Damage = 100, Range = 70, Stun = 1.5, Cooldown = 15,
			Description = "The void swallows your opponent and freezes them." },
	},
}

---------------------------------------------------------------------
-- Lookup helpers
---------------------------------------------------------------------
AuraData.ByName = {}
for index, aura in ipairs(AuraData.List) do
	aura.Index = index
	AuraData.ByName[aura.Name] = aura
end

-- Rarest first, used by the roll algorithm.
AuraData.RarestFirst = table.clone(AuraData.List)
table.sort(AuraData.RarestFirst, function(a, b)
	return a.Chance > b.Chance
end)

function AuraData.Get(name)
	return AuraData.ByName[name]
end

function AuraData.GetTier(name)
	local aura = AuraData.ByName[name]
	return aura and AuraData.Tiers[aura.Tier]
end

-- 1234567 -> "1,234,567"
function AuraData.FormatNumber(n)
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

function AuraData.FormatChance(chance)
	return "1 in " .. AuraData.FormatNumber(chance)
end

-- Picks a random aura. Goes from rarest to most common and gives each
-- one a (luck / chance) shot, so "1 in 1,000" really feels like it.
function AuraData.RollRandom(luck, rng)
	rng = rng or Random.new()
	luck = math.max(luck or 1, 1)
	for _, aura in ipairs(AuraData.RarestFirst) do
		if rng:NextNumber() < (luck / aura.Chance) then
			return aura
		end
	end
	return AuraData.List[1]
end

return AuraData
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">AuraEffects</string>
        <string name="Source"><![CDATA[-- AuraEffects (ModuleScript in ReplicatedStorage)
-- Builds and animates the aura visuals around a character.
-- Runs on each player's own computer (called by the AuraRenderer LocalScript),
-- so the animation is smooth and costs the server nothing.
--
-- Rarer tiers stack more layers:
--   Common    : glow particles + light
--   Uncommon  : + rising motes
--   Rare      : + orbiting stars with trails
--   Epic      : + body trail + ambient haze
--   Legendary : + rotating ground ring + spiral beams
--   Mythic    : + halo + shockwave pulses
--   Secret    : + everything bigger, extra sparks, lightning beams

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))
local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local AuraEffects = {}

local TEX = Config.Textures
local TAU = math.pi * 2

---------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------
local function seq2(a, b)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, a),
		ColorSequenceKeypoint.new(1, b),
	})
end

local function numSeq(points)
	local keypoints = {}
	for _, p in ipairs(points) do
		table.insert(keypoints, NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0))
	end
	return NumberSequence.new(keypoints)
end

local function make(className, props, parent)
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		inst[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function fxPart(props, parent)
	local part = make("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Massless = true,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	})
	for key, value in pairs(props) do
		part[key] = value
	end
	part.Parent = parent
	return part
end

local function getFxFolder()
	local folder = workspace:FindFirstChild("LocalAuraFX")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "LocalAuraFX"
		folder.Parent = workspace
	end
	return folder
end

local function addTrail(part, color0, color1, halfLength, lifetime, parent)
	local a0 = make("Attachment", { Position = Vector3.new(0, halfLength, 0) }, part)
	local a1 = make("Attachment", { Position = Vector3.new(0, -halfLength, 0) }, part)
	return make("Trail", {
		Attachment0 = a0,
		Attachment1 = a1,
		Color = seq2(color0, color1),
		Transparency = numSeq({ { 0, 0.2 }, { 1, 1 } }),
		Lifetime = lifetime,
		LightEmission = 1,
		LightInfluence = 0,
		FaceCamera = true,
		MinLength = 0.05,
	}, parent or part)
end

---------------------------------------------------------------------
-- Aura handle (one per character)
---------------------------------------------------------------------
local Handle = {}
Handle.__index = Handle

function AuraEffects.Apply(character, auraName)
	local aura = AuraData.Get(auraName)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not aura or not root then
		return nil
	end

	local order = AuraData.Tiers[aura.Tier].Order
	local c1, c2 = aura.Colors[1], aura.Colors[2]
	local special = aura.Special

	local self = setmetatable({
		Character = character,
		Root = root,
		Aura = aura,
		Order = order,
		Time = math.random() * 10,
		PulseTimer = 0,
		ColorTimer = 0,
		Orbiters = {},
		RingParts = {},
		HaloParts = {},
		Emitters = {},
		Destroyed = false,
	}, Handle)

	local folder = make("Folder", { Name = "Aura_" .. character.Name }, getFxFolder())
	self.Folder = folder

	-- Invisible box around the body that particles spawn from.
	local body = fxPart({
		Name = "Body",
		Size = Vector3.new(3.5, 5.5, 3.5),
		Transparency = 1,
		CFrame = root.CFrame,
	}, folder)
	self.Body = body

	-- Invisible spinning pivot for beams.
	local pivot = fxPart({
		Name = "Pivot",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = root.CFrame,
	}, folder)
	self.Pivot = pivot

	local function emitter(props)
		local e = make("ParticleEmitter", {
			LightInfluence = 0,
			Color = seq2(c1, c2),
		}, body)
		for key, value in pairs(props) do
			e[key] = value
		end
		table.insert(self.Emitters, e)
		return e
	end

	-- Size multiplier so rarer tiers are bigger
	local scale = 0.8 + order * 0.15

	-- LAYER 1: core glow (everyone) ----------------------------------
	emitter({
		Texture = TEX.Sparkle,
		Rate = 6 + order * 4,
		Lifetime = NumberRange.new(0.8, 1.6),
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
		Size = numSeq({ { 0, 0.15 * scale }, { 0.3, 0.45 * scale }, { 1, 0 } }),
		Transparency = numSeq({ { 0, 0.3 }, { 1, 1 } }),
		LightEmission = 1,
		RotSpeed = NumberRange.new(-90, 90),
		Rotation = NumberRange.new(0, 360),
	})

	self.Light = make("PointLight", {
		Color = c1,
		Range = 6 + order * 1.5,
		Brightness = 0.8 + order * 0.35,
		Shadows = false,
	}, body)

	-- LAYER 2: rising motes ------------------------------------------
	if order >= 2 then
		emitter({
			Texture = TEX.Spark,
			Rate = 4 + order * 3,
			Lifetime = NumberRange.new(1.2, 2),
			Speed = NumberRange.new(0, 0.5),
			Acceleration = Vector3.new(0, 2.5 + order * 0.4, 0),
			Size = numSeq({ { 0, 0.1 * scale }, { 0.5, 0.2 * scale }, { 1, 0 } }),
			Transparency = numSeq({ { 0, 0.1 }, { 1, 1 } }),
			LightEmission = 1,
			Color = seq2(c2, c1),
		})
	end

	-- LAYER 3: orbiting stars ----------------------------------------
	if order >= 3 then
		local count = order - 1 -- Rare 2, Epic 3 ... Secret 6
		for i = 1, count do
			local orb = fxPart({
				Name = "Orbiter",
				Shape = Enum.PartType.Ball,
				Material = Enum.Material.Neon,
				Size = Vector3.one * (0.3 + order * 0.04),
				Color = (i % 2 == 0) and c2 or c1,
				Transparency = 0,
				CFrame = root.CFrame,
			}, folder)
			addTrail(orb, c1, c2, orb.Size.Y * 0.5, 0.25 + order * 0.04)
			table.insert(self.Orbiters, {
				Part = orb,
				Offset = (i - 1) / count * TAU,
				Radius = 2.6 + (i % 2) * 0.6,
				Tilt = (i % 3 - 1) * 0.5,
				Speed = 2 + (i % 2) * 0.8,
			})
		end
	end

	-- LAYER 4: body trail + haze -------------------------------------
	if order >= 4 then
		addTrail(body, c1, c2, 2.4, 0.35, body)
		emitter({
			Texture = TEX.Smoke,
			Rate = 3 + order,
			Lifetime = NumberRange.new(1.5, 2.5),
			Speed = NumberRange.new(0.2, 0.8),
			SpreadAngle = Vector2.new(180, 180),
			Size = numSeq({ { 0, 1.5 }, { 1, 3.5 } }),
			Transparency = numSeq({ { 0, 1 }, { 0.3, 0.8 }, { 1, 1 } }),
			LightEmission = (special == "Dark") and 0 or 0.6,
			RotSpeed = NumberRange.new(-30, 30),
			Rotation = NumberRange.new(0, 360),
		})
	end

	-- LAYER 5: ground ring + spiral beams ----------------------------
	if order >= 5 then
		local segments = 14 + order * 2
		for i = 1, segments do
			local seg = fxPart({
				Name = "Ring",
				Material = Enum.Material.Neon,
				Size = Vector3.new(0.15, 0.15, 0.9),
				Color = (i % 2 == 0) and c1 or c2,
				Transparency = 0.15,
			}, folder)
			table.insert(self.RingParts, { Part = seg, Offset = (i - 1) / segments * TAU })
		end

		local beamCount = order - 3 -- Legendary 2, Mythic 3, Secret 4
		for i = 1, beamCount do
			local angle = (i - 1) / beamCount * TAU
			local bottom = make("Attachment", {
				Position = Vector3.new(math.cos(angle) * 2.5, -2.8, math.sin(angle) * 2.5),
			}, pivot)
			local top = make("Attachment", {
				Position = Vector3.new(math.cos(angle + 2) * 1.2, 3.2, math.sin(angle + 2) * 1.2),
			}, pivot)
			make("Beam", {
				Attachment0 = bottom,
				Attachment1 = top,
				Color = seq2(c1, c2),
				Transparency = numSeq({ { 0, 1 }, { 0.2, 0.3 }, { 0.8, 0.3 }, { 1, 1 } }),
				Width0 = 0.35,
				Width1 = 0.1,
				CurveSize0 = 3,
				CurveSize1 = -3,
				LightEmission = 1,
				LightInfluence = 0,
				FaceCamera = true,
				Segments = 20,
			}, pivot)
		end
	end

	-- LAYER 6: halo + pulses -----------------------------------------
	if order >= 6 then
		local haloSegments = 16
		for i = 1, haloSegments do
			local seg = fxPart({
				Name = "Halo",
				Material = Enum.Material.Neon,
				Size = Vector3.new(0.12, 0.12, 0.42),
				Color = c2,
				Transparency = 0.05,
			}, folder)
			table.insert(self.HaloParts, { Part = seg, Offset = (i - 1) / haloSegments * TAU })
		end
		self.PulseEvery = (order >= 7) and 1.4 or 2.2
	end

	-- LAYER 7: secret extras -----------------------------------------
	if order >= 7 then
		emitter({
			Texture = TEX.Spark,
			Rate = 25,
			Lifetime = NumberRange.new(0.3, 0.6),
			Speed = NumberRange.new(8, 14),
			SpreadAngle = Vector2.new(180, 180),
			Drag = 4,
			Size = numSeq({ { 0, 0.3 }, { 1, 0 } }),
			LightEmission = 1,
		})
		-- crackling "lightning" beams between orbiters
		for i = 1, #self.Orbiters - 1, 2 do
			local a = make("Attachment", {}, self.Orbiters[i].Part)
			local b = make("Attachment", {}, self.Orbiters[i + 1].Part)
			make("Beam", {
				Attachment0 = a,
				Attachment1 = b,
				Color = seq2(c2, c1),
				Width0 = 0.08,
				Width1 = 0.08,
				LightEmission = 1,
				LightInfluence = 0,
				FaceCamera = true,
				Texture = "",
				CurveSize0 = 1.5,
				CurveSize1 = -1.5,
				Segments = 12,
			}, self.Orbiters[i].Part)
		end
	end

	-- SPECIAL EFFECTS -------------------------------------------------
	if special == "Fire" then
		emitter({
			Texture = TEX.Fire,
			Rate = 18,
			Lifetime = NumberRange.new(0.5, 1),
			Speed = NumberRange.new(1, 3),
			Acceleration = Vector3.new(0, 6, 0),
			Size = numSeq({ { 0, 1.2 }, { 1, 0 } }),
			Transparency = numSeq({ { 0, 0.4 }, { 1, 1 } }),
			LightEmission = 1,
			Color = seq2(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 70, 20)),
			RotSpeed = NumberRange.new(-60, 60),
			Rotation = NumberRange.new(0, 360),
		})
	elseif special == "Snow" then
		emitter({
			Texture = TEX.Sparkle,
			Rate = 14,
			Lifetime = NumberRange.new(2, 3),
			Speed = NumberRange.new(0, 0.5),
			Acceleration = Vector3.new(0, -1.5, 0),
			Size = numSeq({ { 0, 0.25 }, { 1, 0.15 } }),
			Transparency = numSeq({ { 0, 0.1 }, { 0.8, 0.3 }, { 1, 1 } }),
			LightEmission = 0.7,
			Color = seq2(Color3.new(1, 1, 1), c1),
			RotSpeed = NumberRange.new(-120, 120),
			Rotation = NumberRange.new(0, 360),
		})
	elseif special == "Dark" then
		emitter({
			Texture = TEX.Smoke,
			Rate = 10,
			Lifetime = NumberRange.new(1, 1.8),
			Speed = NumberRange.new(0.5, 1),
			Acceleration = Vector3.new(0, 1.5, 0),
			Size = numSeq({ { 0, 1 }, { 1, 2.5 } }),
			Transparency = numSeq({ { 0, 0.5 }, { 1, 1 } }),
			LightEmission = 0,
			Color = seq2(Color3.fromRGB(10, 5, 15), Color3.fromRGB(40, 20, 50)),
		})
	elseif special == "Inward" then
		emitter({
			Texture = TEX.Sparkle,
			Rate = 40,
			Shape = Enum.ParticleEmitterShape.Sphere,
			ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
			ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
			Lifetime = NumberRange.new(0.5, 0.7),
			Speed = NumberRange.new(4, 6),
			Size = numSeq({ { 0, 0.3 }, { 1, 0 } }),
			Transparency = numSeq({ { 0, 0.6 }, { 0.5, 0 }, { 1, 1 } }),
			LightEmission = 1,
			Color = seq2(c2, c1),
		})
	end

	self.Rainbow = (special == "Rainbow")
	self:Update(0)
	return self
end

---------------------------------------------------------------------
-- Called every frame by the renderer
---------------------------------------------------------------------
function Handle:Update(dt)
	if self.Destroyed then
		return
	end
	local root = self.Root
	if not root.Parent then
		return
	end

	self.Time += dt
	local t = self.Time
	local pos = root.Position

	self.Body.CFrame = root.CFrame
	self.Pivot.CFrame = CFrame.new(pos) * CFrame.Angles(0, t * 1.6, 0)

	-- Orbiters
	for _, o in ipairs(self.Orbiters) do
		local a = t * o.Speed + o.Offset
		local offset = Vector3.new(math.cos(a) * o.Radius, math.sin(a * 1.3 + o.Offset) * 1.2 + o.Tilt, math.sin(a) * o.Radius)
		o.Part.CFrame = CFrame.new(pos + offset)
	end

	-- Ground ring (feet are ~3 studs below the root)
	if #self.RingParts > 0 then
		local radius = 3.2 + math.sin(t * 2) * 0.15
		local center = pos - Vector3.new(0, 2.9, 0)
		for _, r in ipairs(self.RingParts) do
			local a = r.Offset + t * 0.8
			local p = center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
			r.Part.CFrame = CFrame.lookAt(p, center) * CFrame.Angles(0, math.pi / 2, 0)
		end
	end

	-- Halo above head
	if #self.HaloParts > 0 then
		local center = pos + Vector3.new(0, 3.1 + math.sin(t * 2.5) * 0.12, 0)
		for _, h in ipairs(self.HaloParts) do
			local a = h.Offset - t * 1.2
			local p = center + Vector3.new(math.cos(a) * 0.9, 0, math.sin(a) * 0.9)
			h.Part.CFrame = CFrame.lookAt(p, center) * CFrame.Angles(0, math.pi / 2, 0)
		end
	end

	-- Shockwave pulses
	if self.PulseEvery then
		self.PulseTimer += dt
		if self.PulseTimer >= self.PulseEvery then
			self.PulseTimer = 0
			self:Pulse()
		end
	end

	-- Rainbow color cycling
	if self.Rainbow then
		local hue = (t * 0.15) % 1
		local a = Color3.fromHSV(hue, 0.7, 1)
		local b = Color3.fromHSV((hue + 0.35) % 1, 0.7, 1)
		self.Light.Color = a
		for i, o in ipairs(self.Orbiters) do
			o.Part.Color = (i % 2 == 0) and b or a
		end
		self.ColorTimer += dt
		if self.ColorTimer > 0.2 then
			self.ColorTimer = 0
			local colorSeq = seq2(a, b)
			for _, e in ipairs(self.Emitters) do
				if e.Texture ~= TEX.Smoke then
					e.Color = colorSeq
				end
			end
		end
	end
end

function Handle:Pulse()
	local aura = self.Aura
	local root = self.Root
	local ring = fxPart({
		Name = "Pulse",
		Shape = Enum.PartType.Cylinder,
		Material = Enum.Material.Neon,
		Color = aura.Colors[2],
		Transparency = 0.3,
		Size = Vector3.new(0.15, 2, 2),
		CFrame = CFrame.new(root.Position - Vector3.new(0, 2.9, 0)) * CFrame.Angles(0, 0, math.pi / 2),
	}, self.Folder)
	local grow = (self.Order >= 7) and 26 or 18
	TweenService:Create(ring, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, grow, grow),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 1.1)
end

function Handle:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	if self.Folder then
		self.Folder:Destroy()
	end
end

function Handle:IsAlive()
	return not self.Destroyed
		and self.Root.Parent ~= nil
		and self.Character.Parent ~= nil
end

---------------------------------------------------------------------
-- One-shot explosion (used when someone equips a new aura, and later
-- for duel hits). scale: 1 = normal.
---------------------------------------------------------------------
function AuraEffects.Burst(position, colors, scale)
	scale = scale or 1
	local c1, c2 = colors[1], colors[2]
	local folder = getFxFolder()

	local sphere = fxPart({
		Name = "BurstSphere",
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.Neon,
		Color = c1,
		Transparency = 0.2,
		Size = Vector3.one * 1,
		CFrame = CFrame.new(position),
	}, folder)
	TweenService:Create(sphere, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.one * 9 * scale,
		Transparency = 1,
	}):Play()
	Debris:AddItem(sphere, 0.5)

	local ring = fxPart({
		Name = "BurstRing",
		Shape = Enum.PartType.Cylinder,
		Material = Enum.Material.Neon,
		Color = c2,
		Transparency = 0.2,
		Size = Vector3.new(0.2, 1, 1),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
	}, folder)
	TweenService:Create(ring, TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, 20 * scale, 20 * scale),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.8)

	local holder = fxPart({ Name = "BurstHolder", Size = Vector3.one, Transparency = 1, CFrame = CFrame.new(position) }, folder)
	local sparks = make("ParticleEmitter", {
		Texture = TEX.Sparkle,
		Enabled = false,
		Lifetime = NumberRange.new(0.6, 1.2),
		Speed = NumberRange.new(10 * scale, 22 * scale),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
		Size = numSeq({ { 0, 0.6 * scale }, { 1, 0 } }),
		Transparency = numSeq({ { 0, 0 }, { 1, 1 } }),
		LightEmission = 1,
		LightInfluence = 0,
		Color = seq2(c1, c2),
		RotSpeed = NumberRange.new(-200, 200),
	}, holder)
	sparks:Emit(math.floor(40 * scale))
	local light = make("PointLight", { Color = c1, Range = 16 * scale, Brightness = 4 }, holder)
	TweenService:Create(light, TweenInfo.new(0.8), { Brightness = 0 }):Play()
	Debris:AddItem(holder, 1.5)
end

return AuraEffects
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">CosmicConfig</string>
        <string name="Source"><![CDATA[-- CosmicConfig (ModuleScript in ReplicatedStorage)
-- All the numbers you might want to tweak live here.

local Config = {}

---------------------------------------------------------------------
-- GAME PASSES
-- Create each pass on the Creator Dashboard (Monetization > Passes),
-- then paste its ID here.
-- While an ID is 0, the pass is FREE in Roblox Studio so you can test,
-- and nobody owns it in the live game.
---------------------------------------------------------------------
Config.GamePasses = {
	AutoRoll = 0, -- unlocks the Auto Roll button
	QuickRoll = 0, -- faster rolling (see QuickRollCooldown)
	DoubleLuck = 0, -- permanent x2 luck
	VIP = 0, -- x1.25 luck, VIP tag, VIP Lounge access
	MultiRoll = 0, -- every roll rolls 3 auras at once
	LuckyCharm = 0, -- lucky roll every 5 rolls instead of every 10
}
Config.FreePassesInStudio = true

-- What the store shows for each pass (order = position in the store)
Config.PassInfo = {
	{ Key = "AutoRoll", Icon = "🔁", Name = "Auto Roll", Description = "Rolls for you automatically, even while you're AFK." },
	{ Key = "QuickRoll", Icon = "⚡", Name = "Quick Roll", Description = "Roll twice as fast." },
	{ Key = "DoubleLuck", Icon = "🍀", Name = "2x Luck", Description = "Permanently doubles your luck on every roll." },
	{ Key = "MultiRoll", Icon = "🎲", Name = "Triple Roll", Description = "Every roll gives you 3 auras at once." },
	{ Key = "LuckyCharm", Icon = "✨", Name = "Lucky Charm", Description = "Lucky roll every 5 rolls instead of every 10." },
	{ Key = "VIP", Icon = "👑", Name = "VIP", Description = "x1.25 luck, a gold VIP tag and access to the VIP Lounge." },
}

---------------------------------------------------------------------
-- DEVELOPER PRODUCTS (can be bought many times)
-- Create them on the Creator Dashboard (Monetization > Developer Products).
---------------------------------------------------------------------
Config.Products = {
	PersonalLuck = 0, -- x2 luck for you
	ServerLuck = 0, -- x2 luck for everyone in the server
}
Config.ProductInfo = {
	{ Key = "PersonalLuck", Icon = "🧪", Name = "Luck Potion", Description = "x2 luck for 10 minutes. Stacks time if you buy more." },
	{ Key = "ServerLuck", Icon = "🌌", Name = "Server Luck", Description = "x2 luck for EVERYONE in the server for 15 minutes." },
}

---------------------------------------------------------------------
-- LUCK
---------------------------------------------------------------------
Config.BaseLuck = 1 -- 1 = normal odds, 2 = everything twice as likely
Config.LuckMultipliers = {
	DoubleLuck = 2,
	VIP = 1.25,
	PersonalBoost = 2,
	ServerBoost = 2,
}
Config.PersonalBoostMinutes = 10
Config.ServerBoostMinutes = 15

---------------------------------------------------------------------
-- ROLLING
---------------------------------------------------------------------
Config.RollCooldown = 1.2 -- seconds between rolls (server enforced)
Config.QuickRollCooldown = 0.6 -- with the Quick Roll pass
Config.LuckyRollEvery = 10 -- every Nth roll gets bonus luck
Config.LuckyCharmEvery = 5 -- with the Lucky Charm pass
Config.LuckyRollMultiplier = 2
Config.MultiRollCount = 3 -- with the Triple Roll pass

-- Rolls at or above these odds get special treatment
Config.AnnounceAtChance = 1000 -- whole server gets a message
Config.CutsceneAtChance = 10000 -- dramatic reveal on the roller's screen
Config.ShowcaseAtChance = 10000 -- camera spins around you to show it off
Config.SkyShiftAtChance = 1000000 -- sky changes for everyone (secret auras)

---------------------------------------------------------------------
-- SAVING + LEADERBOARD
---------------------------------------------------------------------
Config.DataStoreName = "CosmicRNG_Data_v1"
Config.LeaderboardStoreName = "CosmicRNG_TopRolls_v1"
Config.AutosaveInterval = 120
Config.LeaderboardRefresh = 90 -- seconds

---------------------------------------------------------------------
-- WORLD
---------------------------------------------------------------------
Config.RemoveDefaultBaseplate = true -- deletes the part named "Baseplate"

---------------------------------------------------------------------
-- PARTICLE TEXTURES (built into Roblox, always available)
-- You can swap these for your own uploaded decal IDs later.
---------------------------------------------------------------------
Config.Textures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Spark = "rbxasset://textures/particles/fire_sparks_main.dds",
}

---------------------------------------------------------------------
-- SOUNDS
-- The game makes its sounds from Roblox's built-in sound files, so they
-- always work. To use a better sound, find one in the Creator Store
-- (Toolbox > Audio), copy its ID and paste it here, e.g.
--   RevealLegendary = "rbxassetid://1234567890",
-- Leave "" to keep the built-in version.
---------------------------------------------------------------------
Config.SoundOverrides = {
	Tick = "", -- each name flicking past while rolling
	Click = "", -- pressing buttons
	Hover = "", -- mouse over buttons
	Whoosh = "", -- panels opening
	Pop = "", -- common/uncommon reveal
	RevealRare = "",
	RevealEpic = "",
	RevealLegendary = "",
	RevealMythic = "", -- mythic + secret
	Heartbeat = "", -- rare roll cutscene
	Rumble = "", -- rare roll cutscene background
	Equip = "",
	Purchase = "",
}
Config.AmbientMusic = "" -- background music ID, "" = soft space hum
Config.AmbientVolume = 0.25
Config.MasterVolume = 1

return Config
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">Luck</string>
        <string name="Source"><![CDATA[-- Luck (ModuleScript in ReplicatedStorage)
-- One place that works out a player's luck, used by BOTH the server
-- (for real rolls) and the screen (to show "Luck x5"), so they always match.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local Luck = {}

-- Same clock on server and clients (seconds since 1970)
function Luck.Now()
	return workspace:GetServerTimeNow()
end

-- Returns a list of active bonuses: { Name, Multiplier, EndsAt (or nil) }
function Luck.GetBonuses(player)
	local bonuses = {}
	local m = Config.LuckMultipliers
	local now = Luck.Now()

	if player:GetAttribute("Pass_DoubleLuck") then
		table.insert(bonuses, { Name = "2x Luck", Multiplier = m.DoubleLuck })
	end
	if player:GetAttribute("Pass_VIP") then
		table.insert(bonuses, { Name = "VIP", Multiplier = m.VIP })
	end

	local personalEnd = player:GetAttribute("PersonalLuckEnd") or 0
	if personalEnd > now then
		table.insert(bonuses, { Name = "Potion", Multiplier = m.PersonalBoost, EndsAt = personalEnd })
	end

	local serverEnd = ReplicatedStorage:GetAttribute("ServerLuckEnd") or 0
	if serverEnd > now then
		table.insert(bonuses, { Name = "Server", Multiplier = m.ServerBoost, EndsAt = serverEnd })
	end

	-- Reserved for events in a later part
	local eventLuck = ReplicatedStorage:GetAttribute("EventLuck")
	if eventLuck and eventLuck > 1 then
		table.insert(bonuses, { Name = "Event", Multiplier = eventLuck })
	end

	return bonuses
end

function Luck.Get(player)
	local total = Config.BaseLuck
	for _, bonus in ipairs(Luck.GetBonuses(player)) do
		total *= bonus.Multiplier
	end
	return total
end

function Luck.LuckyEvery(player)
	if player:GetAttribute("Pass_LuckyCharm") then
		return Config.LuckyCharmEvery
	end
	return Config.LuckyRollEvery
end

function Luck.Format(n)
	if math.abs(n - math.floor(n + 0.5)) < 0.001 then
		return tostring(math.floor(n + 0.5))
	end
	local text = string.format("%.2f", n):gsub("0+$", ""):gsub("%.$", "")
	return text
end

-- 125 -> "2:05"
function Luck.FormatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

return Luck
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name">SoundFX</string>
        <string name="Source"><![CDATA[-- SoundFX (ModuleScript in ReplicatedStorage) - used by LocalScripts only
-- Every sound in the game. They are built from Roblox's built-in sound
-- files (always available) and shaped with pitch, echo, reverb and bass.
-- Swap any of them for a Creator Store sound in CosmicConfig.SoundOverrides.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local SoundFX = {}

local BUILT_IN = {
	Tick = "rbxasset://sounds/volume_slider.ogg",
	Boom = "rbxasset://sounds/impact_explosion_03.mp3",
	Wind = "rbxasset://sounds/action_falling.ogg",
	Thud = "rbxasset://sounds/action_jump_land.mp3",
}

-- Effect recipes
local EFFECTS = {
	Reverb = { Class = "ReverbSoundEffect", Props = { DecayTime = 1.8, Density = 1, Diffusion = 1, DryLevel = 0, WetLevel = -4 } },
	Echo = { Class = "EchoSoundEffect", Props = { Delay = 0.22, Feedback = 0.35, DryLevel = 0, WetLevel = -6 } },
	Bass = { Class = "EqualizerSoundEffect", Props = { LowGain = 8, MidGain = 0, HighGain = -4 } },
	Muffle = { Class = "EqualizerSoundEffect", Props = { LowGain = 6, MidGain = -16, HighGain = -45 } },
	Bright = { Class = "EqualizerSoundEffect", Props = { LowGain = -10, MidGain = 0, HighGain = 4 } },
}

-- Sound recipes: which file, pitch (Speed), volume and effects
local PRESETS = {
	Tick = { Id = BUILT_IN.Tick, Speed = 1, Volume = 0.55 },
	Click = { Id = BUILT_IN.Tick, Speed = 1.35, Volume = 0.5 },
	Hover = { Id = BUILT_IN.Tick, Speed = 1.9, Volume = 0.15 },
	Whoosh = { Id = BUILT_IN.Wind, Speed = 1.8, Volume = 0.35, Duration = 0.45, Effects = { "Bright" } },
	Pop = { Id = BUILT_IN.Boom, Speed = 2.4, Volume = 0.2, Effects = { "Bright" } },
	RevealRare = { Id = BUILT_IN.Boom, Speed = 1.6, Volume = 0.32, Effects = { "Reverb" } },
	RevealEpic = { Id = BUILT_IN.Boom, Speed = 1.2, Volume = 0.42, Effects = { "Reverb" } },
	RevealLegendary = { Id = BUILT_IN.Boom, Speed = 0.85, Volume = 0.55, Effects = { "Reverb", "Echo" } },
	RevealMythic = { Id = BUILT_IN.Boom, Speed = 0.62, Volume = 0.7, Effects = { "Reverb", "Echo", "Bass" } },
	Heartbeat = { Id = BUILT_IN.Boom, Speed = 0.33, Volume = 0.9, Effects = { "Muffle" } },
	Rumble = { Id = BUILT_IN.Wind, Speed = 0.45, Volume = 0.6, Looped = true, Effects = { "Muffle" } },
	Equip = { Id = BUILT_IN.Boom, Speed = 2, Volume = 0.18, Effects = { "Bright" } },
	Purchase = { Id = BUILT_IN.Tick, Speed = 1.5, Volume = 0.5, Effects = { "Reverb" } },
	Thud = { Id = BUILT_IN.Thud, Speed = 0.8, Volume = 0.5 },
}

-- All game sounds go through one group so we can mute them together
local group = SoundService:FindFirstChild("CosmicSFX")
if not group then
	group = Instance.new("SoundGroup")
	group.Name = "CosmicSFX"
	group.Volume = Config.MasterVolume
	group.Parent = SoundService
end
local musicGroup = SoundService:FindFirstChild("CosmicMusic")
if not musicGroup then
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "CosmicMusic"
	musicGroup.Volume = 1
	musicGroup.Parent = SoundService
end

local muted = false

local function build(name, opts)
	local preset = PRESETS[name]
	if not preset then
		warn("[SoundFX] unknown sound", name)
		return nil
	end
	opts = opts or {}

	local override = Config.SoundOverrides[name]
	local useOverride = override ~= nil and override ~= ""

	local sound = Instance.new("Sound")
	sound.Name = "SFX_" .. name
	sound.SoundId = useOverride and override or preset.Id
	sound.Volume = (useOverride and 0.5 or preset.Volume) * (opts.Volume or 1)
	sound.PlaybackSpeed = (useOverride and 1 or preset.Speed) * (opts.Speed or 1)
	sound.Looped = preset.Looped == true
	sound.SoundGroup = group

	if not useOverride and preset.Effects then
		for priority, effectName in ipairs(preset.Effects) do
			local recipe = EFFECTS[effectName]
			local effect = Instance.new(recipe.Class)
			for key, value in pairs(recipe.Props) do
				effect[key] = value
			end
			effect.Priority = priority
			effect.Parent = sound
		end
	end

	if opts.Parent then
		-- 3D sound that comes from a place in the world
		sound.RollOffMinDistance = 10
		sound.RollOffMaxDistance = opts.MaxDistance or 150
		sound.Parent = opts.Parent
	else
		sound.Parent = SoundService
	end
	return sound, preset
end

-- Play a one-shot sound. opts: { Speed = 1.2, Volume = 0.5, Parent = part }
function SoundFX.Play(name, opts)
	local sound, preset = build(name, opts)
	if not sound then
		return nil
	end
	sound:Play()
	if preset.Duration then
		task.delay(preset.Duration, function()
			if sound.Parent then
				TweenService:Create(sound, TweenInfo.new(0.15), { Volume = 0 }):Play()
			end
		end)
		Debris:AddItem(sound, preset.Duration + 0.3)
	elseif not sound.Looped then
		Debris:AddItem(sound, 8)
	end
	return sound
end

-- Start a looping sound (fades in). Stop it with SoundFX.FadeOut.
function SoundFX.Loop(name, fadeIn, opts)
	local sound = build(name, opts)
	if not sound then
		return nil
	end
	local target = sound.Volume
	sound.Looped = true
	sound.Volume = 0
	sound:Play()
	TweenService:Create(sound, TweenInfo.new(fadeIn or 0.5), { Volume = target }):Play()
	return sound
end

function SoundFX.FadeOut(sound, duration)
	if not sound then
		return
	end
	duration = duration or 0.5
	TweenService:Create(sound, TweenInfo.new(duration), { Volume = 0 }):Play()
	Debris:AddItem(sound, duration + 0.1)
end

-- Quick rising "ding ding ding" made from ticks (new best, purchases)
function SoundFX.Chime(baseSpeed, notes)
	baseSpeed = baseSpeed or 1
	notes = notes or 4
	local steps = { 1, 1.26, 1.5, 2, 2.52 } -- a major chord going up
	task.spawn(function()
		for i = 1, math.min(notes, #steps) do
			SoundFX.Play("Purchase", { Speed = baseSpeed * steps[i] / 1.5, Volume = 0.8 })
			task.wait(0.07)
		end
	end)
end

function SoundFX.SetMuted(value)
	muted = value
	group.Volume = muted and 0 or Config.MasterVolume
	musicGroup.Volume = muted and 0 or 1
end

function SoundFX.IsMuted()
	return muted
end

-- Background ambience: your music if set, otherwise a soft space hum
local ambient
function SoundFX.StartAmbient()
	if ambient then
		return
	end
	ambient = Instance.new("Sound")
	ambient.Name = "CosmicAmbient"
	ambient.Looped = true
	ambient.SoundGroup = musicGroup
	if Config.AmbientMusic ~= "" then
		ambient.SoundId = Config.AmbientMusic
		ambient.Volume = Config.AmbientVolume
	else
		ambient.SoundId = BUILT_IN.Wind
		ambient.PlaybackSpeed = 0.22
		ambient.Volume = Config.AmbientVolume * 0.35
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = 4
		eq.MidGain = -12
		eq.HighGain = -40
		eq.Parent = ambient
	end
	ambient.Parent = SoundService
	ambient:Play()
end

return SoundFX
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">UIKit</string>
        <string name="Source"><![CDATA[-- UIKit (ModuleScript in ReplicatedStorage) - used by LocalScripts only
-- Shared look + helpers for every screen in the game: colors, fonts,
-- buttons with bounce + sound, particle bursts, confetti, toasts and
-- "only one panel open at a time".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))

local UIKit = {}

UIKit.Theme = {
	Panel = Color3.fromRGB(18, 14, 34),
	PanelLight = Color3.fromRGB(34, 28, 62),
	Accent = Color3.fromRGB(150, 110, 255),
	Accent2 = Color3.fromRGB(80, 190, 255),
	Gold = Color3.fromRGB(255, 200, 70),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(190, 180, 225),
	Good = Color3.fromRGB(90, 220, 130),
	Bad = Color3.fromRGB(240, 80, 100),
}
UIKit.TitleFont = Enum.Font.FredokaOne
UIKit.BodyFont = Enum.Font.GothamBold

local THEME = UIKit.Theme
local rand = Random.new()

---------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------
function UIKit.new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = UIKit.new

function UIKit.corner(radius)
	return new("UICorner", { CornerRadius = radius or UDim.new(0, 12) })
end

-- Outline around a frame/button (named "Border" so it is easy to find)
function UIKit.stroke(color, thickness, transparency)
	return new("UIStroke", {
		Name = "Border",
		Color = color,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- Black outline around text
function UIKit.textStroke(thickness)
	return new("UIStroke", {
		Name = "TextOutline",
		Color = Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UIKit.gradient(c1, c2, rotation)
	return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 90 })
end

function UIKit.tween(inst, duration, props, style, direction)
	local tw = TweenService:Create(
		inst,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end
local tween = UIKit.tween

function UIKit.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UIKit.BodyFont,
		TextColor3 = THEME.Text,
		TextSize = 18,
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	return new("TextLabel", defaults)
end

-- Very dark colors are unreadable as text; this brightens them.
function UIKit.readable(color, minValue)
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s, math.max(v, minValue or 0.6))
end

-- Hover/press bounce + sounds for any button
function UIKit.addButtonFeel(button, noSound)
	local scale = button:FindFirstChild("FeelScale") or new("UIScale", { Name = "FeelScale", Parent = button })
	button.MouseEnter:Connect(function()
		tween(scale, 0.12, { Scale = 1.06 })
		if not noSound then
			SoundFX.Play("Hover")
		end
	end)
	button.MouseLeave:Connect(function()
		tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		tween(scale, 0.06, { Scale = 0.92 })
	end)
	button.MouseButton1Up:Connect(function()
		tween(scale, 0.18, { Scale = 1.06 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		if not noSound then
			SoundFX.Play("Click")
		end
	end)
end

-- Shrinks UI on small screens (phones). Returns the UIScale.
function UIKit.addAutoScale(guiObject, baseHeight)
	local camera = workspace.CurrentCamera
	local scale = new("UIScale", { Name = "ScreenScale", Parent = guiObject })
	local function update()
		scale.Scale = math.clamp(camera.ViewportSize.Y / (baseHeight or 820), 0.55, 1.1)
	end
	update()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	return scale
end

-- A ScreenGui for this player
function UIKit.screen(name, displayOrder)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	return new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		Parent = playerGui,
	})
end

---------------------------------------------------------------------
-- Effects layer (bursts, confetti, toasts) on top of everything
---------------------------------------------------------------------
local fxGui
local function getFxGui()
	if not fxGui or not fxGui.Parent then
		fxGui = UIKit.screen("CosmicFX", 50)
	end
	return fxGui
end

local STAR_GLYPHS = { "✦", "✧", "★", "✶" }

-- Stars and dots flying out from a point (origin in screen scale 0-1)
function UIKit.burst(colors, count, power, origin)
	local layer = getFxGui()
	origin = origin or Vector2.new(0.5, 0.4)
	power = power or 1
	for _ = 1, count do
		local angle = rand:NextNumber(0, math.pi * 2)
		local dist = rand:NextNumber(120, 380) * power
		local color = colors[rand:NextInteger(1, #colors)]
		local startPos = UDim2.fromScale(origin.X, origin.Y)
		local endPos = UDim2.new(origin.X, math.cos(angle) * dist, origin.Y, math.sin(angle) * dist)
		local duration = rand:NextNumber(0.6, 1.2)
		local piece
		if rand:NextNumber() < 0.5 then
			local size = rand:NextInteger(6, 14)
			piece = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = startPos, Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = color, BorderSizePixel = 0, Parent = layer,
			}, { UIKit.corner(UDim.new(1, 0)) })
			tween(piece, duration, { Position = endPos, Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)
		else
			piece = UIKit.label({
				AnchorPoint = Vector2.new(0.5, 0.5), Position = startPos, Size = UDim2.fromOffset(40, 40),
				Text = STAR_GLYPHS[rand:NextInteger(1, #STAR_GLYPHS)], TextColor3 = color,
				TextSize = rand:NextInteger(18, 36), Font = Enum.Font.GothamBlack,
				Rotation = rand:NextNumber(0, 360), Parent = layer,
			})
			tween(piece, duration, {
				Position = endPos, TextTransparency = 1, Rotation = piece.Rotation + rand:NextNumber(-270, 270),
			}, Enum.EasingStyle.Quart)
		end
		Debris:AddItem(piece, duration + 0.1)
	end
end

-- Confetti raining from the top of the screen
function UIKit.confetti(colors, count)
	local layer = getFxGui()
	for _ = 1, count or 60 do
		local x = rand:NextNumber(0, 1)
		local w, h = rand:NextInteger(6, 12), rand:NextInteger(10, 18)
		local piece = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(x, 0, 0, -20),
			Size = UDim2.fromOffset(w, h),
			Rotation = rand:NextNumber(0, 360),
			BackgroundColor3 = colors[rand:NextInteger(1, #colors)],
			BorderSizePixel = 0,
			Parent = layer,
		}, { UIKit.corner(UDim.new(0, 2)) })
		local duration = rand:NextNumber(1.6, 2.8)
		task.delay(rand:NextNumber(0, 0.5), function()
			tween(piece, duration, {
				Position = UDim2.new(x + rand:NextNumber(-0.15, 0.15), 0, 1, 40),
				Rotation = piece.Rotation + rand:NextNumber(-540, 540),
			}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		end)
		Debris:AddItem(piece, duration + 0.7)
	end
end

-- Little message that slides up near the bottom of the screen
local toastLabel, toastStroke, toastToken = nil, nil, 0
function UIKit.toast(text, color)
	local layer = getFxGui()
	if not toastLabel or toastLabel.Parent ~= layer then
		toastLabel = UIKit.label({
			Name = "Toast",
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -175), Size = UDim2.fromOffset(700, 34),
			Text = "", Font = UIKit.TitleFont, TextSize = 24, TextTransparency = 1, Parent = layer,
		})
		toastStroke = UIKit.textStroke(2)
		toastStroke.Transparency = 1
		toastStroke.Parent = toastLabel
	end
	toastToken += 1
	local token = toastToken
	toastLabel.Text = text
	toastLabel.TextColor3 = color or THEME.Text
	toastLabel.Position = UDim2.new(0.5, 0, 1, -150)
	toastLabel.TextTransparency = 0
	toastStroke.Transparency = 0.3
	tween(toastLabel, 0.25, { Position = UDim2.new(0.5, 0, 1, -175) }, Enum.EasingStyle.Back)
	task.delay(2.5, function()
		if token == toastToken then
			tween(toastLabel, 0.4, { TextTransparency = 1 })
			tween(toastStroke, 0.4, { Transparency = 1 })
		end
	end)
end

---------------------------------------------------------------------
-- Panels: open one and the others close
---------------------------------------------------------------------
local panelEvent = Instance.new("BindableEvent")
UIKit.PanelOpened = panelEvent.Event -- fires with the panel's name

function UIKit.announcePanel(name)
	panelEvent:Fire(name)
end

-- Pop-in animation for a panel (needs a UIScale named "PopScale")
function UIKit.popIn(guiObject)
	local pop = guiObject:FindFirstChild("PopScale") or new("UIScale", { Name = "PopScale", Parent = guiObject })
	pop.Scale = 0.8
	tween(pop, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
	SoundFX.Play("Whoosh")
end

return UIKit
]]></string>
      </Properties>
