	["Celestial"] = 0,
	["Black Hole"] = 0,
	["Galaxy"] = 0,
	["Cosmic Rift"] = 0,
	["Big Bang"] = 0,
	["Void Sovereign"] = 0,
	-- new auras (add pictures the same way)
	["Stellar Phoenix"] = 0,
	["Chronos"] = 0,
