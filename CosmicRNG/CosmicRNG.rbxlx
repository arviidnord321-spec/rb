gateText.Size = UDim2.fromScale(1, 1)
gateText.Font = Enum.Font.FredokaOne
gateText.TextScaled = true
gateText.Text = "⚔ DUEL ISLAND ⚔"
gateText.TextColor3 = Color3.fromRGB(255, 120, 120)
gateText.Parent = gateGui

