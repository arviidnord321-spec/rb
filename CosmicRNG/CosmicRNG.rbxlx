-- AUTO ROLL BUTTON
---------------------------------------------------------------------
local function ownsAutoRoll()
	return player:GetAttribute("Pass_AutoRoll") == true
end

local function updateAutoButton()
	local autoStroke = autoButton:FindFirstChild("Border")
	if not ownsAutoRoll() then
		autoButton.Text = "🔒 AUTO\n<font size='13'>Game Pass</font>"
		autoButton.BackgroundColor3 = THEME.PanelLight
		autoStroke.Color = THEME.Gold
	elseif autoRolling then
		autoButton.Text = "AUTO: ON"
		autoButton.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
		autoStroke.Color = THEME.Good
	else
		autoButton.Text = "AUTO: OFF"
		autoButton.BackgroundColor3 = THEME.PanelLight
		autoStroke.Color = THEME.Accent
	end
end

---------------------------------------------------------------------
-- RARE ROLL CUTSCENE
---------------------------------------------------------------------
local raysConnection
local function playCutscene(aura)
	local order = tierOf(aura).Order
	local duration = (order >= 7) and 3.6 or (order >= 6) and 2.8 or 2
	local color = tierOf(aura).Color

	tween(dimLayer, 0.5, { BackgroundTransparency = 0.25 })
	raysLayer.Visible = true
	for _, ray in ipairs(rays) do
		ray.BackgroundColor3 = aura.Colors[1]
		ray.BackgroundTransparency = 1
		tween(ray, 0.6, { BackgroundTransparency = 0 })
	end
	if raysConnection then
		raysConnection:Disconnect()
	end
	raysConnection = RunService.RenderStepped:Connect(function(dt)
		for i, ray in ipairs(rays) do
			ray.Rotation += dt * ((i % 2 == 0) and 25 or 40)
		end
	end)

	local rumble = SoundFX.Loop("Rumble", 0.8)

	cutsceneText.Text = (order >= 7) and "THE UNIVERSE TREMBLES..."
		or (order >= 6) and "Something MYTHIC approaches..."
		or "A LEGENDARY aura approaches..."
	cutsceneText.TextColor3 = color
	tween(cutsceneText, 0.4, { TextTransparency = 0 })
	tween(cutsceneStroke, 0.4, { Transparency = 0.3 })

	-- heartbeat: "lub-dub", getting stronger
	local beats = math.floor(duration / 0.5)
	for i = 1, beats do
		local strength = i / beats
		cutsceneScale.Scale = 1.15 + strength * 0.1
		tween(cutsceneScale, 0.35, { Scale = 1 })
		addShake(0.3 + strength * 1.2)
		UIKit.burst(aura.Colors, 6, 0.6)
		SoundFX.Play("Heartbeat", { Volume = 0.6 + strength * 0.4 })
		task.delay(0.13, function()
			SoundFX.Play("Heartbeat", { Speed = 1.15, Volume = 0.4 + strength * 0.3 })
		end)
		task.wait(0.5)
	end

	SoundFX.FadeOut(rumble, 0.6)
	tween(cutsceneText, 0.2, { TextTransparency = 1 })
	tween(cutsceneStroke, 0.2, { Transparency = 1 })
	flash(1, 0.9)
	addShake(2.5)
	tween(dimLayer, 1.2, { BackgroundTransparency = 1 })
	for _, ray in ipairs(rays) do
		tween(ray, 1.2, { BackgroundTransparency = 1 })
	end
	task.delay(1.3, function()
		if raysConnection then
			raysConnection:Disconnect()
			raysConnection = nil
		end
		raysLayer.Visible = false
	end)
end

---------------------------------------------------------------------
-- CAMERA SHOWCASE: camera circles your character to show off the aura
---------------------------------------------------------------------
local function showcase(duration)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	tween(rollBar, 0.3, { Position = UDim2.new(0.5, 0, 1, 220) })
	tween(statsPanel, 0.3, { Position = UDim2.new(0, -320, 0, 64) })

	camera.CameraType = Enum.CameraType.Scriptable
	local look = root.CFrame.LookVector
	local baseAngle = math.atan2(look.Z, look.X)
	local start = os.clock()
	local connection = RunService.RenderStepped:Connect(function()
		if not root.Parent then
			return
		end
		local alpha = math.clamp((os.clock() - start) / duration, 0, 1)
		local eased = 1 - (1 - alpha) ^ 2
		local angle = baseAngle + eased * math.pi * 1.4
		local radius = 13 - eased * 4
		local height = 2.5 + math.sin(alpha * math.pi) * 2.5
		local focus = root.Position + Vector3.new(0, 1, 0)
		camera.CFrame = CFrame.lookAt(focus + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius), focus)
	end)
	task.wait(duration)
	connection:Disconnect()
	camera.CameraType = Enum.CameraType.Custom

	tween(rollBar, 0.4, { Position = UDim2.new(0.5, 0, 1, -20) }, Enum.EasingStyle.Back)
	tween(statsPanel, 0.4, { Position = UDim2.new(0, 16, 0, 64) }, Enum.EasingStyle.Back)
end

---------------------------------------------------------------------
-- ROLL ANIMATION
---------------------------------------------------------------------
local function revealSoundFor(order)
	if order >= 6 then
		return "RevealMythic"
	elseif order == 5 then
		return "RevealLegendary"
	elseif order == 4 then
		return "RevealEpic"
	elseif order == 3 then
		return "RevealRare"
	end
	return "Pop"
end

local function playRollAnimation(result, fast)
	local final = AuraData.Get(result.Aura)
	local order = tierOf(final).Order

	reveal.Visible = true
	reveal.Position = UDim2.fromScale(0.5, 0.4)
	badgeLabel.Visible = false
	clearExtras()
	setRevealVisible(true)
	popScale.Scale = 0.6
	tween(popScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)

	if result.Lucky then
		UIKit.toast("✨ LUCKY ROLL! x" .. Luck.Format(Config.LuckyRollMultiplier) .. " luck", THEME.Gold)
	end

	-- 1) Spin through random auras, slowing down at the end
	local steps = fast and 7 or 16
	local showLuck = math.max(result.Luck or 1, 1) * 40 -- show exciting names while spinning
	for i = 1, steps do
		local progress = i / steps
		local fake = AuraData.RollRandom(showLuck, rand)
		setRevealAura(fake)
		popScale.Scale = 1.1
		tween(popScale, 0.08, { Scale = 1 })
		imageScale.Scale = 0.9
		tween(imageScale, 0.08, { Scale = 1 })
		nameLabel.Rotation = rand:NextNumber(-3, 3)
		SoundFX.Play("Tick", { Speed = 0.85 + progress * 0.9 })
		task.wait((fast and 0.03 or 0.04) + progress ^ 3 * (fast and 0.12 or 0.28))
	end
	nameLabel.Rotation = 0

	-- 2) Big rolls get a cutscene first
	if final.Chance >= Config.CutsceneAtChance then
		setRevealVisible(false)
		playCutscene(final)
		setRevealVisible(true)
	end

	-- 3) REVEAL
	setRevealAura(final)
	RevealRemote:FireServer() -- everyone nearby sees the 3D reveal effect
	popScale.Scale = 1.7
	tween(popScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	nameLabel.Rotation = -8
	tween(nameLabel, 0.8, { Rotation = 0 }, Enum.EasingStyle.Elastic)
	cardBorder.Thickness = 8
	tween(cardBorder, 0.6, { Thickness = 3 })
	if auraImage.Visible then
		imageScale.Scale = 0.3
		auraImage.Rotation = -25
		tween(imageScale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
		tween(auraImage, 0.9, { Rotation = 0 }, Enum.EasingStyle.Elastic)
		imageGlow.Size = UDim2.fromOffset(IMAGE_SIZE + 140, IMAGE_SIZE + 140)
		imageGlow.BackgroundTransparency = 0.2
		tween(imageGlow, 0.7, { Size = UDim2.fromOffset(IMAGE_SIZE + 40, IMAGE_SIZE + 40), BackgroundTransparency = 0.6 }, Enum.EasingStyle.Quint)
	end
	shine.Position = UDim2.fromScale(-0.2, 0.5)
	tween(shine, 0.7, { Position = UDim2.fromScale(1.2, 0.5) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

	local colors = { final.Colors[1], final.Colors[2], tierOf(final).Color }
	UIKit.burst(colors, 10 + order * 8, 0.7 + order * 0.15)
	SoundFX.Play(revealSoundFor(order))
	if order >= 3 then
		flash(math.min(0.15 + order * 0.08, 0.7), 0.4)
		addShake(0.2 + order * 0.2)
		fovPunch(order * 1.5)
	end

	if result.IsNewBest and data.Rolls > 1 then
		badgeLabel.Text = "★ NEW BEST! ★"
		badgeLabel.BackgroundColor3 = THEME.Gold
		badgeLabel.Visible = true
		UIKit.confetti(colors, 70)
		SoundFX.Chime(1, 5)
	elseif result.IsFirstTime then
		badgeLabel.Text = "NEW!"
		badgeLabel.BackgroundColor3 = THEME.Good
		badgeLabel.Visible = true
		SoundFX.Chime(1.2, 3)
	end
	if badgeLabel.Visible then
		badgeScale.Scale = 0
		tween(badgeScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	if result.Results and #result.Results > 1 then
		local extras = {}
		for i = 2, #result.Results do
			table.insert(extras, result.Results[i])
		end
		showExtras(extras)
	end

	-- 4) Hold, maybe show off with the camera, then float away
	local doShowcase = final.Chance >= Config.ShowcaseAtChance and (not fast or final.Chance >= 100000)
	task.wait(fast and 0.6 or (1.2 + order * 0.15))
	if doShowcase then
		tween(reveal, 0.35, { Position = UDim2.fromScale(0.5, 0.14) })
		tween(popScale, 0.35, { Scale = 0.55 })
		showcase(2.8)
	end
	badgeLabel.Visible = false
	tween(reveal, 0.35, { Position = UDim2.fromScale(0.5, 0.34) })
	setRevealVisible(false, 0.35)
	for _, chip in ipairs(extrasRow:GetChildren()) do
		if chip:IsA("TextLabel") then
			tween(chip, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
		end
	end
	task.wait(0.35)
	reveal.Visible = false
	clearExtras()
end

---------------------------------------------------------------------
-- ROLLING
---------------------------------------------------------------------
local function setRollingLook(isRolling)
	if isRolling then
		rollButton.Text = autoRolling and "AUTO" or "..."
		tween(rollButton, 0.15, { TextTransparency = 0.3 })
	else
		rollButton.Text = "ROLL"
		tween(rollButton, 0.15, { TextTransparency = 0 })
	end
end

local function doRoll(fast)
	if rolling then
		return
	end
	rolling = true
	setRollingLook(true)

	local ok, result = pcall(function()
		return RollRemote:InvokeServer()
	end)
	if not ok or type(result) ~= "table" or result.Error then
		rolling = false
		setRollingLook(false)
		if ok and type(result) == "table" and result.Error == "Loading" then
			UIKit.toast("Loading your data...", THEME.SubText)
		elseif ok and type(result) == "table" and result.Error == "InDuel" then
			UIKit.toast("You can't roll during a duel!", THEME.Bad)
		end
		task.wait(0.2)
		return
	end

	data.Rolls = result.Rolls
	data.Inventory = result.Inventory or data.Inventory
	updateInfo()

	playRollAnimation(result, fast)

	-- Equip automatically when you beat your best aura
	local final = AuraData.Get(result.Aura)
	if result.IsNewBest or data.Equipped == "" then
		data.Equipped = final.Name
		EquipRemote:FireServer(final.Name)
	end
	if final.Chance > data.BestChance then
		data.BestChance = final.Chance
	end

	updateStats()
	if inventoryOpen then
		refreshInventory()
	end
	rolling = false
	setRollingLook(false)
end

rollButton.Activated:Connect(function()
	if not autoRolling then
		doRoll(false)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.R and not autoRolling then
		doRoll(false)
	end
end)

autoButton.Activated:Connect(function()
	if not ownsAutoRoll() then
		local passId = Config.GamePasses.AutoRoll
		if passId and passId ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, passId)
		else
			UIKit.toast("Auto Roll pass not set up yet (CosmicConfig)", THEME.Bad)
		end
		return
	end
	autoRolling = not autoRolling
	updateAutoButton()
	if autoRolling then
		task.spawn(function()
			while autoRolling and ownsAutoRoll() do
				doRoll(true)
				task.wait(0.05)
			end
			autoRolling = false
			updateAutoButton()
		end)
	end
end)

player:GetAttributeChangedSignal("Pass_AutoRoll"):Connect(updateAutoButton)

-- Duels: hide the roll bar and pause auto roll while fighting
player:GetAttributeChangedSignal("InDuel"):Connect(function()
	if player:GetAttribute("InDuel") then
		autoRolling = false
		updateAutoButton()
		setInventoryOpen(false)
		tween(rollBar, 0.35, { Position = UDim2.new(0.5, 0, 1, 220) })
		tween(statsPanel, 0.35, { Position = UDim2.new(0, -320, 0, 64) })
	else
		tween(rollBar, 0.5, { Position = UDim2.new(0.5, 0, 1, -20) }, Enum.EasingStyle.Back)
		tween(statsPanel, 0.5, { Position = UDim2.new(0, 16, 0, 64) }, Enum.EasingStyle.Back)
	end
end)

-- Shimmer + breathing glow on the roll button
task.spawn(function()
	while rollButton.Parent do
		rollGradient.Offset = Vector2.new(-1, 0)
		tween(rollGradient, 2.2, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		tween(rollGlow, 1.1, { BackgroundTransparency = 0.45, Size = UDim2.fromOffset(262, 98) }, Enum.EasingStyle.Sine)
		task.wait(1.1)
		tween(rollGlow, 1.1, { BackgroundTransparency = 0.75, Size = UDim2.fromOffset(250, 92) }, Enum.EasingStyle.Sine)
		task.wait(1.1)
		tween(rollGradient, 2.2, { Offset = Vector2.new(-1, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		tween(rollGlow, 1.1, { BackgroundTransparency = 0.45, Size = UDim2.fromOffset(262, 98) }, Enum.EasingStyle.Sine)
		task.wait(1.1)
		tween(rollGlow, 1.1, { BackgroundTransparency = 0.75, Size = UDim2.fromOffset(250, 92) }, Enum.EasingStyle.Sine)
		task.wait(1.1)
	end
end)

---------------------------------------------------------------------
-- INVENTORY PANEL
---------------------------------------------------------------------
local inventoryHolder = new("Frame", {
	Name = "InventoryHolder",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.47),
	Size = UDim2.fromOffset(680, 470),
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 8,
	Parent = gui,
})
UIKit.addAutoScale(inventoryHolder, 760)
local inventory = new("Frame", {
	Name = "Inventory",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = THEME.Panel,
	BackgroundTransparency = 0.05,
	ZIndex = 8,
	Parent = inventoryHolder,
}, { corner(UDim.new(0, 18)), stroke(THEME.Accent, 2.5, 0) })

label({
	Position = UDim2.fromOffset(22, 12), Size = UDim2.new(1, -44, 0, 40), Text = "✦ YOUR AURAS",
	Font = TITLE_FONT, TextSize = 32, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = inventory,
})
local discoveredLabel = label({
	Position = UDim2.fromOffset(22, 50), Size = UDim2.new(1, -44, 0, 22), Text = "",
	TextSize = 15, TextColor3 = THEME.SubText, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = inventory,
})
local closeButton = new("TextButton", {
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(42, 42),
	BackgroundColor3 = THEME.Bad, Text = "X", Font = TITLE_FONT, TextSize = 24, TextColor3 = THEME.Text,
	AutoButtonColor = false, ZIndex = 8, Parent = inventory,
}, { corner(UDim.new(0, 10)), textStroke(1.5) })
UIKit.addButtonFeel(closeButton)

local list = new("ScrollingFrame", {
	Position = UDim2.fromOffset(16, 82), Size = UDim2.new(1, -32, 1, -98),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
	ScrollBarImageColor3 = THEME.Accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ZIndex = 8, Parent = inventory,
}, {
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(200, 214), CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center,
	}),
	new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }),
})

local function buildCard(aura, count, index, animate)
	local owned = count > 0
	local tier = tierOf(aura)
	local equipped = data.Equipped == aura.Name

	local cardFrame = new("Frame", {
		Name = aura.Name,
		BackgroundColor3 = THEME.PanelLight,
		LayoutOrder = -aura.Chance, -- rarest first
		ZIndex = 8,
		Parent = list,
	}, { corner(UDim.new(0, 12)), stroke(equipped and THEME.Good or tier.Color, equipped and 3 or 1.5, owned and 0 or 0.6) })
	local cardScale = new("UIScale", { Parent = cardFrame })
	if animate then
		cardScale.Scale = 0.6
		task.delay(index * 0.015, function()
			tween(cardScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
	cardFrame.MouseEnter:Connect(function()
		tween(cardScale, 0.12, { Scale = 1.04 })
	end)
	cardFrame.MouseLeave:Connect(function()
		tween(cardScale, 0.12, { Scale = 1 })
	end)

	-- picture (or a placeholder) in the top-left corner
	local image = AuraData.GetImage(aura.Name)
	local thumb
	if owned and image then
		thumb = new("ImageLabel", {
			Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(58, 58),
			BackgroundColor3 = THEME.Panel, Image = image, ScaleType = Enum.ScaleType.Crop,
			ZIndex = 8, Parent = cardFrame,
		}, { corner(UDim.new(0, 10)) })
	else
		thumb = new("Frame", {
			Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(58, 58),
			BackgroundColor3 = owned and Color3.new(1, 1, 1) or Color3.fromRGB(24, 20, 44),
			ZIndex = 8, Parent = cardFrame,
		}, { corner(UDim.new(0, 10)) })
		if owned then
			UIKit.gradient(aura.Colors[1], aura.Colors[2], 45).Parent = thumb
		end
		label({
			Size = UDim2.fromScale(1, 1), Text = owned and "✦" or "?", Font = TITLE_FONT, TextSize = 30,
			TextColor3 = owned and Color3.new(1, 1, 1) or Color3.fromRGB(110, 100, 140), ZIndex = 8, Parent = thumb,
		})
	end
	stroke(tier.Color, 2, owned and 0 or 0.6).Parent = thumb

	local nameText = label({
		Position = UDim2.fromOffset(76, 10), Size = UDim2.new(1, -86, 0, 24),
		Text = owned and aura.Name or "???", Font = TITLE_FONT, TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
	})
	new("UITextSizeConstraint", { MaxTextSize = 20, Parent = nameText })
	if owned then
		UIKit.gradient(UIKit.readable(aura.Colors[1]), UIKit.readable(aura.Colors[2]), 0).Parent = nameText
	else
		nameText.TextColor3 = Color3.fromRGB(110, 100, 140)
	end

	local tierText = label({
		Position = UDim2.fromOffset(76, 36), Size = UDim2.new(1, -86, 0, 14),
		Text = aura.Tier, TextScaled = true, TextColor3 = tier.Color,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
	})
	new("UITextSizeConstraint", { MaxTextSize = 13, Parent = tierText })
	local chanceText = label({
		Position = UDim2.fromOffset(76, 52), Size = UDim2.new(1, -86, 0, 14),
		Text = AuraData.FormatChance(aura.Chance) .. (owned and ("  •  x" .. AuraData.FormatNumber(count)) or ""),
		TextScaled = true, TextColor3 = THEME.SubText,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
	})
	new("UITextSizeConstraint", { MaxTextSize = 12, Parent = chanceText })

	if owned then
		label({
			Position = UDim2.fromOffset(10, 78), Size = UDim2.new(1, -20, 0, 18),
			Text = ("⚡ %s"):format(aura.Power.Name), TextSize = 14, TextColor3 = Color3.fromRGB(255, 220, 120),
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
		})
		label({
			Position = UDim2.fromOffset(10, 96), Size = UDim2.new(1, -20, 0, 34),
			Text = aura.Power.Description, TextSize = 12, Font = Enum.Font.Gotham, TextWrapped = true,
			TextColor3 = THEME.SubText, TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 8, Parent = cardFrame,
		})
		label({
			Position = UDim2.fromOffset(10, 132), Size = UDim2.new(1, -20, 0, 16),
			Text = ("❤ %d HP   ⚔ %d DMG"):format(tier.MaxHealth, tier.AttackDamage),
			TextSize = 12, TextColor3 = Color3.fromRGB(255, 150, 160),
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
		})

		local equipButton = new("TextButton", {
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -20, 0, 34),
			BackgroundColor3 = equipped and THEME.Good or THEME.Accent, AutoButtonColor = false,
			Text = equipped and "EQUIPPED" or "EQUIP", Font = TITLE_FONT, TextSize = 18,
			TextColor3 = THEME.Text, ZIndex = 8, Parent = cardFrame,
		}, { corner(UDim.new(0, 8)), textStroke(1.2) })
		UIKit.addButtonFeel(equipButton, true)
		equipButton.Activated:Connect(function()
			if data.Equipped ~= aura.Name then
				data.Equipped = aura.Name
				EquipRemote:FireServer(aura.Name)
				SoundFX.Play("Equip")
				UIKit.burst({ aura.Colors[1], aura.Colors[2] }, 14, 0.5, Vector2.new(0.5, 0.5))
				refreshInventory(false)
			end
		end)
	else
		label({
			Position = UDim2.fromOffset(10, 90), Size = UDim2.new(1, -20, 0, 60),
			Text = "Not discovered yet.\nKeep rolling!", TextSize = 14, Font = Enum.Font.Gotham,
			TextColor3 = Color3.fromRGB(130, 120, 160), TextWrapped = true, ZIndex = 8, Parent = cardFrame,
		})
	end
end

refreshInventory = function(animate)
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local discovered = 0
	for index, aura in ipairs(AuraData.List) do
		local count = data.Inventory[aura.Name] or 0
		if count > 0 then
			discovered += 1
		end
		buildCard(aura, count, #AuraData.List - index, animate)
	end
	discoveredLabel.Text = ("Discovered %d / %d auras  •  Rarer auras = stronger duel powers"):format(
		discovered, #AuraData.List)
end

setInventoryOpen = function(open)
	if open == inventoryOpen then
		return
	end
	inventoryOpen = open
	if open then
		UIKit.announcePanel("Inventory")
		refreshInventory(true)
		inventoryHolder.Visible = true
		UIKit.popIn(inventory)
	else
		inventoryHolder.Visible = false
	end
end

aurasButton.Activated:Connect(function()
	setInventoryOpen(not inventoryOpen)
end)
closeButton.Activated:Connect(function()
	setInventoryOpen(false)
end)
UIKit.PanelOpened:Connect(function(name)
	if name ~= "Inventory" then
		setInventoryOpen(false)
	end
end)

---------------------------------------------------------------------
-- ANNOUNCEMENTS
---------------------------------------------------------------------
local bannerToken = 0
local function showBanner(message, color, image)
	bannerIcon.Visible = image ~= nil
	bannerIcon.Image = image or ""
	bannerLabel.Position = UDim2.fromOffset(image and 58 or 10, 0)
	bannerLabel.Size = UDim2.new(1, image and -68 or -20, 1, 0)
	bannerToken += 1
	local token = bannerToken
	bannerLabel.Text = message
	bannerStroke.Color = color
	banner.Position = UDim2.new(0.5, 0, 0, -90)
	tween(banner, 0.5, { Position = UDim2.new(0.5, 0, 0, 70) }, Enum.EasingStyle.Back)
	task.delay(5, function()
		if token == bannerToken then
			tween(banner, 0.4, { Position = UDim2.new(0.5, 0, 0, -90) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general then
			general:DisplaySystemMessage(message)
		end
	end)
end

local function skyShift(aura)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	local colorFx = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	if atmosphere then
		local oldColor, oldDecay = atmosphere.Color, atmosphere.Decay
		tween(atmosphere, 1.5, { Color = aura.Colors[2], Decay = aura.Colors[1] })
		task.delay(10, function()
			tween(atmosphere, 3, { Color = oldColor, Decay = oldDecay })
		end)
	end
	if colorFx then
		local oldTint = colorFx.TintColor
		tween(colorFx, 1.5, { TintColor = aura.Colors[2]:Lerp(Color3.new(1, 1, 1), 0.6) })
		task.delay(10, function()
			tween(colorFx, 3, { TintColor = oldTint })
		end)
	end
	flash(0.8, 1.5)
	addShake(1.5)
end

AnnounceRemote.OnClientEvent:Connect(function(info)
	if info.Type == "Duel" then
		local aura = AuraData.Get(info.WinnerAura or "")
		showBanner(("⚔ <b>%s</b> defeated <b>%s</b> in a duel%s!"):format(
			info.Winner, info.Loser, aura and (" with <font color='#" .. tierOf(aura).Color:ToHex() .. "'>" .. aura.Name .. "</font>") or ""),
			Color3.fromRGB(255, 90, 100), aura and AuraData.GetImage(aura.Name) or nil)
		SoundFX.Play("Pop", { Volume = 0.7 })
		return
	end
	if info.Type == "ServerLuck" then
		showBanner(("🌌 <b>%s</b> activated <font color='#ffd76a'><b>SERVER LUCK</b></font>! x%s luck for everyone!"):format(
			info.PlayerName, Luck.Format(Config.LuckMultipliers.ServerBoost)), THEME.Gold)
		UIKit.confetti({ THEME.Gold, THEME.Accent, THEME.Accent2 }, 80)
		SoundFX.Chime(1, 5)
		return
	end

	local aura = AuraData.Get(info.Aura)
	if not aura then
		return
	end
	local hex = tierOf(aura).Color:ToHex()
	showBanner(("✦ <b>%s</b> rolled <font color='#%s'><b>%s</b></font> (%s) ✦"):format(
		info.PlayerName, hex, aura.Name, AuraData.FormatChance(aura.Chance)), tierOf(aura).Color, AuraData.GetImage(aura.Name))
	if info.UserId ~= player.UserId then
		SoundFX.Play("Pop", { Volume = 0.7 })
	end
	if aura.Chance >= Config.SkyShiftAtChance then
		skyShift(aura)
	end
end)

---------------------------------------------------------------------
-- DATA SYNC
---------------------------------------------------------------------
DataUpdatedRemote.OnClientEvent:Connect(function(snapshot)
	data = snapshot
	updateStats()
	if inventoryOpen then
		refreshInventory(false)
	end
end)

updateAutoButton()
updateStats()

---------------------------------------------------------------------
-- INTRO: title card, then the UI slides in
---------------------------------------------------------------------
local function playIntro()
	rollBar.Position = UDim2.new(0.5, 0, 1, 220)
	statsPanel.Position = UDim2.new(0, -320, 0, 64)

	local holder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(800, 200),
		BackgroundTransparency = 1, ZIndex = 9, Parent = gui,
	})
	UIKit.addAutoScale(holder)
	local title = label({
		Size = UDim2.new(1, 0, 0, 130), Text = "COSMIC RNG", Font = TITLE_FONT, TextSize = 120, ZIndex = 9, Parent = holder,
	})
	textStroke(5).Parent = title
	local titleGradient = UIKit.gradient(Color3.fromRGB(190, 140, 255), Color3.fromRGB(90, 220, 255), 0)
	titleGradient.Parent = title
	local subtitle = label({
		Position = UDim2.fromOffset(0, 130), Size = UDim2.new(1, 0, 0, 40), Text = "roll the universe",
		Font = TITLE_FONT, TextSize = 32, TextColor3 = THEME.SubText, TextTransparency = 1, ZIndex = 9, Parent = holder,
	})
	local titleScale = new("UIScale", { Scale = 0.3, Parent = title })

	tween(titleScale, 0.8, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(titleGradient, 2.5, { Rotation = 360 }, Enum.EasingStyle.Linear)
	SoundFX.Play("RevealEpic", { Volume = 0.6 })
	UIKit.burst({ Color3.fromRGB(190, 140, 255), Color3.fromRGB(90, 220, 255), Color3.new(1, 1, 1) }, 40, 1.2, Vector2.new(0.5, 0.42))
	task.wait(0.5)
	tween(subtitle, 0.6, { TextTransparency = 0 })
	task.wait(1.6)
	tween(title, 0.5, { TextTransparency = 1 })
	tween(title:FindFirstChild("TextOutline"), 0.5, { Transparency = 1 })
	tween(subtitle, 0.5, { TextTransparency = 1 })
	tween(titleScale, 0.5, { Scale = 1.3 })
	SoundFX.Play("Whoosh")
	tween(rollBar, 0.6, { Position = UDim2.new(0.5, 0, 1, -20) }, Enum.EasingStyle.Back)
	tween(statsPanel, 0.6, { Position = UDim2.new(0, 16, 0, 64) }, Enum.EasingStyle.Back)
	task.wait(0.6)
	holder:Destroy()
end

task.spawn(function()
	local introOk, introError = pcall(playIntro)
	if not introOk then
		warn("[RollUI] intro failed:", introError)
		rollBar.Position = UDim2.new(0.5, 0, 1, -20)
		statsPanel.Position = UDim2.new(0, 16, 0, 64)
	end
	for _ = 1, 30 do
		local ok, snapshot = pcall(function()
			return GetDataRemote:InvokeServer()
		end)
		if ok and snapshot then
			data = snapshot
			updateStats()
			if data.Rolls == 0 then
				UIKit.toast("Press ROLL (or R) to discover your first aura!", THEME.Accent2)
			end
			return
		end
		task.wait(1)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="22">
        <Properties>
          <string name="Name">StoreUI</string>
          <string name="Source"><![CDATA[-- StoreUI (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Side menu (Store + Sound on/off) and the Store panel that sells
-- game passes and luck boosts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local Luck = require(ReplicatedStorage:WaitForChild("Luck"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local TestProductRemote = remotes:WaitForChild("TestProduct")

local player = Players.LocalPlayer
local THEME = UIKit.Theme
local TITLE_FONT = UIKit.TitleFont
local new, corner, stroke, textStroke, tween, label =
	UIKit.new, UIKit.corner, UIKit.stroke, UIKit.textStroke, UIKit.tween, UIKit.label

local gui = UIKit.screen("CosmicMenu", 1)

---------------------------------------------------------------------
-- SIDE MENU (left middle of the screen)
---------------------------------------------------------------------
local menu = new("Frame", {
	Name = "SideMenu",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 16, 0.5, 0),
	Size = UDim2.fromOffset(84, 190),
	BackgroundTransparency = 1,
	Parent = gui,
}, {
	new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }),
})
UIKit.addAutoScale(menu)

local function menuButton(order, icon, text, color)
	local button = new("TextButton", {
		Name = text,
		LayoutOrder = order,
		Size = UDim2.fromOffset(84, 84),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.1,
		AutoButtonColor = false,
		Text = "",
		Parent = menu,
	}, { corner(UDim.new(0, 18)), stroke(color, 2.5, 0) })
	local iconLabel = label({
		Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 6), Text = icon, TextSize = 38, Parent = button,
	})
	local textLabel = label({
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -6), Size = UDim2.new(1, 0, 0, 20),
		Text = text, Font = TITLE_FONT, TextSize = 16, Parent = button,
	})
	textStroke(1.2).Parent = textLabel
	UIKit.addButtonFeel(button)
	return button, iconLabel, textLabel
end

local storeButton, storeIcon = menuButton(1, "🛒", "STORE", THEME.Gold)
local soundButton, soundIcon, soundText = menuButton(2, "🔊", "SOUND", THEME.Accent2)

-- the store icon gently wiggles to draw attention
task.spawn(function()
	while storeIcon.Parent do
		task.wait(4)
		tween(storeIcon, 0.12, { Rotation = -14 })
		task.wait(0.12)
		tween(storeIcon, 0.12, { Rotation = 14 })
		task.wait(0.12)
		tween(storeIcon, 0.3, { Rotation = 0 }, Enum.EasingStyle.Elastic)
	end
end)

soundButton.Activated:Connect(function()
	local muted = not SoundFX.IsMuted()
	SoundFX.SetMuted(muted)
	soundIcon.Text = muted and "🔇" or "🔊"
	soundText.Text = muted and "MUTED" or "SOUND"
end)

---------------------------------------------------------------------
-- STORE PANEL
---------------------------------------------------------------------
local holder = new("Frame", {
	Name = "StoreHolder",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.47),
	Size = UDim2.fromOffset(640, 500),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})
UIKit.addAutoScale(holder, 780)

local panel = new("Frame", {
	Name = "Store",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = THEME.Panel,
	BackgroundTransparency = 0.05,
	Parent = holder,
}, { corner(UDim.new(0, 18)), stroke(THEME.Gold, 2.5, 0) })

local titleLabel = label({
	Position = UDim2.fromOffset(22, 12), Size = UDim2.new(1, -44, 0, 40), Text = "🛒 COSMIC STORE",
	Font = TITLE_FONT, TextSize = 32, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
UIKit.gradient(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 150, 80), 0).Parent = titleLabel
label({
	Position = UDim2.fromOffset(22, 50), Size = UDim2.new(1, -44, 0, 22),
	Text = "Passes are forever • Boosts stack their time", TextSize = 15, TextColor3 = THEME.SubText,
	TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
local closeButton = new("TextButton", {
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(42, 42),
	BackgroundColor3 = THEME.Bad, Text = "X", Font = TITLE_FONT, TextSize = 24, TextColor3 = THEME.Text,
	AutoButtonColor = false, Parent = panel,
}, { corner(UDim.new(0, 10)), textStroke(1.5) })
UIKit.addButtonFeel(closeButton)

local list = new("ScrollingFrame", {
	Position = UDim2.fromOffset(16, 84), Size = UDim2.new(1, -32, 1, -100),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
	ScrollBarImageColor3 = THEME.Gold, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	Parent = panel,
}, {
	new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
})

local function sectionTitle(order, text)
	local t = label({
		LayoutOrder = order, Size = UDim2.new(1, 0, 0, 30), Text = text, Font = TITLE_FONT, TextSize = 22,
		TextColor3 = THEME.Gold, TextXAlignment = Enum.TextXAlignment.Left, Parent = list,
	})
	textStroke(1.5).Parent = t
end

-- Prices are looked up once and remembered
local priceCache = {}
local function fetchPrice(id, infoType, priceLabel)
	if id == 0 then
		priceLabel.Text = "Set ID"
		return
	end
	local cacheKey = tostring(infoType) .. id
	if priceCache[cacheKey] then
		priceLabel.Text = priceCache[cacheKey]
		return
	end
	priceLabel.Text = "..."
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(id, infoType)
		end)
		local text = (ok and info and info.PriceInRobux) and ("R$ " .. info.PriceInRobux) or "R$ ?"
		priceCache[cacheKey] = text
		priceLabel.Text = text
	end)
end

local itemRefreshers = {}

local function itemRow(order, item, kind)
	local row = new("Frame", {
		Name = item.Key,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 86),
		BackgroundColor3 = THEME.PanelLight,
		Parent = list,
	}, { corner(UDim.new(0, 14)), stroke(THEME.Accent, 1.5, 0.4) })
	local rowScale = new("UIScale", { Parent = row })
	row.MouseEnter:Connect(function()
		tween(rowScale, 0.12, { Scale = 1.02 })
	end)
	row.MouseLeave:Connect(function()
		tween(rowScale, 0.12, { Scale = 1 })
	end)

	local icon = label({
		Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(70, 86), Text = item.Icon, TextSize = 44, Parent = row,
	})
	label({
		Position = UDim2.fromOffset(86, 12), Size = UDim2.new(1, -250, 0, 28), Text = item.Name, Font = TITLE_FONT,
		TextSize = 24, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local desc = label({
		Position = UDim2.fromOffset(86, 40), Size = UDim2.new(1, -250, 0, 38), Text = item.Description,
		Font = Enum.Font.Gotham, TextSize = 14, TextWrapped = true, TextColor3 = THEME.SubText,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = row,
	})

	local buyButton = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(140, 50),
		BackgroundColor3 = THEME.Good, AutoButtonColor = false, Text = "", Font = TITLE_FONT, TextSize = 22,
		TextColor3 = THEME.Text, Parent = row,
	}, { corner(UDim.new(0, 12)), textStroke(1.5) })
	UIKit.addButtonFeel(buyButton, true)

	local id = (kind == "Pass") and Config.GamePasses[item.Key] or Config.Products[item.Key]
	local infoType = (kind == "Pass") and Enum.InfoType.GamePass or Enum.InfoType.Product

	local function refresh()
		if kind == "Pass" and player:GetAttribute("Pass_" .. item.Key) then
			buyButton.Text = "OWNED ✓"
			buyButton.BackgroundColor3 = Color3.fromRGB(60, 70, 90)
			row:FindFirstChild("Border").Color = THEME.Good
			return
		end
		buyButton.BackgroundColor3 = THEME.Good
		fetchPrice(id, infoType, buyButton)
		if kind == "Product" then
			-- show the remaining time of an active boost
			local endsAt = (item.Key == "PersonalLuck") and (player:GetAttribute("PersonalLuckEnd") or 0)
				or (ReplicatedStorage:GetAttribute("ServerLuckEnd") or 0)
			local left = endsAt - Luck.Now()
			if left > 0 then
				desc.Text = item.Description .. "\n<font color='#ffd76a'>Active: " .. Luck.FormatTime(left) .. " left</font>"
				desc.RichText = true
			else
				desc.Text = item.Description
			end
		end
	end
	itemRefreshers[item.Key] = refresh
	refresh()

	buyButton.Activated:Connect(function()
		if kind == "Pass" and player:GetAttribute("Pass_" .. item.Key) then
			return
		end
		SoundFX.Play("Click")
		if id == 0 then
			if kind == "Product" and RunService:IsStudio() and Config.FreePassesInStudio then
				-- Studio test: free boost
				TestProductRemote:FireServer(item.Key)
				SoundFX.Chime(1, 4)
				UIKit.toast("Studio test: " .. item.Name .. " activated!", THEME.Gold)
			else
				UIKit.toast("Put the " .. kind .. " ID for " .. item.Name .. " in CosmicConfig", THEME.Bad)
			end
			return
		end
		if kind == "Pass" then
			MarketplaceService:PromptGamePassPurchase(player, id)
		else
			MarketplaceService:PromptProductPurchase(player, id)
		end
	end)

	-- bounce the icon now and then
	task.spawn(function()
		task.wait(order * 0.3)
		while icon.Parent do
			tween(icon, 0.25, { Rotation = -10 })
			task.wait(0.25)
			tween(icon, 0.5, { Rotation = 0 }, Enum.EasingStyle.Elastic)
			task.wait(3 + order * 0.2)
		end
	end)
end

sectionTitle(0, "✦ GAME PASSES")
for i, item in ipairs(Config.PassInfo) do
	itemRow(i, item, "Pass")
end
sectionTitle(100, "✦ BOOSTS")
for i, item in ipairs(Config.ProductInfo) do
	itemRow(100 + i, item, "Product")
end

local function refreshAll()
	for _, refresh in pairs(itemRefreshers) do
		refresh()
	end
end

-- Update when passes/boosts change
for key in pairs(Config.GamePasses) do
	player:GetAttributeChangedSignal("Pass_" .. key):Connect(function()
		refreshAll()
		if player:GetAttribute("Pass_" .. key) and holder.Visible then
			SoundFX.Chime(1, 5)
			UIKit.confetti({ THEME.Gold, THEME.Accent, THEME.Good }, 60)
		end
	end)
end
player:GetAttributeChangedSignal("PersonalLuckEnd"):Connect(refreshAll)
ReplicatedStorage:GetAttributeChangedSignal("ServerLuckEnd"):Connect(refreshAll)

---------------------------------------------------------------------
-- Open / close
---------------------------------------------------------------------
local open = false
local function setOpen(value)
	if value == open then
		return
	end
	open = value
	if open then
		UIKit.announcePanel("Store")
		refreshAll()
		holder.Visible = true
		UIKit.popIn(panel)
	else
		holder.Visible = false
	end
end

storeButton.Activated:Connect(function()
	setOpen(not open)
end)
closeButton.Activated:Connect(function()
	setOpen(false)
end)
UIKit.PanelOpened:Connect(function(name)
	if name ~= "Store" then
		setOpen(false)
	end
end)

-- keep boost timers ticking while the store is open
task.spawn(function()
	while gui.Parent do
		task.wait(1)
		if open then
			for _, item in ipairs(Config.ProductInfo) do
				itemRefreshers[item.Key]()
			end
		end
	end
end)

-- Purchase feedback
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, _, purchased)
	if userId == player.UserId and purchased then
		SoundFX.Chime(1, 5)
		UIKit.confetti({ THEME.Gold, THEME.Accent2, THEME.Good }, 50)
		UIKit.toast("Thank you! Boost activated 🍀", THEME.Gold)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="23">
        <Properties>
          <string name="Name">WorldFX</string>
          <string name="Source"><![CDATA[-- WorldFX (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Brings the map to life on each player's screen: spinning core rings,
-- bobbing crystals, spinning gems, shooting stars, ambience, the Lucky Isle
-- portals and the pink + gold sky on Lucky Isle.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local rand = Random.new()

SoundFX.StartAmbient()

local island = workspace:WaitForChild("CosmicIsland", 60)
if not island then
	warn("[WorldFX] CosmicIsland not found")
	return
end

---------------------------------------------------------------------
-- Collect everything we animate (remembering where it started)
---------------------------------------------------------------------
local core = island:WaitForChild("CosmicCore", 10)
local orb = core and core:FindFirstChild("CoreOrb")
local orbShell = core and core:FindFirstChild("CoreOrbShell")
local rings = {}
if core then
	for i = 1, 3 do
		local ring = core:FindFirstChild("CoreRing" .. i)
		if ring then
			table.insert(rings, ring)
		end
	end
end
local orbPosition = orb and orb.Position

local floaters = {}
local gems = {}
for _, child in ipairs(island:GetChildren()) do
	if child:IsA("BasePart") then
		if child.Name == "FloatingCrystal" then
			table.insert(floaters, { Part = child, Base = child.CFrame, Phase = rand:NextNumber(0, 6) })
		elseif child.Name == "SpinGem" then
			table.insert(gems, { Part = child, Position = child.Position, Phase = rand:NextNumber(0, 6) })
		end
	end
end

---------------------------------------------------------------------
-- Per-frame animation
---------------------------------------------------------------------
local t = 0
RunService.RenderStepped:Connect(function(dt)
	t += dt

	if orb and orbPosition then
		local pulse = 5 + math.sin(t * 2) * 0.35
		orb.Size = Vector3.one * pulse
		orb.CFrame = CFrame.new(orbPosition + Vector3.new(0, math.sin(t * 1.2) * 0.4, 0))
		if orbShell then
			orbShell.CFrame = orb.CFrame * CFrame.Angles(t * 0.3, t * 0.5, 0)
		end
	end
	if orbPosition then
		if rings[1] then
			rings[1]:PivotTo(CFrame.new(orbPosition) * CFrame.Angles(t * 0.9, t * 0.4, 0))
		end
		if rings[2] then
			rings[2]:PivotTo(CFrame.new(orbPosition) * CFrame.Angles(0, t * 0.7, t * 1.1))
		end
		if rings[3] then
			rings[3]:PivotTo(CFrame.new(orbPosition) * CFrame.Angles(t * 0.5, 0, t * 0.6))
		end
	end

	for _, f in ipairs(floaters) do
		local base = f.Base
		local lift = Vector3.new(0, math.sin(t * 0.8 + f.Phase) * 1.2, 0)
		f.Part.CFrame = CFrame.new(base.Position + lift) * CFrame.Angles(0, t * 0.4 + f.Phase, 0) * base.Rotation
	end

	for _, g in ipairs(gems) do
		g.Part.CFrame = CFrame.new(g.Position + Vector3.new(0, math.sin(t * 2 + g.Phase) * 0.25, 0))
			* CFrame.Angles(0, t * 1.5 + g.Phase, 0)
			* CFrame.Angles(math.rad(45), 0, math.rad(45))
	end
end)

---------------------------------------------------------------------
-- Shooting stars
---------------------------------------------------------------------
local fxFolder = workspace:FindFirstChild("LocalAuraFX") or Instance.new("Folder")
fxFolder.Name = "LocalAuraFX"
fxFolder.Parent = workspace

local STAR_COLORS = {
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(170, 210, 255),
	Color3.fromRGB(220, 180, 255),
	Color3.fromRGB(255, 220, 160),
}

local function shootingStar()
	local angle = rand:NextNumber(0, math.pi * 2)
	local distance = rand:NextNumber(180, 380)
	local start = Vector3.new(math.cos(angle) * distance, rand:NextNumber(140, 260), math.sin(angle) * distance)
	local direction = Vector3.new(rand:NextNumber(-1, 1), rand:NextNumber(-0.45, -0.15), rand:NextNumber(-1, 1)).Unit
	local finish = start + direction * rand:NextNumber(220, 360)
	local color = STAR_COLORS[rand:NextInteger(1, #STAR_COLORS)]

	local star = Instance.new("Part")
	star.Name = "ShootingStar"
	star.Shape = Enum.PartType.Ball
	star.Size = Vector3.one * 1.6
	star.Material = Enum.Material.Neon
	star.Color = color
	star.Anchored = true
	star.CanCollide = false
	star.CanQuery = false
	star.CanTouch = false
	star.CastShadow = false
	star.CFrame = CFrame.new(start)

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.7, 0)
	a0.Parent = star
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.7, 0)
	a1.Parent = star
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.45
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(color, Color3.fromRGB(120, 140, 255))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	trail.Parent = star
	star.Parent = fxFolder

	local duration = rand:NextNumber(0.9, 1.6)
	TweenService:Create(star, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(finish) }):Play()
	task.delay(duration * 0.75, function()
		TweenService:Create(star, TweenInfo.new(duration * 0.25), { Transparency = 1, Size = Vector3.one * 0.2 }):Play()
	end)
	Debris:AddItem(star, duration + 0.6)
end

task.spawn(function()
	while true do
		task.wait(rand:NextNumber(1.2, 3.5))
		shootingStar()
		if rand:NextNumber() < 0.15 then
			-- sometimes a little meteor shower
			for _ = 1, rand:NextInteger(2, 4) do
				task.wait(rand:NextNumber(0.1, 0.3))
				shootingStar()
			end
		end
	end
end)

---------------------------------------------------------------------
-- PORTALS + LUCKY ISLE animations
---------------------------------------------------------------------
local Lighting = game:GetService("Lighting")

-- things that spin around a fixed pivot: { Model, BaseCFrame, Function(t) -> CFrame offset }
local spinners = {}
local function addSpinner(model, offsetFn)
	if model then
		table.insert(spinners, { Model = model, Base = model.WorldPivot, Offset = offsetFn })
	end
end

local plaza = island:WaitForChild("PortalPlaza", 10)
if plaza then
	addSpinner(plaza:FindFirstChild("LuckyPortalRing"), function(time)
		return CFrame.Angles(0, 0, time * 0.8)
	end)
	addSpinner(plaza:FindFirstChild("LuckyPortalRingOuter"), function(time)
		return CFrame.Angles(0, 0, -time * 0.5)
	end)
	addSpinner(plaza:FindFirstChild("LuckyPortalGems"), function(time)
		return CFrame.Angles(0, 0, time * 0.35)
	end)
end

local royal = workspace:WaitForChild("LuckyIsland", 30)
local royalOrb, royalOrbBase
local lanterns = {}
if royal then
	local royalCore = royal:FindFirstChild("LuckyCore")
	if royalCore then
		royalOrb = royalCore:FindFirstChild("LuckyOrb")
		royalOrbBase = royalOrb and royalOrb.Position
		addSpinner(royalCore:FindFirstChild("LuckyRing1"), function(time)
			return CFrame.Angles(time * 0.8, time * 0.3, 0)
		end)
		addSpinner(royalCore:FindFirstChild("LuckyRing2"), function(time)
			return CFrame.Angles(0, time * 0.6, time * 0.9)
		end)
		addSpinner(royalCore:FindFirstChild("LuckyRing3"), function(time)
			return CFrame.Angles(time * 0.4, 0, time * 0.5)
		end)
	end
	addSpinner(royal:FindFirstChild("ReturnPortalRing"), function(time)
		return CFrame.Angles(0, 0, -time * 0.8)
	end)
	addSpinner(royal:FindFirstChild("ReturnPortalRingOuter"), function(time)
		return CFrame.Angles(0, 0, time * 0.5)
	end)
	for _, child in ipairs(royal:GetChildren()) do
		if child:IsA("BasePart") and child.Name == "LuckyLantern" then
			table.insert(lanterns, { Part = child, Base = child.Position, Phase = rand:NextNumber(0, 6) })
		end
	end
end

RunService.RenderStepped:Connect(function()
	for _, s in ipairs(spinners) do
		s.Model:PivotTo(s.Base * s.Offset(t))
	end
	if royalOrb and royalOrbBase then
		royalOrb.Size = Vector3.one * (5.5 + math.sin(t * 2.2) * 0.4)
		royalOrb.CFrame = CFrame.new(royalOrbBase + Vector3.new(0, math.sin(t * 1.1) * 0.5, 0))
	end
	for _, l in ipairs(lanterns) do
		l.Part.CFrame = CFrame.new(l.Base + Vector3.new(0, math.sin(t * 0.9 + l.Phase) * 1.4, 0))
			* CFrame.Angles(0, t * 0.5 + l.Phase, 0)
	end
end)

---------------------------------------------------------------------
-- Lucky Isle sky: pink + gold while you're there
---------------------------------------------------------------------
local savedSky
local function setRoyalSky(on)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	local colorFx = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	local info = TweenInfo.new(2, Enum.EasingStyle.Sine)
	if on then
		savedSky = {
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			AtmosphereColor = atmosphere and atmosphere.Color,
			AtmosphereDecay = atmosphere and atmosphere.Decay,
			Tint = colorFx and colorFx.TintColor,
			Saturation = colorFx and colorFx.Saturation,
		}
		TweenService:Create(Lighting, info, {
			Ambient = Color3.fromRGB(120, 90, 100),
			OutdoorAmbient = Color3.fromRGB(190, 140, 160),
		}):Play()
		if atmosphere then
			TweenService:Create(atmosphere, info, {
				Color = Color3.fromRGB(255, 170, 195),
				Decay = Color3.fromRGB(140, 70, 110),
			}):Play()
		end
		if colorFx then
			TweenService:Create(colorFx, info, {
				TintColor = Color3.fromRGB(255, 238, 225),
				Saturation = 0.25,
			}):Play()
		end
	elseif savedSky then
		TweenService:Create(Lighting, info, {
			Ambient = savedSky.Ambient,
			OutdoorAmbient = savedSky.OutdoorAmbient,
		}):Play()
		if atmosphere and savedSky.AtmosphereColor then
			TweenService:Create(atmosphere, info, {
				Color = savedSky.AtmosphereColor,
				Decay = savedSky.AtmosphereDecay,
			}):Play()
		end
		if colorFx and savedSky.Tint then
			TweenService:Create(colorFx, info, {
				TintColor = savedSky.Tint,
				Saturation = savedSky.Saturation,
			}):Play()
		end
		savedSky = nil
	end
end

local wasOnRoyal = false
player:GetAttributeChangedSignal("OnLuckyIsland"):Connect(function()
	local on = player:GetAttribute("OnLuckyIsland") == true
	if on == wasOnRoyal then
		return
	end
	wasOnRoyal = on
	setRoyalSky(on)
	if on then
		UIKit.toast(("🍀 Welcome to Lucky Isle! x%s luck here"):format(tostring(Config.LuckyIsland.LuckMultiplier)), UIKit.Theme.Gold)
		SoundFX.Chime(1, 5)
	end
end)

---------------------------------------------------------------------
-- Portal travel effect (the server teleports, we make it look good)
---------------------------------------------------------------------
local portalGui = UIKit.screen("CosmicPortal", 40)
local portalFlash = UIKit.new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(255, 220, 160),
	BackgroundTransparency = 1,
	Parent = portalGui,
}, {
	UIKit.new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 200), Color3.fromRGB(255, 150, 210)),
		Rotation = 45,
	}),
})

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local PortalFXRemote = remotes:WaitForChild("PortalFX", 30)
local camera = workspace.CurrentCamera
if PortalFXRemote then
	PortalFXRemote.OnClientEvent:Connect(function(kind)
		if kind == "Out" then
			SoundFX.Play("Whoosh", { Speed = 0.7, Volume = 1.5 })
			SoundFX.Play("RevealEpic", { Volume = 0.5 })
			UIKit.tween(portalFlash, 0.3, { BackgroundTransparency = 0 })
			local fov = camera.FieldOfView
			UIKit.tween(camera, 0.3, { FieldOfView = fov + 25 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.45, function()
				camera.FieldOfView = fov
			end)
		elseif kind == "In" then
			UIKit.tween(portalFlash, 0.8, { BackgroundTransparency = 1 })
			UIKit.burst({ Color3.fromRGB(255, 220, 140), Color3.fromRGB(255, 150, 210), Color3.fromRGB(120, 230, 210) }, 30, 1.2, Vector2.new(0.5, 0.5))
		elseif kind == "Denied" then
			UIKit.toast("👑 This portal is for VIPs only!", UIKit.Theme.Gold)
			SoundFX.Play("Thud")
			local passId = Config.GamePasses.VIP
			if passId and passId ~= 0 then
				MarketplaceService:PromptGamePassPurchase(player, passId)
			end
		end
	end)
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="24">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>