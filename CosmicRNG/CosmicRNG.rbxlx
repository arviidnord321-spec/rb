})

---------------------------------------------------------------------
-- ACTIONS
---------------------------------------------------------------------
local function myRoot()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function opponentRoot()
	local model = opponent and opponent.Model
	return model and model:FindFirstChild("HumanoidRootPart")
end

-- turn toward the opponent when they're close, so hits feel fair
local function faceOpponent(maxDistance)
	local root, theirs = myRoot(), opponentRoot()
	if root and theirs and (theirs.Position - root.Position).Magnitude <= maxDistance then
		root.CFrame = CFrame.lookAt(root.Position, Vector3.new(theirs.Position.X, root.Position.Y, theirs.Position.Z))
	end
end

local function aimDirection()
	return camera.CFrame.LookVector
end

-- push your own character (knockback, dodge rolls)
local function push(velocity, duration)
	local root = myRoot()
	if not root then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "PushAttachment"
	attachment.Parent = root
	local mover = Instance.new("LinearVelocity")
	mover.Attachment0 = attachment
	mover.VectorVelocity = velocity
	mover.MaxForce = 1e6
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.Parent = root
	task.delay(duration, function()
		mover:Destroy()
		attachment:Destroy()
	end)
end

local function attack()
	local now = os.clock()
	if not fighting or blocking or now < nextAttackAt then
		return
	end
	-- predict the combo so the animation starts instantly
	if now - lastLocalAttack <= DUEL.ComboWindow then
		localCombo = (localCombo % 3) + 1
	else
		localCombo = 1
	end
	lastLocalAttack = now
	local heavy = localCombo == 3
	nextAttackAt = now + (heavy and DUEL.HeavyRecovery or DUEL.AttackCooldown)
	faceOpponent(DUEL.AttackRange + 4)
	DuelRequest:FireServer({ Action = "Attack", Aim = aimDirection() })
	local clip = heavy and "Roundhouse" or ((localCombo == 2) and "CrossRight" or "JabLeft")
	CombatAnim.Play(player.Character, clip)
	SoundFX.Play(heavy and "SwingHeavy" or "SwingLight")
	attackButton:FindFirstChild("FeelScale").Scale = 0.88
	tween(attackButton:FindFirstChild("FeelScale"), 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
end

local function setBlock(on)
	if on and (not fighting) then
		return
	end
	if blocking == on then
		return
	end
	blocking = on
	DuelRequest:FireServer({ Action = "Block", On = on })
	blockButton.BackgroundColor3 = on and Color3.fromRGB(150, 220, 255) or Color3.fromRGB(60, 140, 200)
end

local function dodge()
	local now = os.clock()
	if not fighting or blocking or now < dodgeReadyAt then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = myRoot()
	if not humanoid or not root or humanoid.WalkSpeed <= 0 then
		return -- stunned
	end
	dodgeReadyAt = now + DUEL.DodgeCooldown
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = -root.CFrame.LookVector -- standing still: hop backwards
	end
	direction = Vector3.new(direction.X, 0, direction.Z).Unit
	push(direction * DUEL.DodgeSpeed + Vector3.new(0, 4, 0), 0.2)
	DuelRequest:FireServer({ Action = "Dodge", Direction = direction })
	CombatAnim.Play(character, "Dodge")
	SoundFX.Play("Dodge")
end

local function usePower()
	if not fighting or os.clock() < powerReadyAt then
		return
	end
	faceOpponent(80)
	DuelRequest:FireServer({ Action = "Power", Aim = aimDirection() })
end

attackButton.Activated:Connect(attack)
powerButton.Activated:Connect(usePower)
dodgeButton.Activated:Connect(dodge)
blockButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		setBlock(true)
	end
end)
blockButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		setBlock(false)
	end
end)
forfeitButton.Activated:Connect(function()
	if inDuel then
		DuelRequest:FireServer({ Action = "Forfeit" })
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not inDuel then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.F then
		attack()
	elseif input.KeyCode == Enum.KeyCode.Q then
		usePower()
	elseif input.KeyCode == Enum.KeyCode.G then
		setBlock(true)
	elseif input.KeyCode == Enum.KeyCode.E then
		dodge()
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.G then
		setBlock(false)
	end
end)

---------------------------------------------------------------------
-- HUD updates every frame
---------------------------------------------------------------------
local function updateSide(side, model)
	if not model then
		return
	end
	local hp = model:GetAttribute("DuelHP") or 0
	local maxHp = math.max(model:GetAttribute("DuelMaxHP") or 1, 1)
	local shieldAmount = model:GetAttribute("DuelShield") or 0
	local fraction = math.clamp(hp / maxHp, 0, 1)
	if math.abs(fraction - side.LastFraction) > 0.001 then
		tween(side.Fill, 0.15, { Size = UDim2.fromScale(fraction, 1) })
		tween(side.Trail, 0.8, { Size = UDim2.fromScale(fraction, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		side.LastFraction = fraction
	end
	side.Shield.Size = UDim2.fromScale(math.clamp(shieldAmount / maxHp, 0, 1), 0.35)
	local guard = (model:GetAttribute("DuelGuard") or DUEL.GuardMax) / DUEL.GuardMax
	side.Guard.Size = UDim2.fromScale(math.clamp(guard, 0, 1), 1)
	side.Guard.BackgroundColor3 = model:GetAttribute("DuelBlocking") and Color3.fromRGB(200, 240, 255) or Color3.fromRGB(120, 200, 255)
	side.Text.Text = ("%d / %d%s"):format(hp, maxHp, shieldAmount > 0 and ("  🛡" .. shieldAmount) or "")
end

RunService.RenderStepped:Connect(function()
	if not inDuel then
		return
	end
	updateSide(mySide, me and me.Model)
	updateSide(theirSide, opponent and opponent.Model)
	if fighting then
		local left = math.max(0, math.ceil(fightEndsAt - os.clock()))
		timerLabel.Text = ("%d:%02d"):format(left // 60, left % 60)
		timerLabel.TextColor3 = (left < 10) and RED or THEME.Text
	end
	local dodgeLeft = dodgeReadyAt - os.clock()
	dodgeCooldown.Size = UDim2.fromScale(1, math.clamp(dodgeLeft / DUEL.DodgeCooldown, 0, 1))
	local cooldownLeft = powerReadyAt - os.clock()
	local total = (me and me.Power and me.Power.Cooldown) or 1
	if cooldownLeft > 0 then
		powerCooldown.Size = UDim2.fromScale(1, math.clamp(cooldownLeft / total, 0, 1))
		powerLabel.Text = ("%.1f"):format(cooldownLeft)
	else
		powerCooldown.Size = UDim2.fromScale(1, 0)
		powerLabel.Text = me and me.Power and ("⚡\n" .. me.Power.Name) or "⚡\nNo power"
	end
end)

---------------------------------------------------------------------
-- BATTLE BEAT: a drum loop made from the sound designer's drum kit.
-- It gets more intense when someone is low on HP or time is running out.
---------------------------------------------------------------------
local beatOn = false
local BPM = 132
-- 16 steps per bar: K = kick, S = snare, h = closed hat, o = open hat
local PATTERN_CALM = { "Kh", "h", "h", "Kh", "Sh", "h", "Kh", "h", "Kh", "h", "Kh", "h", "Sh", "h", "h", "o" }
local PATTERN_HYPE = { "Kh", "h", "Kh", "h", "Sh", "h", "Kh", "Kh", "Kh", "h", "Kh", "h", "Sh", "Kh", "Sh", "So" }
local DRUMS = { K = "Kick", S = "Snare", h = "HatClosed", o = "HatOpen" }

local function intense()
	if not me or not opponent then
		return false
	end
	local function low(info)
		local model = info.Model
		return model and (model:GetAttribute("DuelHP") or 1) / math.max(model:GetAttribute("DuelMaxHP") or 1, 1) <= 0.3
	end
	return low(me) or low(opponent) or (fightEndsAt - os.clock() <= 15)
end

local function startBeat()
	if beatOn then
		return
	end
	beatOn = true
	SoundFX.SetAmbientVolume(0.15, 1)
	task.spawn(function()
		local stepLength = 60 / BPM / 4
		local nextTime = os.clock()
		local step = 0
		while beatOn do
			local pattern = intense() and PATTERN_HYPE or PATTERN_CALM
			local hits = pattern[(step % 16) + 1]
			for letter in hits:gmatch(".") do
				local drum = DRUMS[letter]
				if drum then
					SoundFX.Play(drum, { Music = true, Volume = (letter == "h") and 0.8 or 1 })
				end
			end
			step += 1
			nextTime += stepLength
			local waitTime = nextTime - os.clock()
			if waitTime > 0 then
				task.wait(waitTime)
			else
				nextTime = os.clock() -- fell behind (lag): don't machine-gun to catch up
			end
		end
	end)
end

local function stopBeat()
	beatOn = false
	SoundFX.SetAmbientVolume(1, 2)
end

---------------------------------------------------------------------
-- SERVER MESSAGES
---------------------------------------------------------------------
local function describeAura(info)
	local aura, tier = statsForAura(info.Aura)
	return ("<font color='#%s'>%s</font>  ❤ %d  ⚔ %d"):format(tier.Color:ToHex(), aura and aura.Name or "No aura", info.MaxHP, info.Damage)
end

DuelEvent.OnClientEvent:Connect(function(info)
	local kind = info.Type
	if kind == "Challenge" then
		showChallenge(info)
	elseif kind == "Notice" then
		UIKit.toast(info.Text, THEME.SubText)
	elseif kind == "Start" then
		setPanelOpen(false)
		hidePopup()
		inDuel = true
		fighting = false
		me, opponent = info.Me, info.Opponent
		powerReadyAt = 0
		mySide.Name.Text = me.Name .. " (you)"
		mySide.Aura.Text = describeAura(me)
		theirSide.Name.Text = (opponent.IsBot and "🤖 " or "") .. opponent.Name
		theirSide.Aura.Text = describeAura(opponent)
		mySide.LastFraction, theirSide.LastFraction = -1, -1
		powerButton.BackgroundColor3 = me.Aura and AuraData.Get(me.Aura).Colors[1]:Lerp(THEME.Accent, 0.4) or THEME.Accent
		local limit = math.floor(info.TimeLimit)
		timerLabel.Text = ("%d:%02d"):format(limit // 60, limit % 60)
		hud.Visible = true
		-- 3, 2, 1...
		task.spawn(function()
			for n = info.Countdown, 1, -1 do
				if not inDuel then
					return
				end
				flashBig(tostring(n), THEME.Text, (n == info.Countdown) and ("vs " .. opponent.Name) or nil)
				SoundFX.Play("Beep", { Speed = (n == 1) and 1.25 or 1 })
				task.wait(1)
			end
		end)
	elseif kind == "Fight" then
		fighting = true
		fightEndsAt = os.clock() + info.EndsIn
		flashBig("FIGHT!", RED)
		hideBig(0.9)
		SoundFX.Play("Gong")
		startBeat()
	elseif kind == "PowerUsed" then
		powerReadyAt = os.clock() + info.Cooldown
	elseif kind == "OutOfRange" then
		UIKit.toast("Too far away for your power!", THEME.Bad)
	elseif kind == "Knockback" then
		push(info.Velocity, 0.15)
	elseif kind == "Combo" then
		showCombo(info.Combo)
	elseif kind == "DodgeUsed" then
		dodgeReadyAt = os.clock() + info.Cooldown
	elseif kind == "End" then
		fighting = false
		stopBeat()
		setBlock(false)
		local reasonText = ({ KO = "Knockout!", Time = "Time's up!", Forfeit = "Forfeit", Left = "Opponent left" })[info.Reason] or ""
		if info.Result == "Win" then
			flashBig("VICTORY!", THEME.Gold, reasonText)
			UIKit.confetti({ THEME.Gold, Color3.fromRGB(120, 255, 170), THEME.Accent2 }, 110)
			SoundFX.Jingle("Victory")
		elseif info.Result == "Lose" then
			flashBig("DEFEAT", RED, reasonText)
			SoundFX.Jingle("Defeat")
		else
			flashBig("DRAW", THEME.SubText, reasonText)
		end
		task.delay(3.4, function()
			hideBig(0)
			inDuel = false
			hud.Visible = false
			me, opponent = nil, nil
		end)
	end
end)

---------------------------------------------------------------------
-- "FINISH THEM!" when the opponent is on their last hits,
-- and a red screen edge when YOU are low
---------------------------------------------------------------------
local finishLabel = label({
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 112), Size = UDim2.fromOffset(500, 44),
	Text = "💀 FINISH THEM! 💀", Font = TITLE_FONT, TextSize = 34, TextColor3 = RED, Visible = false, Parent = hud,
})
textStroke(2.5).Parent = finishLabel
local finishScale = new("UIScale", { Parent = finishLabel })

local vignette = {}
for i, spec in ipairs({
	{ Vector2.new(0, 0), UDim2.fromScale(1, 0.18), 90 }, -- top
	{ Vector2.new(0, 1), UDim2.fromScale(1, 0.18), -90 }, -- bottom
	{ Vector2.new(0, 0), UDim2.fromScale(0.12, 1), 0 }, -- left
	{ Vector2.new(1, 0), UDim2.fromScale(0.12, 1), 180 }, -- right
}) do
	local edge = new("Frame", {
		AnchorPoint = spec[1],
		Position = UDim2.fromScale(spec[1].X, spec[1].Y),
		Size = spec[2],
		BackgroundColor3 = Color3.fromRGB(255, 0, 30),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = hud,
	}, {
		new("UIGradient", {
			Rotation = spec[3],
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		}),
	})
	vignette[i] = edge
end

local function fractionOf(info)
	local model = info and info.Model
	if not model then
		return 1
	end
	return (model:GetAttribute("DuelHP") or 0) / math.max(model:GetAttribute("DuelMaxHP") or 1, 1)
end

RunService.RenderStepped:Connect(function()
	if not inDuel or not fighting then
		finishLabel.Visible = false
		for _, edge in ipairs(vignette) do
			edge.BackgroundTransparency = 1
		end
		return
	end
	local theirs, mine = fractionOf(opponent), fractionOf(me)
	finishLabel.Visible = theirs > 0 and theirs <= 0.2
	if finishLabel.Visible then
		finishScale.Scale = 1 + math.sin(os.clock() * 10) * 0.08
	end
	local danger = (mine <= 0.25) and (0.55 + math.sin(os.clock() * 6) * 0.2) or 1
	for _, edge in ipairs(vignette) do
		edge.BackgroundTransparency = danger
	end
end)

---------------------------------------------------------------------
-- FINISHER CUTSCENE (camera + cinema bars for the two fighters)
---------------------------------------------------------------------
local barTop = new("Frame", {
	AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 0.13),
	BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 20, Parent = gui,
})
local barBottom = new("Frame", {
	AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.13),
	BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 20, Parent = gui,
})
local caption = label({
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.935), Size = UDim2.fromOffset(700, 40),
	Text = "", Font = TITLE_FONT, TextSize = 30, ZIndex = 21, TextTransparency = 1, RichText = true, Parent = gui,
})
local captionStroke = textStroke(2)
captionStroke.Transparency = 1
captionStroke.Parent = caption

local function cinemaBars(show)
	tween(barTop, 0.4, { Position = UDim2.fromScale(0, show and 0.13 or 0) })
	tween(barBottom, 0.4, { Position = UDim2.fromScale(0, show and 0.87 or 1) })
end

local function playFinisherCamera(info)
	local loserRoot = info.Loser and info.Loser:FindFirstChild("HumanoidRootPart")
	local winnerRoot = info.Winner and info.Winner:FindFirstChild("HumanoidRootPart")
	if not loserRoot then
		return
	end
	local iWon = info.Winner == player.Character
	local c1 = (info.Colors and info.Colors[1]) or Color3.new(1, 1, 1)
	local duration = info.Duration or 4.6
	actions.Visible = false
	forfeitButton.Visible = false
	cinemaBars(true)

	local loserPos = loserRoot.Position
	local side = winnerRoot and (loserPos - winnerRoot.Position) or Vector3.new(1, 0, 0)
	side = Vector3.new(side.X, 0, side.Z)
	side = (side.Magnitude > 0.1) and side.Unit or Vector3.new(1, 0, 0)
	local across = Vector3.new(-side.Z, 0, side.X)

	camera.CameraType = Enum.CameraType.Scriptable
	local start = os.clock()
	local shake = 0
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local shot
		if t < 1.3 then
			-- low angle beside the loser, looking up at the magic circle
			local a = t * 0.25
			local offset = (across * math.cos(a) + side * math.sin(a)) * 14 + Vector3.new(0, 2.5, 0)
			shot = CFrame.lookAt(loserPos + offset, loserPos + Vector3.new(0, 14 + t * 6, 0))
		elseif t < 2.9 then
			-- pull back to see the whole beam
			local k = math.clamp((t - 1.3) / 0.6, 0, 1)
			local offset = across * (14 + k * 16) + side * 6 + Vector3.new(0, 4 + k * 8, 0)
			shot = CFrame.lookAt(loserPos + offset, loserPos + Vector3.new(0, 10, 0))
		elseif winnerRoot and winnerRoot.Parent then
			-- hero shot of the winner
			local k = math.clamp((t - 2.9) / 1.5, 0, 1)
			local look = winnerRoot.CFrame.LookVector
			local eye = winnerRoot.Position + look * (10 - k * 3) + Vector3.new(0, 2.2 - k * 0.6, 0) + across * 2
			shot = CFrame.lookAt(eye, winnerRoot.Position + Vector3.new(0, 1.5, 0))
		else
			shot = camera.CFrame
		end
		if shake > 0.01 then
			shot *= CFrame.Angles(rand:NextNumber(-shake, shake) * 0.03, rand:NextNumber(-shake, shake) * 0.03, 0)
			shake *= 0.9
		end
		camera.CFrame = shot
	end)

	-- the strike moment
	task.delay(1.3, function()
		shake = 3
		flashBig(iWon and "💀 FINISHED!" or "ELIMINATED", iWon and THEME.Gold or RED)
		hideBig(1.2)
	end)
	task.delay(2.9, function()
		caption.Text = ("⚡ FINISHED BY <font color='#%s'>%s</font>%s"):format(
			c1:Lerp(Color3.new(1, 1, 1), 0.3):ToHex(), info.WinnerName or "?", info.AuraName and (" • " .. info.AuraName) or "")
		tween(caption, 0.3, { TextTransparency = 0 })
		tween(captionStroke, 0.3, { Transparency = 0.2 })
	end)
	task.delay(duration, function()
		connection:Disconnect()
		camera.CameraType = Enum.CameraType.Custom
		cinemaBars(false)
		tween(caption, 0.3, { TextTransparency = 1 })
		tween(captionStroke, 0.3, { Transparency = 1 })
		actions.Visible = true
		forfeitButton.Visible = true
	end)
end

DuelEvent.OnClientEvent:Connect(function(info)
	if info.Type == "Finisher" then
		fighting = false
		stopBeat()
		setBlock(false)
		playFinisherCamera(info)
	end
end)


---------------------------------------------------------------------
-- FEEL THE HITS: screen shake, red flash, zoom punch
---------------------------------------------------------------------
local shakeAmount = 0
local shaking = false
RunService.RenderStepped:Connect(function(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if shakeAmount > 0.01 then
		shaking = true
		local m = shakeAmount * 0.3
		if humanoid then
			humanoid.CameraOffset = Vector3.new(rand:NextNumber(-m, m), rand:NextNumber(-m, m), rand:NextNumber(-m, m))
		end
		shakeAmount = math.max(0, shakeAmount - dt * 4)
	elseif shaking then
		shaking = false
		if humanoid then
			humanoid.CameraOffset = Vector3.zero
		end
	end
end)

local baseFov = camera.FieldOfView
if DuelFX then
	DuelFX.OnClientEvent:Connect(function(info)
		if not inDuel then
			return
		end
		local character = player.Character
		if info.Type == "Damage" and (info.Amount or 0) > 0 and info.Kind ~= "Burn" then
			local big = info.Heavy or info.Amount >= 30
			if info.Target == character then
				shakeAmount = math.max(shakeAmount, big and 1.6 or 0.7)
				hurtFlash.BackgroundTransparency = big and 0.55 or 0.75
				tween(hurtFlash, 0.35, { BackgroundTransparency = 1 })
			elseif info.Attacker == character then
				shakeAmount = math.max(shakeAmount, big and 1 or 0.3)
				if big then
					camera.FieldOfView = baseFov - 6
					tween(camera, 0.35, { FieldOfView = baseFov }, Enum.EasingStyle.Quint)
				end
			end
		elseif info.Type == "GuardBreak" and info.Target == character then
			shakeAmount = math.max(shakeAmount, 1.2)
			setBlock(false)
		elseif info.Type == "Block" and info.Target == character then
			shakeAmount = math.max(shakeAmount, 0.35)
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="30">
        <Properties>
          <string name="Name">DuelFX</string>
          <string name="Source"><![CDATA[-- DuelFX (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Draws everything that happens in duels, for fighters AND spectators:
-- damage numbers, hit flashes, projectiles, beams, explosions, meteors,
-- shields, freezes, plus a health bar over every fighter's head.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local AuraEffects = require(ReplicatedStorage:WaitForChild("AuraEffects"))
local CombatAnim = require(ReplicatedStorage:WaitForChild("CombatAnim"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local DuelFX = remotes:WaitForChild("DuelFX", 60)
if not DuelFX then
	return
end

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")
local rand = Random.new()

local folder = workspace:FindFirstChild("LocalDuelFX") or Instance.new("Folder")
folder.Name = "LocalDuelFX"
folder.Parent = workspace

local function tween(inst, duration, props, style, direction)
	local tw = TweenService:Create(inst, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function fxPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for key, value in pairs(props) do
		p[key] = value
	end
	p.Parent = folder
	return p
end

local function rootOf(model)
	return model and model:FindFirstChild("HumanoidRootPart")
end

local function colorsOf(info)
	local colors = info.Colors
	if type(colors) == "table" and colors[1] then
		return colors[1], colors[2] or colors[1]
	end
	return Color3.new(1, 1, 1), Color3.new(1, 1, 1)
end

-- a sound coming from a spot in the world
local function soundAt(position, name, opts)
	local holder = fxPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(position) })
	opts = opts or {}
	opts.Parent = holder
	opts.MaxDistance = opts.MaxDistance or 160
	SoundFX.Play(name, opts)
	Debris:AddItem(holder, 5)
end

local function line(from, to, color, width, duration)
	local length = (to - from).Magnitude
	if length < 0.05 then
		return
	end
	local beam = fxPart({
		Size = Vector3.new(width, width, length),
		CFrame = CFrame.lookAt((from + to) / 2, to),
		Color = color,
		Transparency = 0.1,
	})
	tween(beam, duration, { Size = Vector3.new(0.05, 0.05, length), Transparency = 1 })
	Debris:AddItem(beam, duration + 0.1)
	return beam
end

local function ring(position, color, startSize, endSize, duration)
	local r = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, startSize, startSize),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Transparency = 0.15,
	})
	tween(r, duration, { Size = Vector3.new(0.05, endSize, endSize), Transparency = 1 }, Enum.EasingStyle.Quint)
	Debris:AddItem(r, duration + 0.1)
end

local function sphere(position, color, startSize, endSize, duration, material)
	local s = fxPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * startSize,
		CFrame = CFrame.new(position),
		Color = color,
		Transparency = 0.2,
		Material = material or Enum.Material.Neon,
	})
	tween(s, duration, { Size = Vector3.one * endSize, Transparency = 1 }, Enum.EasingStyle.Quint)
	Debris:AddItem(s, duration + 0.1)
end

---------------------------------------------------------------------
-- Floating numbers + hit flash
---------------------------------------------------------------------
local function floatingText(model, text, color, big)
	local root = rootOf(model)
	if not root then
		return
	end
	local holder = fxPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(root.Position + Vector3.new(rand:NextNumber(-1.5, 1.5), 2.5, rand:NextNumber(-1.5, 1.5))) })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(big and 160 or 120, big and 60 or 46)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	gui.Parent = holder
	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.Font = Enum.Font.FredokaOne
	textLabel.TextScaled = true
	textLabel.Text = text
	textLabel.TextColor3 = color
	textLabel.Parent = gui
	local outline = Instance.new("UIStroke")
	outline.Thickness = 2.5
	outline.Parent = textLabel
	local scale = Instance.new("UIScale")
	scale.Scale = 1.6
	scale.Parent = textLabel
	tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(gui, 0.9, { StudsOffset = Vector3.new(0, 3, 0) })
	task.delay(0.5, function()
		tween(textLabel, 0.4, { TextTransparency = 1 })
		tween(outline, 0.4, { Transparency = 1 })
	end)
	Debris:AddItem(holder, 1)
end

local function hitFlash(model, color)
	if not model or not model.Parent then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.FillColor = color
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.3
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	tween(highlight, 0.35, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(highlight, 0.4)
end

---------------------------------------------------------------------
-- Health bars over every fighter (for spectators too)
---------------------------------------------------------------------
local bars = {} -- [model] = { Gui, Fill, Text }

local function makeBar(model)
	local head = model:FindFirstChild("Head") or rootOf(model)
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "DuelBar"
	gui.Adornee = head
	gui.Size = UDim2.fromOffset(170, 40)
	gui.StudsOffset = Vector3.new(0, 5.6, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Parent = playerGui
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 18)
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = Color3.new(1, 1, 1)
	name.Text = "⚔ " .. (model:GetAttribute("DuelName") or model.Name)
	name.Parent = gui
	local outline = Instance.new("UIStroke")
	outline.Thickness = 1.5
	outline.Parent = name
	local back = Instance.new("Frame")
	back.Position = UDim2.fromOffset(0, 20)
	back.Size = UDim2.new(1, 0, 0, 14)
	back.BackgroundColor3 = Color3.fromRGB(30, 20, 40)
	back.BorderSizePixel = 0
	back.Parent = gui
	local backCorner = Instance.new("UICorner")
	backCorner.CornerRadius = UDim.new(1, 0)
	backCorner.Parent = back
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(90, 220, 130)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill
	bars[model] = { Gui = gui, Fill = fill }
end

local function removeBar(model)
	local bar = bars[model]
	if bar then
		bar.Gui:Destroy()
		bars[model] = nil
	end
end

local function fightersInWorld()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character and player.Character:GetAttribute("InDuel") then
			table.insert(list, player.Character)
		end
	end
	local botFolder = workspace:FindFirstChild("DuelBots")
	if botFolder then
		for _, bot in ipairs(botFolder:GetChildren()) do
			if bot:GetAttribute("InDuel") then
				table.insert(list, bot)
			end
		end
	end
	return list
end

task.spawn(function()
	while true do
		task.wait(0.3)
		local alive = {}
		for _, model in ipairs(fightersInWorld()) do
			alive[model] = true
			if not bars[model] then
				makeBar(model)
				CombatAnim.SetLoop(model, "Stance", true)
			end
			CombatAnim.SetLoop(model, "Block", model:GetAttribute("DuelBlocking") == true)
		end
		for model in pairs(bars) do
			if not alive[model] or not model.Parent then
				removeBar(model)
				if model.Parent then
					CombatAnim.SetLoop(model, "Stance", false)
					CombatAnim.SetLoop(model, "Block", false)
					CombatAnim.SetLoop(model, "Stun", false)
					task.delay(1.6, function()
						if not model:GetAttribute("InDuel") then
							CombatAnim.Release(model)
						end
					end)
				end
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	for model, bar in pairs(bars) do
		CombatAnim.SetLoop(model, "Block", model:GetAttribute("DuelBlocking") == true)
		local hp = model:GetAttribute("DuelHP") or 0
		local maxHp = math.max(model:GetAttribute("DuelMaxHP") or 1, 1)
		local fraction = math.clamp(hp / maxHp, 0, 1)
		bar.Fill.Size = UDim2.fromScale(fraction, 1)
		bar.Fill.BackgroundColor3 = Color3.fromRGB(255, 80, 90):Lerp(Color3.fromRGB(90, 220, 130), fraction)
	end
end)

---------------------------------------------------------------------
-- Projectiles (the server decides hits; we draw the same path)
---------------------------------------------------------------------
local projectiles = {} -- [id] = part

local function spawnProjectile(info)
	local c1, c2 = colorsOf(info)
	local orb = fxPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.4,
		CFrame = CFrame.new(info.Origin),
		Color = c1,
	})
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.6, 0)
	a0.Parent = orb
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.6, 0)
	a1.Parent = orb
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.25
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(c1, c2)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = orb
	local light = Instance.new("PointLight")
	light.Color = c1
	light.Range = 10
	light.Brightness = 2
	light.Parent = orb
	projectiles[info.Id] = orb
	local duration = info.Range / info.Speed
	tween(orb, duration, { CFrame = CFrame.new(info.Origin + info.Direction * info.Range) }, Enum.EasingStyle.Linear)
	Debris:AddItem(orb, duration + 0.2)
	soundAt(info.Origin, "Shoot")
end

local function projectileHit(info)
	local orb = projectiles[info.Id]
	projectiles[info.Id] = nil
	local color = orb and orb.Color or Color3.new(1, 1, 1)
	if orb then
		orb:Destroy()
	end
	if not info.Miss then
		AuraEffects.Burst(info.Position, { color, Color3.new(1, 1, 1) }, 0.5)
	end
end

---------------------------------------------------------------------
-- Meteors: red warning circle, then a rock falls from the sky
---------------------------------------------------------------------
local function meteor(info)
	local c1, c2 = colorsOf(info)
	local target = info.Target
	local warning = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, info.Radius * 2, info.Radius * 2),
		CFrame = CFrame.new(target + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(255, 60, 60),
		Transparency = 0.6,
	})
	tween(warning, info.Delay, { Transparency = 0.2 }, Enum.EasingStyle.Linear)
	Debris:AddItem(warning, info.Delay + 0.1)
	local rock = fxPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3,
		CFrame = CFrame.new(target + Vector3.new(12, 60, 6)),
		Color = c1,
	})
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = Config.Textures.Fire
	fire.Rate = 60
	fire.Lifetime = NumberRange.new(0.3, 0.6)
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 0) })
	fire.LightEmission = 1
	fire.LightInfluence = 0
	fire.Color = ColorSequence.new(c1, c2)
	fire.Parent = rock
	tween(rock, info.Delay, { CFrame = CFrame.new(target) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(info.Delay, function()
		rock:Destroy()
		AuraEffects.Burst(target + Vector3.new(0, 1, 0), { c1, c2 }, 1.2)
		ring(target + Vector3.new(0, 0.2, 0), c1, 2, info.Radius * 2.4, 0.6)
		soundAt(target, "Explosion", { Volume = 0.9 })
	end)
end

---------------------------------------------------------------------
-- Shields + freezes stay on a fighter for a while
---------------------------------------------------------------------
local function followFor(model, part, duration, offset)
	local root = rootOf(model)
	if not root then
		part:Destroy()
		return
	end
	local stop = os.clock() + duration
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if os.clock() > stop or not root.Parent then
			connection:Disconnect()
			tween(part, 0.25, { Transparency = 1 })
			Debris:AddItem(part, 0.3)
			return
		end
		part.CFrame = root.CFrame * (offset or CFrame.new())
	end)
end

local function shieldBubble(info)
	local bubble = fxPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 7,
		Color = info.Color or Color3.fromRGB(140, 200, 255),
		Material = Enum.Material.ForceField,
		Transparency = 0,
	})
	followFor(info.Target, bubble, info.Duration or 4)
	local root = rootOf(info.Target)
	if root then
		soundAt(root.Position, "ShieldUp")
	end
end

local function iceBlock(model, duration)
	local block = fxPart({
		Size = Vector3.new(4.5, 6.5, 4.5),
		Color = Color3.fromRGB(170, 230, 255),
		Material = Enum.Material.Ice,
		Transparency = 0.35,
	})
	followFor(model, block, duration, CFrame.new(0, -0.3, 0))
end

---------------------------------------------------------------------
-- Power name floating over the caster
---------------------------------------------------------------------
local function powerCallout(info)
	local c1 = colorsOf(info)
	floatingText(info.Caster, "⚡ " .. info.Name .. "!", c1:Lerp(Color3.new(1, 1, 1), 0.25), true)
	local root = rootOf(info.Caster)
	if root then
		ring(root.Position - Vector3.new(0, 2.8, 0), c1, 2, 12, 0.5)
	end
end

---------------------------------------------------------------------
-- Handle every effect message
---------------------------------------------------------------------
DuelFX.OnClientEvent:Connect(function(info)
	local kind = info.Type
	if kind == "Swing" then
		local root = rootOf(info.Attacker)
		local clip = (info.Combo == 3) and "Roundhouse" or ((info.Combo == 2) and "CrossRight" or "JabLeft")
		local mine = info.Attacker == localPlayer.Character -- your own swing already played instantly
		if not mine then
			CombatAnim.Play(info.Attacker, clip)
		end
		if root then
			if not mine then
				soundAt(root.Position, info.Heavy and "SwingHeavy" or "SwingLight", { Volume = 0.9 })
			end
			if info.Heavy then
				task.delay(0.22, function()
					if root.Parent then
						ring(root.Position - Vector3.new(0, 2.8, 0), info.Color or Color3.new(1, 1, 1), 2, 11, 0.35)
					end
				end)
			end
		end
	elseif kind == "Damage" then
		local root = rootOf(info.Target)
		local attackerRoot = rootOf(info.Attacker)
		local big = info.Heavy or (info.Amount or 0) >= 30
		if info.Kind == "Burn" then
			if info.Amount > 0 then
				floatingText(info.Target, "-" .. info.Amount, Color3.fromRGB(255, 150, 60))
			end
			if root then
				soundAt(root.Position, "BurnCrackle", { Volume = 0.8 })
			end
		elseif info.Amount > 0 then
			-- the body reacts
			if info.WasBlocked then
				CombatAnim.Play(info.Target, "BlockHit")
			else
				CombatAnim.Play(info.Target, big and "HitHeavy" or "HitLight")
				hitFlash(info.Target, Color3.fromRGB(255, 60, 60))
			end
			-- numbers: bigger and angrier for big hits
			local text = "-" .. info.Amount .. (info.Heavy and "!" or "")
			local color = info.WasBlocked and Color3.fromRGB(160, 180, 210)
				or (info.Heavy and Color3.fromRGB(255, 140, 40) or Color3.fromRGB(255, 90, 90))
			floatingText(info.Target, text, color, big)
			if root then
				-- sparks where the hit landed (between the two fighters)
				local contact = root.Position + Vector3.new(0, 0.6, 0)
				if attackerRoot then
					contact = root.Position:Lerp(attackerRoot.Position, 0.3) + Vector3.new(0, 0.8, 0)
				end
				local c = info.Color or Color3.new(1, 1, 1)
				AuraEffects.Burst(contact, { c, Color3.new(1, 1, 1) }, big and 0.9 or 0.45)
				sphere(contact, Color3.new(1, 1, 1), 0.6, big and 6 or 3.5, big and 0.25 or 0.15)
				if not info.WasBlocked then
					soundAt(contact, big and "HeavyHit" or "Jab", { Volume = 1 })
					if big and rand:NextNumber() < 0.6 then
						soundAt(root.Position, "HurtHeavy", { Volume = 0.9 })
					elseif rand:NextNumber() < 0.25 then
						soundAt(root.Position, "HurtLight", { Volume = 0.8 })
					end
				end
				if info.Heavy then
					ring(root.Position - Vector3.new(0, 2.6, 0), c, 3, 16, 0.45)
				end
			end
		end
		if info.Blocked and info.Blocked > 0 then
			floatingText(info.Target, "🛡" .. info.Blocked, Color3.fromRGB(140, 200, 255))
		end
	elseif kind == "Heal" then
		floatingText(info.Target, "+" .. math.floor(info.Amount + 0.5), Color3.fromRGB(110, 255, 150), true)
		hitFlash(info.Target, Color3.fromRGB(110, 255, 150))
		local root = rootOf(info.Target)
		if root then
			AuraEffects.Burst(root.Position, { Color3.fromRGB(110, 255, 150), Color3.new(1, 1, 1) }, 0.6)
			soundAt(root.Position, "HealShimmer")
		end
	elseif kind == "Shield" then
		shieldBubble(info)
	elseif kind == "Stun" then
		iceBlock(info.Target, info.Duration)
	elseif kind == "PowerCast" then
		powerCallout(info)
	elseif kind == "Projectile" then
		spawnProjectile(info)
	elseif kind == "ProjectileHit" then
		projectileHit(info)
	elseif kind == "Dash" then
		local c1, c2 = colorsOf(info)
		line(info.From, info.To, c1, 2.5, 0.4)
		line(info.From, info.To, c2, 1, 0.6)
		AuraEffects.Burst(info.To, { c1, c2 }, 0.6)
		soundAt(info.To, "Dodge", { Speed = 0.8 })
	elseif kind == "Burst" then
		local c1, c2 = colorsOf(info)
		sphere(info.Position, c1, 2, info.Radius * 2, 0.5)
		ring(info.Position - Vector3.new(0, 2.6, 0), c2, 2, info.Radius * 2.2, 0.6)
		AuraEffects.Burst(info.Position, { c1, c2 }, 1.2 + info.Radius / 15)
		soundAt(info.Position, "Explosion")
	elseif kind == "Meteor" then
		meteor(info)
	elseif kind == "Freeze" then
		local c1 = colorsOf(info)
		local root = rootOf(info.Target)
		if root then
			line(info.From, root.Position, c1, 1.6, 0.5)
			soundAt(root.Position, "IceShatter")
		end
	elseif kind == "Drain" then
		local c1, c2 = colorsOf(info)
		local root = rootOf(info.To)
		if root then
			for i = 1, 3 do
				task.delay(i * 0.08, function()
					line(info.From, root.Position, (i % 2 == 0) and c1 or c2, 1.2, 0.5)
				end)
			end
			soundAt(info.From, "Vacuum", { Speed = 1.3 })
		end
	elseif kind == "Beam" then
		local c1, c2 = colorsOf(info)
		line(info.From, info.To, c1, 3, 0.5)
		line(info.From, info.To, Color3.new(1, 1, 1), 1, 0.35)
		line(info.From, info.To, c2, 5, 0.25)
		soundAt(info.From, "BeamFire")
	elseif kind == "Pull" then
		local c1, c2 = colorsOf(info)
		line(info.From, info.To, c1, 2, 0.5)
		sphere(info.To, c2, 8, 1, 0.5, Enum.Material.ForceField)
		soundAt(info.To, "Vacuum")
	elseif kind == "Teleport" then
		local c1, c2 = colorsOf(info)
		sphere(info.From, c1, 4, 0.5, 0.4)
		sphere(info.To, c2, 0.5, 6, 0.4)
		AuraEffects.Burst(info.To, { c1, c2 }, 0.8)
		soundAt(info.To, "TeleportZap")
	elseif kind == "DuelStart" then
		if info.Center then
			ring(info.Center + Vector3.new(0, 0.3, 0), Color3.fromRGB(255, 80, 100), 4, 34, 1)
		end
	elseif kind == "DuelEnd" then
		local root = rootOf(info.Winner)
		if root then
			AuraEffects.Burst(root.Position, { Color3.fromRGB(255, 210, 90), Color3.new(1, 1, 1) }, 2)
			local beam = fxPart({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(300, 6, 6),
				CFrame = CFrame.new(root.Position + Vector3.new(0, 150, 0)) * CFrame.Angles(0, 0, math.pi / 2),
				Color = Color3.fromRGB(255, 210, 90),
				Transparency = 0.2,
			})
			tween(beam, 2, { Size = Vector3.new(300, 0.2, 0.2), Transparency = 1 })
			Debris:AddItem(beam, 2.1)
		end
	end
end)

---------------------------------------------------------------------
-- Extra power effects: burning, dodging, reflected hits
---------------------------------------------------------------------
local Lighting = game:GetService("Lighting")

local function burnPuff(model)
	local root = rootOf(model)
	if not root then
		return
	end
	local holder = fxPart({ Size = Vector3.new(2, 4, 2), Transparency = 1, CFrame = root.CFrame })
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = Config.Textures.Fire
	fire.Lifetime = NumberRange.new(0.3, 0.6)
	fire.Speed = NumberRange.new(2, 4)
	fire.Acceleration = Vector3.new(0, 8, 0)
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) })
	fire.LightEmission = 1
	fire.LightInfluence = 0
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 220, 100), Color3.fromRGB(255, 70, 30))
	fire.Enabled = false
	fire.Parent = holder
	fire:Emit(18)
	Debris:AddItem(holder, 1)
end

local function afterimage(info)
	local root = rootOf(info.Target)
	if not root then
		return
	end
	local c1, c2 = colorsOf(info)
	for i = 1, 4 do
		task.delay(i * 0.08, function()
			if root.Parent then
				local ghost = fxPart({
					Size = Vector3.new(2, 5, 1),
					CFrame = root.CFrame,
					Color = (i % 2 == 0) and c1 or c2,
					Transparency = 0.45,
					Material = Enum.Material.ForceField,
				})
				tween(ghost, 0.5, { Transparency = 1, Size = Vector3.new(3, 6, 1.5) })
				Debris:AddItem(ghost, 0.55)
			end
		end)
	end
end

---------------------------------------------------------------------
-- THE FINISHER: a sky beam obliterates the loser
---------------------------------------------------------------------
-- builds a flat ring of neon pieces that we spin each frame
local function buildRing(center, radius, segments, thickness, color)
	local pieces = {}
	for i = 1, segments do
		local piece = fxPart({
			Size = Vector3.new(thickness, thickness, (2 * math.pi * radius / segments) * 0.8),
			Color = color,
			Transparency = 1,
		})
		table.insert(pieces, { Part = piece, Angle = (i / segments) * math.pi * 2 })
	end
	return { Pieces = pieces, Center = center, Radius = radius }
end

local function placeRing(ring, spin, tilt, transparency)
	for _, piece in ipairs(ring.Pieces) do
		local a = piece.Angle + spin
		local p = ring.Center + Vector3.new(math.cos(a) * ring.Radius, math.sin(a + tilt) * tilt * 2, math.sin(a) * ring.Radius)
		piece.Part.CFrame = CFrame.lookAt(p, ring.Center) * CFrame.Angles(0, math.pi / 2, 0)
		piece.Part.Transparency = transparency
	end
end

local function destroyRing(ring)
	for _, piece in ipairs(ring.Pieces) do
		piece.Part:Destroy()
	end
end

local function cylinder(top, bottom, width, color, transparency, material)
	local length = (top - bottom).Magnitude
	return fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, width, width),
		CFrame = CFrame.new((top + bottom) / 2) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Transparency = transparency,
		Material = material or Enum.Material.Neon,
	})
end

local function playFinisher(info)
	local loserRoot = rootOf(info.Loser)
	if not loserRoot then
		return
	end
	local c1, c2 = colorsOf(info)
	local bright1 = c1:Lerp(Color3.new(1, 1, 1), 0.25)
	local order = info.Order or 3
	local duration = info.Duration or 4.6
	local special = info.Special
	local ground = loserRoot.Position - Vector3.new(0, 2.9, 0)
	local sky = ground + Vector3.new(0, 58, 0)
	local cleanup = {}
	local function keep(inst)
		table.insert(cleanup, inst)
		return inst
	end

	local localRoot = rootOf(localPlayer.Character)
	local nearby = localRoot and (localRoot.Position - ground).Magnitude < 260

	-- 1) the world darkens and takes the winner's color
	local grade
	if nearby then
		grade = Instance.new("ColorCorrectionEffect")
		grade.Name = "FinisherGrade"
		grade.Parent = Lighting
		tween(grade, 0.5, { Brightness = -0.12, Saturation = -0.35, Contrast = 0.25, TintColor = Color3.new(1, 1, 1):Lerp(c1, 0.35) })
	end

	-- glow on both fighters
	local loserGlow = Instance.new("Highlight")
	loserGlow.FillColor = Color3.fromRGB(255, 60, 70)
	loserGlow.OutlineColor = Color3.new(1, 1, 1)
	loserGlow.FillTransparency = 0.6
	loserGlow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	loserGlow.Parent = info.Loser
	keep(loserGlow)
	if info.Winner and info.Winner.Parent then
		local winnerGlow = Instance.new("Highlight")
		winnerGlow.FillColor = c1
		winnerGlow.OutlineColor = c2
		winnerGlow.FillTransparency = 0.75
		winnerGlow.Parent = info.Winner
		keep(winnerGlow)
	end

	-- 2) a magic circle forms in the sky
	local rings = {}
	local ringCount = math.clamp(math.ceil(order / 2), 1, 3) + 1
	for i = 1, ringCount do
		table.insert(rings, buildRing(sky, 6 + i * 4.5, 18 + i * 8, 0.6, (i % 2 == 0) and c2 or bright1))
	end
	local orb = keep(fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one, CFrame = CFrame.new(sky), Color = Color3.new(1, 1, 1), Transparency = 0 }))
	local orbLight = Instance.new("PointLight")
	orbLight.Color = c1
	orbLight.Range = 40
	orbLight.Brightness = 3
	orbLight.Parent = orb
	tween(orb, 1.3, { Size = Vector3.one * (6 + order) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	-- sparkles getting sucked into the orb
	local gather = keep(fxPart({ Size = Vector3.one * 40, CFrame = CFrame.new(sky), Transparency = 1 }))
	local gatherEmitter = Instance.new("ParticleEmitter")
	gatherEmitter.Texture = Config.Textures.Sparkle
	gatherEmitter.Shape = Enum.ParticleEmitterShape.Sphere
	gatherEmitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	gatherEmitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	gatherEmitter.Rate = 120
	gatherEmitter.Lifetime = NumberRange.new(0.6, 0.9)
	gatherEmitter.Speed = NumberRange.new(25, 35)
	gatherEmitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	gatherEmitter.LightEmission = 1
	gatherEmitter.LightInfluence = 0
	gatherEmitter.Color = ColorSequence.new(c1, c2)
	gatherEmitter.Parent = gather

	-- rune circle on the ground under the loser
	local rune = buildRing(ground + Vector3.new(0, 0.3, 0), 7, 28, 0.35, c2)
	local runeGems = {}
	for i = 1, 6 do
		table.insert(runeGems, { Part = keep(fxPart({ Size = Vector3.one * 0.9, Color = bright1, Transparency = 1 })), Angle = (i / 6) * math.pi * 2 })
	end

	-- black holes implode before they strike
	if special == "Inward" then
		local implode = keep(fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 26, CFrame = CFrame.new(loserRoot.Position), Color = Color3.new(0, 0, 0), Transparency = 0.6, Material = Enum.Material.ForceField }))
		tween(implode, 1.3, { Size = Vector3.one * 1, Transparency = 0.1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end

	-- sounds: rumble + heartbeats while charging
	local rumbleHolder = keep(fxPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(ground) }))
	local rumble = SoundFX.Loop("Rumble", 0.5, { Parent = rumbleHolder, MaxDistance = 300, Volume = 1.4 })
	soundAt(ground, "Heartbeat", { Volume = 1, MaxDistance = 260 })
	task.delay(0.6, function()
		soundAt(ground, "Heartbeat", { Volume = 1.2, Speed = 1.1, MaxDistance = 260 })
	end)

	local start = os.clock()
	local strikeAt = 1.3
	local fadeAt = 2.8
	local struck = false
	local beams = {}
	local laser
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		if t > duration then
			connection:Disconnect()
			return
		end
		-- spin the sky rings (fade in, then out after the strike)
		local ringAlpha = (t < 0.5) and (1 - t / 0.5 * 0.85) or ((t < fadeAt) and 0.15 or math.min(1, 0.15 + (t - fadeAt) / 0.6))
		for i, ring in ipairs(rings) do
			placeRing(ring, t * (i % 2 == 0 and -1.4 or 1.1) * (1 + (struck and 1.5 or 0)), 0, ringAlpha)
		end
		placeRing(rune, -t * 0.8, 0, ringAlpha)
		for _, gem in ipairs(runeGems) do
			local a = gem.Angle + t * 1.6
			gem.Part.CFrame = CFrame.new(rune.Center + Vector3.new(math.cos(a) * 9, 0.6 + math.sin(t * 4 + gem.Angle) * 0.3, math.sin(a) * 9)) * CFrame.Angles(math.rad(45), a, math.rad(45))
			gem.Part.Transparency = ringAlpha
		end
		-- flickering targeting laser before the strike
		if not struck then
			if not laser then
				laser = keep(fxPart({ Size = Vector3.new(0.3, 0.3, 58), Color = Color3.fromRGB(255, 60, 70), Transparency = 0.5 }))
			end
			laser.CFrame = CFrame.lookAt((sky + ground) / 2, ground)
			laser.Transparency = (math.floor(t * 20) % 2 == 0) and 0.2 or 0.7
		end
		-- rainbow auras: the beam cycles through colors
		if struck and special == "Rainbow" and beams[2] then
			beams[2].Color = Color3.fromHSV((t * 0.8) % 1, 0.8, 1)
		end
		-- the beam pulses while it burns
		if struck and t < fadeAt and beams[1] then
			local pulse = 1 + math.sin(t * 30) * 0.08
			for i, beam in ipairs(beams) do
				local width = ({ 5, 11, 17 })[i] * pulse * (0.8 + order * 0.05)
				beam.Size = Vector3.new(beam.Size.X, width, width)
			end
		end
	end)

	-- 3) STRIKE
	task.delay(strikeAt, function()
		struck = true
		if laser then
			laser:Destroy()
		end
		gatherEmitter.Enabled = false
		tween(orb, 0.15, { Size = Vector3.one * 2, Transparency = 0.3 })

		-- three layers of beam from the sky to the ground
		local layers = {
			{ Color = Color3.new(1, 1, 1), Transparency = 0, Material = Enum.Material.Neon },
			{ Color = c1, Transparency = 0.2, Material = Enum.Material.Neon },
			{ Color = c2, Transparency = 0.35, Material = Enum.Material.ForceField },
		}
		for _, layer in ipairs(layers) do
			local beam = keep(cylinder(sky + Vector3.new(0, 60, 0), ground, 0.5, layer.Color, layer.Transparency, layer.Material))
			table.insert(beams, beam)
		end
		local beamLight = Instance.new("PointLight")
		beamLight.Color = c1
		beamLight.Range = 60
		beamLight.Brightness = 12
		beamLight.Parent = beams[1]
		tween(beamLight, fadeAt - strikeAt + 0.5, { Brightness = 0 })

		-- impact: bursts, shockwaves, sparks, smoke
		AuraEffects.Burst(ground + Vector3.new(0, 2, 0), { c1, c2 }, 2.5 + order * 0.3)
		task.delay(0.15, function()
			AuraEffects.Burst(ground + Vector3.new(0, 4, 0), { Color3.new(1, 1, 1), c1 }, 2)
		end)
		for i = 1, 3 do
			task.delay((i - 1) * 0.18, function()
				ring(ground + Vector3.new(0, 0.3, 0), (i == 2) and c2 or c1, 4, 40 + order * 6 + i * 8, 0.9)
			end)
		end
		sphere(ground + Vector3.new(0, 3, 0), Color3.new(1, 1, 1), 4, 22 + order * 2, 0.45)

		local impact = keep(fxPart({ Size = Vector3.one, CFrame = CFrame.new(ground + Vector3.new(0, 1, 0)), Transparency = 1 }))
		local sparks = Instance.new("ParticleEmitter")
		sparks.Texture = Config.Textures.Spark
		sparks.Enabled = false
		sparks.Lifetime = NumberRange.new(0.6, 1.4)
		sparks.Speed = NumberRange.new(30, 70)
		sparks.SpreadAngle = Vector2.new(80, 80)
		sparks.Acceleration = Vector3.new(0, -40, 0)
		sparks.Drag = 1.5
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
		sparks.LightEmission = 1
		sparks.LightInfluence = 0
		sparks.Color = ColorSequence.new(Color3.new(1, 1, 1), c1)
		sparks.Parent = impact
		sparks:Emit(140 + order * 20)
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = Config.Textures.Smoke
		smoke.Enabled = false
		smoke.Lifetime = NumberRange.new(1.2, 2)
		smoke.Speed = NumberRange.new(12, 20)
		smoke.SpreadAngle = Vector2.new(90, 5)
		smoke.EmissionDirection = Enum.NormalId.Top
		smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
		smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		smoke.Color = ColorSequence.new((special == "Dark") and Color3.fromRGB(20, 10, 25) or c2:Lerp(Color3.new(1, 1, 1), 0.4))
		smoke.Parent = impact
		smoke:Emit(50)

		-- fire auras get roaring flames around the beam
		if special == "Fire" then
			local flames = Instance.new("ParticleEmitter")
			flames.Texture = Config.Textures.Fire
			flames.Rate = 90
			flames.Lifetime = NumberRange.new(0.5, 1)
			flames.Speed = NumberRange.new(8, 16)
			flames.Acceleration = Vector3.new(0, 20, 0)
			flames.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 0) })
			flames.LightEmission = 1
			flames.LightInfluence = 0
			flames.Color = ColorSequence.new(Color3.fromRGB(255, 220, 100), Color3.fromRGB(255, 60, 20))
			flames.Parent = impact
			task.delay(fadeAt - strikeAt, function()
				flames.Enabled = false
			end)
		end

		-- debris flies out in every direction (real physics, only on this screen)
		local debrisColor = (special == "Snow") and Color3.fromRGB(200, 240, 255) or c1
		for _ = 1, 12 + order * 4 do
			local shard = Instance.new("Part")
			shard.Size = Vector3.new(rand:NextNumber(0.6, 1.6), rand:NextNumber(0.6, 1.6), rand:NextNumber(0.6, 1.6))
			shard.Material = Enum.Material.Neon
			shard.Color = (rand:NextNumber() < 0.5) and debrisColor or c2
			shard.CanQuery = false
			shard.CanTouch = false
			shard.CFrame = CFrame.new(ground + Vector3.new(rand:NextNumber(-2, 2), 1.5, rand:NextNumber(-2, 2)))
				* CFrame.Angles(rand:NextNumber(0, 6), rand:NextNumber(0, 6), rand:NextNumber(0, 6))
			shard.Parent = folder
			local angle = rand:NextNumber(0, math.pi * 2)
			shard.AssemblyLinearVelocity = Vector3.new(math.cos(angle), 0, math.sin(angle)) * rand:NextNumber(25, 55) + Vector3.new(0, rand:NextNumber(35, 70), 0)
			shard.AssemblyAngularVelocity = Vector3.new(rand:NextNumber(-12, 12), rand:NextNumber(-12, 12), rand:NextNumber(-12, 12))
			task.delay(1.8, function()
				if shard.Parent then
					tween(shard, 0.6, { Transparency = 1, Size = Vector3.one * 0.1 })
				end
			end)
			Debris:AddItem(shard, 2.5)
		end

		-- the big sound
		soundAt(ground, "RevealMythic", { Volume = 1.6, MaxDistance = 400 })
		soundAt(ground, "Heartbeat", { Speed = 0.6, Volume = 1.6, MaxDistance = 400 })
		soundAt(ground, "Zap", { Speed = 0.6, Volume = 1.2, MaxDistance = 400 })
		SoundFX.FadeOut(rumble, 1.5)

		-- the loser glows white and dissolves into rising sparkles
		tween(loserGlow, 0.5, { FillColor = Color3.new(1, 1, 1), FillTransparency = 0 })
		task.delay(0.7, function()
			if info.Loser and info.Loser.Parent then
				for _, item in ipairs(info.Loser:GetDescendants()) do
					if item:IsA("BasePart") then
						item.LocalTransparencyModifier = 1
					end
				end
			end
			loserGlow.Enabled = false
			local soul = keep(fxPart({ Size = Vector3.new(2, 5, 2), CFrame = CFrame.new(ground + Vector3.new(0, 3, 0)), Transparency = 1 }))
			local rise = Instance.new("ParticleEmitter")
			rise.Texture = Config.Textures.Sparkle
			rise.Rate = 80
			rise.Lifetime = NumberRange.new(1, 1.6)
			rise.Speed = NumberRange.new(4, 8)
			rise.EmissionDirection = Enum.NormalId.Top
			rise.SpreadAngle = Vector2.new(25, 25)
			rise.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
			rise.LightEmission = 1
			rise.LightInfluence = 0
			rise.Color = ColorSequence.new(Color3.new(1, 1, 1), c1)
			rise.Parent = soul
			task.delay(1, function()
				rise.Enabled = false
			end)
		end)
	end)

	-- 4) the beam fades, "ELIMINATED" appears
	task.delay(fadeAt, function()
		for _, beam in ipairs(beams) do
			tween(beam, 0.5, { Size = Vector3.new(beam.Size.X, 0.1, 0.1), Transparency = 1 })
		end
		tween(orb, 0.5, { Transparency = 1, Size = Vector3.one * 12 })
		local tag = keep(fxPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(ground + Vector3.new(0, 7, 0)) }))
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(420, 110)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = 260
		gui.Parent = tag
		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Size = UDim2.fromScale(1, 0.62)
		title.Font = Enum.Font.FredokaOne
		title.TextScaled = true
		title.Text = "ELIMINATED"
		title.TextColor3 = Color3.fromRGB(255, 70, 80)
		title.Parent = gui
		local outline = Instance.new("UIStroke")
		outline.Thickness = 3
		outline.Parent = title
		local sub = Instance.new("TextLabel")
		sub.BackgroundTransparency = 1
		sub.Position = UDim2.fromScale(0, 0.62)
		sub.Size = UDim2.fromScale(1, 0.38)
		sub.Font = Enum.Font.FredokaOne
		sub.TextScaled = true
		sub.Text = ("by %s%s"):format(info.WinnerName or "?", info.AuraName and (" • " .. info.AuraName) or "")
		sub.TextColor3 = bright1
		sub.Parent = gui
		local subOutline = Instance.new("UIStroke")
		subOutline.Thickness = 2
		subOutline.Parent = sub
		local pop = Instance.new("UIScale")
		pop.Scale = 2
		pop.Parent = title
		tween(pop, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end)

	-- 5) clean up and give the loser their body back
	task.delay(duration + 0.1, function()
		for _, ringItem in ipairs(rings) do
			destroyRing(ringItem)
		end
		destroyRing(rune)
		for _, inst in ipairs(cleanup) do
			if inst.Parent then
				inst:Destroy()
			end
		end
		if grade then
			tween(grade, 0.6, { Brightness = 0, Saturation = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) })
			Debris:AddItem(grade, 0.7)
		end
		if info.Loser and info.Loser.Parent then
			for _, item in ipairs(info.Loser:GetDescendants()) do
				if item:IsA("BasePart") then
					item.LocalTransparencyModifier = 0
				end
			end
		end
	end)
end

DuelFX.OnClientEvent:Connect(function(info)
	local kind = info.Type
	if kind == "Burn" then
		burnPuff(info.Target)
	elseif kind == "Dodge" then
		floatingText(info.Target, "DODGE!", Color3.fromRGB(200, 180, 255))
	elseif kind == "Afterimage" then
		afterimage(info)
	elseif kind == "Finisher" then
		playFinisher(info)
	end
end)


---------------------------------------------------------------------
-- Blocks, guard breaks, dodges, casting poses, stuns, victory poses
---------------------------------------------------------------------
local function shieldFlash(model, attackerModel)
	local root = rootOf(model)
	if not root then
		return
	end
	local facing = root.CFrame.LookVector
	local attackerRoot = rootOf(attackerModel)
	if attackerRoot then
		local d = attackerRoot.Position - root.Position
		d = Vector3.new(d.X, 0, d.Z)
		if d.Magnitude > 0.1 then
			facing = d.Unit
		end
	end
	local center = root.Position + facing * 2 + Vector3.new(0, 0.5, 0)
	local shield = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 5, 5),
		CFrame = CFrame.lookAt(center, center + facing) * CFrame.Angles(0, math.pi / 2, 0),
		Color = Color3.fromRGB(120, 200, 255),
		Material = Enum.Material.ForceField,
		Transparency = 0,
	})
	tween(shield, 0.3, { Size = Vector3.new(0.1, 6.5, 6.5), Transparency = 1 })
	Debris:AddItem(shield, 0.35)
	AuraEffects.Burst(center, { Color3.fromRGB(150, 220, 255), Color3.new(1, 1, 1) }, 0.35)
	soundAt(center, "Block")
end

local function guardBreak(model)
	local root = rootOf(model)
	if not root then
		return
	end
	floatingText(model, "GUARD BREAK!", Color3.fromRGB(120, 200, 255), true)
	for _ = 1, 10 do
		local shard = Instance.new("Part")
		shard.Size = Vector3.new(0.5, 0.8, 0.1)
		shard.Material = Enum.Material.Glass
		shard.Color = Color3.fromRGB(150, 210, 255)
		shard.Transparency = 0.2
		shard.CanQuery = false
		shard.CanTouch = false
		shard.CFrame = root.CFrame * CFrame.new(rand:NextNumber(-1.5, 1.5), rand:NextNumber(-0.5, 1.5), -1.5)
		shard.Parent = folder
		shard.AssemblyLinearVelocity = Vector3.new(rand:NextNumber(-20, 20), rand:NextNumber(10, 25), rand:NextNumber(-20, 20))
		Debris:AddItem(shard, 1.5)
	end
	soundAt(root.Position, "GuardBreak")
	CombatAnim.Play(model, "HitHeavy")
end

local function dodgeRoll(info)
	local mine = info.Target == localPlayer.Character -- already played on your screen
	if not mine then
		CombatAnim.Play(info.Target, "Dodge")
	end
	local root = rootOf(info.Target)
	if root then
		if not mine then
			soundAt(root.Position, "Dodge")
		end
		afterimage({ Target = info.Target, Colors = info.Colors or { Color3.fromRGB(200, 200, 255), Color3.fromRGB(140, 140, 255) } })
		ring(root.Position - Vector3.new(0, 2.8, 0), Color3.fromRGB(200, 200, 255), 2, 7, 0.3)
	end
end

local function castPose(info)
	local pose = CombatAnim.PowerPose[info.PowerType] or "CastForward"
	CombatAnim.Play(info.Caster, pose)
	local c1 = colorsOf(info)
	-- energy gathers in the hands while winding up
	for _, handName in ipairs({ "RightHand", "LeftHand" }) do
		local hand = info.Caster and info.Caster:FindFirstChild(handName)
		if hand then
			local orb = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.4, CFrame = hand.CFrame, Color = c1, Transparency = 0.1 })
			local light = Instance.new("PointLight")
			light.Color = c1
			light.Range = 8
			light.Brightness = 3
			light.Parent = orb
			local start = os.clock()
			local windup = info.Windup or 0.2
			local connection
			connection = RunService.RenderStepped:Connect(function()
				local t = os.clock() - start
				if t > windup + 0.15 or not hand.Parent then
					connection:Disconnect()
					orb:Destroy()
					return
				end
				orb.CFrame = hand.CFrame
				orb.Size = Vector3.one * (0.4 + math.min(t / windup, 1) * 1.4)
			end)
		end
	end
	local root = rootOf(info.Caster)
	if root then
		soundAt(root.Position, "Zap", { Speed = 2.2, Volume = 0.6 })
	end
end

DuelFX.OnClientEvent:Connect(function(info)
	local kind = info.Type
	if kind == "Block" then
		shieldFlash(info.Target, info.Attacker)
	elseif kind == "GuardBreak" then
		guardBreak(info.Target)
		CombatAnim.SetLoop(info.Target, "Stun", true)
		task.delay(1, function()
			if info.Target then
				CombatAnim.SetLoop(info.Target, "Stun", false)
			end
		end)
	elseif kind == "DodgeRoll" then
		dodgeRoll(info)
	elseif kind == "PowerCast" then
		castPose(info)
	elseif kind == "Stun" then
		CombatAnim.SetLoop(info.Target, "Stun", true)
		task.delay(info.Duration or 1, function()
			if info.Target then
				CombatAnim.SetLoop(info.Target, "Stun", false)
			end
		end)
	elseif kind == "Dash" then
		-- the caster leans into the dash (DashLean comes from the cast pose)
	elseif kind == "DuelEnd" then
		if info.Winner then
			CombatAnim.Play(info.Winner, "Victory")
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="31">
        <Properties>
          <string name="Name">IslandFX</string>
          <string name="Source"><![CDATA[-- IslandFX (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Brings the Rebirth Gate and the rebirth islands to life on your screen:
--   * spinning / bobbing / blinking things (marked with FX_ attributes)
--   * the aurora over Frostfall, geysers and eruptions on Ember Isle
--   * gate portals show 🔒 or ✅ for YOUR rebirths
--   * each island says welcome when you arrive

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local Luck = require(ReplicatedStorage:WaitForChild("Luck"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")

local folder = workspace:WaitForChild("RebirthIslands", 60)
if not folder then
	warn("[IslandFX] RebirthIslands not found")
	return
end

---------------------------------------------------------------------
-- Collect everything that moves
---------------------------------------------------------------------
local movers = {} -- spin / bob / pulse
local auroras = {} -- aurora panels
local geysers = {}
local eruptions = {}
local blinkers = {}
local rand = Random.new()

local function pivotOf(instance)
	if instance:IsA("Model") then
		return instance:GetPivot()
	end
	return instance.CFrame
end

local function collect(instance)
	local spin = instance:GetAttribute("FX_Spin")
	local bob = instance:GetAttribute("FX_Bob")
	local pulse = instance:GetAttribute("FX_Pulse")
	if spin or bob or pulse then
		table.insert(movers, {
			Instance = instance,
			Base = pivotOf(instance),
			Spin = spin,
			Bob = bob,
			Pulse = pulse,
			BaseSize = instance:IsA("BasePart") and instance.Size or nil,
			Phase = rand:NextNumber(0, 6),
		})
	end
	if instance:GetAttribute("FX_Aurora") then
		for _, panel in ipairs(instance:GetChildren()) do
			if panel:IsA("BasePart") then
				table.insert(auroras, { Part = panel, Phase = panel:GetAttribute("Phase") or 0, Base = panel.Color })
			end
		end
	end
	if instance:GetAttribute("FX_Geyser") then
		table.insert(geysers, { Part = instance, Phase = instance:GetAttribute("Phase") or 0, Last = 0 })
	end
	if instance:GetAttribute("FX_Eruption") then
		table.insert(eruptions, { Part = instance, Next = os.clock() + rand:NextNumber(5, 10) })
	end
	if instance:GetAttribute("FX_Blink") then
		table.insert(blinkers, { Part = instance, Phase = instance:GetAttribute("Phase") or 0 })
	end
end

for _, instance in ipairs(folder:GetDescendants()) do
	collect(instance)
end

-- only animate what's close to you (the islands are far apart)
local NEAR = 420
local function near(position)
	return (camera.CFrame.Position - position).Magnitude < NEAR
end

local t = 0
RunService.RenderStepped:Connect(function(dt)
	t += dt
	for _, m in ipairs(movers) do
		if near(m.Base.Position) then
			local cf = m.Base
			if m.Bob then
				cf = cf + Vector3.new(0, math.sin(t * 1.3 + m.Phase) * m.Bob, 0)
			end
			if m.Spin then
				cf = cf * CFrame.Angles(m.Spin.X * t, m.Spin.Y * t, m.Spin.Z * t)
			end
			if m.Instance:IsA("Model") then
				m.Instance:PivotTo(cf)
			else
				m.Instance.CFrame = cf
				if m.Pulse and m.BaseSize then
					m.Instance.Size = m.BaseSize * (1 + math.sin(t * 2.4 + m.Phase) * m.Pulse * 0.2)
				end
			end
		end
	end
	for _, a in ipairs(auroras) do
		local wave = math.sin(t * 0.7 + a.Phase)
		a.Part.Transparency = 0.62 + wave * 0.22
		a.Part.Color = a.Base:Lerp(Color3.new(1, 1, 1), (math.sin(t * 0.4 + a.Phase * 0.5) + 1) * 0.12)
	end
	for _, b in ipairs(blinkers) do
		b.Part.Transparency = ((t + b.Phase) % 1.6 < 0.8) and 0 or 0.8
	end
end)

-- geysers blast every few seconds, the volcano erupts now and then
task.spawn(function()
	while true do
		task.wait(0.2)
		local now = workspace:GetServerTimeNow()
		for _, g in ipairs(geysers) do
			local cycle = math.floor((now + g.Phase) / 5)
			if cycle ~= g.Last then
				g.Last = cycle
				if near(g.Part.Position) then
					local blast = g.Part:FindFirstChild("Blast")
					if blast then
						blast:Emit(40)
					end
					SoundFX.Play("Swoosh", { Parent = g.Part, Speed = 0.6, Volume = 0.8, MaxDistance = 80 })
				end
			end
		end
		for _, e in ipairs(eruptions) do
			if os.clock() >= e.Next then
				e.Next = os.clock() + rand:NextNumber(9, 16)
				if near(e.Part.Position) then
					for _, child in ipairs(e.Part:GetChildren()) do
						if child:IsA("ParticleEmitter") and child:GetAttribute("Eruption") then
							child:Emit(120)
						end
					end
					SoundFX.Play("Rumble", { Parent = e.Part, Volume = 1, MaxDistance = 220 })
					SoundFX.Play("Explosion", { Parent = e.Part, Speed = 0.6, Volume = 0.7, MaxDistance = 220 })
					-- a little camera shake if you're close
					local character = player.Character
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
					if humanoid and (camera.CFrame.Position - e.Part.Position).Magnitude < 120 then
						task.spawn(function()
							for _ = 1, 12 do
								humanoid.CameraOffset = Vector3.new(rand:NextNumber(-0.3, 0.3), rand:NextNumber(-0.3, 0.3), 0)
								task.wait(0.03)
							end
							humanoid.CameraOffset = Vector3.zero
						end)
					end
				end
			end
		end
	end
end)

---------------------------------------------------------------------
-- Gate portals: locked or unlocked for YOU
---------------------------------------------------------------------
local gate = folder:WaitForChild("RebirthGate", 30)
local function refreshLocks()
	if not gate then
		return
	end
	local n = player:GetAttribute("Rebirths") or 0
	for _, item in ipairs(gate:GetDescendants()) do
		local need = item:GetAttribute("NeedRebirths")
		if need then
			local unlocked = n >= need
			if item:IsA("BasePart") then
				item.Transparency = unlocked and 1 or 0.2
			elseif item:IsA("BillboardGui") then
				local text = item:FindFirstChild("Text")
				if text then
					local base = text:GetAttribute("BaseText") or text.Text
					text:SetAttribute("BaseText", base)
					text.Text = base .. (unlocked and "\n<font color='#78ffaa'>✅ UNLOCKED</font>" or "\n<font color='#ff8c8c'>🔒 LOCKED</font>")
					item.Size = UDim2.fromOffset(300, 96)
				end
			end
		end
	end
end
refreshLocks()
player:GetAttributeChangedSignal("Rebirths"):Connect(refreshLocks)

---------------------------------------------------------------------
-- Island welcome (each island's sky colors are done by SkyFX)
---------------------------------------------------------------------
local current = nil
player:GetAttributeChangedSignal("OnRebirthIsland"):Connect(function()
	local key = player:GetAttribute("OnRebirthIsland")
	if key == current then
		return
	end
	current = key
	if key then
		for _, info in ipairs(Config.RebirthIslands) do
			if info.Key == key then
				local after = Luck.Get(player)
				UIKit.luckBoost(info.Icon, info.Name, info.LuckMultiplier, after / info.LuckMultiplier, after, info.Color)
			end
		end
	end
end)

---------------------------------------------------------------------
-- Locked portal message
---------------------------------------------------------------------
local PortalFXRemote = remotes:WaitForChild("PortalFX", 30)
if PortalFXRemote then
	PortalFXRemote.OnClientEvent:Connect(function(kind, data)
		if kind == "DeniedRebirth" and type(data) == "table" then
			UIKit.toast(("🔒 %s unlocks at Rebirth %d - open ⭐ REBIRTH to see your progress"):format(
				tostring(data.Name), tonumber(data.Need) or 1), Color3.fromRGB(255, 140, 140))
			SoundFX.Play("Thud")
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="32">
        <Properties>
          <string name="Name">LimitedOffer</string>
          <string name="Source"><![CDATA[-- LimitedOffer (LocalScript in StarterPlayer > StarterPlayerScripts)
-- The 🔥 LIMITED button + panel: 3 super strong packs (pick ONE), only on
-- sale for the first 7 days after release. Shows a live countdown, opens
-- itself once when you join, and disappears when the offer ends or you buy.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local THEME = UIKit.Theme
local TITLE_FONT = UIKit.TitleFont
local new, corner, stroke, textStroke, tween, label =
	UIKit.new, UIKit.corner, UIKit.stroke, UIKit.textStroke, UIKit.tween, UIKit.label

local OFFER = Config.LimitedOffer
local HOT = Color3.fromRGB(255, 120, 60)
local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local TestProductRemote = remotes:WaitForChild("TestProduct")

local function secondsLeft()
	local ends = ReplicatedStorage:GetAttribute("LimitedOfferEnds")
	if not ends then
		return nil
	end
	return ends - os.time()
end

local function available()
	local left = secondsLeft()
	return left ~= nil and left > 0 and (player:GetAttribute("LimitedBought") or "") == ""
end

local function formatLeft(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days = seconds // 86400
	local hours = (seconds % 86400) // 3600
	local minutes = (seconds % 3600) // 60
	if days > 0 then
		return ("%dd %dh %dm"):format(days, hours, minutes)
	end
	return ("%dh %dm %ds"):format(hours, minutes, seconds % 60)
end

---------------------------------------------------------------------
-- Side menu button
---------------------------------------------------------------------
local menuGui = player:WaitForChild("PlayerGui"):WaitForChild("CosmicMenu", 30)
local sideMenu = menuGui and menuGui:WaitForChild("SideMenu", 10)
local button, buttonTime
if sideMenu then
	button = new("TextButton", {
		Name = "LIMITED", LayoutOrder = -1, Size = UDim2.fromOffset(84, 84), BackgroundColor3 = Color3.fromRGB(60, 20, 20),
		BackgroundTransparency = 0.05, AutoButtonColor = false, Text = "", Visible = false, Parent = sideMenu,
	}, { corner(UDim.new(0, 18)), stroke(HOT, 3, 0) })
	label({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 4), Text = "🔥", TextSize = 32, Parent = button })
	local text = label({ Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 18), Text = "LIMITED", Font = TITLE_FONT, TextSize = 15, TextColor3 = Color3.fromRGB(255, 220, 150), Parent = button })
	textStroke(1.2).Parent = text
	buttonTime = label({ Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 16), Text = "", TextSize = 11, Parent = button })
	textStroke(1).Parent = buttonTime
	UIKit.addButtonFeel(button)
end

---------------------------------------------------------------------
-- Panel
---------------------------------------------------------------------
local gui = UIKit.screen("CosmicLimited", 3)
local holder = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(780, 500),
	BackgroundTransparency = 1, Visible = false, Parent = gui,
})
UIKit.addAutoScale(holder, 820)
local panel = new("Frame", {
	Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(26, 12, 22), BackgroundTransparency = 0.03, ClipsDescendants = true, Parent = holder,
}, { corner(UDim.new(0, 20)), stroke(HOT, 3, 0) })
local shine = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = HOT, BackgroundTransparency = 0.88, Parent = panel }, {
	new("UIGradient", { Name = "Shine", Rotation = 30, Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 1), NumberSequenceKeypoint.new(0.5, 0.1),
		NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1),
	}) }),
})
local title = label({
	Position = UDim2.fromOffset(24, 12), Size = UDim2.new(1, -90, 0, 44), Text = "🔥 LIMITED LAUNCH OFFER 🔥", Font = TITLE_FONT,
	TextSize = 36, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
UIKit.gradient(Color3.fromRGB(255, 230, 120), HOT, 0).Parent = title
textStroke(2).Parent = title
local subtitle = label({
	Position = UDim2.fromOffset(24, 56), Size = UDim2.new(1, -48, 0, 24), Text = "", TextSize = 17, RichText = true,
	TextColor3 = THEME.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
local closeButton = new("TextButton", {
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(42, 42),
	BackgroundColor3 = THEME.Bad, Text = "X", Font = TITLE_FONT, TextSize = 24, TextColor3 = THEME.Text, AutoButtonColor = false, Parent = panel,
}, { corner(UDim.new(0, 10)), textStroke(1.5) })
UIKit.addButtonFeel(closeButton)

local cards = new("Frame", {
	Position = UDim2.fromOffset(20, 96), Size = UDim2.new(1, -40, 1, -112), BackgroundTransparency = 1, Parent = panel,
}, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 14), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })

local function buy(pack)
	local id = Config.Products[pack.Key]
	if id and id ~= 0 then
		MarketplaceService:PromptProductPurchase(player, id)
	elseif Config.FreePassesInStudio and RunService:IsStudio() then
		TestProductRemote:FireServer(pack.Key)
		UIKit.toast("(Studio test) " .. pack.Name .. " given for free", THEME.Gold)
	else
		UIKit.toast("This pack isn't set up yet (CosmicConfig.Products)", THEME.Bad)
	end
end

for index, pack in ipairs(OFFER.Packs) do
	local card = new("Frame", {
		LayoutOrder = index, Size = UDim2.fromOffset(234, 380), BackgroundColor3 = Color3.fromRGB(40, 20, 36), Parent = cards,
	}, { corner(UDim.new(0, 16)), stroke(pack.Color, 2.5, 0) })
	local badge = label({ Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 60), Text = pack.Icon, TextSize = 52, Parent = card })
	task.spawn(function()
		while badge.Parent do
			tween(badge, 0.8, { Rotation = 8 }, Enum.EasingStyle.Sine)
			task.wait(0.8)
			tween(badge, 0.8, { Rotation = -8 }, Enum.EasingStyle.Sine)
			task.wait(0.8)
		end
	end)
	local name = label({ Position = UDim2.fromOffset(8, 72), Size = UDim2.new(1, -16, 0, 30), Text = pack.Name, Font = TITLE_FONT, TextSize = 22, TextColor3 = UIKit.readable(pack.Color, 0.85), Parent = card })
	textStroke(1.5).Parent = name
	local list = {}
	for _, line in ipairs(pack.Gives) do
		table.insert(list, "✔ " .. line)
	end
	label({
		Position = UDim2.fromOffset(14, 110), Size = UDim2.new(1, -28, 0, 170), Text = table.concat(list, "\n\n"), TextSize = 15,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = card,
	})
	local buyButton = new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(1, -28, 0, 52),
		BackgroundColor3 = pack.Color, Text = ("R$ %s"):format(OFFER.PriceText), Font = TITLE_FONT, TextSize = 26,
		TextColor3 = THEME.Text, AutoButtonColor = false, Parent = card,
	}, { corner(UDim.new(0, 12)), textStroke(2) })
	UIKit.addButtonFeel(buyButton)
	buyButton.Activated:Connect(function()
		buy(pack)
	end)
end

local open = false
local function setOpen(value)
	if value == open then
		return
	end
	open = value and available()
	if open then
		UIKit.announcePanel("Limited")
		holder.Visible = true
		UIKit.popIn(panel)
		SoundFX.Chime(1, 4)
	else
		holder.Visible = false
	end
end
if button then
	button.Activated:Connect(function()
		setOpen(not open)
	end)
end
closeButton.Activated:Connect(function()
	setOpen(false)
end)
UIKit.PanelOpened:Connect(function(name)
	if name ~= "Limited" then
		setOpen(false)
	end
end)

-- countdown + pulsing button
RunService.RenderStepped:Connect(function()
	local isOn = available()
	if button then
		button.Visible = isOn
		if isOn then
			buttonTime.Text = formatLeft(secondsLeft())
			local pulse = (math.sin(os.clock() * 4) + 1) / 2
			button.BackgroundColor3 = Color3.fromRGB(60, 20, 20):Lerp(Color3.fromRGB(120, 40, 20), pulse)
		end
	end
	if open then
		if not isOn then
			setOpen(false)
			return
		end
		subtitle.Text = ("Pick <b>ONE</b> pack • super strong • ends in <font color='#ffb46a'><b>%s</b></font>"):format(formatLeft(secondsLeft()))
		local g = shine:FindFirstChild("Shine")
		if g then
			g.Offset = Vector2.new(((os.clock() * 0.3) % 2) - 1, 0)
		end
	end
end)

-- show it once, a little after joining (waits until other windows, like the
-- daily reward, are closed)
local function anyPanelOpen()
	local playerGui = player:FindFirstChild("PlayerGui")
	for _, name in ipairs({ "CosmicQuests", "CosmicPets", "CosmicRebirth", "CosmicMenu" }) do
		local screen = playerGui and playerGui:FindFirstChild(name)
		if screen then
			for _, child in ipairs(screen:GetChildren()) do
				if child:IsA("Frame") and child.Name ~= "SideMenu" and child.Visible then
					return true
				end
			end
		end
	end
	return false
end
task.spawn(function()
	task.wait(9)
	for _ = 1, 120 do
		if not available() then
			return
		end
		if not anyPanelOpen() then
			task.wait(1.5)
			if not anyPanelOpen() then
				setOpen(true)
				return
			end
		end
		task.wait(1)
	end
end)

player:GetAttributeChangedSignal("LimitedBought"):Connect(function()
	if (player:GetAttribute("LimitedBought") or "") ~= "" then
		setOpen(false)
		SoundFX.Jingle("Victory")
		UIKit.confetti({ HOT, THEME.Gold, Color3.new(1, 1, 1) }, 120)
		UIKit.toast("🔥 Limited pack unlocked! Thank you!", THEME.Gold)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="33">
        <Properties>
          <string name="Name">NameplateStyler</string>
          <string name="Source"><![CDATA[-- NameplateStyler (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Makes every floating sign in the world (parkour, portals, eggs, cores,
-- islands...) easy to read:
--   * drawn on top of objects, so a wall or platform never cuts the text off
--   * a bit smaller and sized in the world, so far-away signs shrink instead
--     of covering your screen
--   * see-through, and they fade out more the further away you are
-- Only map signs are changed (not health bars or player name tags).

local Players = game:GetService("Players")

local camera = workspace.CurrentCamera

-- the map models whose signs we style
local ROOTS = {
	"CosmicIsland", "LuckyIsland", "ParkourCourses", "RebirthIslands",
	"PetHatcheries", "DuelIsland", "CosmicSkyDecor",
}
local PIXELS_PER_STUD = 48 -- 320 px wide sign -> about 6.7 studs wide
local NEAR = 30 -- closer than this: clearest
local BASE_TEXT = 0.12 -- text transparency up close
local FAR_TEXT = 0.6 -- text transparency at the edge of its range

local styled = {} -- [BillboardGui] = { Labels = {...}, Strokes = {...} }

local function isCharacterPart(gui)
	local node = gui.Parent
	while node and node ~= workspace do
		if node:IsA("Model") and Players:GetPlayerFromCharacter(node) then
			return true
		end
		node = node.Parent
	end
	return false
end

local function anchorPosition(gui)
	local target = gui.Adornee or gui.Parent
	if target and target:IsA("BasePart") then
		return target.Position + gui.StudsOffset
	elseif target and target:IsA("Attachment") then
		return target.WorldPosition + gui.StudsOffset
	end
	return nil
end

local applying = false
local function resize(gui)
	local size = gui.Size
	-- pixel sizes become world sizes (and 20% smaller than before)
	if size.X.Offset > 0 or size.Y.Offset > 0 then
		applying = true
		gui.Size = UDim2.new(size.X.Offset / PIXELS_PER_STUD, 0, size.Y.Offset / PIXELS_PER_STUD, 0)
		applying = false
	end
end

local function style(gui)
	if styled[gui] or isCharacterPart(gui) then
		return
	end
	local entry = { Labels = {}, Strokes = {} }
	styled[gui] = entry
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = math.min(gui.MaxDistance > 0 and gui.MaxDistance or 150, 180)
	resize(gui)
	-- if a script changes the size later, convert the new size too
	gui:GetPropertyChangedSignal("Size"):Connect(function()
		if not applying then
			resize(gui)
		end
	end)
	local function collect(item)
		if item:IsA("TextLabel") then
			table.insert(entry.Labels, item)
		elseif item:IsA("UIStroke") then
			table.insert(entry.Strokes, item)
		end
	end
	for _, item in ipairs(gui:GetDescendants()) do
		collect(item)
	end
	gui.DescendantAdded:Connect(collect)
	gui.Destroying:Connect(function()
		styled[gui] = nil
	end)
end

local function watchRoot(root)
	for _, item in ipairs(root:GetDescendants()) do
		if item:IsA("BillboardGui") then
			style(item)
		end
	end
	root.DescendantAdded:Connect(function(item)
		if item:IsA("BillboardGui") then
			task.defer(style, item)
		end
	end)
end

for _, name in ipairs(ROOTS) do
	task.spawn(function()
		local root = workspace:WaitForChild(name, 60)
		if root then
			watchRoot(root)
		end
	end)
end
-- roots that get rebuilt later (or show up after we start)
workspace.ChildAdded:Connect(function(child)
	if table.find(ROOTS, child.Name) then
		watchRoot(child)
	end
end)

-- fade with distance (a few times a second is plenty)
task.spawn(function()
	while true do
		task.wait(0.2)
		local eye = camera.CFrame.Position
		for gui, entry in pairs(styled) do
			local position = anchorPosition(gui)
			if position then
				local range = math.max(gui.MaxDistance, NEAR + 1)
				local f = math.clamp(((position - eye).Magnitude - NEAR) / (range - NEAR), 0, 1)
				local textT = BASE_TEXT + (FAR_TEXT - BASE_TEXT) * f
				for _, label in ipairs(entry.Labels) do
					label.TextTransparency = textT
				end
				for _, s in ipairs(entry.Strokes) do
					s.Transparency = math.clamp(0.45 + f * 0.4, 0, 1)
				end
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="34">
        <Properties>
          <string name="Name">ParkourClient</string>
          <string name="Source"><![CDATA[-- ParkourClient (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Runs the parkour bits that must be smooth on your own screen:
--   * vanishing platforms blink and disappear on a shared timer
--   * spinning laser bars turn and moving platforms slide (and carry you)
--   * jump pads launch you into the air
--   * a run timer + checkpoint counter while you're on a course
--   * messages for start / checkpoint / finish (from the Parkour script)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Luck = require(ReplicatedStorage:WaitForChild("Luck"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local THEME = UIKit.Theme
local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local ParkourEvent = remotes:WaitForChild("ParkourEvent", 30)

local courses = workspace:WaitForChild("ParkourCourses", 60)
if not courses then
	warn("[ParkourClient] ParkourCourses not found")
	return
end

---------------------------------------------------------------------
-- Collect vanishing platforms, jump pads and trophies
---------------------------------------------------------------------
local vanishers, pads, trophies, spinners, movers, ices = {}, {}, {}, {}, {}, {}
for _, item in ipairs(courses:GetDescendants()) do
	if item:IsA("BasePart") then
		if item:GetAttribute("Spinner") then
			table.insert(spinners, {
				Part = item,
				Center = item:GetAttribute("SpinCenter"),
				Speed = item:GetAttribute("SpinSpeed") or 2,
				Offset = item:GetAttribute("SpinOffset") or 0,
			})
		elseif item:GetAttribute("MoveAmplitude") then
			table.insert(movers, {
				Part = item,
				Base = item.CFrame,
				Amplitude = item:GetAttribute("MoveAmplitude"),
				Period = item:GetAttribute("MovePeriod") or 3,
				Offset = item:GetAttribute("MoveOffset") or 0,
			})
		elseif item:GetAttribute("Vanish") then
			table.insert(vanishers, {
				Part = item,
				Period = item:GetAttribute("VanishPeriod") or 3,
				On = item:GetAttribute("VanishOn") or 2,
				Offset = item:GetAttribute("VanishOffset") or 0,
			})
		elseif item:GetAttribute("Slippery") then
			table.insert(ices, item)
		elseif item:GetAttribute("Launch") then
			table.insert(pads, { Part = item, Launch = item:GetAttribute("Launch") })
		elseif item.Name == "SpinGem" then
			table.insert(trophies, { Part = item, Position = item.Position })
		end
	end
end

local function standingOn(part, position)
	local localPos = part.CFrame:PointToObjectSpace(position)
	local half = part.Size / 2
	return math.abs(localPos.X) <= half.X + 0.4 and math.abs(localPos.Z) <= half.Z + 0.4
		and localPos.Y > half.Y and localPos.Y < half.Y + 3.6
end

local lastLaunch = 0
local t = 0
local slideVelocity -- your sliding speed while on ice
RunService.RenderStepped:Connect(function(dt)
	t += dt
	local now = workspace:GetServerTimeNow()
	local myCharacter = player.Character
	local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

	-- spinning laser bars (same clock as the server, so hits are fair)
	for _, spinner in ipairs(spinners) do
		if spinner.Center then
			spinner.Part.CFrame = CFrame.new(spinner.Center) * CFrame.Angles(0, now * spinner.Speed + spinner.Offset, 0)
		end
	end

	-- moving platforms; if you're standing on one it carries you along
	for _, mover in ipairs(movers) do
		local offset = mover.Amplitude * math.sin((now + mover.Offset) / mover.Period * math.pi * 2)
		local newCFrame = mover.Base + offset
		if myRoot and standingOn(mover.Part, myRoot.Position) then
			local delta = newCFrame.Position - mover.Part.Position
			myRoot.CFrame += delta
		end
		mover.Part.CFrame = newCFrame
	end

	-- ice: you keep sliding, so speeding up and stopping is slow
	local onIce = false
	if myRoot then
		for _, ice in ipairs(ices) do
			if standingOn(ice, myRoot.Position) then
				onIce = true
				break
			end
		end
	end
	if onIce then
		local velocity = myRoot.AssemblyLinearVelocity
		local flat = Vector3.new(velocity.X, 0, velocity.Z)
		slideVelocity = slideVelocity and slideVelocity:Lerp(flat, math.min(1, dt * 1.6)) or flat
		myRoot.AssemblyLinearVelocity = Vector3.new(slideVelocity.X, velocity.Y, slideVelocity.Z)
	else
		slideVelocity = nil
	end

	-- vanishing platforms: solid, then blink, then gone
	for _, v in ipairs(vanishers) do
		local phase = (now + v.Offset) % v.Period
		local visible = phase < v.On
		local warning = visible and phase > v.On - 0.6
		v.Part.CanCollide = visible
		if not visible then
			v.Part.Transparency = 0.9
		elseif warning then
			v.Part.Transparency = (math.floor(phase * 12) % 2 == 0) and 0.15 or 0.6
		else
			v.Part.Transparency = 0.15
		end
	end

	-- jump pads
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and os.clock() - lastLaunch > 0.6 then
		for _, pad in ipairs(pads) do
			if standingOn(pad.Part, root.Position) then
				lastLaunch = os.clock()
				root.AssemblyLinearVelocity = pad.Launch
				SoundFX.Play("Whoosh", { Speed = 1.3, Volume = 1.2 })
				break
			end
		end
	end

	-- spinning finish trophies
	for _, trophy in ipairs(trophies) do
		trophy.Part.CFrame = CFrame.new(trophy.Position + Vector3.new(0, math.sin(t * 2) * 0.4, 0))
			* CFrame.Angles(0, t * 1.5, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45))
	end
end)

---------------------------------------------------------------------
-- Run timer (top of the screen while you're on a course)
---------------------------------------------------------------------
local gui = UIKit.screen("CosmicParkour", 5)
local timerPanel = UIKit.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 12),
	Size = UDim2.fromOffset(420, 46),
	BackgroundColor3 = THEME.Panel,
	BackgroundTransparency = 0.15,
	Visible = false,
	Parent = gui,
}, { UIKit.corner(UDim.new(0, 14)), UIKit.stroke(Color3.fromRGB(90, 240, 200), 2, 0) })
UIKit.addAutoScale(timerPanel)
local timerLabel = UIKit.label({
	Size = UDim2.fromScale(1, 1),
	Text = "",
	Font = UIKit.TitleFont,
	TextSize = 22,
	RichText = true,
	Parent = timerPanel,
})

local checkpointText = ""
RunService.RenderStepped:Connect(function()
	local course = player:GetAttribute("ParkourCourse")
	local started = player:GetAttribute("ParkourStart")
	if course and started then
		timerPanel.Visible = true
		local seconds = workspace:GetServerTimeNow() - started
		timerLabel.Text = ("🏃 %s   <font color='#9fe8ff'>⏱ %d:%04.1f</font>%s"):format(
			course, seconds // 60, seconds % 60, checkpointText)
	else
		timerPanel.Visible = false
	end
end)

---------------------------------------------------------------------
-- Messages from the server
---------------------------------------------------------------------
if ParkourEvent then
	ParkourEvent.OnClientEvent:Connect(function(info)
		if info.Type == "Start" then
			checkpointText = ""
			UIKit.toast("🏁 " .. info.Course .. " - GO! No checkpoints: fall and you start over", Color3.fromRGB(120, 255, 170))
			SoundFX.Play("Pop", { Speed = 1.3 })
		elseif info.Type == "Checkpoint" then
			checkpointText = ("   <font color='#78ffaa'>✔ %d/%d</font>"):format(info.Number, info.Total)
			UIKit.toast(("✔ Checkpoint %d/%d saved!"):format(info.Number, info.Total), Color3.fromRGB(120, 255, 170))
			SoundFX.Chime(1.2, 3)
		elseif info.Type == "Ouch" then
			UIKit.toast("💥 Ouch! Back to the start", THEME.Bad)
			SoundFX.Play("Thud")
		elseif info.Type == "Left" then
			checkpointText = ""
			UIKit.toast("Run cancelled", THEME.SubText)
		elseif info.Type == "Finish" then
			checkpointText = ""
			local timeText = ("%d:%04.1f"):format(info.Time // 60, info.Time % 60)
			if info.Rewarded then
				UIKit.toast(("🏆 %s done in %s! x%s luck for %d min"):format(
					info.Course, timeText, Luck.Format(info.Multiplier), info.Minutes), THEME.Gold)
				UIKit.confetti({ THEME.Gold, Color3.fromRGB(120, 255, 170), THEME.Accent2 }, 90)
				SoundFX.Chime(1, 5)
				SoundFX.Play("RevealLegendary", { Volume = 0.6 })
			else
				UIKit.toast(("🏆 Done in %s! Reward ready again in %s"):format(
					timeText, Luck.FormatTime(info.CooldownLeft)), THEME.Gold)
				SoundFX.Chime(1.2, 3)
			end
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="35">
        <Properties>
          <string name="Name">PetClient</string>
          <string name="Source"><![CDATA[-- PetClient (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Pets on your screen:
--   * 🐾 PETS button + panel: your pets (3D previews), equip up to 3
--   * egg panel when you press E at an egg: price, odds, HATCH button
--   * the hatching animation (egg wobbles, cracks, pet pops out)
--   * everyone's equipped pets float behind them, each kind moving in its
--     own way (wings flap, fish wiggle, stars spin, wisps orbit...)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))
local PetData = require(ReplicatedStorage:WaitForChild("PetData"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local THEME = UIKit.Theme
local TITLE_FONT = UIKit.TitleFont
local new, corner, stroke, textStroke, tween, label =
	UIKit.new, UIKit.corner, UIKit.stroke, UIKit.textStroke, UIKit.tween, UIKit.label

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local HatchRemote = remotes:WaitForChild("HatchEgg")
local PetRemote = remotes:WaitForChild("PetAction")
local GetDataRemote = remotes:WaitForChild("GetData")
local DataUpdatedRemote = remotes:WaitForChild("DataUpdated")

local myData = { Inventory = {}, Pets = {}, EquippedPets = {} }

---------------------------------------------------------------------
-- BUILDING A PET (used for followers AND the 3D previews)
---------------------------------------------------------------------
local function piece(model, props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "ClassName" and key ~= "Offset" and key ~= "Role" then
			p[key] = value
		end
	end
	p:SetAttribute("Role", props.Role or "Body")
	p.CFrame = props.Offset or CFrame.new()
	p.Parent = model
	return p
end

local function eyes(model, z, y, spread, size)
	for _, side in ipairs({ -1, 1 }) do
		piece(model, { Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * size, Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic,
			Offset = CFrame.new(side * spread, y, z) })
		piece(model, { Name = "Pupil", Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.55, Color = Color3.fromRGB(20, 20, 30), Material = Enum.Material.SmoothPlastic,
			Offset = CFrame.new(side * spread, y, z - size * 0.3) })
	end
end

local BUILDERS = {}

BUILDERS.Blob = function(model, c1, c2)
	piece(model, { Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 1.8, 2.2), Color = c1, Material = Enum.Material.SmoothPlastic })
	piece(model, { Name = "Shine", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.5, Color = c2, Material = Enum.Material.Neon, Offset = CFrame.new(0.5, 0.55, -0.6) })
	eyes(model, -0.95, 0.15, 0.4, 0.45)
end

BUILDERS.Cat = function(model, c1, c2)
	piece(model, { Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.9, Color = c1, Material = Enum.Material.SmoothPlastic })
	for _, side in ipairs({ -1, 1 }) do
		piece(model, { ClassName = "WedgePart", Name = "Ear", Size = Vector3.new(0.25, 0.8, 0.6), Color = c2, Material = Enum.Material.SmoothPlastic,
			Offset = CFrame.new(side * 0.55, 1, -0.1) * CFrame.Angles(0, math.pi / 2, 0) })
	end
	piece(model, { Name = "Tail", Size = Vector3.new(0.25, 0.25, 1.4), Color = c2, Material = Enum.Material.Neon, Role = "Tail",
		Offset = CFrame.new(0, 0.2, 1.3) * CFrame.Angles(0.6, 0, 0) })
	eyes(model, -0.82, 0.2, 0.38, 0.42)
end

BUILDERS.Bunny = function(model, c1, c2)
	piece(model, { Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.8, Color = c1, Material = Enum.Material.SmoothPlastic })
	for _, side in ipairs({ -1, 1 }) do
		piece(model, { Name = "Ear", Size = Vector3.new(0.35, 1.5, 0.2), Color = c1, Material = Enum.Material.SmoothPlastic, Role = "Ear",
			Offset = CFrame.new(side * 0.4, 1.4, 0) * CFrame.Angles(0, 0, -side * 0.2) })
		piece(model, { Name = "EarInside", Size = Vector3.new(0.18, 1.1, 0.05), Color = c2, Material = Enum.Material.Neon, Role = "Ear",
			Offset = CFrame.new(side * 0.4, 1.4, -0.11) * CFrame.Angles(0, 0, -side * 0.2) })
	end
	piece(model, { Name = "Tail", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic, Offset = CFrame.new(0, -0.3, 0.9) })
	eyes(model, -0.78, 0.15, 0.35, 0.4)
end

BUILDERS.Bird = function(model, c1, c2)
	piece(model, { Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.7, 1.8), Color = c1, Material = Enum.Material.SmoothPlastic })
	piece(model, { Name = "Belly", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.3, 1.2), Color = c2, Material = Enum.Material.SmoothPlastic, Offset = CFrame.new(0, -0.15, -0.35) })
	piece(model, { ClassName = "WedgePart", Name = "Beak", Size = Vector3.new(0.35, 0.3, 0.6), Color = Color3.fromRGB(255, 190, 60), Material = Enum.Material.SmoothPlastic,
		Offset = CFrame.new(0, 0.05, -1.05) * CFrame.Angles(0, math.pi, 0) })
	for _, side in ipairs({ -1, 1 }) do
		piece(model, { Name = "Wing", Size = Vector3.new(1.4, 0.15, 0.9), Color = c2, Material = Enum.Material.Neon, Role = side < 0 and "WingL" or "WingR",
			Offset = CFrame.new(side * 1.2, 0.2, 0.1) })
	end
	eyes(model, -0.75, 0.35, 0.33, 0.35)
end

BUILDERS.Fish = function(model, c1, c2)
	piece(model, { Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.5, 2.3), Color = c1, Material = Enum.Material.SmoothPlastic })
	piece(model, { ClassName = "WedgePart", Name = "Tail", Size = Vector3.new(0.15, 1.3, 1), Color = c2, Material = Enum.Material.Neon, Role = "Tail",
		Offset = CFrame.new(0, 0, 1.5) })
	piece(model, { ClassName = "WedgePart", Name = "Fin", Size = Vector3.new(0.12, 0.7, 0.9), Color = c2, Material = Enum.Material.Neon, Offset = CFrame.new(0, 0.85, 0.2) })
	eyes(model, -0.85, 0.2, 0.42, 0.36)
end

BUILDERS.Jelly = function(model, c1, c2)
	piece(model, { Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 1.5, 2), Color = c1, Material = Enum.Material.Neon, Transparency = 0.25 })
	for k = 1, 5 do
		local a = k / 5 * math.pi * 2
		piece(model, { Name = "Tentacle", Size = Vector3.new(0.15, 1.6, 0.15), Color = c2, Material = Enum.Material.Neon, Role = "Tentacle",
			Offset = CFrame.new(math.cos(a) * 0.55, -1.2, math.sin(a) * 0.55) })
	end
	eyes(model, -0.8, 0.1, 0.35, 0.35)
end

BUILDERS.Dragon = function(model, c1, c2)
	piece(model, { Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(1.7, 1.6, 2.2), Color = c1, Material = Enum.Material.SmoothPlastic })
	piece(model, { Name = "Head", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.3, Color = c1, Material = Enum.Material.SmoothPlastic, Offset = CFrame.new(0, 0.7, -1.2) })
	for _, side in ipairs({ -1, 1 }) do
