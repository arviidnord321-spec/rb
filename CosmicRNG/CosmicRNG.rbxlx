      <Item class="LocalScript" referent="37">
        <Properties>
          <string name="Name">RebirthClient</string>
          <string name="Source"><![CDATA[-- RebirthClient (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Everything about rebirths on your screen:
--   * the ⭐ REBIRTH button + panel (progress bars, rewards, all unlocks)
--   * the big rebirth celebration (and a pillar of light everyone sees)
--   * the Rebirth Trail perk (on everyone who has it)
--   * the Double Jump perk

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))
local Rebirth = require(ReplicatedStorage:WaitForChild("Rebirth"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local THEME = UIKit.Theme
local TITLE_FONT = UIKit.TitleFont
local new, corner, stroke, textStroke, tween, label =
	UIKit.new, UIKit.corner, UIKit.stroke, UIKit.textStroke, UIKit.tween, UIKit.label

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local RebirthRemote = remotes:WaitForChild("Rebirth")
local AnnounceRemote = remotes:WaitForChild("Announce")

local STAR_GOLD = Color3.fromRGB(255, 210, 90)

local function rebirths()
	return player:GetAttribute("Rebirths") or 0
end

---------------------------------------------------------------------
-- SIDE MENU BUTTON (added to the menu the StoreUI script makes)
---------------------------------------------------------------------
local menuGui = player:WaitForChild("PlayerGui"):WaitForChild("CosmicMenu", 30)
local sideMenu = menuGui and menuGui:WaitForChild("SideMenu", 10)

local menuButton, readyDot
if sideMenu then
	menuButton = new("TextButton", {
		Name = "REBIRTH",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(84, 84),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.1,
		AutoButtonColor = false,
		Text = "",
		Parent = sideMenu,
	}, { corner(UDim.new(0, 18)), stroke(Color3.fromRGB(140, 220, 255), 2.5, 0) })
	local icon = label({ Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 6), Text = "⭐", TextSize = 38, Parent = menuButton })
	local text = label({
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -6), Size = UDim2.new(1, 0, 0, 20),
		Text = "REBIRTH", Font = TITLE_FONT, TextSize = 15, Parent = menuButton,
	})
	textStroke(1.2).Parent = text
	readyDot = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = THEME.Good, Visible = false, Parent = menuButton,
	}, { corner(UDim.new(1, 0)), stroke(Color3.new(1, 1, 1), 2, 0) })
	label({ Size = UDim2.fromScale(1, 1), Text = "!", Font = TITLE_FONT, TextSize = 16, Parent = readyDot })
	UIKit.addButtonFeel(menuButton)
	-- the star slowly spins
	task.spawn(function()
		while icon.Parent do
			tween(icon, 2, { Rotation = 360 }, Enum.EasingStyle.Linear)
			task.wait(2)
			icon.Rotation = 0
			task.wait(3)
		end
	end)
else
	warn("[RebirthClient] SideMenu not found, open the rebirth panel at the Rebirth Altar")
end

---------------------------------------------------------------------
-- REBIRTH PANEL
---------------------------------------------------------------------
local gui = UIKit.screen("CosmicRebirth", 2)
local holder = new("Frame", {
	Name = "RebirthHolder",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.47),
	Size = UDim2.fromOffset(620, 560),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})
UIKit.addAutoScale(holder, 800)

local panel = new("Frame", {
	Name = "Rebirth",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = THEME.Panel,
	BackgroundTransparency = 0.05,
	ClipsDescendants = true,
	Parent = holder,
}, { corner(UDim.new(0, 18)), stroke(Color3.fromRGB(140, 220, 255), 2.5, 0) })

-- slow moving shine in the background
local shine = new("Frame", {
	Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(120, 160, 255), BackgroundTransparency = 0.85,
	ZIndex = 0, Parent = panel,
}, {
	corner(UDim.new(0, 18)),
	new("UIGradient", {
		Name = "Shine",
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 1), NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1),
		}),
		Rotation = 25,
	}),
})

local titleLabel = label({
	Position = UDim2.fromOffset(22, 12), Size = UDim2.new(1, -80, 0, 40), Text = "⭐ REBIRTH",
	Font = TITLE_FONT, TextSize = 32, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
UIKit.gradient(Color3.fromRGB(150, 230, 255), Color3.fromRGB(255, 200, 110), 0).Parent = titleLabel
label({
	Position = UDim2.fromOffset(22, 50), Size = UDim2.new(1, -44, 0, 22),
	Text = "You KEEP all your auras • every rebirth is harder but better", TextSize = 15, TextColor3 = THEME.SubText,
	TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
local closeButton = new("TextButton", {
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(42, 42),
	BackgroundColor3 = THEME.Bad, Text = "X", Font = TITLE_FONT, TextSize = 24, TextColor3 = THEME.Text,
	AutoButtonColor = false, Parent = panel,
}, { corner(UDim.new(0, 10)), textStroke(1.5) })
UIKit.addButtonFeel(closeButton)

-- current level
local levelLabel = label({
	Position = UDim2.fromOffset(22, 80), Size = UDim2.new(1, -44, 0, 34), Text = "",
	Font = TITLE_FONT, TextSize = 26, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
textStroke(1.5).Parent = levelLabel

-- a requirement row with a progress bar
local function requirementRow(y, icon)
	local row = new("Frame", {
		Position = UDim2.fromOffset(18, y), Size = UDim2.new(1, -36, 0, 58),
		BackgroundColor3 = THEME.PanelLight, Parent = panel,
	}, { corner(UDim.new(0, 12)) })
	label({ Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(40, 58), Text = icon, TextSize = 28, Parent = row })
	local text = label({
		Position = UDim2.fromOffset(56, 6), Size = UDim2.new(1, -110, 0, 22), Text = "", TextSize = 17,
		RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local barBack = new("Frame", {
		Position = UDim2.fromOffset(56, 34), Size = UDim2.new(1, -110, 0, 14),
		BackgroundColor3 = Color3.fromRGB(14, 10, 26), Parent = row,
	}, { corner(UDim.new(1, 0)) })
	local barFill = new("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = barBack,
	}, { corner(UDim.new(1, 0)), UIKit.gradient(Color3.fromRGB(110, 210, 255), Color3.fromRGB(190, 130, 255), 0) })
	local check = label({
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(40, 40),
		Text = "", TextSize = 28, Parent = row,
	})
	return { Text = text, Fill = barFill, Check = check }
end
local rollsRow = requirementRow(122, "🎲")
local rareRow = requirementRow(188, "💎")

-- rewards for the next rebirth
local rewardBox = new("Frame", {
	Position = UDim2.fromOffset(18, 256), Size = UDim2.new(1, -36, 0, 92),
	BackgroundColor3 = Color3.fromRGB(28, 40, 70), Parent = panel,
}, { corner(UDim.new(0, 12)), stroke(Color3.fromRGB(110, 210, 255), 1.5, 0.3) })
label({
	Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 22), Text = "NEXT REBIRTH GIVES",
	Font = TITLE_FONT, TextSize = 18, TextColor3 = Color3.fromRGB(150, 230, 255),
	TextXAlignment = Enum.TextXAlignment.Left, Parent = rewardBox,
})
local rewardText = label({
	Position = UDim2.fromOffset(12, 30), Size = UDim2.new(1, -24, 1, -34), Text = "", TextSize = 16,
	RichText = true, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top, Parent = rewardBox,
})

-- the big button
local rebirthButton = new("TextButton", {
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 358), Size = UDim2.fromOffset(300, 56),
	BackgroundColor3 = THEME.Good, Text = "REBIRTH!", Font = TITLE_FONT, TextSize = 30, TextColor3 = THEME.Text,
	AutoButtonColor = false, Parent = panel,
}, { corner(UDim.new(0, 14)), textStroke(2), stroke(Color3.new(1, 1, 1), 2, 0.4) })
UIKit.addButtonFeel(rebirthButton)
local buttonGlow = new("UIGradient", {
	Color = ColorSequence.new(Color3.fromRGB(120, 255, 170), Color3.fromRGB(70, 200, 255)),
	Rotation = 0,
	Parent = rebirthButton,
})

-- every unlock
local perkList = new("ScrollingFrame", {
	Position = UDim2.fromOffset(16, 426), Size = UDim2.new(1, -32, 1, -438),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
	ScrollBarImageColor3 = Color3.fromRGB(140, 220, 255), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	Parent = panel,
}, {
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 6) }),
})
local perkRows = {}
for index, perk in ipairs(Config.Rebirth.Perks) do
	local row = new("Frame", {
		LayoutOrder = index, Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = THEME.PanelLight, Parent = perkList,
	}, { corner(UDim.new(0, 10)) })
	label({ Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(36, 44), Text = perk.Icon, TextSize = 24, Parent = row })
	label({
		Position = UDim2.fromOffset(50, 3), Size = UDim2.new(1, -170, 0, 20), Text = perk.Name, Font = TITLE_FONT, TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	label({
		Position = UDim2.fromOffset(50, 22), Size = UDim2.new(1, -170, 0, 18), Text = perk.Description, TextSize = 12,
		TextColor3 = THEME.SubText, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
	})
	local status = label({
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(110, 30),
		Text = "", Font = TITLE_FONT, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
	})
	perkRows[index] = { Row = row, Status = status, Perk = perk }
end

---------------------------------------------------------------------
-- Filling in the panel
---------------------------------------------------------------------
local function percent(scale)
	return math.floor((1 - scale) * 100 + 0.5)
end

local function refresh()
	local progress = Rebirth.Progress(player)
	local n = progress.Rebirths
	local color = Rebirth.Color(math.max(n, 1))
	if n > 0 then
		levelLabel.Text = ("<font color='#%s'>%s Rebirth %d</font>   <font color='#bfb4e1' size='18'>Luck x%s • rolls %d%% faster</font>"):format(
			color:ToHex(), Rebirth.Stars(n), n, tostring(Rebirth.LuckMultiplier(n)), percent(Rebirth.CooldownScale(n)))
	else
		levelLabel.Text = "<font color='#bfb4e1'>No rebirths yet - reach the goals below!</font>"
	end

	local cost = progress.Cost
	local rollsDone = math.min(progress.Rolls, cost.Rolls)
	rollsRow.Text.Text = ("Roll <b>%s</b> times <font color='#bfb4e1'>(%s / %s)</font>"):format(
		AuraData.FormatNumber(cost.Rolls), AuraData.FormatNumber(rollsDone), AuraData.FormatNumber(cost.Rolls))
	tween(rollsRow.Fill, 0.3, { Size = UDim2.fromScale(math.clamp(progress.Rolls / cost.Rolls, 0, 1), 1) })
	rollsRow.Check.Text = progress.RollsDone and "✅" or ""

	local bestText = progress.Best > 0 and AuraData.FormatChance(progress.Best) or "nothing yet"
	rareRow.Text.Text = ("Roll a <b>%s</b> aura or rarer <font color='#bfb4e1'>(best: %s)</font>"):format(
		AuraData.FormatChance(cost.Rarity), bestText)
	local rareScale = progress.Best > 0 and math.clamp(math.log(progress.Best) / math.log(cost.Rarity), 0, 1) or 0
	tween(rareRow.Fill, 0.3, { Size = UDim2.fromScale(rareScale, 1) })
	rareRow.Check.Text = progress.RarityDone and "✅" or ""

	-- what the next one gives
	local nextN = n + 1
	local lines = {
		("🍀 Luck <b>x%s</b> → <font color='#78ffaa'><b>x%s</b></font>  forever"):format(
			tostring(Rebirth.LuckMultiplier(n)), tostring(Rebirth.LuckMultiplier(nextN))),
		("⚡ Rolling <b>%d%%</b> → <font color='#78ffaa'><b>%d%%</b></font> faster"):format(
			percent(Rebirth.CooldownScale(n)), percent(Rebirth.CooldownScale(nextN))),
	}
	local perks = Rebirth.PerksAt(nextN)
	if #perks > 0 then
		local names = {}
		for _, perk in ipairs(perks) do
			table.insert(names, perk.Icon .. " " .. perk.Name)
		end
		table.insert(lines, "<font color='#ffd76a'><b>UNLOCKS: " .. table.concat(names, ", ") .. "</b></font>")
	else
		table.insert(lines, ("<font color='#%s'>%s</font> a new star on your name"):format(Rebirth.Color(nextN):ToHex(), Rebirth.Stars(nextN)))
	end
	rewardText.Text = table.concat(lines, "\n")

	-- the button
	if progress.Ready then
		rebirthButton.Text = "⭐ REBIRTH! ⭐"
		rebirthButton.BackgroundColor3 = THEME.Good
		buttonGlow.Enabled = true
	else
		rebirthButton.Text = "NOT READY YET"
		rebirthButton.BackgroundColor3 = Color3.fromRGB(70, 66, 90)
		buttonGlow.Enabled = false
	end
	if readyDot then
		readyDot.Visible = progress.Ready
	end

	-- the unlock list
	for _, entry in pairs(perkRows) do
		local unlocked = n >= entry.Perk.Rebirths
		entry.Status.Text = unlocked and "✅ UNLOCKED" or ("🔒 Rebirth %d"):format(entry.Perk.Rebirths)
		entry.Status.TextColor3 = unlocked and THEME.Good or THEME.SubText
		entry.Row.BackgroundColor3 = unlocked and Color3.fromRGB(30, 58, 52) or THEME.PanelLight
	end
end

for _, attribute in ipairs({ "Rebirths", "RebirthRolls", "RebirthBest" }) do
	player:GetAttributeChangedSignal(attribute):Connect(refresh)
end
refresh()

-- the ready dot pulses
task.spawn(function()
	while gui.Parent do
		if readyDot and readyDot.Visible then
			tween(readyDot, 0.4, { Size = UDim2.fromOffset(28, 28) }, Enum.EasingStyle.Sine)
			task.wait(0.4)
			tween(readyDot, 0.4, { Size = UDim2.fromOffset(22, 22) }, Enum.EasingStyle.Sine)
		end
		task.wait(0.5)
	end
end)

---------------------------------------------------------------------
-- Open / close
---------------------------------------------------------------------
local open = false
local function setOpen(value)
	if value == open then
		return
	end
	open = value
	if open then
		UIKit.announcePanel("Rebirth")
		refresh()
		holder.Visible = true
		UIKit.popIn(panel)
	else
		holder.Visible = false
	end
end
if menuButton then
	menuButton.Activated:Connect(function()
		setOpen(not open)
	end)
end
closeButton.Activated:Connect(function()
	setOpen(false)
end)
UIKit.PanelOpened:Connect(function(name)
	if name ~= "Rebirth" then
		setOpen(false)
	end
end)

-- pressing E at the Rebirth Altar opens the panel
task.spawn(function()
	local islands = workspace:WaitForChild("RebirthIslands", 60)
	local gate = islands and islands:WaitForChild("RebirthGate", 30)
	local pedestal = gate and gate:WaitForChild("RebirthPedestal", 30)
	local prompt = pedestal and pedestal:WaitForChild("RebirthAltarPrompt", 30)
	if prompt then
		prompt.Triggered:Connect(function()
			setOpen(true)
		end)
	end
end)

-- shine sweep + button glow animation
RunService.RenderStepped:Connect(function()
	if not open then
		return
	end
	local t = os.clock()
	local shineGradient = shine:FindFirstChild("Shine")
	if shineGradient then
		shineGradient.Offset = Vector2.new(((t * 0.25) % 2) - 1, 0)
	end
	buttonGlow.Rotation = (t * 60) % 360
end)

---------------------------------------------------------------------
-- THE CELEBRATION
---------------------------------------------------------------------
local fxGui = UIKit.screen("CosmicRebirthFX", 45)
local camera = workspace.CurrentCamera

local function celebrate(n, unlocked)
	setOpen(false)
	local color = Rebirth.Color(n)
	SoundFX.Jingle("Rebirth")

	-- 1) build-up: screen darkens, the camera zooms in
	local dark = new("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Parent = fxGui,
	})
	tween(dark, 1, { BackgroundTransparency = 0.45 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local fov = camera.FieldOfView
	tween(camera, 1.1, { FieldOfView = fov - 18 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local rings = {}
	for i = 1, 3 do
		local ring = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45),
			Size = UDim2.fromOffset(900 - i * 150, 900 - i * 150), BackgroundTransparency = 1, Parent = fxGui,
		}, { corner(UDim.new(1, 0)), stroke(color, 4, 0.2) })
		tween(ring, 1.1, { Size = UDim2.fromOffset(20, 20) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		table.insert(rings, ring)
	end
	task.wait(1.1)
	for _, ring in ipairs(rings) do
		ring:Destroy()
	end

	-- 2) BOOM
	camera.FieldOfView = fov + 14
	tween(camera, 0.8, { FieldOfView = fov }, Enum.EasingStyle.Quart)
	local flash = new("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, Parent = fxGui,
	})
	tween(flash, 0.25, { BackgroundColor3 = color }, Enum.EasingStyle.Linear)
	task.delay(0.25, function()
		tween(flash, 0.9, { BackgroundTransparency = 1 })
	end)
	tween(dark, 1.2, { BackgroundTransparency = 1 })
	UIKit.burst({ color, STAR_GOLD, Color3.new(1, 1, 1) }, 60, 1.6, Vector2.new(0.5, 0.45))
	UIKit.confetti({ color, STAR_GOLD, THEME.Accent, THEME.Accent2 }, 120)

	-- shockwave ring
	local wave = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(40, 40),
		BackgroundTransparency = 1, Parent = fxGui,
	}, { corner(UDim.new(1, 0)), stroke(Color3.new(1, 1, 1), 10, 0) })
	tween(wave, 0.8, { Size = UDim2.fromOffset(1600, 1600) }, Enum.EasingStyle.Quart)
	tween(wave:FindFirstChildOfClass("UIStroke"), 0.8, { Transparency = 1, Thickness = 1 })

	-- big title
	local title = label({
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromOffset(900, 110),
		Text = "REBIRTH " .. n .. "!", Font = TITLE_FONT, TextSize = 96, Parent = fxGui,
	})
	UIKit.gradient(Color3.new(1, 1, 1), color, 90).Parent = title
	textStroke(4).Parent = title
	local titleScale = new("UIScale", { Scale = 3, Parent = title })
	tween(titleScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	local stars = label({
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.46), Size = UDim2.fromOffset(600, 60),
		Text = Rebirth.Stars(n), Font = TITLE_FONT, TextSize = 54, TextColor3 = STAR_GOLD, Parent = fxGui,
	})
	textStroke(3).Parent = stars
	local sub = label({
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.53), Size = UDim2.fromOffset(800, 36),
		Text = ("Luck x%s forever  •  rolling %d%% faster"):format(tostring(Rebirth.LuckMultiplier(n)), percent(Rebirth.CooldownScale(n))),
		Font = TITLE_FONT, TextSize = 28, TextColor3 = Color3.fromRGB(150, 255, 190), TextTransparency = 1, Parent = fxGui,
	})
	textStroke(2).Parent = sub
	task.delay(0.4, function()
		tween(sub, 0.4, { TextTransparency = 0 })
	end)

	-- 3) one card per unlock
	local cards = {}
	for index, perkName in ipairs(unlocked or {}) do
		local perk
		for _, p in ipairs(Config.Rebirth.Perks) do
			if p.Name == perkName then
				perk = p
			end
		end
		if perk then
			local card = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, (index - (#unlocked + 1) / 2) * 270, 0.6, 0),
				Size = UDim2.fromOffset(250, 120), BackgroundColor3 = THEME.Panel, Parent = fxGui,
			}, { corner(UDim.new(0, 16)), stroke(color, 3, 0) })
			label({ Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 6), Text = perk.Icon, TextSize = 40, Parent = card })
			label({ Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 26), Text = "UNLOCKED: " .. perk.Name, Font = TITLE_FONT, TextSize = 18, TextColor3 = STAR_GOLD, Parent = card })
			label({ Position = UDim2.fromOffset(10, 82), Size = UDim2.new(1, -20, 0, 32), Text = perk.Description, TextSize = 12, TextWrapped = true, TextColor3 = THEME.SubText, Parent = card })
			local cardScale = new("UIScale", { Scale = 0, Parent = card })
			task.delay(0.6 + index * 0.25, function()
				tween(cardScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
				SoundFX.Play("Pop", { Speed = 1 + index * 0.1 })
			end)
			table.insert(cards, card)
		end
	end

	task.wait(4.2)
	for _, item in ipairs({ title, stars, sub }) do
		tween(item, 0.5, { TextTransparency = 1 })
	end
	for _, card in ipairs(cards) do
		tween(card, 0.5, { BackgroundTransparency = 1 })
		for _, child in ipairs(card:GetDescendants()) do
			if child:IsA("TextLabel") then
				tween(child, 0.5, { TextTransparency = 1 })
			elseif child:IsA("UIStroke") then
				tween(child, 0.5, { Transparency = 1 })
			end
		end
	end
	task.wait(0.6)
	for _, item in ipairs({ dark, flash, wave, title, stars, sub }) do
		item:Destroy()
	end
	for _, card in ipairs(cards) do
		card:Destroy()
	end
	-- tell them where to go next
	for _, perkName in ipairs(unlocked or {}) do
		for _, info in ipairs(Config.RebirthIslands) do
			if info.Name == perkName then
				UIKit.toast(("%s %s is open! Go to the ⭐ Rebirth Gate"):format(info.Icon, info.Name), info.Color)
			end
		end
	end
end

local busy = false
rebirthButton.Activated:Connect(function()
	if busy then
		return
	end
	local progress = Rebirth.Progress(player)
	if not progress.Ready then
		UIKit.toast("Reach both goals first!", THEME.Bad)
		SoundFX.Play("Thud")
		return
	end
	if player:GetAttribute("InDuel") then
		UIKit.toast("You can't rebirth during a duel!", THEME.Bad)
		return
	end
	busy = true
	local ok, result = pcall(function()
		return RebirthRemote:InvokeServer()
	end)
	if ok and type(result) == "table" and result.Rebirths then
		celebrate(result.Rebirths, result.Unlocked)
	else
		UIKit.toast("Rebirth failed, try again", THEME.Bad)
	end
	busy = false
end)

---------------------------------------------------------------------
-- PILLAR OF LIGHT (everyone sees it on the player who rebirthed)
---------------------------------------------------------------------
local function worldPillar(character, n)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local color = Rebirth.Color(n)
	local base = root.Position - Vector3.new(0, 3, 0)
	local folder = Instance.new("Folder")
	folder.Name = "RebirthPillar"
	folder.Parent = workspace
	Debris:AddItem(folder, 4)
	local function fxPart(props)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		for key, value in pairs(props) do
			p[key] = value
		end
		p.Parent = folder
		return p
	end
	-- the beam from the sky
	local beam = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(300, 1, 1),
		CFrame = CFrame.new(base + Vector3.new(0, 150, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Transparency = 0.1,
	})
	TweenService:Create(beam, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = Vector3.new(300, 9, 9) }):Play()
	task.delay(0.5, function()
		TweenService:Create(beam, TweenInfo.new(1.8, Enum.EasingStyle.Quad), { Size = Vector3.new(300, 0.2, 0.2), Transparency = 1 }):Play()
	end)
	local core = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(300, 0.5, 0.5),
		CFrame = beam.CFrame,
		Color = Color3.new(1, 1, 1),
	})
	TweenService:Create(core, TweenInfo.new(0.35), { Size = Vector3.new(300, 4, 4) }):Play()
	task.delay(0.5, function()
		TweenService:Create(core, TweenInfo.new(1.6), { Size = Vector3.new(300, 0.1, 0.1), Transparency = 1 }):Play()
	end)
	-- ground shockwaves
	for i = 0, 2 do
		task.delay(i * 0.18, function()
			local ring = fxPart({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.3, 2, 2),
				CFrame = CFrame.new(base + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = (i == 1) and STAR_GOLD or color,
				Transparency = 0.2,
			})
			TweenService:Create(ring, TweenInfo.new(1.1, Enum.EasingStyle.Quart), { Size = Vector3.new(0.3, 44, 44), Transparency = 1 }):Play()
		end)
	end
	-- stars bursting out
	local burstPart = fxPart({ Size = Vector3.one, CFrame = CFrame.new(base + Vector3.new(0, 3, 0)), Transparency = 1 })
	local stars = Instance.new("ParticleEmitter")
	stars.Texture = Config.Textures.Sparkle
	stars.Rate = 0
	stars.Lifetime = NumberRange.new(1, 2)
	stars.Speed = NumberRange.new(15, 35)
	stars.SpreadAngle = Vector2.new(180, 180)
	stars.Drag = 3
	stars.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	stars.Color = ColorSequence.new(color, STAR_GOLD)
	stars.LightEmission = 1
	stars.Parent = burstPart
	stars:Emit(90)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 50
	light.Brightness = 6
	light.Parent = burstPart
	TweenService:Create(light, TweenInfo.new(2), { Brightness = 0 }):Play()
	SoundFX.Play("Explosion", { Parent = burstPart, Volume = 0.8, MaxDistance = 250 })
end

AnnounceRemote.OnClientEvent:Connect(function(info)
	if type(info) ~= "table" or info.Type ~= "Rebirth" then
		return
	end
	local who = Players:GetPlayerByUserId(info.UserId)
	if who and who.Character then
		-- matches the moment the rebirther's own screen goes BOOM
		task.delay(1.1, worldPillar, who.Character, info.Rebirths)
	end
end)

---------------------------------------------------------------------
-- REBIRTH TRAIL perk (shown on everyone who has it)
---------------------------------------------------------------------
local function updateTrail(who)
	local character = who.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local n = who:GetAttribute("Rebirths") or 0
	local existing = root:FindFirstChild("RebirthTrail")
	if not Rebirth.HasPerk(n, "Rebirth Trail") then
		if existing then
			existing:Destroy()
		end
		for _, name in ipairs({ "RebirthTrailA", "RebirthTrailB" }) do
			local a = root:FindFirstChild(name)
			if a then
				a:Destroy()
			end
		end
		return
	end
	local a0 = root:FindFirstChild("RebirthTrailA") or Instance.new("Attachment")
	a0.Name = "RebirthTrailA"
	a0.Position = Vector3.new(0, 0.9, 0.4)
	a0.Parent = root
	local a1 = root:FindFirstChild("RebirthTrailB") or Instance.new("Attachment")
	a1.Name = "RebirthTrailB"
	a1.Position = Vector3.new(0, -1.4, 0.4)
	a1.Parent = root
	local trail = existing or Instance.new("Trail")
	trail.Name = "RebirthTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.45
	trail.MinLength = 0.1
	trail.FaceCamera = true
	trail.LightEmission = 1
	trail.LightInfluence = 0
	local color = Rebirth.Color(n)
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
	trail.Parent = root
end

local function watchPlayer(who)
	who.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		updateTrail(who)
	end)
	who:GetAttributeChangedSignal("Rebirths"):Connect(function()
		updateTrail(who)
	end)
	if who.Character then
		task.spawn(updateTrail, who)
	end
end
Players.PlayerAdded:Connect(watchPlayer)
for _, who in ipairs(Players:GetPlayers()) do
	watchPlayer(who)
end

---------------------------------------------------------------------
-- DOUBLE JUMP perk
---------------------------------------------------------------------
local airborneSince = nil
local usedDouble = false

local function canDoubleJump()
	if not Rebirth.HasPerk(rebirths(), "Double Jump") then
		return false
	end
	-- parkour stays fair, and duels stay duels
	if player:GetAttribute("ParkourCourse") or player:GetAttribute("InDuel") then
		return false
	end
	return true
end

local function hookHumanoid(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	humanoid.StateChanged:Connect(function(_, state)
		if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
			airborneSince = airborneSince or os.clock()
		elseif state == Enum.HumanoidStateType.Landed or state == Enum.HumanoidStateType.Running
			or state == Enum.HumanoidStateType.Swimming or state == Enum.HumanoidStateType.Seated then
			airborneSince = nil
			usedDouble = false
		end
	end)
end
player.CharacterAdded:Connect(hookHumanoid)
if player.Character then
	task.spawn(hookHumanoid, player.Character)
end

UserInputService.JumpRequest:Connect(function()
	if usedDouble or not airborneSince or os.clock() - airborneSince < 0.18 then
		return
	end
	if not canDoubleJump() then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	usedDouble = true
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(velocity.X, 48, velocity.Z)
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	SoundFX.Play("Whoosh", { Speed = 1.5, Volume = 0.8 })
	-- a little ring puff under your feet
	local color = Rebirth.Color(rebirths())
	local puff = Instance.new("Part")
	puff.Anchored = true
	puff.CanCollide = false
	puff.CanQuery = false
	puff.CanTouch = false
	puff.Shape = Enum.PartType.Cylinder
	puff.Material = Enum.Material.Neon
	puff.Color = color
	puff.Transparency = 0.2
	puff.Size = Vector3.new(0.2, 1.5, 1.5)
	puff.CFrame = CFrame.new(root.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	puff.Parent = workspace
	TweenService:Create(puff, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = Vector3.new(0.1, 7, 7), Transparency = 1 }):Play()
	Debris:AddItem(puff, 0.5)
	local spark = Instance.new("ParticleEmitter")
	spark.Texture = Config.Textures.Sparkle
	spark.Rate = 0
	spark.Lifetime = NumberRange.new(0.4, 0.7)
	spark.Speed = NumberRange.new(6, 12)
	spark.SpreadAngle = Vector2.new(180, 20)
	spark.EmissionDirection = Enum.NormalId.Right
	spark.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	spark.Color = ColorSequence.new(color)
	spark.LightEmission = 1
	spark.Parent = puff
	spark:Emit(18)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">RollUI</string>
          <string name="Source"><![CDATA[-- RollUI (LocalScript in StarterPlayer > StarterPlayerScripts)
-- The main screen: roll button, auto roll, roll animation, rare
-- cutscenes, camera showcase, inventory and announcements.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local Lighting = game:GetService("Lighting")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))
local Luck = require(ReplicatedStorage:WaitForChild("Luck"))
local Rebirth = require(ReplicatedStorage:WaitForChild("Rebirth"))
local PetData = require(ReplicatedStorage:WaitForChild("PetData"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local RollRemote = remotes:WaitForChild("Roll")
local GetDataRemote = remotes:WaitForChild("GetData")
local EquipRemote = remotes:WaitForChild("Equip")
local DataUpdatedRemote = remotes:WaitForChild("DataUpdated")
local AnnounceRemote = remotes:WaitForChild("Announce")
local RevealRemote = remotes:WaitForChild("Reveal")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local rand = Random.new()

local THEME = UIKit.Theme
local TITLE_FONT = UIKit.TitleFont
local new, corner, stroke, textStroke, tween, label =
	UIKit.new, UIKit.corner, UIKit.stroke, UIKit.textStroke, UIKit.tween, UIKit.label

---------------------------------------------------------------------
-- State
---------------------------------------------------------------------
local data = { Rolls = 0, Inventory = {}, Equipped = "", BestChance = 0 }
local rolling = false
local autoRolling = false
local inventoryOpen = false
local refreshInventory -- defined later
local setInventoryOpen -- defined later

local function tierOf(aura)
	return AuraData.Tiers[aura.Tier]
end

---------------------------------------------------------------------
-- SCREEN + LAYERS
---------------------------------------------------------------------
local gui = UIKit.screen("CosmicUI", 0)

local dimLayer = new("Frame", {
	Name = "Dim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 1, ZIndex = 2, Parent = gui,
})
local raysLayer = new("Frame", {
	Name = "Rays", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3,
	Visible = false, Parent = gui,
})
local flashLayer = new("Frame", {
	Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
	BackgroundTransparency = 1, ZIndex = 10, Parent = gui,
})

---------------------------------------------------------------------
-- TOP-LEFT STATS
---------------------------------------------------------------------
local statsPanel = new("Frame", {
	Name = "Stats",
	Position = UDim2.new(0, 16, 0, 64),
	Size = UDim2.fromOffset(260, 78),
	BackgroundColor3 = THEME.Panel,
	BackgroundTransparency = 0.25,
	ZIndex = 5,
	Parent = gui,
}, { corner(), stroke(THEME.Accent, 1.5, 0.4) })
UIKit.addAutoScale(statsPanel)
local rollsLabel = label({
	Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 28),
	Text = "🎲 Rolls: 0", TextXAlignment = Enum.TextXAlignment.Left, TextSize = 20,
	Font = TITLE_FONT, ZIndex = 5, Parent = statsPanel,
})
local bestLabel = label({
	Position = UDim2.fromOffset(14, 40), Size = UDim2.new(1, -28, 0, 26),
	Text = "⭐ Best: none yet", TextXAlignment = Enum.TextXAlignment.Left, TextSize = 15,
	TextColor3 = THEME.SubText, ZIndex = 5, RichText = true, TextTruncate = Enum.TextTruncate.AtEnd,
	Parent = statsPanel,
})

---------------------------------------------------------------------
-- BOTTOM ROLL BAR
---------------------------------------------------------------------
local rollBar = new("Frame", {
	Name = "RollBar",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -20),
	Size = UDim2.fromOffset(540, 150),
	BackgroundTransparency = 1,
	ZIndex = 5,
	Parent = gui,
})
UIKit.addAutoScale(rollBar)

local luckLine = label({
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(1, 60, 0, 24),
	Text = "", RichText = true, TextSize = 19, Font = TITLE_FONT, ZIndex = 5, Parent = rollBar,
})
textStroke(1.5).Parent = luckLine
local luckyLine = label({
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 26), Size = UDim2.new(1, 0, 0, 22),
	Text = "", RichText = true, TextSize = 17, Font = TITLE_FONT, ZIndex = 5, Parent = rollBar,
})
textStroke(1.5).Parent = luckyLine

-- Soft glow behind the roll button
local rollGlow = new("Frame", {
	Name = "Glow",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, 6),
	Size = UDim2.fromOffset(250, 92),
	BackgroundColor3 = Color3.fromRGB(150, 110, 255),
	BackgroundTransparency = 0.7,
	ZIndex = 4,
	Parent = rollBar,
}, { corner(UDim.new(0, 24)) })

local rollButton = new("TextButton", {
	Name = "RollButton",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, 0),
	Size = UDim2.fromOffset(230, 80),
	BackgroundColor3 = Color3.new(1, 1, 1),
	AutoButtonColor = false,
	Text = "ROLL",
	Font = TITLE_FONT,
	TextSize = 44,
	TextColor3 = THEME.Text,
	ZIndex = 5,
	Parent = rollBar,
}, { corner(UDim.new(0, 18)), stroke(Color3.new(1, 1, 1), 3, 0.2), textStroke(2.5) })
local rollGradient = new("UIGradient", {
	Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(170, 90, 255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 140, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 220, 255)),
	}),
	Parent = rollButton,
})
UIKit.addButtonFeel(rollButton, true) -- the roll itself makes sound

local function sideButton(name, text, anchorX, offsetX)
	local button = new("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(anchorX, 1),
		Position = UDim2.new(0.5, offsetX, 1, -10),
		Size = UDim2.fromOffset(135, 60),
		BackgroundColor3 = THEME.PanelLight,
		AutoButtonColor = false,
		Text = text,
		RichText = true,
		Font = TITLE_FONT,
		TextSize = 20,
		TextColor3 = THEME.Text,
		ZIndex = 5,
		Parent = rollBar,
	}, { corner(UDim.new(0, 14)), stroke(THEME.Accent, 2, 0.2), textStroke(1.5) })
	UIKit.addButtonFeel(button)
	return button
end

local autoButton = sideButton("AutoButton", "", 1, -128)
local aurasButton = sideButton("AurasButton", "✦ AURAS", 0, 128)

---------------------------------------------------------------------
-- CENTER REVEAL: glowing card + name
---------------------------------------------------------------------
local reveal = new("Frame", {
	Name = "Reveal",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.4),
	Size = UDim2.fromOffset(700, 420),
	BackgroundTransparency = 1,
	ZIndex = 6,
	Visible = false,
	Parent = gui,
})
UIKit.addAutoScale(reveal)
-- popHolder does the "pop" while reveal handles screen size
local popHolder = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 6, Parent = reveal })
local popScale = new("UIScale", { Parent = popHolder })

-- The aura's picture sits above the card (hidden if it has no picture yet)
local IMAGE_SIZE = 170
local IMAGE_Y = 85 -- center of the picture
local imageGlow = new("Frame", {
	Name = "ImageGlow",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0, IMAGE_Y),
	Size = UDim2.fromOffset(IMAGE_SIZE + 40, IMAGE_SIZE + 40),
	BackgroundColor3 = THEME.Accent,
	BackgroundTransparency = 0.6,
	ZIndex = 6,
	Visible = false,
	Parent = popHolder,
}, { corner(UDim.new(0, 40)) })
local auraImage = new("ImageLabel", {
	Name = "AuraImage",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0, IMAGE_Y),
	Size = UDim2.fromOffset(IMAGE_SIZE, IMAGE_SIZE),
	BackgroundColor3 = THEME.Panel,
	ScaleType = Enum.ScaleType.Crop,
	Image = "",
	ZIndex = 7,
	Visible = false,
	Parent = popHolder,
}, { corner(UDim.new(0, 26)) })
local imageBorder = stroke(THEME.Accent, 4, 0)
imageBorder.Parent = auraImage
local imageScale = new("UIScale", { Parent = auraImage })

local CARD_TRANSPARENCY = 0.15
local card = new("Frame", {
	Name = "Card",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 150),
	Size = UDim2.fromOffset(620, 196),
	BackgroundColor3 = Color3.new(1, 1, 1),
	BackgroundTransparency = CARD_TRANSPARENCY,
	ClipsDescendants = true,
	ZIndex = 5,
	Parent = popHolder,
}, { corner(UDim.new(0, 22)) })
local cardGradient = new("UIGradient", { Rotation = 90, Parent = card })
local cardBorder = stroke(THEME.Accent, 3, 0)
cardBorder.Parent = card

-- A white shine that sweeps across the card on reveal
local shine = new("Frame", {
	Name = "Shine",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(-0.2, 0.5),
	-- not rotated (rotated frames ignore clipping); the gradient is tilted instead
	Size = UDim2.new(0, 160, 1, 0),
	BackgroundColor3 = Color3.new(1, 1, 1),
	BackgroundTransparency = 0,
	BorderSizePixel = 0,
	ZIndex = 5,
	Parent = card,
}, {
	new("UIGradient", {
		Rotation = 20,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}),
})

local tierLabel = label({
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 162), Size = UDim2.new(1, 0, 0, 30),
	Text = "", Font = TITLE_FONT, TextSize = 26, ZIndex = 6, Parent = popHolder,
})
textStroke(2).Parent = tierLabel
local nameLabel = label({
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 242), Size = UDim2.new(1, 0, 0, 96),
	Text = "", Font = TITLE_FONT, TextSize = 84, ZIndex = 6, Parent = popHolder,
})
textStroke(3.5).Parent = nameLabel
local nameGradient = new("UIGradient", { Parent = nameLabel })
local chanceLabel = label({
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 292), Size = UDim2.new(1, 0, 0, 34),
	Text = "", Font = TITLE_FONT, TextSize = 30, TextColor3 = THEME.SubText, ZIndex = 6, Parent = popHolder,
})
textStroke(2).Parent = chanceLabel

local badgeLabel = label({
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 346), Size = UDim2.fromOffset(170, 32),
	Text = "", Font = TITLE_FONT, TextSize = 20, ZIndex = 7, BackgroundTransparency = 0,
	BackgroundColor3 = THEME.Good, Visible = false, Parent = popHolder,
})
corner(UDim.new(1, 0)).Parent = badgeLabel
textStroke(1.5).Parent = badgeLabel
local badgeScale = new("UIScale", { Parent = badgeLabel })

-- Triple Roll: the extra results appear as chips under the card
local extrasRow = new("Frame", {
	Name = "Extras",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 372),
	Size = UDim2.fromOffset(620, 36),
	BackgroundTransparency = 1,
	ZIndex = 6,
	Parent = popHolder,
}, {
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

local revealTexts = { tierLabel, nameLabel, chanceLabel }

local function setRevealAura(aura)
	local c1, c2 = aura.Colors[1], aura.Colors[2]
	local tierColor = tierOf(aura).Color
	nameLabel.Text = aura.Name
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameGradient.Color = ColorSequence.new(UIKit.readable(c1, 0.55), UIKit.readable(c2, 0.55))
	chanceLabel.Text = AuraData.FormatChance(aura.Chance)
	tierLabel.Text = string.upper(aura.Tier)
	tierLabel.TextColor3 = tierColor
	cardGradient.Color = ColorSequence.new(tierColor:Lerp(THEME.Panel, 0.55), THEME.Panel)
	cardBorder.Color = tierColor

	local image = AuraData.GetImage(aura.Name)
	auraImage.Visible = image ~= nil
	imageGlow.Visible = image ~= nil
	if image then
		auraImage.Image = image
		imageBorder.Color = tierColor
		imageGlow.BackgroundColor3 = tierColor
	end
end

local function setRevealVisible(visible, duration)
	local textT = visible and 0 or 1
	local strokeT = visible and 0.3 or 1
	local cardT = visible and CARD_TRANSPARENCY or 1
	local borderT = visible and 0 or 1
	local function apply(inst, props)
		if duration then
			tween(inst, duration, props)
		else
			for key, value in pairs(props) do
				inst[key] = value
			end
		end
	end
	for _, text in ipairs(revealTexts) do
		apply(text, { TextTransparency = textT })
		apply(text:FindFirstChild("TextOutline"), { Transparency = strokeT })
	end
	apply(card, { BackgroundTransparency = cardT })
	apply(cardBorder, { Transparency = borderT })
	apply(auraImage, { ImageTransparency = textT, BackgroundTransparency = textT })
	apply(imageBorder, { Transparency = borderT })
	apply(imageGlow, { BackgroundTransparency = visible and 0.6 or 1 })
end

local function clearExtras()
	for _, child in ipairs(extrasRow:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
end

local function showExtras(names)
	clearExtras()
	for i, auraName in ipairs(names) do
		local aura = AuraData.Get(auraName)
		local chip = label({
			Size = UDim2.fromOffset(170, 34),
			Text = "+ " .. aura.Name,
			Font = TITLE_FONT,
			TextSize = 18,
			TextColor3 = UIKit.readable(aura.Colors[1], 0.7),
			BackgroundTransparency = 0.15,
			BackgroundColor3 = THEME.Panel,
			LayoutOrder = i,
			ZIndex = 6,
			Parent = extrasRow,
		})
		corner(UDim.new(1, 0)).Parent = chip
		stroke(tierOf(aura).Color, 2, 0).Parent = chip
		textStroke(1.5).Parent = chip
		local chipScale = new("UIScale", { Scale = 0, Parent = chip })
		task.delay(0.12 * i, function()
			tween(chipScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			SoundFX.Play("Pop", { Speed = 1 + i * 0.15 })
		end)
	end
end

---------------------------------------------------------------------
-- CUTSCENE RAYS
---------------------------------------------------------------------
local rays = {}
for i = 1, 8 do
	local ray = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.new(0, 46, 2.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Rotation = (i - 1) * (180 / 8),
		ZIndex = 3,
		Parent = raysLayer,
	})
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.42, 0.55),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(0.58, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = ray,
	})
	table.insert(rays, ray)
end

local cutsceneHolder = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(900, 60),
	BackgroundTransparency = 1, ZIndex = 6, Parent = gui,
})
UIKit.addAutoScale(cutsceneHolder)
local cutsceneText = label({
	Size = UDim2.fromScale(1, 1), Text = "", Font = TITLE_FONT, TextSize = 40, ZIndex = 6,
	TextTransparency = 1, Parent = cutsceneHolder,
})
local cutsceneStroke = textStroke(3)
cutsceneStroke.Transparency = 1
cutsceneStroke.Parent = cutsceneText
local cutsceneScale = new("UIScale", { Parent = cutsceneText })

---------------------------------------------------------------------
-- ANNOUNCEMENT BANNER
---------------------------------------------------------------------
local banner = new("Frame", {
	Name = "Banner",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, -90),
	Size = UDim2.fromOffset(640, 58),
	BackgroundColor3 = THEME.Panel,
	BackgroundTransparency = 0.1,
	ZIndex = 9,
	Parent = gui,
}, { corner(UDim.new(0, 14)) })
local bannerStroke = stroke(THEME.Accent, 2.5, 0)
bannerStroke.Parent = banner
UIKit.addAutoScale(banner)
local bannerLabel = label({
	Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), RichText = true,
	Text = "", Font = TITLE_FONT, TextSize = 22, ZIndex = 9, TextWrapped = true, Parent = banner,
})
local bannerIcon = new("ImageLabel", {
	AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.fromOffset(44, 44),
	BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop, ZIndex = 9, Visible = false, Parent = banner,
}, { corner(UDim.new(0, 10)) })

---------------------------------------------------------------------
-- EFFECTS: camera shake, FOV punch, flash
---------------------------------------------------------------------
local shake = 0
local shaking = false
RunService.RenderStepped:Connect(function(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if shake > 0.01 then
		shaking = true
		local m = shake * 0.35
		if humanoid then
			humanoid.CameraOffset = Vector3.new(rand:NextNumber(-m, m), rand:NextNumber(-m, m), rand:NextNumber(-m, m))
		end
		shake = math.max(0, shake - dt * 2.5)
	elseif shaking then
		shaking = false
		if humanoid then
			humanoid.CameraOffset = Vector3.zero
		end
	end
end)

local function addShake(amount)
	shake = math.max(shake, amount)
end

local baseFov = camera.FieldOfView
local function fovPunch(amount)
	camera.FieldOfView = baseFov + amount
	tween(camera, 0.6, { FieldOfView = baseFov }, Enum.EasingStyle.Quint)
end

local function flash(strength, duration)
	flashLayer.BackgroundTransparency = 1 - strength
	tween(flashLayer, duration or 0.5, { BackgroundTransparency = 1 })
end

---------------------------------------------------------------------
-- LUCK LINE + STATS
---------------------------------------------------------------------
local BONUS_ICONS = { ["2x Luck"] = "🍀", VIP = "👑", Potion = "🧪", Server = "🌌", Event = "☄️", ["Lucky Isle"] = "🏝", Parkour = "🏃", Rebirth = "⭐", Pets = "🐾", Forever = "♾", ["Cosmic Roll"] = "🎲" }

local function updateInfo()
	local total = Luck.Get(player)
	local parts = { ("<font color='#9fe8ff'>🍀 Luck x%s</font>"):format(Luck.Format(total)) }
	-- on an island, show that the island multiplies everything: "x60 (x30 × 2)"
	local island = Luck.IslandBonus(player)
	if island then
		parts[1] = ("<font color='#9fe8ff'>🍀 Luck <b>x%s</b></font> <font color='#bfb4e1'>(x%s × %s island)</font>"):format(
			Luck.Format(total), Luck.Format(total / island.Multiplier), Luck.Format(island.Multiplier))
	end
	local now = Luck.Now()
	for _, bonus in ipairs(Luck.GetBonuses(player)) do
		if bonus.EndsAt then
			table.insert(parts, ("<font color='#ffd76a'>%s %s</font>"):format(
				BONUS_ICONS[bonus.Name] or "✦", Luck.FormatTime(bonus.EndsAt - now)))
		elseif bonus.Show and not bonus.Island then
			table.insert(parts, ("<font color='#ffb4dc'>%s %s x%s</font>"):format(
				bonus.Icon or BONUS_ICONS[bonus.Name] or "✦", bonus.Name, Luck.Format(bonus.Multiplier)))
		end
	end
	luckLine.Text = table.concat(parts, "   ")

	local every = Luck.LuckyEvery(player)
	local untilLucky = every - (data.Rolls % every)
	if untilLucky == 1 then
		luckyLine.Text = ("<font color='#ffd76a'>✨ NEXT ROLL IS LUCKY (x%s)</font>"):format(Luck.Format(Config.LuckyRollMultiplier))
	else
		luckyLine.Text = ("<font color='#c9bff0'>Lucky roll in %d</font>"):format(untilLucky)
	end
end

local function updateStats()
	rollsLabel.Text = "🎲 Rolls: " .. AuraData.FormatNumber(data.Rolls)
	local best
	for name, count in pairs(data.Inventory) do
		local aura = AuraData.Get(name)
		if aura and count > 0 and (not best or aura.Chance > best.Chance) then
			best = aura
		end
	end
	if best then
		bestLabel.Text = ("⭐ Best: <font color='#%s'>%s</font> (%s)"):format(
			tierOf(best).Color:ToHex(), best.Name, AuraData.FormatChance(best.Chance))
	else
		bestLabel.Text = "⭐ Best: none yet"
	end
	updateInfo()
end

task.spawn(function()
	while gui.Parent do
		updateInfo()
		task.wait(0.5)
	end
end)

---------------------------------------------------------------------
-- AUTO ROLL BUTTON
---------------------------------------------------------------------
local function ownsAutoRoll()
	return player:GetAttribute("Pass_AutoRoll") == true
end

local function updateAutoButton()
	local autoStroke = autoButton:FindFirstChild("Border")
	if not ownsAutoRoll() then
		autoButton.Text = "🔒 AUTO\n<font size='13'>Game Pass</font>"
		autoButton.BackgroundColor3 = THEME.PanelLight
		autoStroke.Color = THEME.Gold
	elseif autoRolling then
		autoButton.Text = "AUTO: ON"
		autoButton.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
		autoStroke.Color = THEME.Good
	else
		autoButton.Text = "AUTO: OFF"
		autoButton.BackgroundColor3 = THEME.PanelLight
		autoStroke.Color = THEME.Accent
	end
end

---------------------------------------------------------------------
-- RARE ROLL CUTSCENE
---------------------------------------------------------------------
local raysConnection
local function playCutscene(aura)
	local order = tierOf(aura).Order
	local duration = (order >= 7) and 3.6 or (order >= 6) and 2.8 or 2
	local color = tierOf(aura).Color

	tween(dimLayer, 0.5, { BackgroundTransparency = 0.25 })
	raysLayer.Visible = true
	for _, ray in ipairs(rays) do
		ray.BackgroundColor3 = aura.Colors[1]
		ray.BackgroundTransparency = 1
		tween(ray, 0.6, { BackgroundTransparency = 0 })
	end
	if raysConnection then
		raysConnection:Disconnect()
	end
	raysConnection = RunService.RenderStepped:Connect(function(dt)
		for i, ray in ipairs(rays) do
			ray.Rotation += dt * ((i % 2 == 0) and 25 or 40)
		end
	end)

	local rumble = SoundFX.Loop("Rumble", 0.8)

	cutsceneText.Text = (order >= 7) and "THE UNIVERSE TREMBLES..."
		or (order >= 6) and "Something MYTHIC approaches..."
		or "A LEGENDARY aura approaches..."
	cutsceneText.TextColor3 = color
	tween(cutsceneText, 0.4, { TextTransparency = 0 })
	tween(cutsceneStroke, 0.4, { Transparency = 0.3 })

	-- heartbeat: "lub-dub", getting stronger
	local beats = math.floor(duration / 0.5)
	for i = 1, beats do
		local strength = i / beats
		cutsceneScale.Scale = 1.15 + strength * 0.1
		tween(cutsceneScale, 0.35, { Scale = 1 })
		addShake(0.3 + strength * 1.2)
		UIKit.burst(aura.Colors, 6, 0.6)
		SoundFX.Play("Heartbeat", { Volume = 0.6 + strength * 0.4 })
		task.delay(0.13, function()
			SoundFX.Play("Heartbeat", { Speed = 1.15, Volume = 0.4 + strength * 0.3 })
		end)
		task.wait(0.5)
	end

	SoundFX.FadeOut(rumble, 0.6)
	tween(cutsceneText, 0.2, { TextTransparency = 1 })
	tween(cutsceneStroke, 0.2, { Transparency = 1 })
	flash(1, 0.9)
	addShake(2.5)
	tween(dimLayer, 1.2, { BackgroundTransparency = 1 })
	for _, ray in ipairs(rays) do
		tween(ray, 1.2, { BackgroundTransparency = 1 })
	end
	task.delay(1.3, function()
		if raysConnection then
			raysConnection:Disconnect()
			raysConnection = nil
		end
		raysLayer.Visible = false
	end)
end

---------------------------------------------------------------------
-- CAMERA SHOWCASE: camera circles your character to show off the aura
---------------------------------------------------------------------
local function showcase(duration)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	tween(rollBar, 0.3, { Position = UDim2.new(0.5, 0, 1, 220) })
	tween(statsPanel, 0.3, { Position = UDim2.new(0, -320, 0, 64) })

	camera.CameraType = Enum.CameraType.Scriptable
	local look = root.CFrame.LookVector
	local baseAngle = math.atan2(look.Z, look.X)
	local start = os.clock()
	local connection = RunService.RenderStepped:Connect(function()
		if not root.Parent then
			return
		end
		local alpha = math.clamp((os.clock() - start) / duration, 0, 1)
		local eased = 1 - (1 - alpha) ^ 2
		local angle = baseAngle + eased * math.pi * 1.4
		local radius = 13 - eased * 4
		local height = 2.5 + math.sin(alpha * math.pi) * 2.5
		local focus = root.Position + Vector3.new(0, 1, 0)
		camera.CFrame = CFrame.lookAt(focus + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius), focus)
	end)
	task.wait(duration)
	connection:Disconnect()
	camera.CameraType = Enum.CameraType.Custom

	tween(rollBar, 0.4, { Position = UDim2.new(0.5, 0, 1, -20) }, Enum.EasingStyle.Back)
	tween(statsPanel, 0.4, { Position = UDim2.new(0, 16, 0, 64) }, Enum.EasingStyle.Back)
end

---------------------------------------------------------------------
-- ROLL ANIMATION
---------------------------------------------------------------------
local function revealSoundFor(order)
	if order >= 6 then
		return "RevealMythic"
	elseif order == 5 then
		return "RevealLegendary"
	elseif order == 4 then
		return "RevealEpic"
	elseif order == 3 then
		return "RevealRare"
	end
	return "Pop"
end

local function playRollAnimation(result, fast)
	local final = AuraData.Get(result.Aura)
	local order = tierOf(final).Order

	reveal.Visible = true
	reveal.Position = UDim2.fromScale(0.5, 0.4)
	badgeLabel.Visible = false
	clearExtras()
	setRevealVisible(true)
	popScale.Scale = 0.6
	tween(popScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)

	if result.Boosted then
		UIKit.toast(("🎲 COSMIC ROLL! x%d luck on this roll!"):format(Config.Drop.BoostMultiplier), THEME.Gold)
		SoundFX.Chime(1, 5)
	elseif result.Lucky then
		UIKit.toast("✨ LUCKY ROLL! x" .. Luck.Format(Config.LuckyRollMultiplier) .. " luck", THEME.Gold)
	end

	-- 1) Spin through random auras, slowing down at the end
	local steps = fast and 7 or 16
	-- rebirths make rolling faster, the spin speeds up to match
	local pace = Rebirth.CooldownScale(player:GetAttribute("Rebirths") or 0)
	local showLuck = math.max(result.Luck or 1, 1) * 40 -- show exciting names while spinning
	for i = 1, steps do
		local progress = i / steps
		local fake = AuraData.RollRandom(showLuck, rand)
		setRevealAura(fake)
		popScale.Scale = 1.1
		tween(popScale, 0.08, { Scale = 1 })
		imageScale.Scale = 0.9
		tween(imageScale, 0.08, { Scale = 1 })
		nameLabel.Rotation = rand:NextNumber(-3, 3)
		SoundFX.Play("Tick", { Speed = 0.9 + progress * 0.35, Volume = 0.7 + progress * 0.3 })
		task.wait(((fast and 0.03 or 0.04) + progress ^ 3 * (fast and 0.12 or 0.28)) * pace)
	end
	nameLabel.Rotation = 0

	-- 2) Big rolls get a cutscene first
	if final.Chance >= Config.CutsceneAtChance then
		setRevealVisible(false)
		playCutscene(final)
		setRevealVisible(true)
	end

	-- 3) REVEAL
	setRevealAura(final)
	RevealRemote:FireServer() -- everyone nearby sees the 3D reveal effect
	popScale.Scale = 1.7
	tween(popScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	nameLabel.Rotation = -8
	tween(nameLabel, 0.8, { Rotation = 0 }, Enum.EasingStyle.Elastic)
	cardBorder.Thickness = 8
	tween(cardBorder, 0.6, { Thickness = 3 })
	if auraImage.Visible then
		imageScale.Scale = 0.3
		auraImage.Rotation = -25
		tween(imageScale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
		tween(auraImage, 0.9, { Rotation = 0 }, Enum.EasingStyle.Elastic)
		imageGlow.Size = UDim2.fromOffset(IMAGE_SIZE + 140, IMAGE_SIZE + 140)
		imageGlow.BackgroundTransparency = 0.2
		tween(imageGlow, 0.7, { Size = UDim2.fromOffset(IMAGE_SIZE + 40, IMAGE_SIZE + 40), BackgroundTransparency = 0.6 }, Enum.EasingStyle.Quint)
	end
	shine.Position = UDim2.fromScale(-0.2, 0.5)
	tween(shine, 0.7, { Position = UDim2.fromScale(1.2, 0.5) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

	local colors = { final.Colors[1], final.Colors[2], tierOf(final).Color }
	UIKit.burst(colors, 10 + order * 8, 0.7 + order * 0.15)
	SoundFX.Play(revealSoundFor(order))
	if order >= 4 then
		-- a gentle rising bell melody instead of a bang
		local melody = (order >= 6) and { 1, 1.26, 1.5, 2, 2.52 } or (order == 5) and { 1, 1.26, 1.5, 2 } or { 1, 1.5, 2 }
		SoundFX.Notes(melody, 0.11, { Volume = 0.35 })
	end
	if order >= 3 then
		flash(math.min(0.15 + order * 0.08, 0.7), 0.4)
		addShake(0.2 + order * 0.2)
		fovPunch(order * 1.5)
	end

	if result.IsNewBest and data.Rolls > 1 then
		badgeLabel.Text = "★ NEW BEST! ★"
		badgeLabel.BackgroundColor3 = THEME.Gold
		badgeLabel.Visible = true
		UIKit.confetti(colors, 70)
		SoundFX.Chime(1, 5)
	elseif result.IsFirstTime then
		badgeLabel.Text = "NEW!"
		badgeLabel.BackgroundColor3 = THEME.Good
		badgeLabel.Visible = true
		SoundFX.Chime(1.2, 3)
	end
	if badgeLabel.Visible then
		badgeScale.Scale = 0
		tween(badgeScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	if result.Results and #result.Results > 1 then
		local extras = {}
		for i = 2, #result.Results do
			table.insert(extras, result.Results[i])
		end
		showExtras(extras)
	end

	-- 4) Hold, maybe show off with the camera, then float away
	local doShowcase = final.Chance >= Config.ShowcaseAtChance and (not fast or final.Chance >= 100000)
	task.wait(fast and 0.6 or (1.2 + order * 0.15))
	if doShowcase then
		tween(reveal, 0.35, { Position = UDim2.fromScale(0.5, 0.14) })
		tween(popScale, 0.35, { Scale = 0.55 })
		showcase(2.8)
	end
	badgeLabel.Visible = false
	tween(reveal, 0.35, { Position = UDim2.fromScale(0.5, 0.34) })
	setRevealVisible(false, 0.35)
	for _, chip in ipairs(extrasRow:GetChildren()) do
		if chip:IsA("TextLabel") then
			tween(chip, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
		end
	end
	task.wait(0.35)
	reveal.Visible = false
	clearExtras()
end

---------------------------------------------------------------------
-- ROLLING
---------------------------------------------------------------------
local function setRollingLook(isRolling)
	if isRolling then
		rollButton.Text = autoRolling and "AUTO" or "..."
		tween(rollButton, 0.15, { TextTransparency = 0.3 })
	else
		rollButton.Text = "ROLL"
		tween(rollButton, 0.15, { TextTransparency = 0 })
	end
end

local function doRoll(fast)
	if rolling then
		return
	end
	rolling = true
	setRollingLook(true)

	local ok, result = pcall(function()
		return RollRemote:InvokeServer()
	end)
	if not ok or type(result) ~= "table" or result.Error then
		rolling = false
		setRollingLook(false)
		if ok and type(result) == "table" and result.Error == "Loading" then
			UIKit.toast("Loading your data...", THEME.SubText)
		elseif ok and type(result) == "table" and result.Error == "InDuel" then
			UIKit.toast("You can't roll during a duel!", THEME.Bad)
		end
		task.wait(0.2)
		return
	end

	data.Rolls = result.Rolls
	data.Inventory = result.Inventory or data.Inventory
	updateInfo()

	playRollAnimation(result, fast)

	-- Equip automatically when you beat your best aura
	local final = AuraData.Get(result.Aura)
	if result.IsNewBest or data.Equipped == "" then
		data.Equipped = final.Name
		EquipRemote:FireServer(final.Name)
	end
	if final.Chance > data.BestChance then
		data.BestChance = final.Chance
	end

	updateStats()
	if inventoryOpen then
		refreshInventory()
	end
	rolling = false
	setRollingLook(false)
end

rollButton.Activated:Connect(function()
	if not autoRolling then
		doRoll(false)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.R and not autoRolling then
		doRoll(false)
	end
end)

autoButton.Activated:Connect(function()
	if not ownsAutoRoll() then
		local passId = Config.GamePasses.AutoRoll
		if passId and passId ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, passId)
		else
			UIKit.toast("Auto Roll pass not set up yet (CosmicConfig)", THEME.Bad)
		end
		return
	end
	autoRolling = not autoRolling
	updateAutoButton()
	if autoRolling then
		task.spawn(function()
			while autoRolling and ownsAutoRoll() do
				doRoll(true)
				task.wait(0.05)
			end
			autoRolling = false
			updateAutoButton()
		end)
	end
end)

player:GetAttributeChangedSignal("Pass_AutoRoll"):Connect(updateAutoButton)

-- Duels: hide the roll bar and pause auto roll while fighting
player:GetAttributeChangedSignal("InDuel"):Connect(function()
	if player:GetAttribute("InDuel") then
		autoRolling = false
		updateAutoButton()
		setInventoryOpen(false)
		tween(rollBar, 0.35, { Position = UDim2.new(0.5, 0, 1, 220) })
		tween(statsPanel, 0.35, { Position = UDim2.new(0, -320, 0, 64) })
	else
		tween(rollBar, 0.5, { Position = UDim2.new(0.5, 0, 1, -20) }, Enum.EasingStyle.Back)
		tween(statsPanel, 0.5, { Position = UDim2.new(0, 16, 0, 64) }, Enum.EasingStyle.Back)
	end
end)

-- Shimmer + breathing glow on the roll button
task.spawn(function()
	while rollButton.Parent do
		rollGradient.Offset = Vector2.new(-1, 0)
		tween(rollGradient, 2.2, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		tween(rollGlow, 1.1, { BackgroundTransparency = 0.45, Size = UDim2.fromOffset(262, 98) }, Enum.EasingStyle.Sine)
		task.wait(1.1)
		tween(rollGlow, 1.1, { BackgroundTransparency = 0.75, Size = UDim2.fromOffset(250, 92) }, Enum.EasingStyle.Sine)
		task.wait(1.1)
		tween(rollGradient, 2.2, { Offset = Vector2.new(-1, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		tween(rollGlow, 1.1, { BackgroundTransparency = 0.45, Size = UDim2.fromOffset(262, 98) }, Enum.EasingStyle.Sine)
		task.wait(1.1)
		tween(rollGlow, 1.1, { BackgroundTransparency = 0.75, Size = UDim2.fromOffset(250, 92) }, Enum.EasingStyle.Sine)
		task.wait(1.1)
	end
end)

