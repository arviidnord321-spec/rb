]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="25">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="26">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="27">
        <Properties>
          <string name="Name">AuraRenderer</string>
          <string name="Source"><![CDATA[-- AuraRenderer (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Draws everything about OTHER players (and you) in the 3D world:
--   * every player's aura (the server only sets an "Aura" attribute)
--   * floating name tags with aura + VIP crown
--   * roll effects everyone can see (charge-up, reveal pillars, sky beams)
--   * [VIP] and aura tags in chat

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))
local Rebirth = require(ReplicatedStorage:WaitForChild("Rebirth"))
local AuraEffects = require(ReplicatedStorage:WaitForChild("AuraEffects"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local RollFXRemote = remotes:WaitForChild("RollFX")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

local tracked = {} -- [character] = true
local handles = {} -- [character] = aura handle
local tags = {} -- [character] = { Gui, Gradient, Order, Phase }

local GOLD = Color3.fromRGB(255, 200, 70)

local function fxFolder()
	local folder = workspace:FindFirstChild("LocalAuraFX")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "LocalAuraFX"
		folder.Parent = workspace
	end
	return folder
end

local function fxPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	for key, value in pairs(props) do
		part[key] = value
	end
	part.Parent = fxFolder()
	return part
end

local function tween(inst, duration, props, style, direction)
	local tw = TweenService:Create(inst, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function readable(color)
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s, math.max(v, 0.6))
end

---------------------------------------------------------------------
-- NAME TAGS
---------------------------------------------------------------------
local function isVIP(character)
	local player = Players:GetPlayerFromCharacter(character)
	return player ~= nil and player:GetAttribute("Pass_VIP") == true
end

local function rebirthsOf(character)
	local player = Players:GetPlayerFromCharacter(character)
	return player and (player:GetAttribute("Rebirths") or 0) or 0
end

local function removeTag(character)
	local tag = tags[character]
	if tag then
		tag.Gui:Destroy()
		tags[character] = nil
	end
end

local function buildTag(character)
	removeTag(character)
	local player = Players:GetPlayerFromCharacter(character)
	local head = character:FindFirstChild("Head")
	if not player or not head then
		return
	end
	local aura = AuraData.Get(character:GetAttribute("Aura") or "")
	local vip = isVIP(character)
	local rebirths = rebirthsOf(character)
	if not aura and not vip and rebirths <= 0 then
		return
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "AuraTag_" .. player.Name
	gui.Adornee = head
	gui.Size = UDim2.fromOffset(200, 56)
	gui.StudsOffset = Vector3.new(0, 3.2, 0)
	gui.MaxDistance = 75
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Parent = playerGui

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = gui

	local function line(order, text, size, color, font)
		local l = Instance.new("TextLabel")
		l.LayoutOrder = order
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, size + 4)
		l.Font = font or Enum.Font.FredokaOne
		l.TextSize = size
		l.Text = text
		l.TextColor3 = color
		l.TextTransparency = 0.12 -- a little see-through
		l.Parent = gui
		local outline = Instance.new("UIStroke")
		outline.Thickness = 1.4
		outline.Transparency = 0.45
		outline.Parent = l
		return l
	end

	local gradient
	if vip or rebirths > 0 then
		local parts = {}
		if rebirths > 0 then
			table.insert(parts, ("<font color='#%s'>%s Rebirth %d</font>"):format(Rebirth.Color(rebirths):ToHex(), Rebirth.Stars(rebirths), rebirths))
		end
		if vip then
			table.insert(parts, "👑 VIP")
		end
		local top = line(1, table.concat(parts, "  "), 13, GOLD)
		top.RichText = true
	end
	if aura then
		local nameLine = line(2, aura.Name, 19, Color3.new(1, 1, 1))
		gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new(readable(aura.Colors[1]), readable(aura.Colors[2]))
		gradient.Parent = nameLine
		local tier = AuraData.Tiers[aura.Tier]
		line(3, ("%s • %s"):format(aura.Tier, AuraData.FormatChance(aura.Chance)), 11, tier.Color, Enum.Font.GothamBold)
	end

	tags[character] = {
		Gui = gui,
		Gradient = gradient,
		Order = aura and AuraData.Tiers[aura.Tier].Order or 0,
		Phase = math.random() * 6,
		AuraName = aura and aura.Name or nil,
		VIP = vip,
		Rebirths = rebirths,
	}
end

---------------------------------------------------------------------
-- AURAS
---------------------------------------------------------------------
local function reconcile(character, withBurst)
	local desired = character:GetAttribute("Aura")
	local root = character:FindFirstChild("HumanoidRootPart")
	local handle = handles[character]

	if handle then
		local stillValid = handle:IsAlive() and handle.Aura.Name == desired and handle.Root == root
		if not stillValid then
			handle:Destroy()
			handles[character] = nil
		end
	end

	if not handles[character] and desired and root and character.Parent then
		handles[character] = AuraEffects.Apply(character, desired)
		if withBurst and handles[character] then
			local aura = AuraData.Get(desired)
			AuraEffects.Burst(root.Position, aura.Colors, 0.6 + AuraData.Tiers[aura.Tier].Order * 0.2)
		end
	end

	-- name tag follows the aura + VIP (rebuild only when something changed)
	local tag = tags[character]
	local head = character:FindFirstChild("Head")
	local vip = isVIP(character)
	local rebirths = rebirthsOf(character)
	if not head or (not desired and not vip and rebirths <= 0) then
		removeTag(character)
	elseif not tag or tag.AuraName ~= desired or tag.VIP ~= vip or tag.Rebirths ~= rebirths or tag.Gui.Adornee ~= head then
		buildTag(character)
	end
end

local function untrack(character)
	tracked[character] = nil
	if handles[character] then
		handles[character]:Destroy()
		handles[character] = nil
	end
	removeTag(character)
end

local function track(character)
	if tracked[character] then
		return
	end
	tracked[character] = true

	character:GetAttributeChangedSignal("Aura"):Connect(function()
		reconcile(character, true)
	end)
	character.ChildAdded:Connect(function(child)
		if child.Name == "HumanoidRootPart" or child.Name == "Head" then
			reconcile(character, false)
		end
	end)
	character.Destroying:Connect(function()
		untrack(character)
	end)

	reconcile(character, false)
end

local function onPlayer(player)
	if player.Character then
		track(player.Character)
	end
	player.CharacterAdded:Connect(track)
	player:GetAttributeChangedSignal("Pass_VIP"):Connect(function()
		if player.Character then
			reconcile(player.Character, false)
		end
	end)
	player:GetAttributeChangedSignal("Rebirths"):Connect(function()
		if player.Character then
			reconcile(player.Character, false)
		end
	end)
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	onPlayer(player)
end

-- duel bots wear auras too
task.spawn(function()
	local botFolder = workspace:WaitForChild("DuelBots", 60)
	if not botFolder then
		return
	end
	botFolder.ChildAdded:Connect(function(model)
		if model:IsA("Model") then
			task.wait(0.2) -- let its parts arrive
			track(model)
		end
	end)
	for _, model in ipairs(botFolder:GetChildren()) do
		if model:IsA("Model") then
			track(model)
		end
	end
end)

-- Animate every frame
local clock = 0
RunService.RenderStepped:Connect(function(dt)
	clock += dt
	for character, handle in pairs(handles) do
		if handle:IsAlive() then
			handle:Update(dt)
		else
			handle:Destroy()
			handles[character] = nil
		end
	end
	for _, tag in pairs(tags) do
		tag.Gui.StudsOffset = Vector3.new(0, 3.4 + math.sin(clock * 2 + tag.Phase) * 0.12, 0)
		if tag.Gradient and tag.Order >= 5 then
			tag.Gradient.Offset = Vector2.new(math.sin(clock * 1.5 + tag.Phase) * 0.5, 0)
		end
	end
end)

-- Safety check twice a second (respawns, streaming, removed characters)
task.spawn(function()
	while true do
		task.wait(0.5)
		for character in pairs(tracked) do
			if character.Parent == nil then
				untrack(character)
			else
				reconcile(character, false)
			end
		end
	end
end)

---------------------------------------------------------------------
-- ROLL EFFECTS EVERYONE CAN SEE
---------------------------------------------------------------------
local function chargeUp(root)
	local feet = root.Position - Vector3.new(0, 2.9, 0)
	-- a ring of light rising from the feet to above the head
	local ring = fxPart({
		Name = "ChargeRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.15, 7, 7),
		CFrame = CFrame.new(feet) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(200, 170, 255),
		Transparency = 0.2,
	})
	tween(ring, 1, {
		CFrame = CFrame.new(feet + Vector3.new(0, 6.5, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Size = Vector3.new(0.1, 2, 2),
		Transparency = 1,
	}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(ring, 1.1)

	-- sparkles getting sucked in
	local sphere = fxPart({
		Name = "ChargeSphere",
		Size = Vector3.one * 9,
		CFrame = CFrame.new(root.Position),
		Transparency = 1,
	})
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = Config.Textures.Sparkle
	emitter.Shape = Enum.ParticleEmitterShape.Sphere
	emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	emitter.Rate = 60
	emitter.Lifetime = NumberRange.new(0.4, 0.6)
	emitter.Speed = NumberRange.new(7, 10)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Color = ColorSequence.new(Color3.fromRGB(220, 200, 255), Color3.fromRGB(120, 200, 255))
	emitter.Parent = sphere
	task.delay(0.9, function()
		emitter.Enabled = false
	end)
	Debris:AddItem(sphere, 1.6)
end

local function floatingName(root, aura)
	local holder = fxPart({ Name = "RollName", Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(root.Position) })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 50)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.AlwaysOnTop = true
	gui.Parent = holder
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.Text = aura.Name .. "!"
	text.TextColor3 = readable(aura.Colors[1])
	text.Parent = gui
	local outline = Instance.new("UIStroke")
	outline.Thickness = 2
	outline.Parent = text
	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = text
	tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(gui, 2, { StudsOffset = Vector3.new(0, 8, 0) })
	task.delay(1.2, function()
		tween(text, 0.8, { TextTransparency = 1 })
		tween(outline, 0.8, { Transparency = 1 })
	end)
	Debris:AddItem(holder, 2.2)
end

local REVEAL_SOUNDS = { "Pop", "Pop", "RevealRare", "RevealEpic", "RevealLegendary", "RevealMythic", "RevealMythic", "RevealMythic", "RevealMythic" }

local function revealFX(player, root, aura)
	local order = AuraData.Tiers[aura.Tier].Order
	local c1, c2 = aura.Colors[1], aura.Colors[2]
	local position = root.Position

	AuraEffects.Burst(position, aura.Colors, 0.5 + order * 0.2)
	floatingName(root, aura)

	-- other players hear your roll from where you are standing
	if player ~= localPlayer then
		local holder = fxPart({ Name = "RollSound", Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(position) })
		SoundFX.Play(REVEAL_SOUNDS[order], { Parent = holder, MaxDistance = 120 + order * 30, Volume = 0.8 })
		Debris:AddItem(holder, 6)
	end

	-- Epic+: a pillar of light
	if order >= 4 then
		local height = 40 + order * 10
		local pillar = fxPart({
			Name = "Pillar",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(height, 4, 4),
			CFrame = CFrame.new(position + Vector3.new(0, height / 2 - 3, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = c1,
			Transparency = 0.2,
		})
		tween(pillar, 1.4, { Size = Vector3.new(height, 0.2, 0.2), Transparency = 1 }, Enum.EasingStyle.Quint)
		Debris:AddItem(pillar, 1.5)
	end

	-- Legendary+: a beam all the way into the sky + big shockwave
	if order >= 5 then
		local beam = fxPart({
			Name = "SkyBeam",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(800, 1.5, 1.5),
			CFrame = CFrame.new(position + Vector3.new(0, 400, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = c2,
			Transparency = 0,
		})
		tween(beam, 0.25, { Size = Vector3.new(800, 7, 7) }, Enum.EasingStyle.Quad)
		task.delay(0.6, function()
			tween(beam, 1.6, { Size = Vector3.new(800, 0.2, 0.2), Transparency = 1 })
		end)
		Debris:AddItem(beam, 2.4)

		local wave = fxPart({
			Name = "Shockwave",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 4, 4),
			CFrame = CFrame.new(position - Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = c1,
			Transparency = 0.1,
		})
		local size = (order >= 6) and 120 or 60
		tween(wave, 1.2, { Size = Vector3.new(0.1, size, size), Transparency = 1 }, Enum.EasingStyle.Quint)
		Debris:AddItem(wave, 1.3)
	end

	-- Mythic+: a second, delayed burst
	if order >= 6 then
		task.delay(0.35, function()
			AuraEffects.Burst(position + Vector3.new(0, 3, 0), { c2, c1 }, 2.5)
		end)
	end
end

RollFXRemote.OnClientEvent:Connect(function(info)
	local player = Players:GetPlayerByUserId(info.UserId)
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if info.Phase == "Start" then
		chargeUp(root)
	elseif info.Phase == "Reveal" then
		local aura = AuraData.Get(info.Aura)
		if aura then
			revealFX(player, root, aura)
		end
	end
end)

---------------------------------------------------------------------
-- CHAT TAGS: [VIP] and your equipped aura in its tier color
---------------------------------------------------------------------
TextChatService.OnIncomingMessage = function(message)
	local source = message.TextSource
	if not source then
		return nil
	end
	local player = Players:GetPlayerByUserId(source.UserId)
	if not player then
		return nil
	end
	local prefix = ""
	local rebirths = player:GetAttribute("Rebirths") or 0
	if rebirths > 0 then
		prefix ..= ("<font color='#%s'>[%s]</font> "):format(Rebirth.Color(rebirths):ToHex(), Rebirth.Stars(rebirths))
	end
	if player:GetAttribute("Pass_VIP") then
		prefix ..= "<font color='#FFC846'>[VIP]</font> "
	end
	local aura = AuraData.Get(player:GetAttribute("EquippedAura") or "")
	if aura then
		prefix ..= ("<font color='#%s'>[%s]</font> "):format(AuraData.Tiers[aura.Tier].Color:ToHex(), aura.Name)
	end
	if prefix == "" then
		return nil
	end
	local properties = Instance.new("TextChatMessageProperties")
	properties.PrefixText = prefix .. message.PrefixText
	return properties
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="28">
        <Properties>
          <string name="Name">DropClient</string>
          <string name="Source"><![CDATA[-- DropClient (LocalScript in StarterPlayer > StarterPlayerScripts)
-- The Cosmic Drop on your screen:
--   * a small timer (top-left, under your stats) counting down to the next drop
--   * when a drop is out: "find it!" with an arrow pointing the way + distance
--   * the drop spins and pulses, and a burst when someone grabs it

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local THEME = UIKit.Theme
local new, corner, stroke, label = UIKit.new, UIKit.corner, UIKit.stroke, UIKit.label

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local AnnounceRemote = remotes:WaitForChild("Announce")

local GOLD = Color3.fromRGB(255, 215, 90)

---------------------------------------------------------------------
-- The timer pill
---------------------------------------------------------------------
local gui = UIKit.screen("CosmicDrop", 4)
local pill = new("Frame", {
	Name = "DropTimer",
	Position = UDim2.new(0, 16, 0, 150),
	Size = UDim2.fromOffset(260, 38),
	BackgroundColor3 = THEME.Panel,
	BackgroundTransparency = 0.25,
	Parent = gui,
}, { corner(UDim.new(1, 0)), stroke(GOLD, 1.5, 0.35) })
UIKit.addAutoScale(pill)
local icon = label({
	Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(30, 38), Text = "🎲", TextSize = 22, Parent = pill,
})
local text = label({
	Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -80, 1, 0), Text = "", TextSize = 15, RichText = true,
	TextXAlignment = Enum.TextXAlignment.Left, Parent = pill,
})
local arrow = label({
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -20, 0.5, 0), Size = UDim2.fromOffset(28, 28),
	Text = "➤", TextSize = 24, TextColor3 = GOLD, Visible = false, Parent = pill,
})
local pillScale = pill:FindFirstChild("ScreenScale")

local lastWhole = -1
RunService.RenderStepped:Connect(function()
	-- hide during duels so the fight HUD stays clean
	pill.Visible = not player:GetAttribute("InDuel")
	local active = ReplicatedStorage:GetAttribute("DropActive") == true
	local nextAt = ReplicatedStorage:GetAttribute("DropNextAt")
	if active then
		local position = ReplicatedStorage:GetAttribute("DropPosition")
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local where = ReplicatedStorage:GetAttribute("DropWhere") or "the island"
		if typeof(position) == "Vector3" and root then
			local distance = (position - root.Position).Magnitude
			text.Text = ("<font color='#ffd76a'><b>COSMIC ROLL</b></font> on %s • %dm"):format(where, math.floor(distance))
			-- the arrow points where the drop is, relative to where you're looking
			local look = camera.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			local toDrop = Vector3.new(position.X - root.Position.X, 0, position.Z - root.Position.Z)
			if flatLook.Magnitude > 0.01 and toDrop.Magnitude > 0.01 then
				flatLook, toDrop = flatLook.Unit, toDrop.Unit
				local angle = math.atan2(flatLook:Cross(toDrop).Y, flatLook:Dot(toDrop))
				arrow.Rotation = -math.deg(angle) - 90
			end
			arrow.Visible = true
		else
			text.Text = "<font color='#ffd76a'><b>COSMIC ROLL</b></font> is out!"
			arrow.Visible = false
		end
		icon.Rotation = (os.clock() * 120) % 360
	else
		arrow.Visible = false
		icon.Rotation = 0
		local left = math.max(0, (nextAt or 0) - workspace:GetServerTimeNow())
		local whole = math.floor(left)
		text.Text = ("Cosmic Drop in <b>%d:%02d</b> <font color='#bfb4e1'>(x%d luck)</font>"):format(
			whole // 60, whole % 60, Config.Drop.BoostMultiplier)
		-- the last 10 seconds tick and pulse
		if whole ~= lastWhole and whole <= 10 and whole > 0 and nextAt then
			SoundFX.Play("Tick", { Speed = 1.4, Volume = 0.8 })
			if pillScale then
				local base = pillScale.Scale
				pillScale.Scale = base * 1.08
				task.delay(0.12, function()
					pillScale.Scale = base
				end)
			end
		end
		lastWhole = whole
	end
end)

---------------------------------------------------------------------
-- The drop in the world spins and bobs
---------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
	local drop = workspace:FindFirstChild("CosmicDrop")
	if not drop then
		return
	end
	local center = drop:GetAttribute("DropCenter")
	local die = drop:FindFirstChild("Die")
	if typeof(center) ~= "Vector3" or not die then
		return
	end
	local t = os.clock()
	local target = CFrame.new(center + Vector3.new(0, math.sin(t * 2) * 0.6, 0)) * CFrame.Angles(t * 1.3, t * 1.9, t * 0.7)
	-- move the die and its dots together
	local delta = target * die.CFrame:Inverse()
	for _, child in ipairs(drop:GetChildren()) do
		if child:IsA("BasePart") and (child.Name == "Die" or child.Name == "Dot") then
			child.CFrame = delta * child.CFrame
		end
	end
	local glow = drop:FindFirstChild("Glow")
	if glow then
		glow.Size = Vector3.one * (5 + math.sin(t * 3) * 0.6)
		glow.CFrame = CFrame.new(center + Vector3.new(0, math.sin(t * 2) * 0.6, 0))
	end
end)

---------------------------------------------------------------------
-- Messages
---------------------------------------------------------------------
local function burstAt(position)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.CFrame = CFrame.new(position)
	holder.Parent = workspace
	Debris:AddItem(holder, 3)
	local e = Instance.new("ParticleEmitter")
	e.Texture = Config.Textures.Sparkle
	e.Rate = 0
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(15, 30)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 3
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	e.LightEmission = 1
	e.Color = ColorSequence.new(GOLD, Color3.fromRGB(170, 110, 255))
	e.Parent = holder
	e:Emit(80)
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = GOLD
	ring.Size = Vector3.new(0.3, 2, 2)
	ring.CFrame = CFrame.new(position - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.8, Enum.EasingStyle.Quart), { Size = Vector3.new(0.3, 30, 30), Transparency = 1 }):Play()
	Debris:AddItem(ring, 1)
end

AnnounceRemote.OnClientEvent:Connect(function(info)
	if type(info) ~= "table" then
		return
	end
	if info.Type == "DropSpawned" then
		SoundFX.Chime(1.2, 4)
		local scale = pill:FindFirstChild("ScreenScale")
		if scale then
			local base = scale.Scale
			scale.Scale = base * 1.25
			TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = base }):Play()
		end
	elseif info.Type == "DropGrabbed" then
		if typeof(info.Position) == "Vector3" then
			burstAt(info.Position)
		end
		if info.UserId == player.UserId then
			SoundFX.Jingle("Victory")
			UIKit.confetti({ GOLD, THEME.Accent, THEME.Accent2 }, 90)
			UIKit.burst({ GOLD, Color3.new(1, 1, 1) }, 40, 1.4)
			UIKit.toast(("🎲 You got the COSMIC ROLL! Your next roll has x%d luck!"):format(Config.Drop.BoostMultiplier), GOLD)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="29">
        <Properties>
          <string name="Name">DuelClient</string>
          <string name="Source"><![CDATA[-- DuelClient (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Everything you see and press for 1v1 duels:
--   * ⚔ DUEL button in the side menu -> list of players + bots to fight
--   * challenge pop-up (Accept / Decline)
--   * fight HUD: both health bars, timer, ATTACK + POWER buttons
--   * controls: click or F = attack, Q = aura power
-- The server (DuelService) decides every hit; this script only asks.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))
local CombatAnim = require(ReplicatedStorage:WaitForChild("CombatAnim"))

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local DuelRequest = remotes:WaitForChild("DuelRequest", 60)
local DuelEvent = remotes:WaitForChild("DuelEvent", 60)
local DuelFX = remotes:WaitForChild("DuelFX", 60)
if not DuelRequest or not DuelEvent then
	warn("[DuelClient] duel remotes not found")
	return
end

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local DUEL = Config.Duel
local THEME = UIKit.Theme
local TITLE_FONT = UIKit.TitleFont
local new, corner, stroke, textStroke, tween, label =
	UIKit.new, UIKit.corner, UIKit.stroke, UIKit.textStroke, UIKit.tween, UIKit.label
local RED = Color3.fromRGB(255, 80, 100)
local rand = Random.new()

local gui = UIKit.screen("CosmicDuel", 3)

-- state while fighting
local inDuel = false
local me, opponent -- descriptions from the server
local fightEndsAt = 0
local fighting = false
local powerReadyAt = 0
local nextAttackAt = 0
local dodgeReadyAt = 0
local blocking = false
local localCombo, lastLocalAttack = 0, 0

local function statsForAura(auraName)
	local aura = AuraData.Get(auraName or "")
	local tier = AuraData.Tiers[aura and aura.Tier or DUEL.NoAuraTier]
	return aura, tier
end

---------------------------------------------------------------------
-- DUEL PANEL (opened from the side menu)
---------------------------------------------------------------------
local holder = new("Frame", {
	Name = "DuelHolder",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.47),
	Size = UDim2.fromOffset(620, 500),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})
UIKit.addAutoScale(holder, 780)
local panel = new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = THEME.Panel,
	BackgroundTransparency = 0.05,
	Parent = holder,
}, { corner(UDim.new(0, 18)), stroke(RED, 2.5, 0) })
local titleLabel = label({
	Position = UDim2.fromOffset(22, 12), Size = UDim2.new(1, -44, 0, 40), Text = "⚔ DUELS",
	Font = TITLE_FONT, TextSize = 32, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
UIKit.gradient(Color3.fromRGB(255, 140, 140), Color3.fromRGB(255, 200, 120), 0).Parent = titleLabel
local myStatsLabel = label({
	Position = UDim2.fromOffset(22, 50), Size = UDim2.new(1, -44, 0, 22), Text = "", RichText = true,
	TextSize = 15, TextColor3 = THEME.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
local closeButton = new("TextButton", {
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(42, 42),
	BackgroundColor3 = THEME.Bad, Text = "X", Font = TITLE_FONT, TextSize = 24, TextColor3 = THEME.Text,
	AutoButtonColor = false, Parent = panel,
}, { corner(UDim.new(0, 10)), textStroke(1.5) })
UIKit.addButtonFeel(closeButton)

local list = new("ScrollingFrame", {
	Position = UDim2.fromOffset(16, 84), Size = UDim2.new(1, -32, 1, -100),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
	ScrollBarImageColor3 = RED, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	Parent = panel,
}, {
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
})

local function sectionTitle(order, text)
	local t = label({
		LayoutOrder = order, Size = UDim2.new(1, 0, 0, 28), Text = text, Font = TITLE_FONT, TextSize = 21,
		TextColor3 = Color3.fromRGB(255, 170, 170), TextXAlignment = Enum.TextXAlignment.Left, Parent = list,
	})
	textStroke(1.5).Parent = t
end

local function row(order, icon, title, subtitle, subtitleColor, buttonText, buttonColor, enabled, onClick)
	local frame = new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 70),
		BackgroundColor3 = THEME.PanelLight,
		Parent = list,
	}, { corner(UDim.new(0, 12)), stroke(RED, 1.2, 0.5) })
	label({ Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(56, 70), Text = icon, TextSize = 34, Parent = frame })
	label({
		Position = UDim2.fromOffset(68, 10), Size = UDim2.new(1, -230, 0, 26), Text = title, Font = TITLE_FONT,
		TextSize = 21, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame,
	})
	label({
		Position = UDim2.fromOffset(68, 38), Size = UDim2.new(1, -230, 0, 20), Text = subtitle, RichText = true,
		TextSize = 14, TextColor3 = subtitleColor or THEME.SubText, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame,
	})
	local button = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(140, 46),
		BackgroundColor3 = enabled and buttonColor or Color3.fromRGB(70, 65, 90), AutoButtonColor = false,
		Text = buttonText, Font = TITLE_FONT, TextSize = 20, TextColor3 = THEME.Text, Parent = frame,
	}, { corner(UDim.new(0, 12)), textStroke(1.4) })
	UIKit.addButtonFeel(button)
	if enabled then
		button.Activated:Connect(onClick)
	end
end

local panelOpen = false
local function statsText(auraName)
	local aura, tier = statsForAura(auraName)
	local colorHex = tier.Color:ToHex()
	return ("<font color='#%s'>%s</font>  •  ❤ %d  ⚔ %d%s"):format(
		colorHex, aura and aura.Name or "No aura", tier.MaxHealth, tier.AttackDamage,
		aura and ("  ⚡ " .. aura.Power.Name) or "")
end

local function refreshPanel()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	myStatsLabel.Text = "You: " .. statsText(player:GetAttribute("EquippedAura")) .. "   (rarer aura = stronger!)"

	sectionTitle(0, "✦ PLAYERS")
	local order = 1
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local busy = other:GetAttribute("InDuel") == true
			row(order, "🧑‍🚀", other.DisplayName, statsText(other:GetAttribute("EquippedAura")), nil,
				busy and "IN DUEL" or "CHALLENGE", RED, not busy and not inDuel, function()
					DuelRequest:FireServer({ Action = "Challenge", Target = other.UserId })
				end)
			order += 1
		end
	end
	if order == 1 then
		label({
			LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 40), Text = "Nobody else is here yet - try a bot!",
			TextSize = 16, TextColor3 = THEME.SubText, Parent = list,
		})
	end

	sectionTitle(100, "✦ BOTS")
	for i, bot in ipairs(DUEL.Bots) do
		local _, tier = statsForAura(bot.Aura)
		row(100 + i, "🤖", ("%s  (%s)"):format(bot.Name, bot.Key), statsText(bot.Aura), nil,
			"FIGHT", tier.Color:Lerp(RED, 0.5), not inDuel, function()
				DuelRequest:FireServer({ Action = "Bot", Difficulty = bot.Key })
				UIKit.toast("Summoning " .. bot.Name .. "...", THEME.SubText)
			end)
	end
end

local function setPanelOpen(open)
	if open == panelOpen then
		return
	end
	panelOpen = open
	if open then
		UIKit.announcePanel("Duel")
		refreshPanel()
		holder.Visible = true
		UIKit.popIn(panel)
	else
		holder.Visible = false
	end
end
closeButton.Activated:Connect(function()
	setPanelOpen(false)
end)
UIKit.PanelOpened:Connect(function(name)
	if name ~= "Duel" then
		setPanelOpen(false)
	end
end)
task.spawn(function()
	while gui.Parent do
		task.wait(3)
		if panelOpen then
			refreshPanel()
		end
	end
end)

-- ⚔ DUEL button in the side menu (made by StoreUI)
task.spawn(function()
	local menuGui = player:WaitForChild("PlayerGui"):WaitForChild("CosmicMenu", 30)
	local sideMenu = menuGui and menuGui:WaitForChild("SideMenu", 30)
	if not sideMenu then
		return
	end
	local button = new("TextButton", {
		Name = "DUEL",
		LayoutOrder = 0,
		Size = UDim2.fromOffset(84, 84),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.1,
		AutoButtonColor = false,
		Text = "",
		Parent = sideMenu,
	}, { corner(UDim.new(0, 18)), stroke(RED, 2.5, 0) })
	label({ Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 6), Text = "⚔", TextSize = 38, Parent = button })
	local text = label({
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -6), Size = UDim2.new(1, 0, 0, 20),
		Text = "DUEL", Font = TITLE_FONT, TextSize = 16, Parent = button,
	})
	textStroke(1.2).Parent = text
	UIKit.addButtonFeel(button)
	button.Activated:Connect(function()
		setPanelOpen(not panelOpen)
	end)
	local size = sideMenu.Size
	sideMenu.Size = UDim2.new(size.X.Scale, size.X.Offset, size.Y.Scale, size.Y.Offset + 96)
end)

---------------------------------------------------------------------
-- CHALLENGE POP-UP
---------------------------------------------------------------------
local popup = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, -200),
	Size = UDim2.fromOffset(460, 150),
	BackgroundColor3 = THEME.Panel,
	Parent = gui,
}, { corner(UDim.new(0, 18)), stroke(RED, 3, 0) })
UIKit.addAutoScale(popup)
local popupText = label({
	Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 60), Text = "", RichText = true,
	Font = TITLE_FONT, TextSize = 22, TextWrapped = true, Parent = popup,
})
local timeBar = new("Frame", {
	Position = UDim2.new(0, 16, 0, 74), Size = UDim2.new(1, -32, 0, 6), BackgroundColor3 = RED, BorderSizePixel = 0, Parent = popup,
}, { corner(UDim.new(1, 0)) })
local function popupButton(text, color, x)
	local b = new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(x, 0, 1, -14), Size = UDim2.fromOffset(180, 46),
		BackgroundColor3 = color, AutoButtonColor = false, Text = text, Font = TITLE_FONT, TextSize = 22,
		TextColor3 = THEME.Text, Parent = popup,
	}, { corner(UDim.new(0, 12)), textStroke(1.4) })
	UIKit.addButtonFeel(b)
	return b
end
local acceptButton = popupButton("ACCEPT", THEME.Good, 0.27)
local declineButton = popupButton("DECLINE", THEME.Bad, 0.73)
local pendingFrom
local popupToken = 0

local function hidePopup()
	popupToken += 1
	pendingFrom = nil
	tween(popup, 0.3, { Position = UDim2.new(0.5, 0, 0, -200) })
end

local function showChallenge(info)
	popupToken += 1
	local token = popupToken
	pendingFrom = info.FromUserId
	popupText.Text = ("⚔ <b>%s</b> challenges you!\n<font size='16'>%s</font>"):format(info.FromName, statsText(info.FromAura))
	popup.Position = UDim2.new(0.5, 0, 0, -200)
	tween(popup, 0.45, { Position = UDim2.new(0.5, 0, 0, 80) }, Enum.EasingStyle.Back)
	timeBar.Size = UDim2.new(1, -32, 0, 6)
	tween(timeBar, info.Timeout, { Size = UDim2.new(0, 0, 0, 6) }, Enum.EasingStyle.Linear)
	SoundFX.Play("RevealEpic", { Volume = 0.6 })
	SoundFX.Chime(0.9, 3)
	task.delay(info.Timeout, function()
		if token == popupToken then
			hidePopup()
		end
	end)
end
acceptButton.Activated:Connect(function()
	if pendingFrom then
		DuelRequest:FireServer({ Action = "Respond", From = pendingFrom, Accept = true })
	end
	hidePopup()
end)
declineButton.Activated:Connect(function()
	if pendingFrom then
		DuelRequest:FireServer({ Action = "Respond", From = pendingFrom, Accept = false })
	end
	hidePopup()
end)

