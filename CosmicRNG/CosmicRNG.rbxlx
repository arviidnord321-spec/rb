	bigSub.TextTransparency = sub and 0 or 1
end
local function hideBig(delay)
	task.delay(delay, function()
		tween(bigText, 0.4, { TextTransparency = 1 })
		tween(bigStroke, 0.4, { Transparency = 1 })
		tween(bigSub, 0.4, { TextTransparency = 1 })
	end)
end

