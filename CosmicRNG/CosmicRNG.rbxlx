	BackgroundColor3 = THEME.Bad, Text = "X", Font = TITLE_FONT, TextSize = 24, TextColor3 = THEME.Text,
	AutoButtonColor = false, ZIndex = 8, Parent = inventory,
}, { corner(UDim.new(0, 10)), textStroke(1.5) })
UIKit.addButtonFeel(closeButton)

local list = new("ScrollingFrame", {
	Position = UDim2.fromOffset(16, 82), Size = UDim2.new(1, -32, 1, -98),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
	ScrollBarImageColor3 = THEME.Accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ZIndex = 8, Parent = inventory,
}, {
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(200, 214), CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center,
	}),
	new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }),
})

local function buildCard(aura, count, index, animate)
	local owned = count > 0
	local tier = tierOf(aura)
	local equipped = data.Equipped == aura.Name

	local cardFrame = new("Frame", {
		Name = aura.Name,
		BackgroundColor3 = THEME.PanelLight,
		LayoutOrder = -aura.Chance, -- rarest first
		ZIndex = 8,
		Parent = list,
	}, { corner(UDim.new(0, 12)), stroke(equipped and THEME.Good or tier.Color, equipped and 3 or 1.5, owned and 0 or 0.6) })
	local cardScale = new("UIScale", { Parent = cardFrame })
	if animate then
		cardScale.Scale = 0.6
		task.delay(index * 0.015, function()
			tween(cardScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
	cardFrame.MouseEnter:Connect(function()
		tween(cardScale, 0.12, { Scale = 1.04 })
	end)
	cardFrame.MouseLeave:Connect(function()
		tween(cardScale, 0.12, { Scale = 1 })
	end)

	-- picture (or a placeholder) in the top-left corner
	local image = AuraData.GetImage(aura.Name)
	local thumb
	if owned and image then
		thumb = new("ImageLabel", {
			Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(58, 58),
			BackgroundColor3 = THEME.Panel, Image = image, ScaleType = Enum.ScaleType.Crop,
			ZIndex = 8, Parent = cardFrame,
		}, { corner(UDim.new(0, 10)) })
	else
		thumb = new("Frame", {
			Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(58, 58),
			BackgroundColor3 = owned and Color3.new(1, 1, 1) or Color3.fromRGB(24, 20, 44),
			ZIndex = 8, Parent = cardFrame,
		}, { corner(UDim.new(0, 10)) })
		if owned then
			UIKit.gradient(aura.Colors[1], aura.Colors[2], 45).Parent = thumb
		end
		label({
			Size = UDim2.fromScale(1, 1), Text = owned and "✦" or "?", Font = TITLE_FONT, TextSize = 30,
			TextColor3 = owned and Color3.new(1, 1, 1) or Color3.fromRGB(110, 100, 140), ZIndex = 8, Parent = thumb,
		})
	end
	stroke(tier.Color, 2, owned and 0 or 0.6).Parent = thumb

	local nameText = label({
		Position = UDim2.fromOffset(76, 10), Size = UDim2.new(1, -86, 0, 24),
		Text = owned and aura.Name or "???", Font = TITLE_FONT, TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
	})
	new("UITextSizeConstraint", { MaxTextSize = 20, Parent = nameText })
	if owned then
		UIKit.gradient(UIKit.readable(aura.Colors[1]), UIKit.readable(aura.Colors[2]), 0).Parent = nameText
	else
		nameText.TextColor3 = Color3.fromRGB(110, 100, 140)
	end

	local tierText = label({
		Position = UDim2.fromOffset(76, 36), Size = UDim2.new(1, -86, 0, 14),
		Text = aura.Tier, TextScaled = true, TextColor3 = tier.Color,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
	})
	new("UITextSizeConstraint", { MaxTextSize = 13, Parent = tierText })
	local chanceText = label({
		Position = UDim2.fromOffset(76, 52), Size = UDim2.new(1, -86, 0, 14),
		Text = AuraData.FormatChance(aura.Chance) .. (owned and ("  •  x" .. AuraData.FormatNumber(count)) or ""),
		TextScaled = true, TextColor3 = THEME.SubText,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
	})
	new("UITextSizeConstraint", { MaxTextSize = 12, Parent = chanceText })

	if owned then
		label({
			Position = UDim2.fromOffset(10, 78), Size = UDim2.new(1, -20, 0, 18),
			Text = ("⚡ %s"):format(aura.Power.Name), TextSize = 14, TextColor3 = Color3.fromRGB(255, 220, 120),
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
		})
		label({
			Position = UDim2.fromOffset(10, 96), Size = UDim2.new(1, -20, 0, 34),
			Text = aura.Power.Description, TextSize = 12, Font = Enum.Font.Gotham, TextWrapped = true,
			TextColor3 = THEME.SubText, TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 8, Parent = cardFrame,
		})
		label({
			Position = UDim2.fromOffset(10, 132), Size = UDim2.new(1, -20, 0, 16),
			Text = ("❤ %d HP   ⚔ %d DMG"):format(tier.MaxHealth, tier.AttackDamage),
			TextSize = 12, TextColor3 = Color3.fromRGB(255, 150, 160),
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = cardFrame,
		})

		local equipButton = new("TextButton", {
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -20, 0, 34),
			BackgroundColor3 = equipped and THEME.Good or THEME.Accent, AutoButtonColor = false,
			Text = equipped and "EQUIPPED" or "EQUIP", Font = TITLE_FONT, TextSize = 18,
			TextColor3 = THEME.Text, ZIndex = 8, Parent = cardFrame,
		}, { corner(UDim.new(0, 8)), textStroke(1.2) })
		UIKit.addButtonFeel(equipButton, true)
		equipButton.Activated:Connect(function()
			if data.Equipped ~= aura.Name then
				data.Equipped = aura.Name
				EquipRemote:FireServer(aura.Name)
				SoundFX.Play("Equip")
				UIKit.burst({ aura.Colors[1], aura.Colors[2] }, 14, 0.5, Vector2.new(0.5, 0.5))
				refreshInventory(false)
			end
		end)
	else
		label({
			Position = UDim2.fromOffset(10, 90), Size = UDim2.new(1, -20, 0, 60),
			Text = "Not discovered yet.\nKeep rolling!", TextSize = 14, Font = Enum.Font.Gotham,
			TextColor3 = Color3.fromRGB(130, 120, 160), TextWrapped = true, ZIndex = 8, Parent = cardFrame,
		})
	end
end

refreshInventory = function(animate)
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local discovered = 0
	for index, aura in ipairs(AuraData.List) do
		local count = data.Inventory[aura.Name] or 0
		if count > 0 then
			discovered += 1
		end
		buildCard(aura, count, #AuraData.List - index, animate)
	end
	discoveredLabel.Text = ("Discovered %d / %d auras  •  Rarer auras = stronger duel powers"):format(
		discovered, #AuraData.List)
end

setInventoryOpen = function(open)
	if open == inventoryOpen then
		return
	end
	inventoryOpen = open
	if open then
		UIKit.announcePanel("Inventory")
		refreshInventory(true)
		inventoryHolder.Visible = true
		UIKit.popIn(inventory)
	else
		inventoryHolder.Visible = false
	end
end

aurasButton.Activated:Connect(function()
	setInventoryOpen(not inventoryOpen)
end)
closeButton.Activated:Connect(function()
	setInventoryOpen(false)
end)
UIKit.PanelOpened:Connect(function(name)
	if name ~= "Inventory" then
		setInventoryOpen(false)
	end
end)

---------------------------------------------------------------------
-- ANNOUNCEMENTS
---------------------------------------------------------------------
local bannerToken = 0
local function showBanner(message, color, image)
	bannerIcon.Visible = image ~= nil
	bannerIcon.Image = image or ""
	bannerLabel.Position = UDim2.fromOffset(image and 58 or 10, 0)
	bannerLabel.Size = UDim2.new(1, image and -68 or -20, 1, 0)
	bannerToken += 1
	local token = bannerToken
	bannerLabel.Text = message
	bannerStroke.Color = color
	banner.Position = UDim2.new(0.5, 0, 0, -90)
	tween(banner, 0.5, { Position = UDim2.new(0.5, 0, 0, 70) }, Enum.EasingStyle.Back)
	task.delay(5, function()
		if token == bannerToken then
			tween(banner, 0.4, { Position = UDim2.new(0.5, 0, 0, -90) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general then
			general:DisplaySystemMessage(message)
		end
	end)
end

local function skyShift(aura)
	-- SkyFX reads these and paints the sky in the aura's colors for 10 seconds
	Lighting:SetAttribute("SkyShiftA", aura.Colors[2])
	Lighting:SetAttribute("SkyShiftB", aura.Colors[1])
	Lighting:SetAttribute("SkyShiftUntil", os.clock() + 10)
	flash(0.8, 1.5)
	addShake(1.5)
end

AnnounceRemote.OnClientEvent:Connect(function(info)
	if info.Type == "Duel" then
		local aura = AuraData.Get(info.WinnerAura or "")
		showBanner(("⚔ <b>%s</b> defeated <b>%s</b> in a duel%s!"):format(
			info.Winner, info.Loser, aura and (" with <font color='#" .. tierOf(aura).Color:ToHex() .. "'>" .. aura.Name .. "</font>") or ""),
			Color3.fromRGB(255, 90, 100), aura and AuraData.GetImage(aura.Name) or nil)
		SoundFX.Play("Pop", { Volume = 0.7 })
		return
	end
	if info.Type == "DropSpawned" then
		showBanner(("🎲 A <font color='#ffd76a'><b>COSMIC ROLL</b></font> landed on %s! First to grab it gets x%d luck!"):format(
			tostring(info.Where or "the island"), Config.Drop.BoostMultiplier), THEME.Gold)
		return
	end
	if info.Type == "DropGrabbed" then
		showBanner(("🎲 <b>%s</b> grabbed the <font color='#ffd76a'><b>COSMIC ROLL</b></font>!"):format(info.PlayerName), THEME.Gold)
		return
	end
	if info.Type == "Pet" then
		local pet = PetData.Get(info.Pet or "")
		if pet then
			local color = PetData.Rarities[pet.Rarity].Color
			showBanner(("🥚 <b>%s</b> hatched a <font color='#%s'><b>%s</b></font> pet (%s)!"):format(
				info.PlayerName, color:ToHex(), pet.Name, pet.Rarity), color)
		end
		return
	end
	if info.Type == "Limited" then
		showBanner(("🔥 <b>%s</b> grabbed the <font color='#ff8c5a'><b>LIMITED OFFER</b></font>!"):format(info.PlayerName), Color3.fromRGB(255, 140, 90))
		return
	end
	if info.Type == "Rebirth" then
		local color = Rebirth.Color(info.Rebirths)
		showBanner(("⭐ <b>%s</b> just <font color='#%s'><b>REBIRTHED</b></font>! (Rebirth %d)"):format(
			info.PlayerName, color:ToHex(), info.Rebirths), color)
		if info.UserId ~= player.UserId then
			SoundFX.Chime(1.1, 4)
		end
		return
	end
	if info.Type == "ServerLuck" then
		showBanner(("🌌 <b>%s</b> activated <font color='#ffd76a'><b>SERVER LUCK</b></font>! x%s luck for everyone!"):format(
			info.PlayerName, Luck.Format(Config.LuckMultipliers.ServerBoost)), THEME.Gold)
		UIKit.confetti({ THEME.Gold, THEME.Accent, THEME.Accent2 }, 80)
		SoundFX.Chime(1, 5)
		return
	end

	local aura = AuraData.Get(info.Aura)
	if not aura then
		return
	end
	local hex = tierOf(aura).Color:ToHex()
	showBanner(("✦ <b>%s</b> rolled <font color='#%s'><b>%s</b></font> (%s) ✦"):format(
		info.PlayerName, hex, aura.Name, AuraData.FormatChance(aura.Chance)), tierOf(aura).Color, AuraData.GetImage(aura.Name))
	if info.UserId ~= player.UserId then
		SoundFX.Play("Pop", { Volume = 0.7 })
	end
	if aura.Chance >= Config.SkyShiftAtChance then
		skyShift(aura)
	end
end)

---------------------------------------------------------------------
-- DATA SYNC
---------------------------------------------------------------------
DataUpdatedRemote.OnClientEvent:Connect(function(snapshot)
	data = snapshot
	updateStats()
	if inventoryOpen then
		refreshInventory(false)
	end
end)

updateAutoButton()
updateStats()

---------------------------------------------------------------------
-- INTRO: title card, then the UI slides in
---------------------------------------------------------------------
local function playIntro()
	rollBar.Position = UDim2.new(0.5, 0, 1, 220)
	statsPanel.Position = UDim2.new(0, -320, 0, 64)

	local holder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(800, 200),
		BackgroundTransparency = 1, ZIndex = 9, Parent = gui,
	})
	UIKit.addAutoScale(holder)
	local title = label({
		Size = UDim2.new(1, 0, 0, 130), Text = "COSMIC RNG", Font = TITLE_FONT, TextSize = 120, ZIndex = 9, Parent = holder,
	})
	textStroke(5).Parent = title
	local titleGradient = UIKit.gradient(Color3.fromRGB(190, 140, 255), Color3.fromRGB(90, 220, 255), 0)
	titleGradient.Parent = title
	local subtitle = label({
		Position = UDim2.fromOffset(0, 130), Size = UDim2.new(1, 0, 0, 40), Text = "roll the universe",
		Font = TITLE_FONT, TextSize = 32, TextColor3 = THEME.SubText, TextTransparency = 1, ZIndex = 9, Parent = holder,
	})
	local titleScale = new("UIScale", { Scale = 0.3, Parent = title })

	tween(titleScale, 0.8, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(titleGradient, 2.5, { Rotation = 360 }, Enum.EasingStyle.Linear)
	SoundFX.Play("IntroSwell")
	task.delay(0.3, function()
		SoundFX.Notes({ 1, 1.26, 1.5, 2 }, 0.22, { Volume = 0.3 })
	end)
	UIKit.burst({ Color3.fromRGB(190, 140, 255), Color3.fromRGB(90, 220, 255), Color3.new(1, 1, 1) }, 40, 1.2, Vector2.new(0.5, 0.42))
	task.wait(0.5)
	tween(subtitle, 0.6, { TextTransparency = 0 })
	task.wait(1.6)
	tween(title, 0.5, { TextTransparency = 1 })
	tween(title:FindFirstChild("TextOutline"), 0.5, { Transparency = 1 })
	tween(subtitle, 0.5, { TextTransparency = 1 })
	tween(titleScale, 0.5, { Scale = 1.3 })
	SoundFX.Play("Whoosh", { Volume = 0.5 })
	tween(rollBar, 0.6, { Position = UDim2.new(0.5, 0, 1, -20) }, Enum.EasingStyle.Back)
	tween(statsPanel, 0.6, { Position = UDim2.new(0, 16, 0, 64) }, Enum.EasingStyle.Back)
	task.wait(0.6)
	holder:Destroy()
end

task.spawn(function()
	local introOk, introError = pcall(playIntro)
	if not introOk then
		warn("[RollUI] intro failed:", introError)
		rollBar.Position = UDim2.new(0.5, 0, 1, -20)
		statsPanel.Position = UDim2.new(0, 16, 0, 64)
	end
	for _ = 1, 30 do
		local ok, snapshot = pcall(function()
			return GetDataRemote:InvokeServer()
		end)
		if ok and snapshot then
			data = snapshot
			updateStats()
			if data.Rolls == 0 then
				UIKit.toast("Press ROLL (or R) to discover your first aura!", THEME.Accent2)
			end
			return
		end
		task.wait(1)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="39">
        <Properties>
          <string name="Name">SkyFX</string>
          <string name="Source"><![CDATA[-- SkyFX (LocalScript in StarterPlayer > StarterPlayerScripts)
-- In charge of the sky on your screen:
--   * the sky slowly drifts through different moods on the main island
--     (violet dusk, teal nebula, rose galaxy, deep indigo)
--   * every island has its own sky colors, and they blend smoothly
--   * a secret roll can take over the sky for a few seconds (RollUI)
--   * animates the sky scenery from SkyDecor: twinkling stars, turning
--     galaxies, bobbing islets and sky isles, glowing suns, and all the
--     sky creatures (whales, mantas, jellyfish, fish, turtles, koi, stars,
--     serpents), each with its own way of moving

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local rand = Random.new()

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

---------------------------------------------------------------------
-- SKY MOODS
---------------------------------------------------------------------
-- The main island drifts through these, one after another
local MOODS = {
	{ -- violet dusk
		Ambient = rgb(70, 60, 110), Outdoor = rgb(110, 95, 170),
		Color = rgb(120, 90, 210), Decay = rgb(50, 30, 110), Tint = rgb(245, 240, 255), Saturation = 0.15, Density = 0.3,
	},
	{ -- teal nebula
		Ambient = rgb(55, 80, 110), Outdoor = rgb(90, 150, 185),
		Color = rgb(70, 175, 215), Decay = rgb(20, 60, 105), Tint = rgb(235, 250, 255), Saturation = 0.2, Density = 0.32,
	},
	{ -- rose galaxy
		Ambient = rgb(95, 60, 100), Outdoor = rgb(170, 100, 165),
		Color = rgb(220, 110, 190), Decay = rgb(90, 30, 95), Tint = rgb(255, 240, 248), Saturation = 0.2, Density = 0.3,
	},
	{ -- deep indigo with a warm glow
		Ambient = rgb(60, 55, 105), Outdoor = rgb(105, 100, 180),
		Color = rgb(95, 95, 225), Decay = rgb(35, 25, 85), Tint = rgb(252, 245, 232), Saturation = 0.12, Density = 0.34,
	},
}
local MOOD_SECONDS = 70 -- how long each mood lasts
local BLEND_SECONDS = 20 -- how long the change between moods takes

-- Each place has its own sky
local PLACES = {
	Lucky = {
		Ambient = rgb(120, 90, 100), Outdoor = rgb(190, 140, 160),
		Color = rgb(255, 170, 195), Decay = rgb(140, 70, 110), Tint = rgb(255, 238, 225), Saturation = 0.25, Density = 0.28,
	},
	Frostfall = {
		Ambient = rgb(130, 150, 190), Outdoor = rgb(170, 205, 245),
		Color = rgb(200, 230, 255), Decay = rgb(110, 150, 210), Tint = rgb(225, 240, 255), Saturation = 0.05, Density = 0.33,
	},
	Ember = {
		Ambient = rgb(130, 70, 50), Outdoor = rgb(210, 110, 70),
		Color = rgb(255, 140, 90), Decay = rgb(120, 40, 25), Tint = rgb(255, 225, 205), Saturation = 0.2, Density = 0.36,
	},
	Nexus = {
		Ambient = rgb(110, 60, 140), Outdoor = rgb(170, 90, 220),
		Color = rgb(255, 110, 230), Decay = rgb(60, 20, 120), Tint = rgb(245, 225, 255), Saturation = 0.35, Density = 0.3,
	},
	Duel = {
		Ambient = rgb(90, 55, 80), Outdoor = rgb(160, 90, 130),
		Color = rgb(210, 90, 130), Decay = rgb(80, 20, 60), Tint = rgb(255, 238, 240), Saturation = 0.18, Density = 0.3,
	},
}

local function lerpMood(a, b, t)
	return {
		Ambient = a.Ambient:Lerp(b.Ambient, t),
		Outdoor = a.Outdoor:Lerp(b.Outdoor, t),
		Color = a.Color:Lerp(b.Color, t),
		Decay = a.Decay:Lerp(b.Decay, t),
		Tint = a.Tint:Lerp(b.Tint, t),
		Saturation = a.Saturation + (b.Saturation - a.Saturation) * t,
		Density = a.Density + (b.Density - a.Density) * t,
	}
end

-- the main-island mood right now (same for everyone: it follows the server clock)
local function cycleMood()
	local now = workspace:GetServerTimeNow()
	local total = #MOODS * MOOD_SECONDS
	local phase = now % total
	local index = math.floor(phase / MOOD_SECONDS) + 1
	local into = phase % MOOD_SECONDS
	local current = MOODS[index]
	local nextMood = MOODS[(index % #MOODS) + 1]
	local blendStart = MOOD_SECONDS - BLEND_SECONDS
	if into > blendStart then
		local t = (into - blendStart) / BLEND_SECONDS
		t = t * t * (3 - 2 * t) -- smooth
		return lerpMood(current, nextMood, t)
	end
	return current
end

local function placeMood(root)
	local rebirthIsland = player:GetAttribute("OnRebirthIsland")
	if rebirthIsland and PLACES[rebirthIsland] then
		return PLACES[rebirthIsland]
	end
	if player:GetAttribute("OnLuckyIsland") then
		return PLACES.Lucky
	end
	if root then
		local duel = Config.Places.DuelIsland
		local flat = Vector3.new(root.Position.X - duel.X, 0, root.Position.Z - duel.Z)
		if flat.Magnitude < Config.Places.DuelIslandRadius + 8 then
			return PLACES.Duel
		end
	end
	return nil
end

-- secret rolls take over the sky for a moment (RollUI sets these)
local function skyShiftMood(base)
	local untilTime = Lighting:GetAttribute("SkyShiftUntil")
	if not untilTime or os.clock() > untilTime then
		return base
	end
	local a = Lighting:GetAttribute("SkyShiftA") or base.Color
	local b = Lighting:GetAttribute("SkyShiftB") or base.Decay
	return {
		Ambient = base.Ambient, Outdoor = base.Outdoor,
		Color = a, Decay = b, Tint = a:Lerp(Color3.new(1, 1, 1), 0.6),
		Saturation = base.Saturation + 0.2, Density = base.Density,
	}
end

local current -- what the sky looks like right now (blends toward the target)

local function apply(mood)
	Lighting.Ambient = mood.Ambient
	Lighting.OutdoorAmbient = mood.Outdoor
	local atmosphere = Lighting:FindFirstChild("CosmicAtmosphere") or Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Color = mood.Color
		atmosphere.Decay = mood.Decay
		atmosphere.Density = mood.Density
	end
	local grade = Lighting:FindFirstChild("CosmicColor")
	if grade then
		grade.TintColor = mood.Tint
		grade.Saturation = mood.Saturation
	end
end

RunService.RenderStepped:Connect(function(dt)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local target = skyShiftMood(placeMood(root) or cycleMood())
	if not current then
		current = target
	else
		current = lerpMood(current, target, 1 - math.exp(-dt * 0.9))
	end
	apply(current)
end)

---------------------------------------------------------------------
-- SKY SCENERY ANIMATION
---------------------------------------------------------------------
local decor = workspace:WaitForChild("CosmicSkyDecor", 60)
if not decor then
	warn("[SkyFX] CosmicSkyDecor not found")
	return
end

local twinklers, spinners, bobbers, breathers, creatures = {}, {}, {}, {}, {}
for _, item in ipairs(decor:GetDescendants()) do
	if item:IsA("BasePart") then
		local twinkle = item:GetAttribute("FX_Twinkle")
		if twinkle then
			table.insert(twinklers, { Part = item, Phase = twinkle, Base = item.Transparency })
		end
		local breathe = item:GetAttribute("FX_Breathe")
		if breathe then
			table.insert(breathers, { Part = item, Phase = breathe, Base = item.Size, BaseT = item.Transparency })
		end
	elseif item:IsA("Model") then
		if item:GetAttribute("FX_Creature") then
			local entry = {
				Model = item,
				Motion = item:GetAttribute("Motion") or "Orbit",
				Center = item:GetAttribute("Center") or Vector3.zero,
				Radius = item:GetAttribute("Radius") or 0,
				Height = item:GetAttribute("Height") or 0,
				Speed = item:GetAttribute("Speed") or 0.05,
				Phase = item:GetAttribute("Phase") or 0,
				Bob = item:GetAttribute("Bob") or 4,
				Spin = item:GetAttribute("Spin") or 0,
			}
			if entry.Motion ~= "Serpent" then
				-- remember where every piece sits on the creature, and which pieces
				-- move on their own (fins flap, tails swing, domes breathe)
				local pivot = item:GetPivot()
				entry.Parts = {}
				for _, p in ipairs(item:GetDescendants()) do
					if p:IsA("BasePart") then
						local wiggleKind = p:GetAttribute("Wiggle")
						table.insert(entry.Parts, {
							Part = p,
							Offset = pivot:ToObjectSpace(p.CFrame),
							Wiggle = wiggleKind,
							Joint = p:GetAttribute("Joint") or Vector3.zero,
							Amp = p:GetAttribute("Amp") or 0,
							WSpeed = p:GetAttribute("WSpeed") or 1,
							WPhase = p:GetAttribute("WPhase") or 0,
							Side = p:GetAttribute("Side") or 1,
							BaseSize = p.Size,
						})
					end
				end
			end
			if entry.Motion == "Serpent" then
				-- remember how every piece sits on its body segment
				entry.Segments = {}
				local count = item:GetAttribute("Segments") or 0
				for i = 1, count do
					entry.Segments[i] = { Part = item:FindFirstChild("Seg" .. i), Extras = {} }
				end
				for _, p in ipairs(item:GetChildren()) do
					local index = p:GetAttribute("Segment")
					if p:IsA("BasePart") and index and entry.Segments[index] and p ~= entry.Segments[index].Part then
						table.insert(entry.Segments[index].Extras, { Part = p, Offset = entry.Segments[index].Part.CFrame:ToObjectSpace(p.CFrame) })
					end
				end
				-- time gap between segments so they sit one body-length apart on the path
				local spacing = item:GetAttribute("Spacing") or 4
				entry.SegmentGap = spacing / math.max(math.abs(entry.Speed) * entry.Radius, 1)
			end
			table.insert(creatures, entry)
		elseif item:GetAttribute("FX_SpinLocal") then
			table.insert(spinners, { Model = item, Base = item:GetPivot(), Speed = item:GetAttribute("FX_SpinLocal") })
		elseif item:GetAttribute("FX_Bob") then
			table.insert(bobbers, {
				Model = item,
				Base = item:GetPivot(),
				Bob = item:GetAttribute("FX_Bob"),
				Spin = item:GetAttribute("FX_SpinY") or 0,
				Phase = rand:NextNumber(0, 6),
			})
		end
	end
end

-- where a moving creature is at time t
local function pathAt(c, t)
	local a = c.Phase + t * c.Speed
	if c.Motion == "Figure8" then
		return c.Center + Vector3.new(math.sin(a) * c.Radius, c.Height + math.sin(t * 0.5 + c.Phase) * c.Bob, math.sin(a) * math.cos(a) * c.Radius * 1.2)
	elseif c.Motion == "Wave" then
		return c.Center + Vector3.new(math.cos(a) * c.Radius, c.Height + math.sin(a * 4) * c.Bob * 2.5, math.sin(a) * c.Radius)
	elseif c.Motion == "Serpent" then
		return c.Center + Vector3.new(math.cos(a) * c.Radius, c.Height + math.sin(a * 5) * 14 + math.sin(a * 2) * 10, math.sin(a) * (c.Radius * 0.75 + math.sin(a * 3) * 25))
	end
	return c.Center + Vector3.new(math.cos(a) * c.Radius, c.Height + math.sin(t * 0.4 + c.Phase) * c.Bob, math.sin(a) * c.Radius)
end

-- puts every piece of a creature in place, with its own little motion
local function placeParts(c, cf, t)
	for _, info in ipairs(c.Parts) do
		local kind = info.Wiggle
		if not kind then
			info.Part.CFrame = cf * info.Offset
		elseif kind == "Pulse" then
			local scale = 1 + math.sin(t * info.WSpeed + info.WPhase) * info.Amp
			info.Part.Size = info.BaseSize * Vector3.new(scale, 1 / scale, scale)
			info.Part.CFrame = cf * info.Offset
		else
			local swing = math.sin(t * info.WSpeed + info.WPhase) * info.Amp
			local rotation
			if kind == "Flap" then
				rotation = CFrame.Angles(0, 0, -info.Side * swing)
			elseif kind == "Yaw" then
				rotation = CFrame.Angles(0, swing, 0)
			else -- Pitch
				rotation = CFrame.Angles(swing, 0, 0)
			end
			local joint = info.Joint
			info.Part.CFrame = cf * CFrame.new(joint) * rotation * CFrame.new(-joint) * info.Offset
		end
	end
end

local function moveCreature(c, t)
	if c.Motion == "Hover" then
		local position = c.Center + Vector3.new(0, c.Height + math.sin(t * 0.7 + c.Phase) * c.Bob, 0)
		placeParts(c, CFrame.new(position) * CFrame.Angles(math.sin(t * 0.5 + c.Phase) * 0.15, t * c.Spin + c.Phase, math.cos(t * 0.4 + c.Phase) * 0.15), t)
		return
	end
	if c.Motion == "Serpent" then
		local dt = c.SegmentGap or 0.3
		for i, seg in ipairs(c.Segments) do
			if seg.Part then
				local here = pathAt(c, t - (i - 1) * dt)
				local ahead = pathAt(c, t - (i - 1) * dt + 0.2)
				local cf = CFrame.lookAt(here, ahead)
				seg.Part.CFrame = cf
				for _, extra in ipairs(seg.Extras) do
					extra.Part.CFrame = cf * extra.Offset
				end
			end
		end
		return
	end
	local here = pathAt(c, t)
	local ahead = pathAt(c, t + 0.5)
	local cf = CFrame.lookAt(here, ahead)
	-- lean into turns (and mantas sway their wings)
	local bank = (c.Speed > 0 and -1 or 1) * 0.25
	if c.Motion == "Wave" then
		bank += math.sin(t * 1.6 + c.Phase) * 0.35
	elseif c.Motion == "Figure8" then
		bank = math.cos(c.Phase + t * c.Speed) * 0.4
	end
	placeParts(c, cf * CFrame.Angles(0, 0, bank), t)
end

local FAR = 1100 -- sky things are big, so animate them from further away
local function near(position, range)
	return (camera.CFrame.Position - position).Magnitude < (range or FAR)
end

local t = 0
local frame = 0
RunService.RenderStepped:Connect(function(dt)
	t += dt
	frame += 1

	for _, s in ipairs(twinklers) do
		s.Part.Transparency = math.clamp(s.Base + (math.sin(t * 2.3 + s.Phase * 3) + 1) * 0.3, 0, 0.95)
	end
	for _, b in ipairs(breathers) do
		local wave = math.sin(t * 0.9 + b.Phase)
		b.Part.Size = b.Base * (1 + wave * 0.04 * b.Phase)
		b.Part.Transparency = math.clamp(b.BaseT + wave * 0.05, 0, 0.98)
	end

	-- creatures near you move every frame
	for index, c in ipairs(creatures) do
		local distance = (camera.CFrame.Position - c.Center).Magnitude
		-- close creatures every frame, further ones every 3rd frame (smooth + cheap)
		if distance < 450 or (distance < 800 and (frame + index) % 3 == 0) then
			moveCreature(c, t)
		end
	end

	-- slow things only need updating every other frame
	if frame % 2 == 0 then
		for _, s in ipairs(spinners) do
			if near(s.Base.Position) then
				s.Model:PivotTo(s.Base * CFrame.Angles(0, t * s.Speed, 0))
			end
		end
		for _, b in ipairs(bobbers) do
			if near(b.Base.Position, 700) then
				b.Model:PivotTo(b.Base * CFrame.new(0, math.sin(t * 0.5 + b.Phase) * b.Bob, 0) * CFrame.Angles(0, t * b.Spin, 0))
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="40">
        <Properties>
          <string name="Name">Sprint</string>
          <string name="Source"><![CDATA[-- Sprint (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Hold SHIFT (or tap RUN on phones) to sprint. Uses stamina, which
-- refills when you stop. While sprinting: wider view, speed lines and
-- dust at your feet. The server sets the real speed (Movement script).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local MOVE = Config.Movement
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local SprintRemote = remotes:WaitForChild("Sprint", 60)
if not SprintRemote then
	warn("[Sprint] remote missing")
	return
end

local THEME = UIKit.Theme
local new, corner, tween, label = UIKit.new, UIKit.corner, UIKit.tween, UIKit.label

local wantSprint = false
local sprinting = false
local stamina = MOVE.MaxStamina
local lastSprintTime = 0
local exhausted = false
local baseFov = camera.FieldOfView

---------------------------------------------------------------------
-- UI: stamina bar (bottom left) + speed lines + mobile RUN button
---------------------------------------------------------------------
local gui = UIKit.screen("CosmicSprint", 2)

local barHolder = new("Frame", {
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 16, 1, -18),
	Size = UDim2.fromOffset(230, 34),
	BackgroundTransparency = 1,
	Parent = gui,
})
UIKit.addAutoScale(barHolder)
local barLabel = label({
	Size = UDim2.new(1, 0, 0, 16), Text = "⚡ STAMINA  (hold Shift)", TextSize = 13, Font = UIKit.TitleFont,
	TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, Parent = barHolder,
})
local barBack = new("Frame", {
	Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 12),
	BackgroundColor3 = THEME.Panel, BackgroundTransparency = 1, Parent = barHolder,
}, { corner(UDim.new(1, 0)) })
local barFill = new("Frame", {
	Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(110, 230, 255),
	BackgroundTransparency = 1, BorderSizePixel = 0, Parent = barBack,
}, { corner(UDim.new(1, 0)), UIKit.gradient(Color3.fromRGB(120, 240, 255), Color3.fromRGB(150, 110, 255), 0) })

local barVisible = false
local function setBarVisible(visible)
	if visible == barVisible then
		return
	end
	barVisible = visible
	local t = visible and 0 or 1
	tween(barLabel, 0.3, { TextTransparency = t })
	tween(barBack, 0.3, { BackgroundTransparency = visible and 0.3 or 1 })
	tween(barFill, 0.3, { BackgroundTransparency = t })
end

-- speed lines: thin streaks sliding past the edges of the screen
local lines = {}
for i = 1, 14 do
	local left = i % 2 == 0
	local line = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(left and 0.04 or 0.96, (i / 15)),
		Size = UDim2.fromOffset(160, 2),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = gui,
	})
	table.insert(lines, { Frame = line, Left = left, Phase = math.random() })
end

-- mobile RUN button
local runButton
if UserInputService.TouchEnabled then
	runButton = new("TextButton", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -60),
		Size = UDim2.fromOffset(84, 84),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.15,
		Text = "🏃\nRUN",
		Font = UIKit.TitleFont,
		TextSize = 18,
		TextColor3 = THEME.Text,
		AutoButtonColor = false,
		Parent = gui,
	}, { corner(UDim.new(1, 0)), UIKit.stroke(THEME.Accent2, 2.5, 0) })
	runButton.Activated:Connect(function()
		wantSprint = not wantSprint
		runButton.BackgroundColor3 = wantSprint and Color3.fromRGB(40, 120, 150) or THEME.Panel
	end)
end

---------------------------------------------------------------------
-- Dust at your feet while sprinting (only on your screen)
---------------------------------------------------------------------
local dust
local function attachDust(character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "SprintDust"
	attachment.Position = Vector3.new(0, -2.8, 0)
	attachment.Parent = root
	dust = Instance.new("ParticleEmitter")
	dust.Texture = Config.Textures.Smoke
	dust.Rate = 30
	dust.Enabled = false
	dust.Lifetime = NumberRange.new(0.3, 0.6)
	dust.Speed = NumberRange.new(2, 4)
	dust.SpreadAngle = Vector2.new(40, 40)
	dust.EmissionDirection = Enum.NormalId.Back
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1.6) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	dust.Color = ColorSequence.new(Color3.fromRGB(200, 190, 255))
	dust.LightEmission = 0.4
	dust.Parent = attachment
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "SprintSparks"
	sparks.Texture = Config.Textures.Sparkle
	sparks.Rate = 18
	sparks.Enabled = false
	sparks.Lifetime = NumberRange.new(0.3, 0.5)
	sparks.Speed = NumberRange.new(1, 3)
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	sparks.LightEmission = 1
	sparks.LightInfluence = 0
	sparks.Color = ColorSequence.new(Color3.fromRGB(140, 230, 255))
	sparks.Parent = attachment
end
player.CharacterAdded:Connect(function(character)
	sprinting = false
	task.spawn(attachDust, character)
end)
if player.Character then
	task.spawn(attachDust, player.Character)
end

---------------------------------------------------------------------
-- Input
---------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		wantSprint = true
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		wantSprint = false
	end
end)

---------------------------------------------------------------------
-- Every frame: stamina, speed, effects
---------------------------------------------------------------------
local function setSprinting(value, humanoid)
	if value == sprinting then
		return
	end
	sprinting = value
	SprintRemote:FireServer(value)
	-- feel it right away (the server sets the same value)
	local character = player.Character
	if humanoid and character and not character:GetAttribute("InDuel") then
		humanoid.WalkSpeed = value and MOVE.SprintSpeed or MOVE.WalkSpeed
	end
	tween(camera, 0.35, { FieldOfView = value and baseFov + 9 or baseFov }, Enum.EasingStyle.Sine)
	if dust and dust.Parent then
		dust.Enabled = value
		local sparks = dust.Parent:FindFirstChild("SprintSparks")
		if sparks then
			sparks.Enabled = value
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local moving = humanoid ~= nil and humanoid.MoveDirection.Magnitude > 0.1 and humanoid.Health > 0
		and humanoid.WalkSpeed > 0 -- frozen / stunned / in a cutscene = no sprint

	if exhausted and stamina >= MOVE.MaxStamina * 0.25 then
		exhausted = false
	end
	local shouldSprint = wantSprint and moving and not exhausted and stamina > 0
	setSprinting(shouldSprint, humanoid)

	if sprinting then
		stamina = math.max(0, stamina - MOVE.StaminaDrain * dt)
		lastSprintTime = os.clock()
		if stamina <= 0 then
			exhausted = true
		end
	elseif os.clock() - lastSprintTime > MOVE.RegenDelay then
		stamina = math.min(MOVE.MaxStamina, stamina + MOVE.StaminaRegen * dt)
	end

	local fraction = stamina / MOVE.MaxStamina
	barFill.Size = UDim2.fromScale(fraction, 1)
	setBarVisible(fraction < 0.999 or sprinting)
	barLabel.TextColor3 = exhausted and THEME.Bad or THEME.Text

	-- speed lines
	for _, l in ipairs(lines) do
		if sprinting then
			l.Phase = (l.Phase + dt * 2.2) % 1
			local x = l.Left and (0.02 + l.Phase * 0.12) or (0.98 - l.Phase * 0.12)
			l.Frame.Position = UDim2.fromScale(x, l.Frame.Position.Y.Scale)
			l.Frame.BackgroundTransparency = 0.55 + l.Phase * 0.45
		elseif l.Frame.BackgroundTransparency < 1 then
			l.Frame.BackgroundTransparency = 1
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="41">
        <Properties>
          <string name="Name">StoreUI</string>
          <string name="Source"><![CDATA[-- StoreUI (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Side menu (Store + Sound settings with music/effects sliders) and the Store panel that sells
-- game passes and luck boosts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local Luck = require(ReplicatedStorage:WaitForChild("Luck"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local TestProductRemote = remotes:WaitForChild("TestProduct")

local player = Players.LocalPlayer
local THEME = UIKit.Theme
local TITLE_FONT = UIKit.TitleFont
local new, corner, stroke, textStroke, tween, label =
	UIKit.new, UIKit.corner, UIKit.stroke, UIKit.textStroke, UIKit.tween, UIKit.label

local gui = UIKit.screen("CosmicMenu", 1)

---------------------------------------------------------------------
-- SIDE MENU (left middle of the screen)
---------------------------------------------------------------------
local menu = new("Frame", {
	Name = "SideMenu",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 16, 0.5, 0),
	-- 2 columns: other scripts add DUEL, REBIRTH, PETS and LIMITED buttons here
	Size = UDim2.fromOffset(178, 384),
	BackgroundTransparency = 1,
	Parent = gui,
}, {
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(84, 84),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}),
})
UIKit.addAutoScale(menu)

local function menuButton(order, icon, text, color)
	local button = new("TextButton", {
		Name = text,
		LayoutOrder = order,
		Size = UDim2.fromOffset(84, 84),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.1,
		AutoButtonColor = false,
		Text = "",
		Parent = menu,
	}, { corner(UDim.new(0, 18)), stroke(color, 2.5, 0) })
	local iconLabel = label({
		Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 6), Text = icon, TextSize = 38, Parent = button,
	})
	local textLabel = label({
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -6), Size = UDim2.new(1, 0, 0, 20),
		Text = text, Font = TITLE_FONT, TextSize = 16, Parent = button,
	})
	textStroke(1.2).Parent = textLabel
	UIKit.addButtonFeel(button)
	return button, iconLabel, textLabel
end

local storeButton, storeIcon = menuButton(1, "🛒", "STORE", THEME.Gold)
local soundButton, soundIcon, soundText = menuButton(9, "🔊", "SOUND", THEME.Accent2)

-- the store icon gently wiggles to draw attention
task.spawn(function()
	while storeIcon.Parent do
		task.wait(4)
		tween(storeIcon, 0.12, { Rotation = -14 })
		task.wait(0.12)
		tween(storeIcon, 0.12, { Rotation = 14 })
		task.wait(0.12)
		tween(storeIcon, 0.3, { Rotation = 0 }, Enum.EasingStyle.Elastic)
	end
end)

---------------------------------------------------------------------
-- SOUND SETTINGS: a slider for music and one for sound effects
---------------------------------------------------------------------
local UserInputService = game:GetService("UserInputService")
local SaveSettingsRemote = remotes:WaitForChild("SaveSettings", 10)
local GetDataRemote = remotes:WaitForChild("GetData", 10)

local soundHolder = new("Frame", {
	Name = "SoundHolder",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 210, 0.5, 0),
	Size = UDim2.fromOffset(380, 262),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})
UIKit.addAutoScale(soundHolder)
local soundPanel = new("Frame", {
	Size = UDim2.fromScale(1, 1), BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.05, Parent = soundHolder,
}, { corner(UDim.new(0, 18)), stroke(THEME.Accent2, 2.5, 0) })
label({
	Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -80, 0, 34), Text = "🔊 SOUND", Font = TITLE_FONT, TextSize = 28,
	TextColor3 = THEME.Accent2, TextXAlignment = Enum.TextXAlignment.Left, Parent = soundPanel,
})
local soundClose = new("TextButton", {
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(38, 38),
	BackgroundColor3 = THEME.Bad, Text = "X", Font = TITLE_FONT, TextSize = 22, TextColor3 = THEME.Text, AutoButtonColor = false, Parent = soundPanel,
}, { corner(UDim.new(0, 10)), textStroke(1.5) })
UIKit.addButtonFeel(soundClose)

local settings = { Music = 1, Sfx = 1, Muted = false }
local function saveSettings()
	if SaveSettingsRemote then
		SaveSettingsRemote:FireServer(settings)
	end
end

local function updateMenuIcon()
	local silent = settings.Muted or (settings.Music <= 0 and settings.Sfx <= 0)
	soundIcon.Text = silent and "🔇" or (settings.Sfx < 0.4 and "🔉" or "🔊")
	soundText.Text = settings.Muted and "MUTED" or "SOUND"
end

local sliders = {}
local function slider(y, icon, title, key, onChange)
	label({
		Position = UDim2.fromOffset(20, y), Size = UDim2.new(1, -110, 0, 24), Text = icon .. " " .. title, Font = TITLE_FONT, TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = soundPanel,
	})
	local percent = label({
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, y), Size = UDim2.fromOffset(70, 24), Text = "", Font = TITLE_FONT,
		TextSize = 19, TextColor3 = THEME.Accent2, TextXAlignment = Enum.TextXAlignment.Right, Parent = soundPanel,
	})
	local bar = new("TextButton", {
		Position = UDim2.fromOffset(20, y + 32), Size = UDim2.new(1, -40, 0, 14), BackgroundColor3 = Color3.fromRGB(14, 10, 26),
		Text = "", AutoButtonColor = false, Parent = soundPanel,
	}, { corner(UDim.new(1, 0)) })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar }, {
		corner(UDim.new(1, 0)), UIKit.gradient(THEME.Accent2, THEME.Accent, 0),
	})
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2, Parent = bar,
	}, { corner(UDim.new(1, 0)), stroke(THEME.Accent2, 2.5, 0) })
	local entry = {}
	function entry.Show()
		local value = settings[key]
		fill.Size = UDim2.fromScale(value, 1)
		knob.Position = UDim2.fromScale(value, 0.5)
		percent.Text = math.floor(value * 100 + 0.5) .. "%"
	end
	local dragging = false
	local lastTick = 0
	local function setFromX(x)
		local value = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		value = math.floor(value * 20 + 0.5) / 20 -- steps of 5%
		if value ~= settings[key] then
			settings[key] = value
			onChange()
			entry.Show()
			if os.clock() - lastTick > 0.08 then
				lastTick = os.clock()
				SoundFX.Play("Tick", { Speed = 0.8 + value * 0.8 })
			end
		end
	end
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			saveSettings()
		end
	end)
	table.insert(sliders, entry)
	return entry
end

local function applySound()
	SoundFX.SetVolumes(settings.Sfx, settings.Music)
	SoundFX.SetMuted(settings.Muted)
	updateMenuIcon()
end
slider(62, "🎵", "Music", "Music", applySound)
slider(130, "💥", "Sound effects", "Sfx", applySound)

local muteButton = new("TextButton", {
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(220, 42),
	BackgroundColor3 = THEME.PanelLight, Text = "", Font = TITLE_FONT, TextSize = 19, TextColor3 = THEME.Text,
	AutoButtonColor = false, Parent = soundPanel,
}, { corner(UDim.new(0, 12)), textStroke(1.3) })
UIKit.addButtonFeel(muteButton)
local function showMute()
	muteButton.Text = settings.Muted and "🔈 UNMUTE ALL" or "🔇 MUTE ALL"
	muteButton.BackgroundColor3 = settings.Muted and THEME.Bad or THEME.PanelLight
end
muteButton.Activated:Connect(function()
	settings.Muted = not settings.Muted
	applySound()
	showMute()
	saveSettings()
end)

local function showAll()
	for _, entry in ipairs(sliders) do
		entry.Show()
	end
	showMute()
	updateMenuIcon()
end
showAll()

local soundOpen = false
local function setSoundOpen(value)
	soundOpen = value
	if value then
		UIKit.announcePanel("Sound")
		showAll()
		soundHolder.Visible = true
		UIKit.popIn(soundPanel)
	else
		soundHolder.Visible = false
	end
end
soundButton.Activated:Connect(function()
	setSoundOpen(not soundOpen)
end)
soundClose.Activated:Connect(function()
	setSoundOpen(false)
end)
UIKit.PanelOpened:Connect(function(name)
	if name ~= "Sound" and soundOpen then
		setSoundOpen(false)
	end
end)

-- load the saved settings
task.spawn(function()
	if not GetDataRemote then
		return
	end
	for _ = 1, 20 do
		local ok, snapshot = pcall(function()
			return GetDataRemote:InvokeServer()
		end)
		if ok and type(snapshot) == "table" then
			local saved = snapshot.Settings
			if type(saved) == "table" then
				settings.Music = tonumber(saved.Music) or 1
				settings.Sfx = tonumber(saved.Sfx) or 1
				settings.Muted = saved.Muted == true
				applySound()
				showAll()
			end
			return
		end
		task.wait(1)
	end
end)

---------------------------------------------------------------------
-- STORE PANEL
---------------------------------------------------------------------
local holder = new("Frame", {
	Name = "StoreHolder",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.47),
	Size = UDim2.fromOffset(640, 500),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})
UIKit.addAutoScale(holder, 780)

local panel = new("Frame", {
	Name = "Store",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = THEME.Panel,
	BackgroundTransparency = 0.05,
	Parent = holder,
}, { corner(UDim.new(0, 18)), stroke(THEME.Gold, 2.5, 0) })

local titleLabel = label({
	Position = UDim2.fromOffset(22, 12), Size = UDim2.new(1, -44, 0, 40), Text = "🛒 COSMIC STORE",
	Font = TITLE_FONT, TextSize = 32, TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
UIKit.gradient(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 150, 80), 0).Parent = titleLabel
label({
	Position = UDim2.fromOffset(22, 50), Size = UDim2.new(1, -44, 0, 22),
	Text = "Passes are forever • Boosts stack their time", TextSize = 15, TextColor3 = THEME.SubText,
	TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
})
local closeButton = new("TextButton", {
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(42, 42),
	BackgroundColor3 = THEME.Bad, Text = "X", Font = TITLE_FONT, TextSize = 24, TextColor3 = THEME.Text,
	AutoButtonColor = false, Parent = panel,
}, { corner(UDim.new(0, 10)), textStroke(1.5) })
UIKit.addButtonFeel(closeButton)

local list = new("ScrollingFrame", {
	Position = UDim2.fromOffset(16, 84), Size = UDim2.new(1, -32, 1, -100),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
	ScrollBarImageColor3 = THEME.Gold, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	Parent = panel,
}, {
	new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
})

local function sectionTitle(order, text)
	local t = label({
		LayoutOrder = order, Size = UDim2.new(1, 0, 0, 30), Text = text, Font = TITLE_FONT, TextSize = 22,
		TextColor3 = THEME.Gold, TextXAlignment = Enum.TextXAlignment.Left, Parent = list,
	})
	textStroke(1.5).Parent = t
end

-- Prices are looked up once and remembered
local priceCache = {}
local function fetchPrice(id, infoType, priceLabel)
	if id == 0 then
		priceLabel.Text = "Set ID"
		return
	end
	local cacheKey = tostring(infoType) .. id
	if priceCache[cacheKey] then
		priceLabel.Text = priceCache[cacheKey]
		return
	end
	priceLabel.Text = "..."
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(id, infoType)
		end)
		local text = (ok and info and info.PriceInRobux) and ("R$ " .. info.PriceInRobux) or "R$ ?"
		priceCache[cacheKey] = text
		priceLabel.Text = text
	end)
end

local itemRefreshers = {}

local function itemRow(order, item, kind)
	local row = new("Frame", {
		Name = item.Key,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 86),
		BackgroundColor3 = THEME.PanelLight,
		Parent = list,
	}, { corner(UDim.new(0, 14)), stroke(THEME.Accent, 1.5, 0.4) })
	local rowScale = new("UIScale", { Parent = row })
	row.MouseEnter:Connect(function()
		tween(rowScale, 0.12, { Scale = 1.02 })
	end)
	row.MouseLeave:Connect(function()
		tween(rowScale, 0.12, { Scale = 1 })
	end)

	local icon = label({
		Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(70, 86), Text = item.Icon, TextSize = 44, Parent = row,
	})
	label({
		Position = UDim2.fromOffset(86, 12), Size = UDim2.new(1, -250, 0, 28), Text = item.Name, Font = TITLE_FONT,
		TextSize = 24, TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
	})
	local desc = label({
		Position = UDim2.fromOffset(86, 40), Size = UDim2.new(1, -250, 0, 38), Text = item.Description,
		Font = Enum.Font.Gotham, TextSize = 14, TextWrapped = true, TextColor3 = THEME.SubText,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = row,
	})

	local buyButton = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(140, 50),
		BackgroundColor3 = THEME.Good, AutoButtonColor = false, Text = "", Font = TITLE_FONT, TextSize = 22,
		TextColor3 = THEME.Text, Parent = row,
	}, { corner(UDim.new(0, 12)), textStroke(1.5) })
	UIKit.addButtonFeel(buyButton, true)

	local id = (kind == "Pass") and Config.GamePasses[item.Key] or Config.Products[item.Key]
	local infoType = (kind == "Pass") and Enum.InfoType.GamePass or Enum.InfoType.Product

	local function refresh()
		if kind == "Pass" and player:GetAttribute("Pass_" .. item.Key) then
			buyButton.Text = "OWNED ✓"
			buyButton.BackgroundColor3 = Color3.fromRGB(60, 70, 90)
			row:FindFirstChild("Border").Color = THEME.Good
			return
		end
		buyButton.BackgroundColor3 = THEME.Good
		fetchPrice(id, infoType, buyButton)
		if kind == "Product" then
			-- show the remaining time of an active boost
			local endsAt = (item.Key == "PersonalLuck") and (player:GetAttribute("PersonalLuckEnd") or 0)
				or (ReplicatedStorage:GetAttribute("ServerLuckEnd") or 0)
			local left = endsAt - Luck.Now()
			if left > 0 then
				desc.Text = item.Description .. "\n<font color='#ffd76a'>Active: " .. Luck.FormatTime(left) .. " left</font>"
				desc.RichText = true
			else
				desc.Text = item.Description
			end
		end
	end
	itemRefreshers[item.Key] = refresh
	refresh()

	buyButton.Activated:Connect(function()
		if kind == "Pass" and player:GetAttribute("Pass_" .. item.Key) then
			return
		end
		SoundFX.Play("Click")
		if id == 0 then
			if kind == "Product" and RunService:IsStudio() and Config.FreePassesInStudio then
				-- Studio test: free boost
				TestProductRemote:FireServer(item.Key)
				SoundFX.Chime(1, 4)
				UIKit.toast("Studio test: " .. item.Name .. " activated!", THEME.Gold)
			else
				UIKit.toast("Put the " .. kind .. " ID for " .. item.Name .. " in CosmicConfig", THEME.Bad)
			end
			return
		end
		if kind == "Pass" then
			MarketplaceService:PromptGamePassPurchase(player, id)
		else
			MarketplaceService:PromptProductPurchase(player, id)
		end
	end)

	-- bounce the icon now and then
	task.spawn(function()
		task.wait(order * 0.3)
		while icon.Parent do
			tween(icon, 0.25, { Rotation = -10 })
			task.wait(0.25)
			tween(icon, 0.5, { Rotation = 0 }, Enum.EasingStyle.Elastic)
			task.wait(3 + order * 0.2)
		end
	end)
end

sectionTitle(0, "✦ GAME PASSES")
for i, item in ipairs(Config.PassInfo) do
	itemRow(i, item, "Pass")
end
sectionTitle(100, "✦ BOOSTS")
for i, item in ipairs(Config.ProductInfo) do
	itemRow(100 + i, item, "Product")
end

local function refreshAll()
	for _, refresh in pairs(itemRefreshers) do
		refresh()
	end
end

-- Update when passes/boosts change
for key in pairs(Config.GamePasses) do
	player:GetAttributeChangedSignal("Pass_" .. key):Connect(function()
		refreshAll()
		if player:GetAttribute("Pass_" .. key) and holder.Visible then
			SoundFX.Chime(1, 5)
			UIKit.confetti({ THEME.Gold, THEME.Accent, THEME.Good }, 60)
		end
	end)
end
player:GetAttributeChangedSignal("PersonalLuckEnd"):Connect(refreshAll)
ReplicatedStorage:GetAttributeChangedSignal("ServerLuckEnd"):Connect(refreshAll)

---------------------------------------------------------------------
-- Open / close
---------------------------------------------------------------------
local open = false
local function setOpen(value)
	if value == open then
		return
	end
	open = value
	if open then
		UIKit.announcePanel("Store")
		refreshAll()
		holder.Visible = true
		UIKit.popIn(panel)
	else
		holder.Visible = false
	end
end

storeButton.Activated:Connect(function()
	setOpen(not open)
end)
closeButton.Activated:Connect(function()
	setOpen(false)
end)
UIKit.PanelOpened:Connect(function(name)
	if name ~= "Store" then
		setOpen(false)
	end
end)

-- keep boost timers ticking while the store is open
task.spawn(function()
	while gui.Parent do
		task.wait(1)
		if open then
			for _, item in ipairs(Config.ProductInfo) do
				itemRefreshers[item.Key]()
			end
		end
	end
end)

-- Purchase feedback
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, _, purchased)
	if userId == player.UserId and purchased then
		SoundFX.Chime(1, 5)
		UIKit.confetti({ THEME.Gold, THEME.Accent2, THEME.Good }, 50)
		UIKit.toast("Thank you! Boost activated 🍀", THEME.Gold)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="42">
        <Properties>
          <string name="Name">WorldFX</string>
          <string name="Source"><![CDATA[-- WorldFX (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Brings the map to life on each player's screen: spinning core rings,
-- bobbing crystals, spinning gems, shooting stars, ambience, the Lucky Isle
-- portals and the pink + gold sky on Lucky Isle.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local SoundFX = require(ReplicatedStorage:WaitForChild("SoundFX"))
local Luck = require(ReplicatedStorage:WaitForChild("Luck"))
local UIKit = require(ReplicatedStorage:WaitForChild("UIKit"))

local player = Players.LocalPlayer
local rand = Random.new()

SoundFX.StartAmbient()

local island = workspace:WaitForChild("CosmicIsland", 60)
if not island then
	warn("[WorldFX] CosmicIsland not found")
	return
end

---------------------------------------------------------------------
-- Collect everything we animate (remembering where it started)
---------------------------------------------------------------------
local core = island:WaitForChild("CosmicCore", 10)
local orb = core and core:FindFirstChild("CoreOrb")
local orbShell = core and core:FindFirstChild("CoreOrbShell")
local rings = {}
if core then
	for i = 1, 3 do
		local ring = core:FindFirstChild("CoreRing" .. i)
		if ring then
			table.insert(rings, ring)
		end
	end
end
local orbPosition = orb and orb.Position

local floaters = {}
local gems = {}
for _, child in ipairs(island:GetChildren()) do
	if child:IsA("BasePart") then
		if child.Name == "FloatingCrystal" then
			table.insert(floaters, { Part = child, Base = child.CFrame, Phase = rand:NextNumber(0, 6) })
		elseif child.Name == "SpinGem" then
			table.insert(gems, { Part = child, Position = child.Position, Phase = rand:NextNumber(0, 6) })
		end
	end
end

---------------------------------------------------------------------
-- Per-frame animation
---------------------------------------------------------------------
local t = 0
RunService.RenderStepped:Connect(function(dt)
	t += dt

	if orb and orbPosition then
		local pulse = 5 + math.sin(t * 2) * 0.35
		orb.Size = Vector3.one * pulse
		orb.CFrame = CFrame.new(orbPosition + Vector3.new(0, math.sin(t * 1.2) * 0.4, 0))
		if orbShell then
			orbShell.CFrame = orb.CFrame * CFrame.Angles(t * 0.3, t * 0.5, 0)
		end
	end
	if orbPosition then
		if rings[1] then
			rings[1]:PivotTo(CFrame.new(orbPosition) * CFrame.Angles(t * 0.9, t * 0.4, 0))
		end
		if rings[2] then
			rings[2]:PivotTo(CFrame.new(orbPosition) * CFrame.Angles(0, t * 0.7, t * 1.1))
		end
		if rings[3] then
			rings[3]:PivotTo(CFrame.new(orbPosition) * CFrame.Angles(t * 0.5, 0, t * 0.6))
		end
	end

	for _, f in ipairs(floaters) do
		local base = f.Base
		local lift = Vector3.new(0, math.sin(t * 0.8 + f.Phase) * 1.2, 0)
		f.Part.CFrame = CFrame.new(base.Position + lift) * CFrame.Angles(0, t * 0.4 + f.Phase, 0) * base.Rotation
	end

	for _, g in ipairs(gems) do
		g.Part.CFrame = CFrame.new(g.Position + Vector3.new(0, math.sin(t * 2 + g.Phase) * 0.25, 0))
			* CFrame.Angles(0, t * 1.5 + g.Phase, 0)
			* CFrame.Angles(math.rad(45), 0, math.rad(45))
	end
end)

---------------------------------------------------------------------
-- Shooting stars
---------------------------------------------------------------------
local fxFolder = workspace:FindFirstChild("LocalAuraFX") or Instance.new("Folder")
fxFolder.Name = "LocalAuraFX"
fxFolder.Parent = workspace

local STAR_COLORS = {
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(170, 210, 255),
	Color3.fromRGB(220, 180, 255),
	Color3.fromRGB(255, 220, 160),
}

local function shootingStar()
	local angle = rand:NextNumber(0, math.pi * 2)
	local distance = rand:NextNumber(180, 380)
	local start = Vector3.new(math.cos(angle) * distance, rand:NextNumber(140, 260), math.sin(angle) * distance)
	local direction = Vector3.new(rand:NextNumber(-1, 1), rand:NextNumber(-0.45, -0.15), rand:NextNumber(-1, 1)).Unit
	local finish = start + direction * rand:NextNumber(220, 360)
	local color = STAR_COLORS[rand:NextInteger(1, #STAR_COLORS)]

	local star = Instance.new("Part")
	star.Name = "ShootingStar"
	star.Shape = Enum.PartType.Ball
	star.Size = Vector3.one * 1.6
	star.Material = Enum.Material.Neon
	star.Color = color
	star.Anchored = true
	star.CanCollide = false
	star.CanQuery = false
	star.CanTouch = false
	star.CastShadow = false
	star.CFrame = CFrame.new(start)

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.7, 0)
	a0.Parent = star
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.7, 0)
	a1.Parent = star
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.45
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(color, Color3.fromRGB(120, 140, 255))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	trail.Parent = star
	star.Parent = fxFolder

	local duration = rand:NextNumber(0.9, 1.6)
	TweenService:Create(star, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(finish) }):Play()
	task.delay(duration * 0.75, function()
		TweenService:Create(star, TweenInfo.new(duration * 0.25), { Transparency = 1, Size = Vector3.one * 0.2 }):Play()
	end)
	Debris:AddItem(star, duration + 0.6)
end

task.spawn(function()
	while true do
		task.wait(rand:NextNumber(1.2, 3.5))
		shootingStar()
		if rand:NextNumber() < 0.15 then
			-- sometimes a little meteor shower
			for _ = 1, rand:NextInteger(2, 4) do
				task.wait(rand:NextNumber(0.1, 0.3))
				shootingStar()
			end
		end
	end
end)

---------------------------------------------------------------------
-- PORTALS + LUCKY ISLE animations
---------------------------------------------------------------------

-- things that spin around a fixed pivot: { Model, BaseCFrame, Function(t) -> CFrame offset }
local spinners = {}
local function addSpinner(model, offsetFn)
	if model then
		table.insert(spinners, { Model = model, Base = model.WorldPivot, Offset = offsetFn })
	end
end

local plaza = island:WaitForChild("PortalPlaza", 10)
if plaza then
	addSpinner(plaza:FindFirstChild("LuckyPortalRing"), function(time)
		return CFrame.Angles(0, 0, time * 0.8)
	end)
	addSpinner(plaza:FindFirstChild("LuckyPortalRingOuter"), function(time)
		return CFrame.Angles(0, 0, -time * 0.5)
	end)
	addSpinner(plaza:FindFirstChild("LuckyPortalGems"), function(time)
		return CFrame.Angles(0, 0, time * 0.35)
	end)
end

local royal = workspace:WaitForChild("LuckyIsland", 30)
local royalOrb, royalOrbBase
local lanterns = {}
if royal then
	local royalCore = royal:FindFirstChild("LuckyCore")
	if royalCore then
		royalOrb = royalCore:FindFirstChild("LuckyOrb")
		royalOrbBase = royalOrb and royalOrb.Position
		addSpinner(royalCore:FindFirstChild("LuckyRing1"), function(time)
			return CFrame.Angles(time * 0.8, time * 0.3, 0)
		end)
		addSpinner(royalCore:FindFirstChild("LuckyRing2"), function(time)
			return CFrame.Angles(0, time * 0.6, time * 0.9)
		end)
		addSpinner(royalCore:FindFirstChild("LuckyRing3"), function(time)
			return CFrame.Angles(time * 0.4, 0, time * 0.5)
		end)
	end
	addSpinner(royal:FindFirstChild("ReturnPortalRing"), function(time)
		return CFrame.Angles(0, 0, -time * 0.8)
	end)
	addSpinner(royal:FindFirstChild("ReturnPortalRingOuter"), function(time)
		return CFrame.Angles(0, 0, time * 0.5)
	end)
	for _, child in ipairs(royal:GetChildren()) do
		if child:IsA("BasePart") and child.Name == "LuckyLantern" then
			table.insert(lanterns, { Part = child, Base = child.Position, Phase = rand:NextNumber(0, 6) })
		end
	end
end

RunService.RenderStepped:Connect(function()
	for _, s in ipairs(spinners) do
		s.Model:PivotTo(s.Base * s.Offset(t))
	end
	if royalOrb and royalOrbBase then
		royalOrb.Size = Vector3.one * (5.5 + math.sin(t * 2.2) * 0.4)
		royalOrb.CFrame = CFrame.new(royalOrbBase + Vector3.new(0, math.sin(t * 1.1) * 0.5, 0))
	end
	for _, l in ipairs(lanterns) do
		l.Part.CFrame = CFrame.new(l.Base + Vector3.new(0, math.sin(t * 0.9 + l.Phase) * 1.4, 0))
			* CFrame.Angles(0, t * 0.5 + l.Phase, 0)
	end
end)

---------------------------------------------------------------------
-- Lucky Isle welcome (the pink + gold sky is done by SkyFX)
---------------------------------------------------------------------
local wasOnRoyal = false
player:GetAttributeChangedSignal("OnLuckyIsland"):Connect(function()
	local on = player:GetAttribute("OnLuckyIsland") == true
	if on == wasOnRoyal then
		return
	end
	wasOnRoyal = on
	if on then
		-- show what the island does to ALL your luck: x30 -> x60
		local multiplier = Config.LuckyIsland.LuckMultiplier
		local after = Luck.Get(player)
		UIKit.luckBoost("🍀", "Lucky Isle", multiplier, after / multiplier, after, UIKit.Theme.Gold)
	end
end)

---------------------------------------------------------------------
-- Portal travel effect (the server teleports, we make it look good)
---------------------------------------------------------------------
local portalGui = UIKit.screen("CosmicPortal", 40)
local portalFlash = UIKit.new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(255, 220, 160),
	BackgroundTransparency = 1,
	Parent = portalGui,
}, {
	UIKit.new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 200), Color3.fromRGB(255, 150, 210)),
		Rotation = 45,
	}),
})

local remotes = ReplicatedStorage:WaitForChild("CosmicRemotes")
local PortalFXRemote = remotes:WaitForChild("PortalFX", 30)
local camera = workspace.CurrentCamera
if PortalFXRemote then
	PortalFXRemote.OnClientEvent:Connect(function(kind)
		if kind == "Out" then
			SoundFX.Play("Whoosh", { Speed = 0.7, Volume = 1.5 })
			SoundFX.Play("RevealEpic", { Volume = 0.5 })
			UIKit.tween(portalFlash, 0.3, { BackgroundTransparency = 0 })
			local fov = camera.FieldOfView
			UIKit.tween(camera, 0.3, { FieldOfView = fov + 25 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.45, function()
				camera.FieldOfView = fov
			end)
		elseif kind == "In" then
			UIKit.tween(portalFlash, 0.8, { BackgroundTransparency = 1 })
			UIKit.burst({ Color3.fromRGB(255, 220, 140), Color3.fromRGB(255, 150, 210), Color3.fromRGB(120, 230, 210) }, 30, 1.2, Vector2.new(0.5, 0.5))
		elseif kind == "Denied" then
			UIKit.toast("👑 This portal is for VIPs only!", UIKit.Theme.Gold)
			SoundFX.Play("Thud")
			local passId = Config.GamePasses.VIP
			if passId and passId ~= 0 then
				MarketplaceService:PromptGamePassPurchase(player, passId)
			end
		end
	end)
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="43">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>