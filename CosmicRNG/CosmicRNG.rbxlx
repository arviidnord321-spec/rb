	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -170), Size = UDim2.fromOffset(600, 30),
	Text = "", Font = TITLE_FONT, TextSize = 22, ZIndex = 9, TextTransparency = 1, Parent = gui,
})
