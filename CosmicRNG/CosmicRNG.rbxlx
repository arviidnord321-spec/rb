---------------------------------------------------------------------
-- CENTER REVEAL: glowing card + name
---------------------------------------------------------------------
local reveal = new("Frame", {
	Name = "Reveal",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.4),
	Size = UDim2.fromOffset(700, 260),
	BackgroundTransparency = 1,
	ZIndex = 6,
	Visible = false,
	Parent = gui,
})
