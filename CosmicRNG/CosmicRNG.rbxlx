		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(PX, topY - thickness / 2, PZ) * FLAT,
		Color = color3,
		Material = material,
		CanCollide = collide ~= false,
		Parent = plaza,
	})
end
