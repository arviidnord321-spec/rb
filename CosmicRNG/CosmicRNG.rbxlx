---------------------------------------------------------------------
-- PORTAL LOGIC
-- Checked by position every 0.1s (works even when touch events don't),
-- plus a "Press E" prompt on each portal.
---------------------------------------------------------------------
local mainIsland = workspace:WaitForChild("CosmicIsland")
local plaza = mainIsland:WaitForChild("PortalPlaza")
local mainZone = plaza:WaitForChild("LuckyPortalZone")

-- where you come out: a few studs in front of each portal, facing away from it
local function exitFrom(zone)
	local spot = (zone.CFrame * CFrame.new(0, 0, -7)).Position
	spot = Vector3.new(spot.X, zone.Position.Y - 3, spot.Z)
	return CFrame.lookAt(spot, spot + zone.CFrame.LookVector * Vector3.new(1, 0, 1))
end
local MAIN_EXIT = exitFrom(mainZone)

local busy = {} -- [player] = true while teleporting

local function allowed(player)
	return not LUCKY.RequireVIP or player:GetAttribute("Pass_VIP") == true
end

local function teleport(player, destination)
	if busy[player] then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or character:GetAttribute("InDuel") then
		return
	end
	busy[player] = true
	PortalFXRemote:FireClient(player, "Out")
	task.wait(0.35)
	if character.Parent then
		root.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(destination)
	end
	PortalFXRemote:FireClient(player, "In")
	task.wait(1.5) -- don't bounce straight back through the other portal
	busy[player] = nil
end

local deniedAt = {}
local function enterMainPortal(player)
	if allowed(player) then
		task.spawn(teleport, player, ARRIVAL)
	elseif os.clock() - (deniedAt[player] or 0) > 3 then
		deniedAt[player] = os.clock()
		PortalFXRemote:FireClient(player, "Denied")
	end
end
local function enterReturnPortal(player)
	task.spawn(teleport, player, MAIN_EXIT)
end

local function inZone(zone, position)
	local localPos = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z
end

local function addPrompt(zone, actionText, objectText, onTriggered)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = zone
	prompt.Triggered:Connect(onTriggered)
end
addPrompt(mainZone, "Travel", "Lucky Isle (ALL luck x" .. LUCKY.LuckMultiplier .. ")", enterMainPortal)
addPrompt(returnZone, "Travel", "Back to Cosmic Island", enterReturnPortal)

-- Who is standing on Lucky Isle? (gives the luck bonus)
local function onIsland(position)
	local offset = position - CENTER
	local flat = Vector3.new(offset.X, 0, offset.Z)
	return flat.Magnitude < RADIUS + 8 and offset.Y > -20 and offset.Y < 80
end

task.spawn(function()
	local loops = 0
	while true do
		task.wait(0.1)
		loops += 1
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and not busy[player] then
				if inZone(mainZone, root.Position) then
					enterMainPortal(player)
				elseif inZone(returnZone, root.Position) then
					enterReturnPortal(player)
				end
			end
			if loops % 5 == 0 then
				local here = root ~= nil and onIsland(root.Position)
				if here and not allowed(player) and not busy[player] then
					task.spawn(teleport, player, MAIN_EXIT) -- not allowed here
					here = false
				end
				if player:GetAttribute("OnLuckyIsland") ~= here then
					player:SetAttribute("OnLuckyIsland", here)
				end
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	busy[player] = nil
	deniedAt[player] = nil
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="17">
      <Properties>
        <string name="Name">Movement</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Movement (Script in ServerScriptService)
-- Sprinting: the Sprint LocalScript tells us when you start/stop running
-- (hold Shift, or the RUN button on mobile) and we set your speed.
-- In duels, DuelService reads the same "Sprinting" flag and uses its own speed.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local MOVE = Config.Movement

-- Shift is the sprint key, so turn off Roblox's Shift Lock option
pcall(function()
	game:GetService("StarterPlayer").EnableMouseLockOption = false
end)

local remotes = ReplicatedStorage:FindFirstChild("CosmicRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "CosmicRemotes"
	remotes.Parent = ReplicatedStorage
end
local SprintRemote = remotes:FindFirstChild("Sprint")
if not SprintRemote then
	SprintRemote = Instance.new("RemoteEvent")
	SprintRemote.Name = "Sprint"
	SprintRemote.Parent = remotes
end

local function applySpeed(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or character:GetAttribute("InDuel") then
		return -- DuelService controls speed during duels
	end
	humanoid.WalkSpeed = player:GetAttribute("Sprinting") and MOVE.SprintSpeed or MOVE.WalkSpeed
end

SprintRemote.OnServerEvent:Connect(function(player, sprinting)
	sprinting = sprinting == true
	if player:GetAttribute("Sprinting") ~= sprinting then
		player:SetAttribute("Sprinting", sprinting)
		applySpeed(player)
	end
end)

local function onPlayer(player)
	player:SetAttribute("Sprinting", false)
	player.CharacterAdded:Connect(function()
		player:SetAttribute("Sprinting", false)
		task.defer(applySpeed, player)
	end)
	-- after a duel ends, put the right speed back
	player:GetAttributeChangedSignal("InDuel"):Connect(function()
		if not player:GetAttribute("InDuel") then
			task.delay(0.1, applySpeed, player)
		end
	end)
end
Players.PlayerAdded:Connect(onPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	onPlayer(player)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="18">
      <Properties>
        <string name="Name">Parkour</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Parkour (Script in ServerScriptService)
-- Builds the obby courses and runs them. Main island:
--   STARSTEP TRAIL (medium) - a long curving trail of small platforms with
--                             moving platforms, spinning laser bars,
--                             vanishing platforms and a jump pad
--   VOID TOWER (hard)       - a 42-step spiral around a tall tower: thin
--                             beams, blinking platforms, spinners, movers,
--                             half-deadly platforms and a jump pad
-- Rebirth islands (harder, more luck):
--   GLACIER CLIMB (Frostfall)  - slippery ice floes + a spiral up an ice spire
--   MAGMA RUN     (Ember)      - over a lava sea: sinking rocks, fire bars
--   PULSE GRID    (Neon Nexus) - a square spiral of platforms blinking in a wave
-- Step on the start pad to begin. There are NO checkpoints: falling, a laser
-- or a red pad sends you back to the start. Reaching the finish gives a luck
-- boost (with a cooldown).
-- Vanishing/moving platforms, spinners and jump pads are animated by the
-- ParkourClient script. Spinners are timed by the server clock, so the
-- server knows exactly where every laser bar is.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local Luck = require(ReplicatedStorage:WaitForChild("Luck"))

local P = Config.Places
local rand = Random.new(99)
local FLAT = CFrame.Angles(0, 0, math.rad(90))

---------------------------------------------------------------------
-- Remote for messages to the player (start / checkpoint / finish)
---------------------------------------------------------------------
local remotes = ReplicatedStorage:FindFirstChild("CosmicRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "CosmicRemotes"
	remotes.Parent = ReplicatedStorage
end
local ParkourEvent = remotes:FindFirstChild("ParkourEvent")
if not ParkourEvent then
	ParkourEvent = Instance.new("RemoteEvent")
	ParkourEvent.Name = "ParkourEvent"
	ParkourEvent.Parent = remotes
end

-- Quests count finished courses (RollService listens)
local ServerStorage = game:GetService("ServerStorage")
local serverEvents = ServerStorage:FindFirstChild("CosmicServerEvents")
if not serverEvents then
	serverEvents = Instance.new("Folder")
	serverEvents.Name = "CosmicServerEvents"
	serverEvents.Parent = ServerStorage
end
local questEvent = serverEvents:FindFirstChild("QuestEvent")
if not questEvent then
	questEvent = Instance.new("BindableEvent")
	questEvent.Name = "QuestEvent"
	questEvent.Parent = serverEvents
end

---------------------------------------------------------------------
-- Build helpers
---------------------------------------------------------------------
local old = workspace:FindFirstChild("ParkourCourses")
if old then
	old:Destroy()
end
local root = Instance.new("Model")
root.Name = "ParkourCourses"
root.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent or root
	return p
end

local function addLight(target, color3, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color3
	light.Range = range
	light.Brightness = brightness
	light.Parent = target
end

local function billboard(target, title, subtitle, color3, offset)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(320, 80)
	gui.StudsOffset = offset or Vector3.new(0, 6, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	gui.Parent = target
	local function line(text, y, height, color, font)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Position = UDim2.fromScale(0, y)
		label.Size = UDim2.fromScale(1, height)
		label.Font = font
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = color
		label.Parent = gui
		local outline = Instance.new("UIStroke")
		outline.Thickness = 2
		outline.Transparency = 0.2
		outline.Parent = label
	end
	line(title, 0, 0.6, color3, Enum.Font.FredokaOne)
	if subtitle then
		line(subtitle, 0.6, 0.4, Color3.fromRGB(230, 225, 255), Enum.Font.GothamBold)
	end
end

local function rewardText(course)
	return ("Finish for x%s luck (%d min)"):format(Luck.Format(course.LuckMultiplier), course.BoostMinutes)
end

---------------------------------------------------------------------
-- Course data, filled while building:
--   Start / Finish = pad parts, Checkpoints = { pad, ... }, Kills = { part, ... }
---------------------------------------------------------------------
local courses = {}

local function newCourse(key, model)
	local course = {
		Key = key,
		Settings = Config.Parkour[key],
		Model = model,
		Checkpoints = {},
		Kills = {},
		Spinners = {},
	}
	courses[key] = course
	return course
end

-- A normal platform: dark top with a glowing rim
local function platform(model, cf, size, topColor, rimColor)
	local top = part({
		Name = "Platform",
		Size = size,
		CFrame = cf,
		Color = topColor,
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})
	part({
		Name = "Rim",
		Size = size + Vector3.new(0.35, -0.6, 0.35),
		CFrame = cf * CFrame.new(0, -0.15, 0),
		Color = rimColor,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Parent = model,
	})
	return top
end

local function vanishPlatform(model, cf, size, period, onTime, offset, color3)
	local p = part({
		Name = "VanishPlatform",
		Size = size,
		CFrame = cf,
		Color = color3 or Color3.fromRGB(255, 200, 80),
		Material = Enum.Material.Neon,
		Transparency = 0.15,
		Parent = model,
	})
	p:SetAttribute("Vanish", true)
	p:SetAttribute("VanishPeriod", period)
	p:SetAttribute("VanishOn", onTime)
	p:SetAttribute("VanishOffset", offset)
	return p
end

local function jumpPad(model, cf, size, launch)
	local p = part({
		Name = "JumpPad",
		Size = size,
		CFrame = cf,
		Color = Color3.fromRGB(80, 255, 140),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	p:SetAttribute("Launch", launch)
	local arrow = part({
		Name = "JumpArrow",
		Size = Vector3.new(1, 0.2, 1),
		CFrame = cf * CFrame.new(0, size.Y / 2 + 0.15, 0) * CFrame.Angles(0, math.rad(45), 0),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Parent = model,
	})
	arrow.Name = "JumpArrow"
	billboard(p, "⬆ JUMP PAD", nil, Color3.fromRGB(120, 255, 170), Vector3.new(0, 3, 0))
	return p
end

local function killPad(course, model, cf, size, color3)
	local p = part({
		Name = "KillPad",
		Size = size,
		CFrame = cf,
		Color = color3 or Color3.fromRGB(255, 40, 70),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	table.insert(course.Kills, p)
	return p
end


-- A platform with a spinning red laser bar on top: jump over it!
local function spinnerPlatform(course, model, cf, topColor, rimColor, speed, offset)
	platform(model, cf, Vector3.new(6, 1, 6), topColor, rimColor)
	local center = (cf * CFrame.new(0, 0.5 + 1.2, 0)).Position
	local length = 6.6
	local bar = part({
		Name = "SpinnerBar",
		Size = Vector3.new(0.7, 0.7, length),
		CFrame = CFrame.new(center),
		Color = Color3.fromRGB(255, 40, 70),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Parent = model,
	})
	bar:SetAttribute("Spinner", true)
	bar:SetAttribute("SpinSpeed", speed)
	bar:SetAttribute("SpinOffset", offset)
	bar:SetAttribute("SpinCenter", center)
	part({
		Name = "SpinnerHub",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.2,
		CFrame = CFrame.new(center),
		Color = Color3.fromRGB(255, 120, 140),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	table.insert(course.Spinners, { Center = center, Length = length, Speed = speed, Offset = offset })
end

-- A platform that slides back and forth (it carries you, see ParkourClient)
local function movingPlatform(model, cf, size, amplitude, period, offset, color3)
	local p = part({
		Name = "MovingPlatform",
		Size = size,
		CFrame = cf,
		Color = color3 or Color3.fromRGB(90, 200, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.1,
		Parent = model,
	})
	p:SetAttribute("MoveAmplitude", amplitude)
	p:SetAttribute("MovePeriod", period)
	p:SetAttribute("MoveOffset", offset)
	return p
end

-- Slippery ice: you keep sliding (ParkourClient handles the sliding)
local function icePlatform(model, cf, size)
	local p = part({
		Name = "IcePlatform",
		Size = size,
		CFrame = cf,
		Color = Color3.fromRGB(170, 225, 255),
		Material = Enum.Material.Ice,
		Transparency = 0.1,
		Reflectance = 0.2,
		CustomPhysicalProperties = PhysicalProperties.new(0.9, 0, 0, 100, 1),
		Parent = model,
	})
	p:SetAttribute("Slippery", true)
	part({
		Name = "Rim",
		Size = size + Vector3.new(0.3, -0.6, 0.3),
		CFrame = cf * CFrame.new(0, -0.15, 0),
		Color = Color3.fromRGB(120, 230, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Parent = model,
	})
	return p
end

-- There are no checkpoints any more: these spots are just wider "rest"
-- platforms. Falling (or a laser / red pad) always sends you back to the START.
local function checkpointPad(_course, model, cf, _number, color3)
	local pad = platform(model, cf, Vector3.new(5, 1, 5), Color3.fromRGB(40, 34, 64), color3)
	pad.Name = "RestPlatform"
	return pad
end

local function startPad(course, model, position, color3)
	local pad = part({
		Name = "StartPad",
		Size = Vector3.new(8, 1, 8),
		CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)),
		Color = Color3.fromRGB(40, 34, 64),
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})
	part({
		Name = "StartGlow",
		Size = Vector3.new(8.6, 0.4, 8.6),
		CFrame = CFrame.new(position + Vector3.new(0, 0.3, 0)),
		Color = color3,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	billboard(pad, "🏁 " .. string.upper(course.Settings.Name), rewardText(course.Settings), color3, Vector3.new(0, 7, 0))
	course.Start = pad
	return pad
end

local function finishPad(course, model, cf, color3)
	local pad = platform(model, cf, Vector3.new(12, 1, 12), Color3.fromRGB(40, 34, 64), color3)
	pad.Name = "FinishPad"
	-- an arch over the finish
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "FinishPost",
			Size = Vector3.new(0.8, 8, 0.8),
			CFrame = cf * CFrame.new(side * 5, 4.5, 0),
			Color = color3,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
	end
	part({
		Name = "FinishBar",
		Size = Vector3.new(10.8, 0.8, 0.8),
		CFrame = cf * CFrame.new(0, 8.9, 0),
		Color = color3,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	local trophy = part({
		Name = "SpinGem",
		Size = Vector3.one * 1.8,
		CFrame = cf * CFrame.new(0, 4, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = Color3.fromRGB(255, 220, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	addLight(trophy, Color3.fromRGB(255, 220, 120), 24, 2)
	billboard(pad, "🏆 FINISH", rewardText(course.Settings), Color3.fromRGB(255, 220, 90), Vector3.new(0, 11, 0))
	course.Finish = pad
	return pad
end

---------------------------------------------------------------------
-- STARSTEP TRAIL (medium): a long curve of small platforms
---------------------------------------------------------------------
do
	local model = Instance.new("Model")
	model.Name = "StarstepTrail"
	model.Parent = root
	local course = newCourse("Starstep", model)
	local TOP = Color3.fromRGB(40, 60, 70)
	local RIM = Color3.fromRGB(90, 240, 200)

	local start = P.StarstepStart
	startPad(course, model, start, RIM)

	local STEPS = 26
	local position = Vector3.new(start.X, 1, start.Z)
	local checkpointNumber = 0
	for i = 1, STEPS do
		local heading = math.pi + i * math.rad(4.5)
		local direction = Vector3.new(math.cos(heading), 0, math.sin(heading))
		local across = Vector3.new(-direction.Z, 0, direction.X)
		local gap, rise = 10, 1.3
		if i == 21 then
			gap, rise = 6.5, 10 -- high up past the jump pad
		end
		position += direction * gap + Vector3.new(0, rise, 0)
		local cf = CFrame.lookAt(position, position + direction) * CFrame.new(0, -0.5, 0)

		if i == STEPS then
			finishPad(course, model, cf * CFrame.new(0, 0, -3), RIM)
		elseif i == 9 or i == 18 then
			checkpointNumber += 1
			checkpointPad(course, model, cf, checkpointNumber, RIM)
		elseif i == 20 then
			jumpPad(model, cf, Vector3.new(4, 1, 4), Vector3.new(0, 75, 0))
		elseif i == 5 or i == 14 or i == 24 then
			spinnerPlatform(course, model, cf, TOP, RIM, 2.2, i * 0.7)
		elseif i % 5 == 2 then
			movingPlatform(model, cf, Vector3.new(3.6, 1, 3.6), across * 5, 3.2, i * 0.4)
		elseif i == 10 or i == 11 or i == 19 then
			vanishPlatform(model, cf, Vector3.new(3.6, 1, 3.6), 2.6, 1.6, i * 0.9)
		else
			platform(model, cf, Vector3.new(3.2, 1, 3.2), TOP, RIM)
		end

		if i % 3 == 0 then
			local star = part({
				Name = "TrailStar",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.8,
				CFrame = CFrame.new(position + Vector3.new(rand:NextNumber(-5, 5), rand:NextNumber(4, 7), rand:NextNumber(-5, 5))),
				Color = RIM,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = model,
			})
			addLight(star, RIM, 8, 0.8)
		end
	end
end

---------------------------------------------------------------------
-- VOID TOWER (hard): a 42-step spiral climb around a dark tower
---------------------------------------------------------------------
do
	local model = Instance.new("Model")
	model.Name = "VoidTower"
	model.Parent = root
	local course = newCourse("VoidTower", model)
	local TOP = Color3.fromRGB(30, 20, 45)
	local RIM = Color3.fromRGB(170, 90, 255)

	local start = P.VoidTowerStart
	startPad(course, model, start, RIM)

	local outward = Vector3.new(start.X, 0, start.Z).Unit
	local towerCenter = Vector3.new(start.X, 0, start.Z) + outward * 21
	local RADIUS = 13
	local STEPS = 42
	local toStart = Vector3.new(start.X, 0, start.Z) - towerCenter
	local angle0 = math.atan2(toStart.Z, toStart.X)

	local BEAMS = { [7] = true, [16] = true, [25] = true, [34] = true, [39] = true }
	local SPINNERS = { [11] = true, [23] = true, [31] = true, [37] = true }
	local MOVERS = { [13] = true, [26] = true, [35] = true }
	local HALF_DEADLY = { [5] = true, [17] = true, [29] = true, [40] = true }

	local height = 3
	local checkpointNumber = 0
	local finishY
	for i = 1, STEPS do
		local angle = angle0 + (i - 1) * 0.6
		if i == 21 then
			height += 10 -- above the jump pad
		elseif i > 1 then
			height += 2.6
		end
		local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local position = towerCenter + radial * RADIUS + Vector3.new(0, height, 0)
		local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
		local cf = CFrame.lookAt(position, position + tangent)

		if i == STEPS then
			finishY = height
			finishPad(course, model, CFrame.new(towerCenter + Vector3.new(0, height, 0)) * CFrame.lookAt(Vector3.zero, -tangent).Rotation, RIM)
		elseif i == 14 or i == 28 then
			checkpointNumber += 1
			checkpointPad(course, model, cf, checkpointNumber, RIM)
		elseif i == 20 then
			jumpPad(model, cf, Vector3.new(3.5, 1, 3.5), Vector3.new(0, 80, 0))
		elseif BEAMS[i] then
			platform(model, cf, Vector3.new(1, 0.5, 7.5), TOP, RIM)
		elseif SPINNERS[i] then
			spinnerPlatform(course, model, cf, TOP, RIM, 2.8, i * 0.53)
		elseif MOVERS[i] then
			movingPlatform(model, cf, Vector3.new(3, 1, 3), radial * 3.5, 2.4, i * 0.31)
		elseif HALF_DEADLY[i] then
			-- half safe, half deadly: land on the inner side
			local inward = -radial
			platform(model, CFrame.new(position + inward * 1.1) * cf.Rotation, Vector3.new(2.2, 1, 3.4), TOP, RIM)
			killPad(course, model, CFrame.new(position - inward * 1.1) * cf.Rotation, Vector3.new(2.2, 1, 3.4))
		elseif i % 3 == 0 then
			vanishPlatform(model, cf, Vector3.new(3, 1, 3), 2.2, 1.2, i * 0.37)
		else
			platform(model, cf, Vector3.new(3, 1, 3), TOP, RIM)
		end
	end

	local towerHeight = finishY + 22
	part({
		Name = "Tower",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(towerHeight, 8, 8),
		CFrame = CFrame.new(towerCenter + Vector3.new(0, finishY - towerHeight / 2 - 0.6, 0)) * FLAT,
		Color = Color3.fromRGB(25, 15, 40),
		Material = Enum.Material.Slate,
		Parent = model,
	})
	for y = -10, finishY - 5, 10 do
		part({
			Name = "TowerRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 8.6, 8.6),
			CFrame = CFrame.new(towerCenter + Vector3.new(0, y, 0)) * FLAT,
			Color = RIM,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
	end
	local beacon = part({
		Name = "Beacon",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3,
		CFrame = CFrame.new(towerCenter + Vector3.new(0, finishY + 12, 0)),
		Color = RIM,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	addLight(beacon, RIM, 40, 3)
end


---------------------------------------------------------------------
-- REBIRTH ISLAND COURSES
-- Each starts at the far edge of its island and heads out over the void.
---------------------------------------------------------------------
local function islandGround(info)
	return function(position)
		local offset = position - info.Center
		local flat = Vector3.new(offset.X, 0, offset.Z)
		return flat.Magnitude < info.Radius - 2 and offset.Y < 6 and offset.Y > -3
	end
end

local function islandInfo(key)
	for _, info in ipairs(Config.RebirthIslands) do
		if info.Key == key then
			return info
		end
	end
	return nil
end

-- start pad on the island edge + a little gateway behind it
local function islandStart(course, model, info, color3)
	local C = info.Center
	local start = C + Vector3.new(0, 0, info.Radius - 8)
	startPad(course, model, start, color3)
	course.OnGround = islandGround(info)
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "StartGatePost",
			Size = Vector3.new(0.8, 7, 0.8),
			CFrame = CFrame.new(start + Vector3.new(side * 4.6, 3.5, -4.6)),
			Color = color3,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
	end
	return start
end

---------------------------------------------------------------------
-- ❄️ GLACIER CLIMB: slippery ice floes, then a spiral up an ice spire
---------------------------------------------------------------------
do
	local info = islandInfo("Frostfall")
	local model = Instance.new("Model")
	model.Name = "GlacierClimb"
	model.Parent = root
	local course = newCourse("GlacierClimb", model)
	local TOP = Color3.fromRGB(60, 90, 130)
	local RIM = Color3.fromRGB(140, 230, 255)
	local C = info.Center
	local start = islandStart(course, model, info, RIM)

	-- part 1: ice floes zig-zagging out over the void
	local position = Vector3.new(start.X, C.Y + 1, start.Z + 4)
	for i = 1, 12 do
		local side = (i % 2 == 0) and 1 or -1
		position = Vector3.new(C.X + side * 4.5, position.Y + 1, position.Z + 8.5)
		local cf = CFrame.new(position) * CFrame.new(0, -0.5, 0)
		if i == 12 then
			checkpointPad(course, model, cf, 1, RIM)
		elseif i == 4 or i == 9 then
			movingPlatform(model, cf, Vector3.new(4, 1, 4), Vector3.new(6, 0, 0), 2.8, i * 0.5, Color3.fromRGB(150, 220, 255))
		elseif i == 6 then
			spinnerPlatform(course, model, cf, TOP, RIM, 2.6, 0.4)
		elseif i % 3 == 2 then
			vanishPlatform(model, cf, Vector3.new(3.6, 1, 3.6), 2.4, 1.4, i * 0.6, Color3.fromRGB(200, 240, 255))
		else
			icePlatform(model, cf, Vector3.new(4, 1, 4))
		end
	end

	-- part 2: spiral around the ice spire
	local spire = Vector3.new(C.X, 0, position.Z + 20)
	local toCheckpoint = Vector3.new(position.X, 0, position.Z) - spire
	local angle0 = math.atan2(toCheckpoint.Z, toCheckpoint.X)
	local height = position.Y
	local RADIUS = 14
	local STEPS = 24
	local finishY
	for k = 1, STEPS do
		local angle = angle0 + k * 0.55
		if k == 17 then
			height += 10
		else
			height += 2.4
		end
		local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
		local p = spire + radial * RADIUS + Vector3.new(0, height, 0)
		local cf = CFrame.lookAt(p, p + tangent) * CFrame.new(0, -0.5, 0)
		if k == STEPS then
			finishY = height
			finishPad(course, model, CFrame.new(spire + Vector3.new(0, height, 0)) * CFrame.lookAt(Vector3.zero, -tangent).Rotation, RIM)
		elseif k == 12 then
			checkpointPad(course, model, cf, 2, RIM)
		elseif k == 16 then
			jumpPad(model, cf, Vector3.new(3.5, 1, 3.5), Vector3.new(0, 80, 0))
		elseif k == 5 or k == 14 or k == 21 then
			spinnerPlatform(course, model, cf, TOP, RIM, 3, k * 0.6)
		elseif k == 8 or k == 19 then
			icePlatform(model, cf, Vector3.new(1.2, 0.6, 7)) -- thin icy beam
		elseif k == 10 or k == 22 then
			movingPlatform(model, cf, Vector3.new(3.4, 1, 3.4), radial * 4, 2.2, k * 0.4, Color3.fromRGB(150, 220, 255))
		elseif k % 4 == 3 then
			vanishPlatform(model, cf, Vector3.new(3.2, 1, 3.2), 2.2, 1.2, k * 0.45, Color3.fromRGB(200, 240, 255))
		else
			icePlatform(model, cf, Vector3.new(3.6, 1, 3.6))
		end
	end

	-- the spire itself, with icicles
	local spireHeight = finishY + 40
	part({
		Name = "IceSpire",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(spireHeight, 9, 9),
		CFrame = CFrame.new(spire + Vector3.new(0, finishY - spireHeight / 2 - 0.6, 0)) * FLAT,
		Color = Color3.fromRGB(120, 190, 240),
		Material = Enum.Material.Glacier,
		Parent = model,
	})
	for y = C.Y, finishY - 6, 12 do
		part({
			Name = "SpireRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 9.6, 9.6),
			CFrame = CFrame.new(spire + Vector3.new(0, y, 0)) * FLAT,
			Color = RIM,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
	end
	local beacon = part({
		Name = "Beacon",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3,
		CFrame = CFrame.new(spire + Vector3.new(0, finishY + 12, 0)),
		Color = RIM,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	addLight(beacon, RIM, 40, 3)
end

---------------------------------------------------------------------
-- 🔥 MAGMA RUN: over a lava sea - sinking rocks, fire bars, lava halves
---------------------------------------------------------------------
do
	local info = islandInfo("Ember")
	local model = Instance.new("Model")
	model.Name = "MagmaRun"
	model.Parent = root
	local course = newCourse("MagmaRun", model)
	local TOP = Color3.fromRGB(50, 35, 35)
	local RIM = Color3.fromRGB(255, 120, 40)
	local LAVA = Color3.fromRGB(255, 100, 25)
	local C = info.Center
	local start = islandStart(course, model, info, RIM)

	local STEPS = 38
	local SPINNERS = { [6] = true, [15] = true, [24] = true, [33] = true }
	local HALF_LAVA = { [4] = true, [13] = true, [28] = true, [35] = true }
	local BEAMS = { [9] = true, [22] = true, [30] = true }
	local SINKERS = { [3] = true, [10] = true, [17] = true, [21] = true, [31] = true, [36] = true }
	local SLIDERS = { [11] = true, [25] = true }
	local position = Vector3.new(start.X, C.Y + 1, start.Z + 4)
	local lastZ
	for i = 1, STEPS do
		local x = math.sin(i * 0.38) * 14
		local rise = (i == 20) and 10 or 1.1
		position = Vector3.new(C.X + x, position.Y + rise, position.Z + 7.6)
		local nextPos = Vector3.new(C.X + math.sin((i + 1) * 0.38) * 14, position.Y, position.Z + 7.6)
		local direction = (nextPos - position).Unit
		local across = Vector3.new(-direction.Z, 0, direction.X)
		local cf = CFrame.lookAt(position, position + direction) * CFrame.new(0, -0.5, 0)
		lastZ = position.Z
		if i == STEPS then
			finishPad(course, model, cf * CFrame.new(0, 0, -4), RIM)
		elseif i == 12 or i == 26 then
			checkpointPad(course, model, cf, (i == 12) and 1 or 2, RIM)
		elseif i == 19 then
			jumpPad(model, cf, Vector3.new(3.5, 1, 3.5), Vector3.new(0, 82, 0))
		elseif SPINNERS[i] then
			spinnerPlatform(course, model, cf, TOP, RIM, 3, i * 0.5)
		elseif HALF_LAVA[i] then
			local p = platform(model, cf * CFrame.new(-1.1, 0, 0), Vector3.new(2.2, 1, 3.6), TOP, RIM)
			p.Material = Enum.Material.Basalt
			killPad(course, model, cf * CFrame.new(1.1, 0, 0), Vector3.new(2.2, 1, 3.6), LAVA)
		elseif BEAMS[i] then
			local p = platform(model, cf, Vector3.new(1, 0.6, 7), TOP, RIM)
			p.Material = Enum.Material.Basalt
		elseif SINKERS[i] then
			-- rocks that bob up and down out of the lava
			movingPlatform(model, cf, Vector3.new(3.6, 1, 3.6), Vector3.new(0, 3, 0), 2.6, i * 0.7, Color3.fromRGB(110, 70, 60))
		elseif SLIDERS[i] then
			movingPlatform(model, cf, Vector3.new(3.4, 1, 3.4), across * 6, 2.2, i * 0.3, Color3.fromRGB(255, 160, 80))
		elseif i % 4 == 2 then
			vanishPlatform(model, cf, Vector3.new(3.4, 1, 3.4), 2.3, 1.3, i * 0.55, Color3.fromRGB(255, 150, 60))
		else
			local p = platform(model, cf, Vector3.new(3.4, 1, 3.4), TOP, RIM)
			p.Material = Enum.Material.Basalt
		end
	end

	-- the lava sea under the whole course (touch it = back to checkpoint)
	local seaStart, seaEnd = start.Z + 8, lastZ + 14
	local sea = part({
		Name = "LavaSea",
		Size = Vector3.new(60, 1, seaEnd - seaStart),
		CFrame = CFrame.new(C.X, C.Y - 4, (seaStart + seaEnd) / 2),
		Color = LAVA,
		Material = Enum.Material.Neon,
		Transparency = 0.05,
		Parent = model,
	})
	table.insert(course.Kills, sea)
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = Config.Textures.Fire
	fire.Rate = 40
	fire.Lifetime = NumberRange.new(0.8, 1.6)
	fire.Speed = NumberRange.new(1, 4)
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), LAVA)
	fire.LightEmission = 1
	fire.EmissionDirection = Enum.NormalId.Top
	fire.Parent = sea
	for z = seaStart + 10, seaEnd - 5, 30 do
		local glow = part({ Name = "LavaGlow", Size = Vector3.one, CFrame = CFrame.new(C.X, C.Y - 2, z), Transparency = 1, CanCollide = false, Parent = model })
		addLight(glow, LAVA, 40, 2)
	end
	-- dark rock walls along the sides of the sea
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "SeaWall",
			Size = Vector3.new(3, 6, seaEnd - seaStart),
			CFrame = CFrame.new(C.X + side * 31.5, C.Y - 2.5, (seaStart + seaEnd) / 2),
			Color = Color3.fromRGB(40, 28, 28),
			Material = Enum.Material.Basalt,
			Parent = model,
		})
	end
end

---------------------------------------------------------------------
-- 💠 PULSE GRID: a square spiral of platforms that pulse to a beat
---------------------------------------------------------------------
do
	local info = islandInfo("Nexus")
	local model = Instance.new("Model")
	model.Name = "PulseGrid"
	model.Parent = root
	local course = newCourse("PulseGrid", model)
	local TOP = Color3.fromRGB(25, 15, 45)
	local RIM = Color3.fromRGB(255, 70, 220)
	local CYAN = Color3.fromRGB(60, 230, 255)
	local C = info.Center
	local start = islandStart(course, model, info, RIM)

	-- legs of the square spiral: direction + number of steps
	local legs = {
		{ Vector3.new(0, 0, 1), 10 },
		{ Vector3.new(1, 0, 0), 8 },
		{ Vector3.new(0, 0, 1), 8 },
		{ Vector3.new(-1, 0, 0), 14 },
	}
	local SPINNERS = { [7] = true, [16] = true, [25] = true, [34] = true }
	local BEAMS = { [4] = true, [19] = true, [29] = true }
	local MOVERS = { [12] = true, [21] = true, [31] = true, [37] = true }
	local HALF_DEADLY = { [9] = true, [33] = true }
	local position = Vector3.new(start.X, C.Y + 1, start.Z + 2)
	local i = 0
	local total = 0
	for _, leg in ipairs(legs) do
		total += leg[2]
	end
	for _, leg in ipairs(legs) do
		local direction = leg[1]
		local across = Vector3.new(-direction.Z, 0, direction.X)
		for _ = 1, leg[2] do
			i += 1
			local rise = (i == 24) and 10 or 1.3
			position += direction * 8 + Vector3.new(0, rise, 0)
			local cf = CFrame.lookAt(position, position + direction) * CFrame.new(0, -0.5, 0)
			if i == total then
				finishPad(course, model, cf * CFrame.new(0, 0, -4), RIM)
			elseif i == 13 or i == 27 then
				checkpointPad(course, model, cf, (i == 13) and 1 or 2, RIM)
			elseif i == 23 then
				jumpPad(model, cf, Vector3.new(3.5, 1, 3.5), Vector3.new(0, 82, 0))
			elseif SPINNERS[i] then
				spinnerPlatform(course, model, cf, TOP, RIM, 3.3, i * 0.45)
			elseif BEAMS[i] then
				platform(model, cf, Vector3.new(0.9, 0.6, 7), TOP, CYAN)
			elseif MOVERS[i] then
				movingPlatform(model, cf, Vector3.new(3.2, 1, 3.2), across * 6.5, 1.9, i * 0.33, CYAN)
			elseif HALF_DEADLY[i] then
				platform(model, cf * CFrame.new(-1.1, 0, 0), Vector3.new(2.2, 1, 3.4), TOP, RIM)
				killPad(course, model, cf * CFrame.new(1.1, 0, 0), Vector3.new(2.2, 1, 3.4))
			elseif i % 2 == 0 then
				-- pulse platforms: they blink in a wave along the course
				vanishPlatform(model, cf, Vector3.new(3.4, 1, 3.4), 2.4, 1.5, -i * 0.3, (i % 4 == 0) and RIM or CYAN)
			else
				platform(model, cf, Vector3.new(3.2, 1, 3.2), TOP, (i % 3 == 0) and CYAN or RIM)
			end
			-- neon grid posts under each step
			if i % 2 == 1 then
				part({
					Name = "GridPost",
					Size = Vector3.new(0.3, 14, 0.3),
					CFrame = CFrame.new(position + Vector3.new(0, -8, 0)),
					Color = (i % 4 == 1) and CYAN or RIM,
					Material = Enum.Material.Neon,
					CanCollide = false,
					CanQuery = false,
					Parent = model,
				})
			end
		end
	end
end

root.Parent = workspace

---------------------------------------------------------------------
-- RUNNING THE COURSES (checked by position every 0.1s)
---------------------------------------------------------------------
local runs = {} -- [player] = { Course = course, Started = time, Checkpoint = number }

-- Is this position standing on (or touching) the given pad?
local function onPad(pad, position, extraHeight)
	local localPos = pad.CFrame:PointToObjectSpace(position)
	local half = pad.Size / 2
	return math.abs(localPos.X) <= half.X + 0.6
		and math.abs(localPos.Z) <= half.Z + 0.6
		and localPos.Y >= -half.Y - 1
		and localPos.Y <= half.Y + (extraHeight or 4)
end

-- Is this player being hit by a spinning laser bar right now?
local function hitBySpinner(spinner, position)
	local feet, head = position.Y - 3.1, position.Y + 1.6
	if spinner.Center.Y < feet or spinner.Center.Y > head then
		return false
	end
	local angle = Luck.Now() * spinner.Speed + spinner.Offset
	local direction = Vector3.new(math.sin(angle), 0, math.cos(angle))
	local a = spinner.Center - direction * (spinner.Length / 2)
	local b = spinner.Center + direction * (spinner.Length / 2)
	local point = Vector3.new(position.X, spinner.Center.Y, position.Z)
	local ab = b - a
	local t = math.clamp((point - a):Dot(ab) / ab:Dot(ab), 0, 1)
	return (point - (a + ab * t)).Magnitude < 1.1
end

local function spotAbove(pad)
	return CFrame.new(pad.Position + Vector3.new(0, pad.Size.Y / 2 + 3, 0))
end

local function stopRun(player, reason)
	if runs[player] then
		runs[player] = nil
		player:SetAttribute("Checkpoint", nil)
		player:SetAttribute("ParkourCourse", nil)
		player:SetAttribute("ParkourStart", nil)
		if reason then
			ParkourEvent:FireClient(player, { Type = reason })
		end
	end
end

local function startRun(player, course)
	runs[player] = { Course = course, Started = Luck.Now(), Checkpoint = 0 }
	player:SetAttribute("Checkpoint", spotAbove(course.Start))
	player:SetAttribute("ParkourCourse", course.Settings.Name)
	player:SetAttribute("ParkourStart", Luck.Now())
	ParkourEvent:FireClient(player, { Type = "Start", Course = course.Settings.Name })
end

local function finishRun(player, course)
	local run = runs[player]
	local seconds = Luck.Now() - run.Started
	local now = Luck.Now()
	local cooldownKey = "ParkourCooldown_" .. course.Key
	local cooldownEnd = player:GetAttribute(cooldownKey) or 0
	local rewarded = cooldownEnd <= now
	if rewarded then
		local settings = course.Settings
		local currentEnd = player:GetAttribute("ParkourLuckEnd") or 0
		local currentMultiplier = (currentEnd > now) and (player:GetAttribute("ParkourLuckMultiplier") or 1) or 1
		player:SetAttribute("ParkourLuckMultiplier", math.max(currentMultiplier, settings.LuckMultiplier))
		player:SetAttribute("ParkourLuckEnd", math.max(currentEnd, now) + settings.BoostMinutes * 60)
		player:SetAttribute(cooldownKey, now + settings.CooldownMinutes * 60)
	end
	runs[player] = nil
	player:SetAttribute("Checkpoint", nil)
	player:SetAttribute("ParkourCourse", nil)
	player:SetAttribute("ParkourStart", nil)
	questEvent:Fire(player, "Parkour", 1)
	ParkourEvent:FireClient(player, {
		Type = "Finish",
		Course = course.Settings.Name,
		Time = seconds,
		Rewarded = rewarded,
		Multiplier = course.Settings.LuckMultiplier,
		Minutes = course.Settings.BoostMinutes,
		CooldownLeft = rewarded and 0 or (cooldownEnd - now),
	})
end

local function onMainIslandGround(position)
	local flat = Vector3.new(position.X, 0, position.Z)
	return flat.Magnitude < Config.MainIslandRadius - 6 and position.Y < 8 and position.Y > -2
end

task.spawn(function()
	while true do
		task.wait(0.1)
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not hrp or not humanoid or humanoid.Health <= 0 or character:GetAttribute("InDuel") then
				stopRun(player)
				continue
			end
			local position = hrp.Position
			local run = runs[player]

			-- stepping on a start pad starts (or restarts) that course
			for _, course in pairs(courses) do
				if onPad(course.Start, position) and (not run or run.Course ~= course or run.Checkpoint > 0) then
					startRun(player, course)
					run = runs[player]
				end
			end

			if run then
				local course = run.Course
				-- checkpoints
				for number, pad in ipairs(course.Checkpoints) do
					if number > run.Checkpoint and onPad(pad, position) then
						run.Checkpoint = number
						player:SetAttribute("Checkpoint", spotAbove(pad))
						ParkourEvent:FireClient(player, { Type = "Checkpoint", Number = number, Total = #course.Checkpoints })
					end
				end
				-- kill pads and spinning lasers send you back
				local ouch = false
				for _, kill in ipairs(course.Kills) do
					if onPad(kill, position, 3.5) then
						ouch = true
						break
					end
				end
				if not ouch then
					for _, spinner in ipairs(course.Spinners) do
						if hitBySpinner(spinner, position) then
							ouch = true
							break
						end
					end
				end
				if ouch then
					hrp.AssemblyLinearVelocity = Vector3.zero
					character:PivotTo(player:GetAttribute("Checkpoint") or spotAbove(course.Start))
					ParkourEvent:FireClient(player, { Type = "Ouch" })
				end
				-- finish
				if onPad(course.Finish, position, 6) then
					finishRun(player, course)
				-- walking around the island again ends the run
				elseif (course.OnGround or onMainIslandGround)(position) and not onPad(course.Start, position, 8) then
					stopRun(player, "Left")
				end
			end
		end
	end
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		stopRun(player)
	end)
end)
for _, player in ipairs(Players:GetPlayers()) do
	player.CharacterAdded:Connect(function()
		stopRun(player)
	end)
end
Players.PlayerRemoving:Connect(function(player)
	runs[player] = nil
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="19">
      <Properties>
        <string name="Name">PetWorld</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- PetWorld (Script in ServerScriptService)
-- Builds a HATCHERY on the main island and on every rebirth island:
-- 3 giant eggs on pedestals. Walk up and press E to open the egg
-- (PetClient shows the odds and the Hatch button; RollService does the
-- hatching and takes the auras).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local PetData = require(ReplicatedStorage:WaitForChild("PetData"))

local old = workspace:FindFirstChild("PetHatcheries")
if old then
	old:Destroy()
end
local root = Instance.new("Folder")
root.Name = "PetHatcheries"

local FLAT = CFrame.Angles(0, 0, math.rad(90))

local function part(props, parent)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "ClassName" then
			p[key] = value
		end
	end
	p.Parent = parent
	return p
end

local function addLight(target, color3, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color3
	light.Range = range
	light.Brightness = brightness
	light.Parent = target
end

local function billboard(target, text, offset, size, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance or 80
	gui.LightInfluence = 0
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.RichText = true
	label.Text = text
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = gui
	local outline = Instance.new("UIStroke")
	outline.Thickness = 2
	outline.Transparency = 0.2
	outline.Parent = label
	return gui
end

-- one giant egg on a pedestal
local function eggStand(parent, egg, position, facing, theme)
	local stand = Instance.new("Model")
	stand.Name = egg.Key
	stand.Parent = parent
	part({
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.2, 6.4, 6.4),
		CFrame = CFrame.new(position + Vector3.new(0, 1.1, 0)) * FLAT,
		Color = theme.Stone,
		Material = theme.StoneMaterial,
	}, stand)
	part({
		Name = "PedestalRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 6.9, 6.9),
		CFrame = CFrame.new(position + Vector3.new(0, 2.1, 0)) * FLAT,
		Color = egg.Color,
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, stand)
	local eggPart = part({
		Name = "Egg",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(4.6, 6, 4.6),
		CFrame = CFrame.new(position + Vector3.new(0, 5.4, 0)),
		Color = egg.Color,
		Material = Enum.Material.SmoothPlastic,
	}, stand)
	eggPart:SetAttribute("EggKey", egg.Key)
	eggPart:SetAttribute("FX_EggBob", true)
	-- glowing spots on the egg
	for k = 1, 7 do
		local a = k * 2.4
		local y = math.sin(k * 1.7) * 1.8
		local r = 2.3 * math.sqrt(math.max(0.2, 1 - (y / 3) ^ 2))
		part({
			Name = "EggSpot",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (0.5 + (k % 3) * 0.25),
			CFrame = CFrame.new(position + Vector3.new(math.cos(a) * r, 5.4 + y, math.sin(a) * r)),
			Color = egg.Color:Lerp(Color3.new(1, 1, 1), 0.6),
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, stand)
	end
	addLight(eggPart, egg.Color, 16, 1.5)
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = Config.Textures.Sparkle
	sparkles.Rate = 4
	sparkles.Lifetime = NumberRange.new(1.5, 2.5)
	sparkles.Speed = NumberRange.new(0.5, 1.5)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparkles.LightEmission = 1
	sparkles.Color = ColorSequence.new(egg.Color, Color3.new(1, 1, 1))
	sparkles.Parent = eggPart

	-- name, price and odds
	local lines = { ("<b>%s</b>"):format(egg.Name:upper()),
		("<font color='#ffd76a'>Costs %dx %s</font>"):format(egg.Cost.Count, egg.Cost.Aura) }
	for _, entry in ipairs(egg.Pets) do
		local pet = PetData.Get(entry[1])
		local color = PetData.Rarities[pet.Rarity].Color
		table.insert(lines, ("<font color='#%s'>%s %s</font>"):format(color:ToHex(), entry[1], PetData.ChanceText(egg, entry[2])))
	end
	billboard(eggPart, table.concat(lines, "\n"), Vector3.new(0, 6.6, 0), UDim2.fromOffset(220, 150))

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "HatchPrompt"
	prompt.ActionText = "Open Egg"
	prompt.ObjectText = egg.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = eggPart
	return stand
end

local THEMES = {
	Main = { Stone = Color3.fromRGB(70, 60, 110), StoneMaterial = Enum.Material.Marble, Floor = Color3.fromRGB(45, 38, 75), Trim = Color3.fromRGB(255, 170, 120), Title = "🥚 COSMIC HATCHERY" },
	Frostfall = { Stone = Color3.fromRGB(150, 200, 240), StoneMaterial = Enum.Material.Ice, Floor = Color3.fromRGB(200, 225, 250), Trim = Color3.fromRGB(140, 230, 255), Title = "🥚 FROST HATCHERY" },
	Ember = { Stone = Color3.fromRGB(45, 30, 30), StoneMaterial = Enum.Material.Basalt, Floor = Color3.fromRGB(60, 42, 40), Trim = Color3.fromRGB(255, 120, 40), Title = "🥚 EMBER HATCHERY" },
	Nexus = { Stone = Color3.fromRGB(30, 20, 55), StoneMaterial = Enum.Material.Glass, Floor = Color3.fromRGB(22, 14, 40), Trim = Color3.fromRGB(255, 70, 220), Title = "🥚 NEXUS HATCHERY" },
}

local function hatchery(islandKey, center, islandCenter, needRebirths)
	local theme = THEMES[islandKey]
	local model = Instance.new("Model")
	model.Name = islandKey .. "Hatchery"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = root
	-- floor
	part({
		Name = "HatcheryFloor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 34, 34),
		CFrame = CFrame.new(center + Vector3.new(0, 0.3, 0)) * FLAT,
		Color = theme.Floor,
		Material = theme.StoneMaterial,
	}, model)
	part({
		Name = "HatcheryRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 35, 35),
		CFrame = CFrame.new(center + Vector3.new(0, 0.2, 0)) * FLAT,
		Color = theme.Trim,
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, model)
	-- the eggs stand in an arc on the far side, facing the island's middle
	local toMiddle = Vector3.new(islandCenter.X - center.X, 0, islandCenter.Z - center.Z)
	toMiddle = toMiddle.Magnitude > 0.1 and toMiddle.Unit or Vector3.new(0, 0, -1)
	local side = Vector3.new(-toMiddle.Z, 0, toMiddle.X)
	for _, egg in ipairs(PetData.Eggs) do
		if egg.Island == islandKey then
			local offset = (egg.Slot - 2)
			local position = center - toMiddle * (5 + math.abs(offset) * -2.5) + side * offset * 9.5
			eggStand(model, egg, position, toMiddle, theme)
		end
	end
	-- an arch with the hatchery's name behind the eggs
	local back = center - toMiddle * 13
	local archCF = CFrame.lookAt(back, back + toMiddle)
	for _, s in ipairs({ -1, 1 }) do
		part({ Name = "ArchPillar", Size = Vector3.new(1.4, 12, 1.4), CFrame = archCF * CFrame.new(s * 14, 6, 0), Color = theme.Stone, Material = theme.StoneMaterial }, model)
		local orb = part({ Name = "ArchOrb", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.8, CFrame = archCF * CFrame.new(s * 14, 12.9, 0), Color = theme.Trim, Material = Enum.Material.Neon, CanCollide = false }, model)
		addLight(orb, theme.Trim, 18, 1.4)
	end
	local beam = part({ Name = "ArchBeam", Size = Vector3.new(30, 1.4, 1.6), CFrame = archCF * CFrame.new(0, 12.4, 0), Color = theme.Stone, Material = theme.StoneMaterial }, model)
	local title = theme.Title
	if needRebirths > 0 then
		title ..= ("\n<font size='40' color='#bfb4e1'>Rebirth %d island</font>"):format(needRebirths)
	end
	billboard(beam, title, Vector3.new(0, 3.2, 0), UDim2.fromOffset(380, 80), 160)
	-- a little "how it works" sign
	local sign = part({ Name = "InfoSign", Size = Vector3.new(8, 3.6, 0.4), CFrame = CFrame.lookAt(center + toMiddle * 13 + side * 10 + Vector3.new(0, 2.6, 0), center + side * 10 + Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, math.pi, 0), Color = theme.Stone, Material = theme.StoneMaterial }, model)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = sign
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.Text = "🐾 Pay with AURAS!\nPets give you luck."
	text.TextColor3 = theme.Trim
	text.Parent = gui
end

hatchery("Main", Config.Places.Hatchery, Vector3.zero, 0)
for _, info in ipairs(Config.RebirthIslands) do
	if info.Hatchery then
		hatchery(info.Key, info.Center + info.Hatchery, info.Center, info.Rebirths)
	end
end

root.Parent = workspace
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="20">
      <Properties>
        <string name="Name">RebirthIslands</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- RebirthIslands (Script in ServerScriptService)
-- Builds the REBIRTH GATE on the main island and the three rebirth islands:
--   ❄️ FROSTFALL ISLE (Rebirth 1) - snow, pines, a frozen lake, an igloo,
--                                   snowmen, icicles and an aurora sky
--   🔥 EMBER ISLE     (Rebirth 2) - a smoking volcano, lava pools, geysers,
--                                   obsidian spikes and burnt trees
--   💠 NEON NEXUS     (Rebirth 3) - a synthwave city: neon grid floor, holo
--                                   towers, neon palms, floating cubes, a
--                                   giant striped sun
-- Each island has more luck while you stand on it, its own parkour course
-- (built by the Parkour script) and a return portal.
-- The portals are checked by position (plus a "Press E" prompt), like the
-- Lucky Isle portal. Things marked with FX_ attributes are animated by the
-- IslandFX script on each player's screen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))

local rand = Random.new(2024)
local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder upright

---------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------
local remotes = ReplicatedStorage:FindFirstChild("CosmicRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "CosmicRemotes"
	remotes.Parent = ReplicatedStorage
end
local PortalFXRemote = remotes:FindFirstChild("PortalFX")
if not PortalFXRemote then
	PortalFXRemote = Instance.new("RemoteEvent")
	PortalFXRemote.Name = "PortalFX"
	PortalFXRemote.Parent = remotes
end

---------------------------------------------------------------------
-- Build helpers
---------------------------------------------------------------------
local old = workspace:FindFirstChild("RebirthIslands")
if old then
	old:Destroy()
end
local folder = Instance.new("Folder")
folder.Name = "RebirthIslands"

local currentParent -- the model that new parts go into

local function part(props)
	local className = props.ClassName or "Part"
	local p = Instance.new(className)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" and key ~= "ClassName" then
			p[key] = value
		end
	end
	p.Parent = props.Parent or currentParent
	return p
end

local function decor(props)
	props.CanCollide = false
	props.CanQuery = false
	props.CastShadow = false
	return part(props)
end

local function addLight(target, color3, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color3
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = target
	return light
end

local function emitter(target, props)
	local e = Instance.new("ParticleEmitter")
	e.Texture = props.Texture or Config.Textures.Sparkle
	e.Rate = props.Rate or 5
	e.Lifetime = props.Lifetime or NumberRange.new(1.5, 3)
	e.Speed = props.Speed or NumberRange.new(0.5, 2)
	e.SpreadAngle = props.Spread or Vector2.new(180, 180)
	e.Size = props.Size or NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.5, 0.4),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = props.Transparency or NumberSequence.new(0)
	e.Acceleration = props.Acceleration or Vector3.zero
	e.LightEmission = props.LightEmission or 1
	e.LightInfluence = 0
	e.Color = props.Color or ColorSequence.new(Color3.new(1, 1, 1))
	e.Rotation = props.Rotation or NumberRange.new(0, 360)
	e.RotSpeed = props.RotSpeed or NumberRange.new(-40, 40)
	if props.Drag then
		e.Drag = props.Drag
	end
	if props.EmissionDirection then
		e.EmissionDirection = props.EmissionDirection
	end
	e.Parent = target
	return e
end

local function sizeSeq(a, b, c)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, a),
		NumberSequenceKeypoint.new(0.5, b),
		NumberSequenceKeypoint.new(1, c),
	})
end

-- upright cylinder, top surface at topY
local function disc(name, center, radius, thickness, topY, color3, material, extra)
	local props = {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(center.X, topY - thickness / 2, center.Z) * FLAT,
		Color = color3,
		Material = material,
	}
	for key, value in pairs(extra or {}) do
		props[key] = value
	end
	return part(props)
end

-- flat ring of pieces (its own Model, so it can spin)
local function ringModel(name, center, radius, segments, thickness, color3, parent, material)
	local model = Instance.new("Model")
	model.Name = name
	local length = (2 * math.pi * radius / segments) * 1.06
	for i = 1, segments do
		local a = (i / segments) * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
		decor({
			Name = "Segment",
			Size = Vector3.new(thickness, thickness, length),
			CFrame = CFrame.lookAt(p, center) * CFrame.Angles(0, math.pi / 2, 0),
			Color = color3,
			Material = material or Enum.Material.Neon,
			Parent = model,
		})
	end
	model.WorldPivot = CFrame.new(center)
	model.Parent = parent or currentParent
	return model
end

-- upright ring facing portalCF's look direction
local function portalRing(name, portalCF, radius, segments, thickness, color3, parent)
	local model = Instance.new("Model")
	model.Name = name
	local length = (2 * math.pi * radius / segments) * 1.08
	for i = 1, segments do
		local a = (i / segments) * math.pi * 2
		local radial = Vector3.new(math.cos(a), math.sin(a), 0)
		decor({
			Name = "Segment",
			Size = Vector3.new(thickness, thickness, length),
			CFrame = portalCF * CFrame.fromMatrix(radial * radius, radial, Vector3.new(0, 0, 1)),
			Color = color3,
			Material = Enum.Material.Neon,
			Parent = model,
		})
	end
	model.WorldPivot = portalCF
	model.Parent = parent or currentParent
	return model
end

local function billboard(target, text, color3, offset, size, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = size or UDim2.fromOffset(420, 70)
	gui.StudsOffset = offset or Vector3.new(0, 6, 0)
	gui.MaxDistance = maxDistance or 220
	gui.LightInfluence = 0
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.RichText = true
	label.Text = text
	label.TextColor3 = color3
	label.Parent = gui
	local outline = Instance.new("UIStroke")
	outline.Thickness = 2.5
	outline.Transparency = 0.2
	outline.Parent = label
	return gui
end

-- spike pointing up (or down with flip = true), made of two wedges
local function spike(position, width, height, color3, material, flip, collide)
	local base = CFrame.new(position) * CFrame.Angles(0, rand:NextNumber(0, math.pi), 0)
	if flip then
		base *= CFrame.Angles(math.pi, 0, 0)
	end
	for k = 0, 1 do
		local cf = base * CFrame.Angles(0, k * math.pi, 0) * CFrame.new(0, height / 2, -width / 4)
		part({
			ClassName = "WedgePart",
			Name = "Spike",
			Size = Vector3.new(width, height, width / 2),
			CFrame = cf,
			Color = color3,
			Material = material,
			CanCollide = collide == true,
			CastShadow = false,
		})
	end
end

-- 4-sided pointy tier (pines, volcano tops), made of wedges
local function pyramid(position, base, height, color3, material, collide)
	for k = 0, 3 do
		part({
			ClassName = "WedgePart",
			Name = "Tier",
			Size = Vector3.new(base, height, base / 2),
			CFrame = CFrame.new(position) * CFrame.Angles(0, k * math.pi / 2, 0) * CFrame.new(0, height / 2, -base / 4),
			Color = color3,
			Material = material,
			CanCollide = collide == true,
		})
	end
end

-- marks something for IslandFX to animate
local function fx(instance, attributes)
	for key, value in pairs(attributes) do
		instance:SetAttribute(key, value)
	end
	return instance
end

---------------------------------------------------------------------
-- Shared island pieces
---------------------------------------------------------------------
-- keep-out zones on every island: return portal path, parkour start, core
local function makeIsland(info, style)
	local model = Instance.new("Model")
	model.Name = info.Key .. "Isle"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model:SetAttribute("IslandKey", info.Key)
	model.Parent = folder
	currentParent = model

	local C = info.Center
	local R = info.Radius
	local D = R - 70 -- how much bigger than the original 70-stud island
	local function at(x, y, z)
		return C + Vector3.new(x, y, z)
	end
	local function free(x, z, margin)
		margin = margin or 0
		local flat = Vector3.new(x, 0, z)
		if flat.Magnitude > R - 6 - margin then
			return false
		end
		if flat.Magnitude < 13 + margin then
			return false -- the core
		end
		if math.abs(x) < 10 + margin and z < -12 then
			return false -- portal + arrival path
		end
		if math.abs(x) < 10 + margin and z > 12 then
			return false -- path to the parkour start
		end
		if info.Hatchery and (flat - Vector3.new(info.Hatchery.X, 0, info.Hatchery.Z)).Magnitude < 19 + margin then
			return false -- pet eggs
		end
		for _, zone in ipairs(style.Reserved or {}) do
			if (flat - zone[1]).Magnitude < zone[2] + margin then
				return false
			end
		end
		return true
	end
	local function randomSpot(minR, maxR, margin, tries)
		for _ = 1, tries or 40 do
			local a = rand:NextNumber(0, math.pi * 2)
			local r = rand:NextNumber(minR, maxR)
			local x, z = math.cos(a) * r, math.sin(a) * r
			if free(x, z, margin) then
				return x, z
			end
		end
		return nil
	end

	-- ground + layered rock underneath
	disc("Ground", C, R, 4, C.Y, style.Ground, style.GroundMaterial)
	disc("EdgeGlow", C, R + 0.7, 0.7, C.Y - 0.2, style.Edge, Enum.Material.Neon, { CanCollide = false })
	local layers = {
		{ r = R - 6, y = -4, t = 6 },
		{ r = R - 18, y = -10, t = 7 },
		{ r = R - 32, y = -17, t = 8 },
		{ r = R - 46, y = -25, t = 9 },
		{ r = R - 58, y = -34, t = 10 },
	}
	for i, layer in ipairs(layers) do
		disc("Underside" .. i, C, layer.r, layer.t, C.Y + layer.y, (i % 2 == 0) and style.RockDark or style.Rock,
			style.RockMaterial, { CanCollide = false })
	end

	-- return portal (behind where you arrive)
	local portalCF = CFrame.lookAt(at(0, 6, -56 - D), at(0, 6, -80 - D)) -- faces away from the island
	disc("PortalStep", at(0, 0, -55 - D), 8, 0.6, C.Y + 0.3, style.Accent2, style.TrimMaterial or Enum.Material.Slate)
	portalRing("ReturnPortalRing", portalCF, 4.6, 36, 0.7, style.Edge)
	local outer = portalRing("ReturnPortalRingOuter", portalCF, 5.6, 40, 0.35, style.Accent)
	fx(outer, { FX_Spin = Vector3.new(0, 0, 0.6) })
	local swirl = decor({
		Name = "ReturnSwirl",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 9, 9),
		CFrame = portalCF * CFrame.Angles(0, math.rad(90), 0),
		Color = style.Edge,
		Material = Enum.Material.Neon,
		Transparency = 0.45,
	})
	emitter(swirl, { Rate = 14, Color = ColorSequence.new(style.Edge, style.Accent), Size = sizeSeq(0, 0.6, 0) })
	addLight(swirl, style.Edge, 22, 2)
	local zone = part({
		Name = "ReturnPortalZone",
		Size = Vector3.new(8, 9, 3),
		CFrame = portalCF,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	billboard(swirl, "🏠 BACK TO COSMIC ISLAND", Color3.new(1, 1, 1), Vector3.new(0, 7.5, 0), UDim2.fromOffset(380, 50))

	-- welcome sign
	local signPost = part({
		Name = "WelcomeSign",
		Size = Vector3.new(10, 4, 0.6),
		CFrame = CFrame.lookAt(at(-11, 5, -40 - D), at(-11, 5, -60 - D)),
		Color = style.RockDark,
		Material = style.RockMaterial,
	})
	for _, side in ipairs({ -4.2, 4.2 }) do
		part({
			Name = "SignLeg",
			Size = Vector3.new(0.6, 3, 0.6),
			CFrame = signPost.CFrame * CFrame.new(side, -3.5, 0),
			Color = style.RockDark,
			Material = style.RockMaterial,
		})
	end
	local signGui = Instance.new("SurfaceGui")
	signGui.Face = Enum.NormalId.Front
	signGui.LightInfluence = 0
	signGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	signGui.PixelsPerStud = 40
	signGui.Parent = signPost
	local signText = Instance.new("TextLabel")
	signText.BackgroundTransparency = 1
	signText.Size = UDim2.fromScale(1, 1)
	signText.Font = Enum.Font.FredokaOne
	signText.TextScaled = true
	signText.RichText = true
	signText.Text = ("%s %s\n<font size='60'>ALL YOUR LUCK x%s HERE</font>"):format(info.Icon, info.Name:upper(), tostring(info.LuckMultiplier))
	signText.TextColor3 = info.Color
	signText.Parent = signGui

	return {
		Model = model,
		Center = C,
		Radius = R,
		At = at,
		Free = free,
		RandomSpot = randomSpot,
		ReturnZone = zone,
		Arrival = CFrame.lookAt(at(0, 4, -44 - D), at(0, 4, 0)),
	}
end

-- floating islands' core: discs + an object that spins + rings
local function islandCore(island, style, buildCenterpiece)
	local at = island.At
	local C = island.Center
	local core = Instance.new("Model")
	core.Name = "IslandCore"
	core.Parent = island.Model
	disc("CoreBase", C, 11, 0.8, C.Y + 0.6, style.RockDark, style.RockMaterial, { Parent = core })
	disc("CoreRim", C, 11.4, 0.4, C.Y + 0.25, style.Edge, Enum.Material.Neon, { Parent = core, CanCollide = false })
	disc("CoreStep", C, 7, 0.8, C.Y + 1.4, style.Rock, style.RockMaterial, { Parent = core })
	disc("CoreTop", C, 4, 0.8, C.Y + 2.2, style.Accent2, style.TrimMaterial or Enum.Material.Slate, { Parent = core })
	local center = at(0, 9, 0)
	local piece = buildCenterpiece(center, core)
	addLight(piece, style.Edge, 40, 3)
	emitter(piece, { Rate = 10, Color = ColorSequence.new(style.Edge, style.Accent), Size = sizeSeq(0, 0.7, 0), Speed = NumberRange.new(1, 3) })
	billboard(piece, ("%s %s"):format(style.CoreIcon or "✦", style.CoreName), style.Edge, Vector3.new(0, 7, 0), UDim2.fromOffset(340, 56))
	fx(ringModel("CoreRing1", center, 6, 28, 0.3, style.Edge, core), { FX_Spin = Vector3.new(0.8, 0.3, 0) })
	fx(ringModel("CoreRing2", center, 7.5, 34, 0.3, style.Accent, core), { FX_Spin = Vector3.new(0, 0.6, 0.9) })
	fx(ringModel("CoreRing3", center, 9, 40, 0.3, style.Accent2, core), { FX_Spin = Vector3.new(0.4, 0, 0.5) })
	-- 4 pillars around the core
	for i = 1, 4 do
		local a = (i / 4) * math.pi * 2 + math.pi / 4
		local p = at(math.cos(a) * 9.5, 0, math.sin(a) * 9.5)
		part({
			Name = "CorePillar",
			Size = Vector3.new(1.4, 7, 1.4),
			CFrame = CFrame.new(p + Vector3.new(0, 4, 0)),
			Color = style.RockDark,
			Material = style.RockMaterial,
			Parent = core,
		})
		local cap = decor({
			Name = "CorePillarCap",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.6,
			CFrame = CFrame.new(p + Vector3.new(0, 8.2, 0)),
			Color = style.Edge,
			Material = Enum.Material.Neon,
			Parent = core,
		})
		addLight(cap, style.Edge, 14, 1.2)
	end
	return core
end

-- lantern posts along the arrival path
local function pathLanterns(island, style)
	for _, side in ipairs({ -1, 1 }) do
		for z = -16, -(island.Radius - 30), -12 do
			local p = island.At(side * 6.5, 0, z)
			part({
				Name = "LanternPost",
				Size = Vector3.new(0.7, 6, 0.7),
				CFrame = CFrame.new(p + Vector3.new(0, 3, 0)),
				Color = style.RockDark,
				Material = style.RockMaterial,
			})
			local lamp = decor({
				Name = "Lantern",
				Size = Vector3.one * 1.3,
				CFrame = CFrame.new(p + Vector3.new(0, 6.8, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
				Color = style.Edge,
				Material = Enum.Material.Neon,
			})
			fx(lamp, { FX_Spin = Vector3.new(0, 1.2, 0) })
			addLight(lamp, style.Edge, 16, 1.3)
		end
	end
	-- path tiles from the portal to the core
	for z = -(island.Radius - 20), -12, 3 do
		part({
			Name = "PathTile",
			Size = Vector3.new(5 + rand:NextNumber(-0.3, 0.3), 0.3, 2.8),
			CFrame = CFrame.new(island.At(0, 0.12, z)) * CFrame.Angles(0, rand:NextNumber(-0.05, 0.05), 0),
			Color = style.Path,
			Material = style.PathMaterial or style.RockMaterial,
		})
	end
	-- and from the core to the parkour start
	for z = 13, island.Radius - 13, 3 do
		part({
			Name = "PathTile",
			Size = Vector3.new(4.2 + rand:NextNumber(-0.3, 0.3), 0.3, 2.8),
			CFrame = CFrame.new(island.At(0, 0.12, z)) * CFrame.Angles(0, rand:NextNumber(-0.05, 0.05), 0),
			Color = style.Path,
			Material = style.PathMaterial or style.RockMaterial,
		})
	end
end

-- a big invisible box above the island that rains particles (snow, embers...)
local function weather(island, props)
	local box = part({
		Name = "Weather",
		Size = Vector3.new(island.Radius * 2, 1, island.Radius * 2),
		CFrame = CFrame.new(island.At(0, 40, 0)),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	props.EmissionDirection = props.EmissionDirection or Enum.NormalId.Bottom
	emitter(box, props)
	return box
end

local builtIslands = {} -- [key] = island table

---------------------------------------------------------------------
-- ❄️ FROSTFALL ISLE
---------------------------------------------------------------------
do
	local info = Config.RebirthIslands[1]
	local SNOW = Color3.fromRGB(236, 244, 255)
	local ICE = Color3.fromRGB(150, 215, 255)
	local PINE = Color3.fromRGB(40, 95, 80)
	local style = {
		Ground = SNOW, GroundMaterial = Enum.Material.Snow,
		Rock = Color3.fromRGB(120, 170, 220), RockDark = Color3.fromRGB(70, 105, 160), RockMaterial = Enum.Material.Glacier,
		Edge = Color3.fromRGB(140, 230, 255), Accent = Color3.fromRGB(190, 160, 255), Accent2 = Color3.fromRGB(215, 235, 255),
		TrimMaterial = Enum.Material.Ice,
		Path = Color3.fromRGB(190, 215, 240), PathMaterial = Enum.Material.Ice,
		CoreName = "FROST CORE", CoreIcon = "❄️",
		Reserved = {
			{ Vector3.new(-32, 0, 10), 17 }, -- frozen lake
			{ Vector3.new(32, 0, -12), 10 }, -- igloo
		},
	}
	local island = makeIsland(info, style)
	local at = island.At
	local C = island.Center

	-- icicles hanging under the island
	for i = 1, 26 do
		local a = (i / 26) * math.pi * 2 + rand:NextNumber(-0.1, 0.1)
		local r = rand:NextNumber(14, info.Radius - 10)
		local layerY = -6 - (1 - r / info.Radius) * 26
		spike(at(math.cos(a) * r, layerY, math.sin(a) * r), rand:NextNumber(1.5, 3.2), rand:NextNumber(6, 16),
			(i % 3 == 0) and ICE or Color3.fromRGB(200, 235, 255), Enum.Material.Ice, true)
	end

	-- the core: a giant spinning snowflake
	islandCore(island, style, function(center, core)
		local flake = Instance.new("Model")
		flake.Name = "Snowflake"
		local hub = decor({
			Name = "Hub",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 2.2,
			CFrame = CFrame.new(center),
			Color = Color3.new(1, 1, 1),
			Material = Enum.Material.Neon,
			Parent = flake,
		})
		for k = 0, 5 do
			local arm = CFrame.new(center) * CFrame.Angles(0, 0, k * math.pi / 3)
			decor({ Name = "Arm", Size = Vector3.new(0.6, 9, 0.6), CFrame = arm, Color = ICE, Material = Enum.Material.Neon, Parent = flake })
			for _, s in ipairs({ -1, 1 }) do
				for _, y in ipairs({ 2.4, 3.6 }) do
					decor({
						Name = "Branch",
						Size = Vector3.new(0.4, y == 2.4 and 2.2 or 1.4, 0.4),
						CFrame = arm * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, s * math.rad(45)) * CFrame.new(0, (y == 2.4 and 1.1 or 0.7), 0),
						Color = Color3.fromRGB(220, 245, 255),
						Material = Enum.Material.Neon,
						Parent = flake,
					})
				end
			end
		end
		flake.WorldPivot = CFrame.new(center)
		flake.Parent = core
		fx(flake, { FX_Spin = Vector3.new(0, 0.7, 0), FX_Bob = 0.6 })
		return hub
	end)
	pathLanterns(island, style)

	-- frozen lake with cracks, ice blocks and a fishing hole
	local lakeCenter = at(-32, 0, 10)
	disc("FrozenLake", lakeCenter, 15, 0.4, C.Y + 0.18, Color3.fromRGB(165, 220, 255), Enum.Material.Ice,
		{ Reflectance = 0.25, CustomPhysicalProperties = PhysicalProperties.new(0.9, 0.02, 0.5, 100, 1) })
	disc("LakeRim", lakeCenter, 16, 0.5, C.Y + 0.1, Color3.fromRGB(230, 240, 255), Enum.Material.Snow)
	for i = 1, 7 do
		local a = rand:NextNumber(0, math.pi * 2)
		local p = lakeCenter + Vector3.new(math.cos(a) * 5, 0, math.sin(a) * 5)
		decor({
			Name = "IceCrack",
			Size = Vector3.new(0.15, 0.06, rand:NextNumber(5, 10)),
			CFrame = CFrame.new(p.X, C.Y + 0.4, p.Z) * CFrame.Angles(0, a + rand:NextNumber(-0.6, 0.6), 0),
			Color = Color3.fromRGB(220, 250, 255),
			Material = Enum.Material.Neon,
			Transparency = 0.3,
		})
	end
	disc("FishingHole", lakeCenter + Vector3.new(4, 0, -3), 1.6, 0.1, C.Y + 0.43, Color3.fromRGB(20, 60, 110), Enum.Material.Water, { CanCollide = false })
	for i = 1, 5 do
		local a = (i / 5) * math.pi * 2
		part({
			Name = "IceBlock",
			Size = Vector3.new(rand:NextNumber(1.6, 3), rand:NextNumber(1.2, 2.4), rand:NextNumber(1.6, 3)),
			CFrame = CFrame.new(lakeCenter.X + math.cos(a) * 12, C.Y + 1, lakeCenter.Z + math.sin(a) * 12) * CFrame.Angles(rand:NextNumber(-0.3, 0.3), a, rand:NextNumber(-0.3, 0.3)),
			Color = ICE,
			Material = Enum.Material.Ice,
			Transparency = 0.25,
		})
	end
	-- a little sign
	local lakeSign = part({ Name = "LakeSign", Size = Vector3.new(0.4, 3.5, 0.4), CFrame = CFrame.new(lakeCenter + Vector3.new(14, 1.75, -9)), Color = Color3.fromRGB(110, 80, 60), Material = Enum.Material.Wood })
	billboard(lakeSign, "⛸ SLIPPERY!", ICE, Vector3.new(0, 3, 0), UDim2.fromOffset(200, 40), 60)

	-- igloo (dome + tunnel)
	local iglooCenter = at(32, 0, -12)
	part({
		Name = "Igloo",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 12,
		CFrame = CFrame.new(iglooCenter + Vector3.new(0, -0.5, 0)),
		Color = Color3.fromRGB(240, 248, 255),
		Material = Enum.Material.Snow,
	})
	part({
		Name = "IglooTunnel",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4, 4.5, 4.5),
		CFrame = CFrame.lookAt(iglooCenter + Vector3.new(0, 0.9, 0), iglooCenter + Vector3.new(-1, 0.9, 0)) * CFrame.new(0, 0, -6) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(230, 240, 252),
		Material = Enum.Material.Snow,
	})
	local door = decor({
		Name = "IglooDoor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 3.2, 3.2),
		CFrame = CFrame.lookAt(iglooCenter + Vector3.new(0, 0.9, 0), iglooCenter + Vector3.new(-1, 0.9, 0)) * CFrame.new(0, 0, -8.05) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(255, 190, 110),
		Material = Enum.Material.Neon,
	})
	addLight(door, Color3.fromRGB(255, 180, 100), 14, 1.5)
	for row = 0, 3 do -- block lines on the dome
		decor({
			Name = "IglooLine",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.12, 12.1 * math.cos(math.asin(math.min(0.95, (row * 1.4 + 0.6) / 6))), 12.1 * math.cos(math.asin(math.min(0.95, (row * 1.4 + 0.6) / 6)))),
			CFrame = CFrame.new(iglooCenter + Vector3.new(0, row * 1.4 + 0.1, 0)) * FLAT,
			Color = Color3.fromRGB(200, 220, 245),
			Material = Enum.Material.SmoothPlastic,
		})
	end

	-- pine trees with snowy tops
	local function pine(x, z)
		local base = at(x, 0, z)
		local height = rand:NextNumber(0.85, 1.3)
		part({
			Name = "PineTrunk",
			Size = Vector3.new(1.2, 3 * height, 1.2),
			CFrame = CFrame.new(base + Vector3.new(0, 1.5 * height, 0)),
			Color = Color3.fromRGB(90, 60, 45),
			Material = Enum.Material.Wood,
		})
		local y = 2.2 * height
		for tier = 1, 3 do
			local w = (7 - tier * 1.7) * height
			local h = 3.6 * height
			pyramid(base + Vector3.new(0, y, 0), w, h, PINE:Lerp(Color3.fromRGB(70, 130, 110), tier * 0.12), Enum.Material.Grass, tier == 1)
			pyramid(base + Vector3.new(0, y + h * 0.55, 0), w * 0.5, h * 0.45, SNOW, Enum.Material.Snow)
			y += 2.3 * height
		end
		local star = decor({
			Name = "PineLight",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			CFrame = CFrame.new(base + Vector3.new(0, y + 1.6 * height, 0)),
			Color = ICE,
			Material = Enum.Material.Neon,
		})
		addLight(star, ICE, 10, 0.8)
	end
	local pines = 0
	for _ = 1, 160 do
		if pines >= 32 then
			break
		end
		local x, z = island.RandomSpot(18, info.Radius - 7, 3)
		if x then
			pine(x, z)
			pines += 1
		end
	end

	-- snowmen
	local function snowman(x, z, facing)
		local base = at(x, 0, z)
		local look = CFrame.lookAt(base, base + facing)
		part({ Name = "SnowBall", Shape = Enum.PartType.Ball, Size = Vector3.one * 3.4, CFrame = look * CFrame.new(0, 1.4, 0), Color = SNOW, Material = Enum.Material.Snow })
		part({ Name = "SnowBall", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.5, CFrame = look * CFrame.new(0, 3.6, 0), Color = SNOW, Material = Enum.Material.Snow })
		local head = part({ Name = "SnowHead", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.8, CFrame = look * CFrame.new(0, 5.3, 0), Color = SNOW, Material = Enum.Material.Snow })
		decor({ Name = "Carrot", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.1, 0.3, 0.3), CFrame = head.CFrame * CFrame.new(0, 0, -1.2) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(255, 140, 40), Material = Enum.Material.SmoothPlastic })
		for _, s in ipairs({ -0.35, 0.35 }) do
			decor({ Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.25, CFrame = head.CFrame * CFrame.new(s, 0.25, -0.82), Color = Color3.fromRGB(20, 20, 30), Material = Enum.Material.SmoothPlastic })
		end
		decor({ Name = "Scarf", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 2.1, 2.1), CFrame = look * CFrame.new(0, 4.5, 0) * FLAT, Color = Color3.fromRGB(230, 60, 80), Material = Enum.Material.Fabric })
		decor({ Name = "ScarfTail", Size = Vector3.new(0.5, 1.4, 0.2), CFrame = look * CFrame.new(0.5, 3.9, -1) * CFrame.Angles(0.2, 0, 0.15), Color = Color3.fromRGB(230, 60, 80), Material = Enum.Material.Fabric })
		decor({ Name = "Hat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 1.3, 1.3), CFrame = look * CFrame.new(0, 6.6, 0) * FLAT, Color = Color3.fromRGB(30, 30, 45), Material = Enum.Material.SmoothPlastic })
		decor({ Name = "HatBrim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 2, 2), CFrame = look * CFrame.new(0, 6.05, 0) * FLAT, Color = Color3.fromRGB(30, 30, 45), Material = Enum.Material.SmoothPlastic })
		for _, s in ipairs({ -1, 1 }) do
			decor({ Name = "StickArm", Size = Vector3.new(0.18, 0.18, 2.6), CFrame = look * CFrame.new(s * 1.9, 3.9, 0) * CFrame.Angles(0, math.rad(90), s * 0.5), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood })
		end
	end
	snowman(-14, -24, Vector3.new(0.5, 0, -1))
	snowman(20, 22, Vector3.new(-1, 0, -0.3))
	snowman(-44, 30, Vector3.new(1, 0, -0.5))
	snowman(-62, -40, Vector3.new(1, 0, 0.4))
	snowman(70, -10, Vector3.new(-1, 0, 0))

	-- ice crystal spikes
	for _ = 1, 15 do
		local x, z = island.RandomSpot(20, info.Radius - 8, 2)
		if x then
			for k = 1, rand:NextInteger(3, 5) do
				local off = (k == 1) and Vector3.zero or Vector3.new(rand:NextNumber(-2, 2), 0, rand:NextNumber(-2, 2))
				spike(at(x, 0, z) + off, rand:NextNumber(1.2, 2), (k == 1) and rand:NextNumber(6, 9) or rand:NextNumber(2.5, 5), ICE, Enum.Material.Ice, false, k == 1)
			end
			local glow = decor({ Name = "CrystalGlow", Size = Vector3.one * 0.5, CFrame = CFrame.new(at(x, 1, z)), Transparency = 1 })
			addLight(glow, ICE, 14, 1.2)
		end
	end

	-- aurora ribbons high in the sky (IslandFX makes them shimmer)
	local auroraColors = { Color3.fromRGB(90, 255, 170), Color3.fromRGB(110, 200, 255), Color3.fromRGB(190, 120, 255) }
	for band = 1, 3 do
		local ribbon = Instance.new("Model")
		ribbon.Name = "Aurora"
		local z0 = 40 + band * 22
		for i = -10, 10 do
			local x = i * 9
			local y = 75 + band * 6 + math.sin(i * 0.5 + band) * 6
			local z = z0 + math.cos(i * 0.35 + band) * 10
			decor({
				Name = "AuroraPanel",
				Size = Vector3.new(9.4, 26, 0.2),
				CFrame = CFrame.lookAt(at(x, y, z), at(x, y, z - 10)) * CFrame.Angles(0, math.sin(i * 0.4) * 0.3, 0),
				Color = auroraColors[band],
				Material = Enum.Material.Neon,
				Transparency = 0.7,
				Parent = ribbon,
			}):SetAttribute("Phase", i * 0.45 + band)
		end
		ribbon.Parent = island.Model
		fx(ribbon, { FX_Aurora = true })
	end

	-- falling snow
	weather(island, {
		Rate = 70,
		Lifetime = NumberRange.new(8, 11),
		Speed = NumberRange.new(4, 6),
		Spread = Vector2.new(25, 25),
		Size = sizeSeq(0.25, 0.35, 0.2),
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		LightEmission = 0.4,
		Acceleration = Vector3.new(1.5, 0, 0.6),
		RotSpeed = NumberRange.new(-90, 90),
	})
	builtIslands[info.Key] = island
end

---------------------------------------------------------------------
-- 🔥 EMBER ISLE
---------------------------------------------------------------------
do
	local info = Config.RebirthIslands[2]
	local BASALT = Color3.fromRGB(55, 42, 42)
	local LAVA = Color3.fromRGB(255, 110, 30)
	local LAVA_HOT = Color3.fromRGB(255, 200, 70)
	local OBSIDIAN = Color3.fromRGB(25, 15, 30)
	local style = {
		Ground = Color3.fromRGB(70, 52, 48), GroundMaterial = Enum.Material.Basalt,
		Rock = Color3.fromRGB(60, 40, 38), RockDark = Color3.fromRGB(35, 24, 26), RockMaterial = Enum.Material.Basalt,
		Edge = LAVA, Accent = Color3.fromRGB(255, 60, 60), Accent2 = Color3.fromRGB(90, 60, 55),
		Path = Color3.fromRGB(105, 85, 78), PathMaterial = Enum.Material.Cobblestone,
		CoreName = "EMBER CORE", CoreIcon = "🔥",
		Reserved = {
			{ Vector3.new(-34, 0, 6), 22 }, -- volcano
		},
	}
	local island = makeIsland(info, style)
	local at = island.At
	local C = island.Center

	-- glowing lava drips under the island
	for i = 1, 18 do
		local a = (i / 18) * math.pi * 2
		local r = rand:NextNumber(12, info.Radius - 14)
		decor({
			Name = "LavaDrip",
			Size = Vector3.new(0.7, rand:NextNumber(10, 22), 0.7),
			CFrame = CFrame.new(at(math.cos(a) * r, -16, math.sin(a) * r)),
			Color = LAVA,
			Material = Enum.Material.Neon,
		})
	end

	-- the core: a burning orb above a fire pit
	islandCore(island, style, function(center, core)
		local orb = decor({
			Name = "FireOrb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 4,
			CFrame = CFrame.new(center),
			Color = LAVA_HOT,
			Material = Enum.Material.Neon,
			Parent = core,
		})
		local fire = Instance.new("Fire")
		fire.Size = 9
		fire.Heat = 12
		fire.Color = LAVA
		fire.SecondaryColor = Color3.fromRGB(255, 40, 20)
		fire.Parent = orb
		fx(orb, { FX_Bob = 0.6, FX_Pulse = 0.4 })
		return orb
	end)
	pathLanterns(island, style)

	-- cracked lava patches in the ground
	for _ = 1, 18 do
		local x, z = island.RandomSpot(16, info.Radius - 8, 1)
		if x then
			disc("LavaCrack", at(x, 0, z), rand:NextNumber(2.5, 5), 0.2, C.Y + 0.1, Color3.fromRGB(200, 90, 40), Enum.Material.CrackedLava)
		end
	end

	-- the volcano: stacked rock rings with a lava crater and smoke
	local volcano = Instance.new("Model")
	volcano.Name = "Volcano"
	volcano.Parent = island.Model
	local vBase = at(-34, 0, 6)
	local rings = { { 18, 4 }, { 15, 5 }, { 12, 5 }, { 9.5, 5 }, { 7.5, 4 } }
	local y = 0
	for i, ring in ipairs(rings) do
		disc("VolcanoRock", vBase, ring[1], ring[2], C.Y + y + ring[2], (i % 2 == 0) and BASALT or Color3.fromRGB(70, 50, 46), Enum.Material.Basalt, { Parent = volcano })
		y += ring[2]
	end
	local crater = disc("Crater", vBase, 5.8, 1, C.Y + y + 0.3, LAVA, Enum.Material.Neon, { Parent = volcano, CanCollide = false })
	addLight(crater, LAVA, 50, 4)
	local craterFire = Instance.new("Fire")
	craterFire.Size = 14
	craterFire.Heat = 20
	craterFire.Color = LAVA
	craterFire.SecondaryColor = Color3.fromRGB(255, 50, 20)
	craterFire.Parent = crater
	emitter(crater, {
		Texture = Config.Textures.Smoke,
		Rate = 6,
		Lifetime = NumberRange.new(6, 9),
		Speed = NumberRange.new(5, 8),
		Spread = Vector2.new(12, 12),
		Size = sizeSeq(4, 10, 16),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(Color3.fromRGB(90, 70, 70), Color3.fromRGB(40, 35, 40)),
		LightEmission = 0,
		EmissionDirection = Enum.NormalId.Right, -- the disc is turned on its side; Right = up
	})
	emitter(crater, {
		Texture = Config.Textures.Spark,
		Rate = 25,
		Lifetime = NumberRange.new(1.5, 3),
		Speed = NumberRange.new(12, 22),
		Spread = Vector2.new(30, 30),
		Size = sizeSeq(0.3, 0.5, 0),
		Acceleration = Vector3.new(0, -18, 0),
		Color = ColorSequence.new(LAVA_HOT, LAVA),
		EmissionDirection = Enum.NormalId.Right,
	}):SetAttribute("Eruption", true)
	crater:SetAttribute("FX_Eruption", true)
	-- lava streams down the sides
	for k = 1, 5 do
		local a = (k / 5) * math.pi * 2 + 0.4
		local top = vBase + Vector3.new(math.cos(a) * 6, y - 0.5, math.sin(a) * 6)
		local bottom = vBase + Vector3.new(math.cos(a) * 18.6, 0.6, math.sin(a) * 18.6)
		local mid = (top + bottom) / 2
		decor({
			Name = "LavaStream",
			Size = Vector3.new(1.4, 0.4, (top - bottom).Magnitude + 1),
			CFrame = CFrame.lookAt(mid, bottom),
			Color = LAVA,
			Material = Enum.Material.Neon,
			Parent = volcano,
		})
	end
	billboard(crater, "🌋 MOUNT EMBER", LAVA_HOT, Vector3.new(0, 12, 0), UDim2.fromOffset(300, 50))

	-- lava pools with rock rims
	for _ = 1, 5 do
		local x, z = island.RandomSpot(22, info.Radius - 12, 5)
		if x then
			local p = at(x, 0, z)
			local r = rand:NextNumber(3.5, 5)
			disc("PoolRim", p, r + 1.2, 1, C.Y + 0.6, BASALT, Enum.Material.Basalt)
			local pool = disc("LavaPool", p, r, 0.2, C.Y + 0.65, LAVA, Enum.Material.Neon, { CanCollide = false })
			addLight(pool, LAVA, 18, 2)
			emitter(pool, { Texture = Config.Textures.Fire, Rate = 6, Lifetime = NumberRange.new(0.6, 1.2), Speed = NumberRange.new(1, 3), Size = sizeSeq(0.5, 1.4, 0), Color = ColorSequence.new(LAVA_HOT, LAVA), EmissionDirection = Enum.NormalId.Right })
		end
	end

	-- geysers: vents that blast fire every few seconds (timed in IslandFX)
	for g = 1, 7 do
		local x, z = island.RandomSpot(16, info.Radius - 9, 3)
		if x then
			local p = at(x, 0, z)
			disc("GeyserVent", p, 1.8, 1, C.Y + 0.7, OBSIDIAN, Enum.Material.Glass)
			local hole = disc("GeyserHole", p, 1, 0.2, C.Y + 0.75, LAVA, Enum.Material.Neon, { CanCollide = false })
			local blast = emitter(hole, {
				Texture = Config.Textures.Fire,
				Rate = 0,
				Lifetime = NumberRange.new(0.8, 1.2),
				Speed = NumberRange.new(30, 40),
				Spread = Vector2.new(6, 6),
				Size = sizeSeq(1.2, 2.4, 0.5),
				Color = ColorSequence.new(LAVA_HOT, Color3.fromRGB(255, 60, 20)),
				EmissionDirection = Enum.NormalId.Right,
			})
			blast.Name = "Blast"
			fx(hole, { FX_Geyser = true, Phase = g * 1.3 })
		end
	end

	-- obsidian spikes
	for _ = 1, 17 do
		local x, z = island.RandomSpot(18, info.Radius - 7, 2)
		if x then
			for k = 1, rand:NextInteger(2, 4) do
				local off = (k == 1) and Vector3.zero or Vector3.new(rand:NextNumber(-2, 2), 0, rand:NextNumber(-2, 2))
				spike(at(x, 0, z) + off, rand:NextNumber(1.4, 2.4), (k == 1) and rand:NextNumber(5, 9) or rand:NextNumber(2, 4), OBSIDIAN, Enum.Material.Glass, false, k == 1)
			end
		end
	end

	-- burnt trees with glowing ember tips
	for _ = 1, 15 do
		local x, z = island.RandomSpot(18, info.Radius - 7, 3)
		if x then
			local base = at(x, 0, z)
			local h = rand:NextNumber(5, 8)
			part({ Name = "BurntTrunk", Size = Vector3.new(0.9, h, 0.9), CFrame = CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(rand:NextNumber(-0.1, 0.1), 0, rand:NextNumber(-0.1, 0.1)), Color = Color3.fromRGB(35, 25, 22), Material = Enum.Material.Wood })
			for b = 1, 3 do
				local a = rand:NextNumber(0, math.pi * 2)
				local by = h * (0.45 + b * 0.15)
				local branch = part({
					Name = "BurntBranch",
					Size = Vector3.new(0.4, 0.4, rand:NextNumber(2, 3.5)),
					CFrame = CFrame.new(base + Vector3.new(0, by, 0)) * CFrame.Angles(0, a, 0) * CFrame.Angles(math.rad(35), 0, 0) * CFrame.new(0, 0, -1.2),
					Color = Color3.fromRGB(35, 25, 22),
					Material = Enum.Material.Wood,
					CanCollide = false,
				})
				decor({ Name = "EmberTip", Size = Vector3.one * 0.35, CFrame = branch.CFrame * CFrame.new(0, 0, -branch.Size.Z / 2), Color = LAVA, Material = Enum.Material.Neon })
			end
		end
	end

	-- obsidian arch over the arrival path
	for _, s in ipairs({ -1, 1 }) do
		part({ Name = "ArchLeg", Size = Vector3.new(1.6, 11, 1.6), CFrame = CFrame.new(at(s * 5, 5.5, -32)), Color = OBSIDIAN, Material = Enum.Material.Glass })
		decor({ Name = "ArchVein", Size = Vector3.new(0.3, 10, 0.3), CFrame = CFrame.new(at(s * 5, 5.5, -32.85)), Color = LAVA, Material = Enum.Material.Neon })
	end
	part({ Name = "ArchTop", Size = Vector3.new(12, 1.6, 1.8), CFrame = CFrame.new(at(0, 11.5, -32)), Color = OBSIDIAN, Material = Enum.Material.Glass })
	local skull = decor({ Name = "ArchGem", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.6, CFrame = CFrame.new(at(0, 12.9, -32)), Color = LAVA_HOT, Material = Enum.Material.Neon })
	addLight(skull, LAVA, 18, 2)

	-- floating embers everywhere
	local embers = weather(island, {
		Texture = Config.Textures.Spark,
		Rate = 30,
		Lifetime = NumberRange.new(6, 9),
		Speed = NumberRange.new(1, 3),
		Spread = Vector2.new(60, 60),
		Size = sizeSeq(0.15, 0.3, 0),
		Color = ColorSequence.new(LAVA_HOT, LAVA),
		Acceleration = Vector3.new(0.5, 1.2, 0),
		EmissionDirection = Enum.NormalId.Top,
	})
	embers.CFrame = CFrame.new(at(0, 2, 0))
	builtIslands[info.Key] = island
end

---------------------------------------------------------------------
-- 💠 NEON NEXUS
---------------------------------------------------------------------
do
	local info = Config.RebirthIslands[3]
	local PINK = Color3.fromRGB(255, 70, 220)
	local CYAN = Color3.fromRGB(60, 230, 255)
	local PURPLE = Color3.fromRGB(140, 80, 255)
	local DARK = Color3.fromRGB(18, 12, 32)
	local style = {
		Ground = DARK, GroundMaterial = Enum.Material.SmoothPlastic,
		Rock = Color3.fromRGB(35, 22, 60), RockDark = Color3.fromRGB(22, 14, 40), RockMaterial = Enum.Material.SmoothPlastic,
		Edge = PINK, Accent = CYAN, Accent2 = Color3.fromRGB(60, 40, 100),
		TrimMaterial = Enum.Material.Glass,
		Path = Color3.fromRGB(45, 30, 80), PathMaterial = Enum.Material.Glass,
		CoreName = "NEXUS CORE", CoreIcon = "💠",
	}
	local island = makeIsland(info, style)
	local at = island.At

	-- neon grid floor (lines clipped to the circle)
	for i = -9, 9 do
		local d = i * 10
		local half = math.sqrt(math.max(0, (info.Radius - 1) ^ 2 - d * d))
		if half > 2 then
			decor({ Name = "GridX", Size = Vector3.new(half * 2, 0.06, 0.18), CFrame = CFrame.new(at(0, 0.04, d)), Color = (i % 2 == 0) and CYAN or PURPLE, Material = Enum.Material.Neon })
			decor({ Name = "GridZ", Size = Vector3.new(0.18, 0.06, half * 2), CFrame = CFrame.new(at(d, 0.04, 0)), Color = (i % 2 == 0) and PINK or PURPLE, Material = Enum.Material.Neon })
		end
	end
	-- neon rings on the underside
	for k = 1, 4 do
		ringModel("UnderRing", at(0, -4 - k * 7, 0), info.Radius - 8 - k * 12, 60, 0.5, (k % 2 == 0) and PINK or CYAN, island.Model)
	end

	-- the core: a spinning crystal (two pyramids) in a cage of rings
	islandCore(island, style, function(center, core)
		local gem = Instance.new("Model")
		gem.Name = "NexusGem"
		local heart = decor({ Name = "Heart", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.6, CFrame = CFrame.new(center), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, Parent = gem })
		for k = 0, 3 do
			for _, flip in ipairs({ false, true }) do
				local cf = CFrame.new(center) * (flip and CFrame.Angles(math.pi, 0, 0) or CFrame.new()) * CFrame.Angles(0, k * math.pi / 2, 0) * CFrame.new(0, 2, -1)
				decor({ ClassName = "WedgePart", Name = "Facet", Size = Vector3.new(4, 4, 2), CFrame = cf, Color = flip and PURPLE or PINK, Material = Enum.Material.Glass, Transparency = 0.2, Parent = gem })
			end
		end
		gem.WorldPivot = CFrame.new(center)
		gem.Parent = core
		fx(gem, { FX_Spin = Vector3.new(0, 1.1, 0), FX_Bob = 0.8 })
		return heart
	end)
	pathLanterns(island, style)

	-- holo towers
	local towerSpots = { { 30, -30 }, { 44, 8 }, { -44, -12 }, { -30, 30 }, { 22, 40 }, { -48, 16 }, { -70, -45 }, { 75, 30 }, { -72, 50 }, { 40, 72 }, { -20, -70 } }
	for i, spot in ipairs(towerSpots) do
		local x, z = spot[1], spot[2]
		if island.Free(x, z, 2) then
			local h = rand:NextNumber(18, 34)
			local w = rand:NextNumber(5, 7)
			local base = at(x, 0, z)
			local color = (i % 2 == 0) and PINK or CYAN
			part({ Name = "Tower", Size = Vector3.new(w, h, w), CFrame = CFrame.new(base + Vector3.new(0, h / 2, 0)), Color = Color3.fromRGB(25, 18, 45), Material = Enum.Material.Glass, Reflectance = 0.15 })
			for row = 3, h - 2, 3 do -- window strips
				for _, face in ipairs({ 0, 1, 2, 3 }) do
					decor({
						Name = "Window",
						Size = Vector3.new(w * 0.7, 0.35, 0.1),
						CFrame = CFrame.new(base + Vector3.new(0, row, 0)) * CFrame.Angles(0, face * math.pi / 2, 0) * CFrame.new(0, 0, -w / 2 - 0.06),
						Color = (rand:NextNumber() < 0.75) and color or Color3.fromRGB(255, 240, 150),
						Material = Enum.Material.Neon,
					})
				end
			end
			decor({ Name = "TowerEdge", Size = Vector3.new(w + 0.3, 0.4, w + 0.3), CFrame = CFrame.new(base + Vector3.new(0, h, 0)), Color = color, Material = Enum.Material.Neon })
			local antenna = decor({ Name = "Antenna", Size = Vector3.new(0.3, 6, 0.3), CFrame = CFrame.new(base + Vector3.new(0, h + 3, 0)), Color = Color3.fromRGB(80, 80, 100), Material = Enum.Material.Metal })
			local blink = decor({ Name = "AntennaLight", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.8, CFrame = antenna.CFrame * CFrame.new(0, 3.2, 0), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon })
			fx(blink, { FX_Blink = true, Phase = i })
			fx(ringModel("HoloRing", base + Vector3.new(0, h + 2.5, 0), w * 0.8, 24, 0.25, color, island.Model), { FX_Spin = Vector3.new(0, (i % 2 == 0) and 1 or -1, 0) })
			addLight(blink, color, 30, 2)
		end
	end

	-- neon palm trees
	for _ = 1, 15 do
		local x, z = island.RandomSpot(16, info.Radius - 8, 3)
		if x then
			local base = at(x, 0, z)
			local lean = rand:NextNumber(-0.25, 0.25)
			local cf = CFrame.new(base) * CFrame.Angles(lean, rand:NextNumber(0, 6), 0)
			for seg = 0, 5 do
				decor({ Name = "PalmTrunk", Size = Vector3.new(0.9, 1.4, 0.9), CFrame = cf * CFrame.new(0, 0.7 + seg * 1.35, 0) * CFrame.Angles(0, seg * 0.4, 0), Color = Color3.fromRGB(40, 25, 70), Material = Enum.Material.SmoothPlastic })
				decor({ Name = "PalmRing", Size = Vector3.new(1, 0.12, 1), CFrame = cf * CFrame.new(0, 1.35 + seg * 1.35, 0), Color = CYAN, Material = Enum.Material.Neon })
			end
			local top = cf * CFrame.new(0, 8.3, 0)
			for leaf = 1, 6 do
				decor({
					Name = "PalmLeaf",
					Size = Vector3.new(0.9, 0.15, 4.5),
					CFrame = top * CFrame.Angles(0, leaf * math.pi / 3, 0) * CFrame.Angles(math.rad(-25), 0, 0) * CFrame.new(0, 0, -2.1),
					Color = PINK,
					Material = Enum.Material.Neon,
				})
			end
			part({ Name = "PalmHitbox", Size = Vector3.new(1, 8, 1), CFrame = cf * CFrame.new(0, 4, 0), Transparency = 1 })
		end
	end

	-- floating cubes
	for i = 1, 20 do
		local a = (i / 20) * math.pi * 2
		local r = rand:NextNumber(22, 85)
		local s = rand:NextNumber(1.5, 3)
		local cube = decor({
			Name = "FloatCube",
			Size = Vector3.one * s,
			CFrame = CFrame.new(at(math.cos(a) * r, rand:NextNumber(12, 24), math.sin(a) * r)),
			Color = ({ PINK, CYAN, PURPLE })[(i % 3) + 1],
			Material = Enum.Material.Neon,
			Transparency = 0.15,
		})
		fx(cube, { FX_Spin = Vector3.new(rand:NextNumber(-1, 1), rand:NextNumber(0.5, 1.5), rand:NextNumber(-1, 1)), FX_Bob = 1.5 })
	end

	-- the giant striped synthwave sun behind the parkour
	local sunCF = CFrame.lookAt(at(0, 60, 230), at(0, 60, 0))
	local sun = decor({
		Name = "SynthSun",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 110, 110),
		CFrame = sunCF * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(255, 120, 90),
		Material = Enum.Material.Neon,
	})
	local glow = Instance.new("SurfaceLight") -- warm glow on the island
	glow.Face = Enum.NormalId.Right
	glow.Range = 60
	glow.Brightness = 0.5
	glow.Color = Color3.fromRGB(255, 120, 160)
	glow.Parent = sun
	for k = 1, 6 do
		local y = -10 - k * 6.5
		local half = math.sqrt(math.max(0, 55 ^ 2 - y ^ 2))
		decor({
			Name = "SunStripe",
			Size = Vector3.new(half * 2 + 2, 1 + k * 0.5, 0.5),
			CFrame = sunCF * CFrame.new(0, y, -1),
			Color = Color3.fromRGB(30, 10, 45),
			Material = Enum.Material.SmoothPlastic,
		})
	end
	decor({ Name = "SunTop", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 112, 112), CFrame = sunCF * CFrame.new(0, 0, 0.6) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(255, 220, 90), Material = Enum.Material.Neon, Transparency = 0.6 })

	-- digital rain of sparkles
	weather(island, {
		Rate = 40,
		Lifetime = NumberRange.new(4, 6),
		Speed = NumberRange.new(8, 12),
		Spread = Vector2.new(0, 0),
		Size = sizeSeq(0.2, 0.25, 0.1),
		Color = ColorSequence.new(CYAN, PINK),
		RotSpeed = NumberRange.new(0, 0),
	})
	builtIslands[info.Key] = island
end

---------------------------------------------------------------------
-- ⭐ THE REBIRTH GATE (on the main island)
---------------------------------------------------------------------
local gate = Instance.new("Model")
gate.Name = "RebirthGate"
gate.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
gate.Parent = folder
currentParent = gate

local G = Config.Places.RebirthGate
local GOLD = Color3.fromRGB(255, 210, 90)
local toSpawn = Vector3.new(-G.X, 0, -G.Z).Unit
local baseAngle = math.atan2(-toSpawn.Z, -toSpawn.X) -- portals stand on the far side

disc("GateFloor", G, 13, 0.6, 0.3, Color3.fromRGB(45, 38, 75), Enum.Material.Marble)
ringModel("GateRing", G + Vector3.new(0, 0.36, 0), 12.4, 72, 0.35, GOLD, gate)
ringModel("GateRingInner", G + Vector3.new(0, 0.36, 0), 7, 48, 0.25, Color3.fromRGB(150, 120, 255), gate)

-- center: a pedestal with a floating star (press E to open the rebirth menu)
local pedestal = part({
	Name = "RebirthPedestal",
	Shape = Enum.PartType.Cylinder,
	Size = Vector3.new(3, 2.6, 2.6),
	CFrame = CFrame.new(G + Vector3.new(0, 1.8, 0)) * FLAT,
	Color = Color3.fromRGB(70, 60, 110),
	Material = Enum.Material.Marble,
})
local prompt = Instance.new("ProximityPrompt")
prompt.Name = "RebirthAltarPrompt"
prompt.ActionText = "Rebirth"
prompt.ObjectText = "Rebirth Altar"
prompt.HoldDuration = 0
prompt.MaxActivationDistance = 10
prompt.RequiresLineOfSight = false
prompt.Parent = pedestal
local star = Instance.new("Model")
star.Name = "RebirthStar"
local starCenter = G + Vector3.new(0, 9, 0)
local starCore = decor({ Name = "StarCore", Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = CFrame.new(starCenter), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, Parent = star })
for k = 0, 4 do
	decor({
		ClassName = "WedgePart",
		Name = "StarPoint",
		Size = Vector3.new(0.6, 3, 1.6),
		CFrame = CFrame.new(starCenter) * CFrame.Angles(0, 0, k * math.pi * 2 / 5) * CFrame.new(0, 2.2, 0),
		Color = GOLD,
		Material = Enum.Material.Neon,
		Parent = star,
	})
end
star.WorldPivot = CFrame.new(starCenter)
star.Parent = gate
fx(star, { FX_Spin = Vector3.new(0, 1, 0), FX_Bob = 0.5 })
addLight(starCore, GOLD, 30, 2.5)
emitter(starCore, { Rate = 12, Color = ColorSequence.new(GOLD, Color3.fromRGB(150, 120, 255)), Size = sizeSeq(0, 0.6, 0), Speed = NumberRange.new(1, 3) })
billboard(starCore, "⭐ REBIRTH ALTAR", GOLD, Vector3.new(0, 4.5, 0), UDim2.fromOffset(320, 52))

-- the three portals
local gatePortals = {} -- { Zone, Island info, Exit }
for index, info in ipairs(Config.RebirthIslands) do
	local angle = baseAngle + (index - 2) * math.rad(60)
	local spot = G + Vector3.new(math.cos(angle) * 10, 0, math.sin(angle) * 10)
	local portalCF = CFrame.lookAt(spot + Vector3.new(0, 5.4, 0), G + Vector3.new(0, 5.4, 0))
	local holder = Instance.new("Model")
	holder.Name = "Portal_" .. info.Key
	holder.Parent = gate
	currentParent = holder
	-- frame: two pillars + a top beam
	for _, s in ipairs({ -1, 1 }) do
		part({ Name = "PortalPillar", Size = Vector3.new(1.2, 10, 1.2), CFrame = portalCF * CFrame.new(s * 4.8, -0.4, 0), Color = Color3.fromRGB(60, 50, 95), Material = Enum.Material.Marble })
		local gem = decor({ Name = "PillarGem", Size = Vector3.one * 1.1, CFrame = portalCF * CFrame.new(s * 4.8, 5.3, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color = info.Color, Material = Enum.Material.Neon })
		fx(gem, { FX_Spin = Vector3.new(0, 1.5, 0) })
	end
	part({ Name = "PortalBeam", Size = Vector3.new(11, 1, 1.4), CFrame = portalCF * CFrame.new(0, 4.8, 0), Color = Color3.fromRGB(60, 50, 95), Material = Enum.Material.Marble })
	portalRing("PortalRing", portalCF, 3.9, 32, 0.55, info.Color, holder)
	fx(portalRing("PortalRingOuter", portalCF, 4.5, 36, 0.25, GOLD, holder), { FX_Spin = Vector3.new(0, 0, 0.7) })
	local swirl = decor({
		Name = "PortalSwirl",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 7.6, 7.6),
		CFrame = portalCF * CFrame.Angles(0, math.rad(90), 0),
		Color = info.Color,
		Material = Enum.Material.Neon,
		Transparency = 0.45,
	})
	emitter(swirl, { Rate = 10, Color = ColorSequence.new(info.Color, Color3.new(1, 1, 1)), Size = sizeSeq(0, 0.5, 0) })
	addLight(swirl, info.Color, 16, 1.6)
	-- a see-through lock pane (IslandFX hides it once you've unlocked it)
	local lock = decor({
		Name = "LockPane",
		Size = Vector3.new(8, 8, 0.3),
		CFrame = portalCF * CFrame.new(0, 0, -0.4),
		Color = Color3.fromRGB(40, 30, 60),
		Material = Enum.Material.ForceField,
		Transparency = 0.2,
	})
	lock:SetAttribute("NeedRebirths", info.Rebirths)
	local sign = billboard(swirl, ("%s <b>%s</b>\nALL luck x%s • Rebirth %d"):format(info.Icon, info.Name:upper(), tostring(info.LuckMultiplier), info.Rebirths),
		info.Color, Vector3.new(0, 6.6, 0), UDim2.fromOffset(300, 70), 120)
	sign.Name = "PortalSign"
	sign:SetAttribute("NeedRebirths", info.Rebirths)
	local zone = part({
		Name = "PortalZone",
		Size = Vector3.new(7, 8, 2.5),
		CFrame = portalCF,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	local exitSpot = (portalCF * CFrame.new(0, 0, -5.5)).Position
	exitSpot = Vector3.new(exitSpot.X, 3, exitSpot.Z)
	table.insert(gatePortals, {
		Zone = zone,
		Info = info,
		Exit = CFrame.lookAt(exitSpot, exitSpot + (exitSpot - spot) * Vector3.new(1, 0, 1)),
	})
end
currentParent = gate

-- gate sign facing the spawn
local gateSign = decor({ Name = "GateSignAnchor", Size = Vector3.one, CFrame = CFrame.new(G + toSpawn * 12 + Vector3.new(0, 1, 0)), Transparency = 1 })
billboard(gateSign, "⭐ REBIRTH GATE", GOLD, Vector3.new(0, 4, 0), UDim2.fromOffset(340, 56), 150)

folder.Parent = workspace

---------------------------------------------------------------------
-- PORTAL LOGIC
---------------------------------------------------------------------
local busy = {}
local deniedAt = {}

local function rebirthsOf(player)
	return player:GetAttribute("Rebirths") or 0
end

local function teleport(player, destination)
	if busy[player] then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or character:GetAttribute("InDuel") then
		return
	end
	busy[player] = true
	PortalFXRemote:FireClient(player, "Out")
	task.wait(0.35)
	if character.Parent then
		root.AssemblyLinearVelocity = Vector3.zero
		character:PivotTo(destination)
	end
	PortalFXRemote:FireClient(player, "In")
	task.wait(1.5)
	busy[player] = nil
end

local function enterGatePortal(player, portal)
	if rebirthsOf(player) >= portal.Info.Rebirths then
		task.spawn(teleport, player, builtIslands[portal.Info.Key].Arrival)
	elseif os.clock() - (deniedAt[player] or 0) > 3 then
		deniedAt[player] = os.clock()
		PortalFXRemote:FireClient(player, "DeniedRebirth", { Name = portal.Info.Name, Need = portal.Info.Rebirths })
	end
end

local function inZone(zone, position)
	local localPos = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z
end

local function addPrompt(zone, objectText, onTriggered)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = "Travel"
	p.ObjectText = objectText
	p.HoldDuration = 0
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.Parent = zone
	p.Triggered:Connect(onTriggered)
end

local MAIN_RETURN = {} -- [key] = where you come out on the main island
for _, portal in ipairs(gatePortals) do
	MAIN_RETURN[portal.Info.Key] = portal.Exit
	addPrompt(portal.Zone, ("%s (ALL luck x%s)"):format(portal.Info.Name, tostring(portal.Info.LuckMultiplier)), function(player)
		enterGatePortal(player, portal)
	end)
end
for key, island in pairs(builtIslands) do
	addPrompt(island.ReturnZone, "Back to Cosmic Island", function(player)
		task.spawn(teleport, player, MAIN_RETURN[key])
	end)
end

local function islandAt(position)
	for _, info in ipairs(Config.RebirthIslands) do
		local offset = position - info.Center
		local flat = Vector3.new(offset.X, 0, offset.Z)
		if flat.Magnitude < info.Radius + 8 and offset.Y > -20 and offset.Y < 90 then
			return info
		end
	end
	return nil
end

task.spawn(function()
	local loops = 0
	while true do
		task.wait(0.1)
		loops += 1
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and not busy[player] then
				for _, portal in ipairs(gatePortals) do
					if inZone(portal.Zone, root.Position) then
						enterGatePortal(player, portal)
					end
				end
				for key, island in pairs(builtIslands) do
					if inZone(island.ReturnZone, root.Position) then
						task.spawn(teleport, player, MAIN_RETURN[key])
					end
				end
			end
			if loops % 5 == 0 then
				local info = root and islandAt(root.Position)
				if info and rebirthsOf(player) < info.Rebirths and not busy[player] then
					task.spawn(teleport, player, CFrame.new(Vector3.new(0, 3, 0))) -- not unlocked yet
					info = nil
				end
				local key = info and info.Key or nil
				if player:GetAttribute("OnRebirthIsland") ~= key then
					player:SetAttribute("OnRebirthIsland", key)
				end
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	busy[player] = nil
	deniedAt[player] = nil
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="21">
      <Properties>
        <string name="Name">RollService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- RollService (Script in ServerScriptService)
-- The "brain" of rolling: picks auras, stores inventories, saves data,
-- checks game passes, sells luck boosts and tells everyone about rare rolls.
-- Everything important happens here so exploiters can't fake rolls.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage:WaitForChild("CosmicConfig"))
local AuraData = require(ReplicatedStorage:WaitForChild("AuraData"))
local Luck = require(ReplicatedStorage:WaitForChild("Luck"))
local Rebirth = require(ReplicatedStorage:WaitForChild("Rebirth"))
local PetData = require(ReplicatedStorage:WaitForChild("PetData"))
local QuestData = require(ReplicatedStorage:WaitForChild("QuestData"))

---------------------------------------------------------------------
-- Remotes (created here so you don't have to make them by hand)
---------------------------------------------------------------------
local remotes = ReplicatedStorage:FindFirstChild("CosmicRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "CosmicRemotes"
	remotes.Parent = ReplicatedStorage
end

local function getRemote(className, name)
	local remote = remotes:FindFirstChild(name)
	if not remote then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = remotes
	end
	return remote
end

local RollRemote = getRemote("RemoteFunction", "Roll")
local GetDataRemote = getRemote("RemoteFunction", "GetData")
local EquipRemote = getRemote("RemoteEvent", "Equip")
local DataUpdatedRemote = getRemote("RemoteEvent", "DataUpdated")
local AnnounceRemote = getRemote("RemoteEvent", "Announce")
local RollFXRemote = getRemote("RemoteEvent", "RollFX") -- server -> everyone: show roll effects
local RevealRemote = getRemote("RemoteEvent", "Reveal") -- roller -> server: "my reveal animation finished"
local RebirthRemote = getRemote("RemoteFunction", "Rebirth") -- player asks to rebirth
local HatchRemote = getRemote("RemoteFunction", "HatchEgg") -- player hatches an egg
local PetRemote = getRemote("RemoteFunction", "PetAction") -- equip / unequip pets
local QuestRemote = getRemote("RemoteFunction", "Quest") -- daily reward + quests
local QuestUpdatedRemote = getRemote("RemoteEvent", "QuestUpdated") -- server -> player: quest progress
local SaveSettingsRemote = getRemote("RemoteEvent", "SaveSettings") -- player's sound settings

---------------------------------------------------------------------
-- Data saving
---------------------------------------------------------------------
local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[CosmicRNG] DataStore unavailable, progress will not save:", result)
	end
end

local sessions = {} -- [player] = data table
local canSave = {} -- [player] = true only if loading worked
local lastRollTime = {} -- [player] = os.clock()
local pendingReveal = {} -- [player] = aura name waiting to be shown to everyone
local rng = Random.new()

local function newData()
	return {
		Version = 1,
		Rolls = 0,
		Inventory = {}, -- [auraName] = how many you've rolled
		Equipped = "",
		BestChance = 0,
		PersonalLuckEnd = 0, -- potion end time (seconds since 1970)
		DuelWins = 0, -- player-vs-player duel wins
		Rebirths = 0,
		RebirthRolls = 0, -- rolls since your last rebirth
		RebirthBest = 0, -- rarest aura (chance) rolled since your last rebirth
		Pets = {}, -- [petName] = how many you own
		EquippedPets = {}, -- list of pet names (max PetData.MaxEquipped)
		BoostRolls = 0, -- Cosmic Rolls waiting (x50 luck on the next roll)
		PermanentLuck = 1, -- from the Limited Offer
		LimitedBought = "", -- which Limited Offer pack this player bought
		Daily = { Streak = 0, LastClaimDay = -1 }, -- daily login reward
		Quests = { Day = -1, List = {}, Bonus = false }, -- today's quests
		Settings = { Music = 1, Sfx = 1, Muted = false }, -- sound sliders
		Receipts = {}, -- recent purchase IDs, so nothing is granted twice
	}
end

local function keyFor(player)
	return "Player_" .. player.UserId
end

local function loadData(player)
	if not store then
		return newData(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			local data = newData()
			if type(result) == "table" then
				for key, value in pairs(result) do
					data[key] = value
				end
			end
			return data, true
		end
		warn(("[CosmicRNG] Load failed for %s (attempt %d): %s"):format(player.Name, attempt, tostring(result)))
		task.wait(attempt)
	end
	-- Loading failed: play without saving so we never wipe real progress.
	return newData(), false
end

local function saveData(player)
	local data = sessions[player]
	if not store or not data or not canSave[player] then
		return false
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:SetAsync(keyFor(player), data, { player.UserId })
		end)
		if ok then
			return true
		end
		warn(("[CosmicRNG] Save failed for %s (attempt %d): %s"):format(player.Name, attempt, tostring(err)))
		task.wait(attempt)
	end
	return false
end

---------------------------------------------------------------------
-- Game passes
---------------------------------------------------------------------
local passIdToKey = {}
for key, id in pairs(Config.GamePasses) do
	if id ~= 0 then
		passIdToKey[id] = key
	end
end

local function checkPass(player, key)
	local id = Config.GamePasses[key]
	if not id or id == 0 then
		return RunService:IsStudio() and Config.FreePassesInStudio
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
	end)
	return ok and owns or false
end

local function hasPass(player, key)
	return player:GetAttribute("Pass_" .. key) == true
end

-- Things a pass gives that you can also earn by rebirthing
local function rebirthGrants(player, key)
	if key == "AutoRoll" then
		return Rebirth.HasPerk(player:GetAttribute("Rebirths") or 0, "Free Auto Roll")
	end
	return false
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	local key = passIdToKey[passId]
	if purchased and key then
		player:SetAttribute("Pass_" .. key, true)
		player:SetAttribute("Owns_" .. key, true)
	end
end)

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
local function snapshot(data)
	return {
		Rolls = data.Rolls,
		Inventory = data.Inventory,
		Equipped = data.Equipped,
		BestChance = data.BestChance,
		Pets = data.Pets,
		EquippedPets = data.EquippedPets,
		Settings = data.Settings,
	}
end

local function applyAuraToCharacter(player)
	local data = sessions[player]
	local character = player.Character
	if data and character then
		character:SetAttribute("Aura", data.Equipped ~= "" and data.Equipped or nil)
	end
end

local function refreshStats(player)
	local data = sessions[player]
	if not data then
		return
	end
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Rolls.Value = data.Rolls
		stats.Aura.Value = data.Equipped ~= "" and data.Equipped or "-"
		stats.Wins.Value = data.DuelWins or 0
		stats.Rebirths.Value = data.Rebirths or 0
	end
	player:SetAttribute("Rolls", data.Rolls)
	player:SetAttribute("Rebirths", data.Rebirths or 0)
	player:SetAttribute("RebirthRolls", data.RebirthRolls or 0)
	player:SetAttribute("RebirthBest", data.RebirthBest or 0)
	player:SetAttribute("PetLuck", PetData.LuckFrom(data.EquippedPets))
	player:SetAttribute("EquippedPets", table.concat(data.EquippedPets or {}, ","))
	player:SetAttribute("BoostRolls", data.BoostRolls or 0)
	player:SetAttribute("PermanentLuck", data.PermanentLuck or 1)
	player:SetAttribute("LimitedBought", data.LimitedBought or "")
	-- perks that unlock passes
	for key in pairs(Config.GamePasses) do
		if rebirthGrants(player, key) and not player:GetAttribute("Pass_" .. key) then
			player:SetAttribute("Pass_" .. key, true)
		end
	end
	player:SetAttribute("EquippedAura", data.Equipped)
	player:SetAttribute("BestChance", data.BestChance)
end

-- quests are filled in further down (rolling, hatching... report progress)
local addQuestProgress = function(_player, _kind, _amount, _extra) end

---------------------------------------------------------------------
-- Rolling
---------------------------------------------------------------------
RollRemote.OnServerInvoke = function(player)
	local data = sessions[player]
	if not data then
		return { Error = "Loading" }
	end
	if player:GetAttribute("InDuel") then
		return { Error = "InDuel" }
	end

	local cooldown = hasPass(player, "QuickRoll") and Config.QuickRollCooldown or Config.RollCooldown
	cooldown *= Rebirth.CooldownScale(data.Rebirths or 0)
	local now = os.clock()
	-- small grace window for network jitter
	if now - (lastRollTime[player] or 0) < cooldown - 0.1 then
		return { Error = "Cooldown" }
	end
	lastRollTime[player] = now

	local rollNumber = data.Rolls + 1
	local lucky = rollNumber % Luck.LuckyEvery(player) == 0
	local luck = Luck.Get(player) * (lucky and Config.LuckyRollMultiplier or 1)
	-- a Cosmic Roll (from the Cosmic Drop) is used up by this roll
	local boosted = (data.BoostRolls or 0) > 0
	if boosted then
		data.BoostRolls -= 1
	end
	local count = hasPass(player, "MultiRoll") and Config.MultiRollCount or 1

	local results = {}
	local best
	for _ = 1, count do
		local aura = AuraData.RollRandom(luck, rng)
		table.insert(results, aura.Name)
		data.Inventory[aura.Name] = (data.Inventory[aura.Name] or 0) + 1
		if not best or aura.Chance > best.Chance then
			best = aura
		end
		if aura.Chance >= Config.AnnounceAtChance then
			AnnounceRemote:FireAllClients({
				Type = "Roll",
				PlayerName = player.DisplayName,
				UserId = player.UserId,
				Aura = aura.Name,
			})
		end
	end
	-- Best result first, the rest sorted rarest first
	table.sort(results, function(a, b)
		return AuraData.Get(a).Chance > AuraData.Get(b).Chance
	end)

	data.Rolls = rollNumber
	data.RebirthRolls = (data.RebirthRolls or 0) + 1
	if best.Chance > (data.RebirthBest or 0) then
		data.RebirthBest = best.Chance
	end
	local isNewBest = best.Chance > data.BestChance
	if isNewBest then
		data.BestChance = best.Chance
	end
	refreshStats(player)

	-- quest progress
	addQuestProgress(player, "Rolls", 1)
	if player:GetAttribute("OnLuckyIsland") or player:GetAttribute("OnRebirthIsland") then
		addQuestProgress(player, "LuckyRolls", 1)
	end
	for _, name in ipairs(results) do
		addQuestProgress(player, "Rarity", 1, AuraData.Get(name).Chance)
	end

	-- Everyone sees this player "charging up"; the reveal comes when the
	-- roller's animation finishes (see RevealRemote below).
	pendingReveal[player] = best.Name
	RollFXRemote:FireAllClients({ Phase = "Start", UserId = player.UserId })

	return {
		Aura = best.Name,
		Results = results,
		Rolls = data.Rolls,
		Lucky = lucky,
		Boosted = boosted,
		Luck = luck,
		IsNewBest = isNewBest,
		IsFirstTime = data.Inventory[best.Name] == 1,
		Inventory = data.Inventory,
	}
end

RevealRemote.OnServerEvent:Connect(function(player)
	local auraName = pendingReveal[player]
	if not auraName then
		return
	end
	pendingReveal[player] = nil
	RollFXRemote:FireAllClients({ Phase = "Reveal", UserId = player.UserId, Aura = auraName })
end)

GetDataRemote.OnServerInvoke = function(player)
	local data = sessions[player]
	if not data then
		return nil
	end
	return snapshot(data)
end

EquipRemote.OnServerEvent:Connect(function(player, auraName)
	local data = sessions[player]
	if not data or type(auraName) ~= "string" or player:GetAttribute("InDuel") then
		return
	end
	if auraName ~= "" then
		if not AuraData.Get(auraName) or (data.Inventory[auraName] or 0) <= 0 then
			return -- you can't equip something you don't own
		end
	end
	data.Equipped = auraName
	applyAuraToCharacter(player)
	refreshStats(player)
	DataUpdatedRemote:FireClient(player, snapshot(data))
end)

---------------------------------------------------------------------
-- Rebirth: needs enough rolls + one rare aura since the last rebirth.
-- You keep your auras; the rebirth counters start again from zero.
---------------------------------------------------------------------
local rebirthBusy = {}
RebirthRemote.OnServerInvoke = function(player)
	local data = sessions[player]
	if not data then
		return { Error = "Loading" }
	end
	if rebirthBusy[player] or player:GetAttribute("InDuel") then
		return { Error = "Busy" }
	end
	local n = data.Rebirths or 0
	local cost = Rebirth.Cost(n)
	if (data.RebirthRolls or 0) < cost.Rolls or (data.RebirthBest or 0) < cost.Rarity then
		return { Error = "NotReady" }
	end
	rebirthBusy[player] = true
	data.Rebirths = n + 1
	data.RebirthRolls = 0
	data.RebirthBest = 0
	refreshStats(player)
	AnnounceRemote:FireAllClients({
		Type = "Rebirth",
		PlayerName = player.DisplayName,
		UserId = player.UserId,
		Rebirths = data.Rebirths,
	})
	task.spawn(saveData, player)
	task.delay(1, function()
		rebirthBusy[player] = nil
	end)
	local unlocked = {}
	for _, perk in ipairs(Rebirth.PerksAt(data.Rebirths)) do
		table.insert(unlocked, perk.Name)
	end
	return { Rebirths = data.Rebirths, Unlocked = unlocked }
end



-- sound settings are saved so they're the same next time you play
SaveSettingsRemote.OnServerEvent:Connect(function(player, settings)
	local data = sessions[player]
	if not data or type(settings) ~= "table" then
		return
	end
	local function level(value, fallback)
		return (type(value) == "number" and value == value) and math.clamp(value, 0, 1) or fallback
	end
	local old = data.Settings or {}
	data.Settings = {
		Music = level(settings.Music, old.Music or 1),
		Sfx = level(settings.Sfx, old.Sfx or 1),
		Muted = settings.Muted == true,
	}
end)

---------------------------------------------------------------------
-- QUESTS + DAILY REWARD
---------------------------------------------------------------------
local function grantReward(player, data, reward)
	if reward.Potion then
		local from = math.max(Luck.Now(), data.PersonalLuckEnd or 0)
		data.PersonalLuckEnd = from + reward.Potion * 60
		player:SetAttribute("PersonalLuckEnd", data.PersonalLuckEnd)
	end
	if reward.BoostRolls then
		data.BoostRolls = (data.BoostRolls or 0) + reward.BoostRolls
	end
	if reward.Aura and AuraData.Get(reward.Aura) then
		data.Inventory[reward.Aura] = (data.Inventory[reward.Aura] or 0) + (reward.Count or 1)
		local aura = AuraData.Get(reward.Aura)
		if aura.Chance > data.BestChance then
			data.BestChance = aura.Chance
		end
	end
	refreshStats(player)
	DataUpdatedRemote:FireClient(player, snapshot(data))
end

-- make sure the player has today's quests (new ones after midnight UTC)
local function ensureQuests(data)
	local today = QuestData.Today()
	data.Quests = data.Quests or { Day = -1, List = {}, Bonus = false }
	data.Daily = data.Daily or { Streak = 0, LastClaimDay = -1 }
	if data.Quests.Day ~= today then
		local list = {}
		for _, id in ipairs(QuestData.QuestsFor(today)) do
			table.insert(list, { Id = id, Progress = 0, Claimed = false })
		end
		data.Quests = { Day = today, List = list, Bonus = false }
	end
	return today
end

local function dailyInfo(data, today)
	local daily = data.Daily
	local canClaim = daily.LastClaimDay ~= today
	local nextStreak = (daily.LastClaimDay == today - 1) and (daily.Streak + 1) or 1
	if not canClaim then
		nextStreak = daily.Streak -- already claimed today: show today's tile
	end
	return {
		CanClaim = canClaim,
		Streak = daily.Streak,
		DayIndex = ((nextStreak - 1) % #QuestData.DailyRewards) + 1,
	}
end

local function questState(data)
	local today = ensureQuests(data)
	local quests = {}
	local allDone = true
	for _, q in ipairs(data.Quests.List) do
		local def = QuestData.ById[q.Id]
		if def then
			local done = q.Progress >= def.Goal
			allDone = allDone and done and q.Claimed
			table.insert(quests, { Id = q.Id, Progress = q.Progress, Goal = def.Goal, Claimed = q.Claimed, Done = done })
		end
	end
	return {
		Daily = dailyInfo(data, today),
		Quests = quests,
		BonusReady = allDone and not data.Quests.Bonus,
		BonusClaimed = data.Quests.Bonus,
		ResetIn = QuestData.SecondsToReset(),
	}
end

-- how many things are waiting to be claimed (the red dot on the menu button)
local function pushQuests(player)
	local data = sessions[player]
	if not data then
		return
	end
	local state = questState(data)
	local ready = state.Daily.CanClaim and 1 or 0
	for _, q in ipairs(state.Quests) do
		if q.Done and not q.Claimed then
			ready += 1
		end
	end
	if state.BonusReady then
		ready += 1
	end
	player:SetAttribute("QuestsReady", ready)
	QuestUpdatedRemote:FireClient(player, state)
end

addQuestProgress = function(player, kind, amount, extra)
	local data = sessions[player]
	if not data then
		return
	end
	ensureQuests(data)
	local changed = false
	for _, q in ipairs(data.Quests.List) do
		local def = QuestData.ById[q.Id]
		if def and def.Kind == kind and not q.Claimed and q.Progress < def.Goal then
			if kind ~= "Rarity" or (extra or 0) >= def.Threshold then
				q.Progress = math.min(def.Goal, q.Progress + (amount or 1))
				changed = true
			end
		end
	end
	if changed then
		pushQuests(player)
	end
end

QuestRemote.OnServerInvoke = function(player, action, index)
	local data = sessions[player]
	if not data then
		return nil
	end
	local today = ensureQuests(data)
	local granted
	if action == "ClaimDaily" then
		local info = dailyInfo(data, today)
		if info.CanClaim then
			local streak = (data.Daily.LastClaimDay == today - 1) and (data.Daily.Streak + 1) or 1
			data.Daily = { Streak = streak, LastClaimDay = today }
			granted = QuestData.DailyRewards[((streak - 1) % #QuestData.DailyRewards) + 1]
		end
	elseif action == "ClaimQuest" and type(index) == "number" then
		local q = data.Quests.List[index]
		local def = q and QuestData.ById[q.Id]
		if def and not q.Claimed and q.Progress >= def.Goal then
			q.Claimed = true
			granted = def.Reward
		end
	elseif action == "ClaimBonus" then
		local state = questState(data)
		if state.BonusReady then
			data.Quests.Bonus = true
			granted = QuestData.Bonus
		end
	end
	if granted then
		grantReward(player, data, granted)
	end
	pushQuests(player)
	return { State = questState(data), Granted = granted }
end

-- other scripts report progress here (parkour finishes, duel wins)
do
	local events = ServerStorage:FindFirstChild("CosmicServerEvents")
	if not events then
		events = Instance.new("Folder")
		events.Name = "CosmicServerEvents"
		events.Parent = ServerStorage
	end
	local questEvent = events:FindFirstChild("QuestEvent")
	if not questEvent then
		questEvent = Instance.new("BindableEvent")
		questEvent.Name = "QuestEvent"
		questEvent.Parent = events
	end
	questEvent.Event:Connect(function(player, kind, amount)
		if typeof(player) == "Instance" and player:IsA("Player") and type(kind) == "string" then
			addQuestProgress(player, kind, amount or 1)
		end
	end)
end

-- new day while you're playing: new quests + a new daily reward
task.spawn(function()
	local lastDay = QuestData.Today()
	while true do
		task.wait(20)
		local today = QuestData.Today()
		if today ~= lastDay then
			lastDay = today
			for _, player in ipairs(Players:GetPlayers()) do
				pushQuests(player)
			end
		end
	end
end)

---------------------------------------------------------------------
-- PETS: hatch eggs by paying with auras, equip up to 3 for luck
---------------------------------------------------------------------
local hatchBusy = {}

-- the egg stand the player is hatching from must be close by
local function nearEgg(player, eggKey)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local hatcheries = workspace:FindFirstChild("PetHatcheries")
	if not root or not hatcheries then
		return false
	end
	for _, item in ipairs(hatcheries:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("EggKey") == eggKey then
			if (item.Position - root.Position).Magnitude < 24 then
				return true
			end
		end
	end
	return false
end

local function islandRebirths(islandKey)
	for _, info in ipairs(Config.RebirthIslands) do
		if info.Key == islandKey then
			return info.Rebirths
		end
	end
	return 0
end

local function removeAura(player, data, auraName, count)
	data.Inventory[auraName] = (data.Inventory[auraName] or 0) - count
	if data.Inventory[auraName] <= 0 then
		data.Inventory[auraName] = nil
		if data.Equipped == auraName then
			data.Equipped = "" -- you just spent your last one
			applyAuraToCharacter(player)
		end
	end
end

local function givePet(data, petName)
	data.Pets = data.Pets or {}
	data.Pets[petName] = (data.Pets[petName] or 0) + 1
end

HatchRemote.OnServerInvoke = function(player, eggKey)
	local data = sessions[player]
	local egg = type(eggKey) == "string" and PetData.EggByKey[eggKey]
	if not data or not egg then
		return { Error = "Unknown" }
	end
	if hatchBusy[player] then
		return { Error = "Busy" }
	end
	if (data.Rebirths or 0) < islandRebirths(egg.Island) then
		return { Error = "Locked" }
	end
	if not nearEgg(player, eggKey) then
		return { Error = "TooFar" }
	end
	local have = data.Inventory[egg.Cost.Aura] or 0
	if have < egg.Cost.Count then
		return { Error = "NotEnough", Have = have }
	end
	hatchBusy[player] = true
	removeAura(player, data, egg.Cost.Aura, egg.Cost.Count)
	local petName = PetData.Hatch(egg, rng)
	givePet(data, petName)
	-- auto-equip if there's a free slot
	data.EquippedPets = data.EquippedPets or {}
	if #data.EquippedPets < PetData.MaxEquipped then
		table.insert(data.EquippedPets, petName)
	end
	refreshStats(player)
	DataUpdatedRemote:FireClient(player, snapshot(data))
	addQuestProgress(player, "Hatch", 1)
	local pet = PetData.Get(petName)
	if pet and PetData.Rarities[pet.Rarity].Order >= 5 then
		AnnounceRemote:FireAllClients({ Type = "Pet", PlayerName = player.DisplayName, UserId = player.UserId, Pet = petName })
	end
	task.delay(0.5, function()
		hatchBusy[player] = nil
	end)
	return { Pet = petName, Pets = data.Pets, EquippedPets = data.EquippedPets }
end

local function ownedCount(data, petName)
	return (data.Pets or {})[petName] or 0
end

local function equippedCount(data, petName)
	local n = 0
	for _, name in ipairs(data.EquippedPets) do
		if name == petName then
			n += 1
		end
	end
	return n
end

PetRemote.OnServerInvoke = function(player, action, petName)
	local data = sessions[player]
	if not data or type(action) ~= "string" then
		return nil
	end
	data.EquippedPets = data.EquippedPets or {}
	if action == "Equip" and type(petName) == "string" and PetData.Get(petName) then
		if #data.EquippedPets < PetData.MaxEquipped and equippedCount(data, petName) < ownedCount(data, petName) then
			table.insert(data.EquippedPets, petName)
		end
	elseif action == "Unequip" and type(petName) == "string" then
		local index = table.find(data.EquippedPets, petName)
		if index then
			table.remove(data.EquippedPets, index)
		end
	elseif action == "EquipBest" then
		-- the luckiest pets you own
		local owned = {}
		for name, count in pairs(data.Pets or {}) do
			if PetData.Get(name) then
				for _ = 1, count do
					table.insert(owned, name)
				end
			end
		end
		table.sort(owned, function(a, b)
			return PetData.Get(a).Luck > PetData.Get(b).Luck
		end)
		data.EquippedPets = {}
		for i = 1, math.min(PetData.MaxEquipped, #owned) do
			table.insert(data.EquippedPets, owned[i])
		end
	elseif action == "UnequipAll" then
		data.EquippedPets = {}
	elseif action == "Merge" and type(petName) == "string" and PetData.Get(petName) then
		-- 3 of the same pet become 1 golden (or rainbow) pet
		local result = PetData.MergeResult(petName)
		if not result or ownedCount(data, petName) < PetData.MergeCount then
			return { Error = "CantMerge", Pets = data.Pets, EquippedPets = data.EquippedPets }
		end
		data.Pets[petName] -= PetData.MergeCount
		if data.Pets[petName] <= 0 then
			data.Pets[petName] = nil
		end
		-- if you had more of them equipped than you still own, swap in the merged pet
		local swapped = false
		while equippedCount(data, petName) > ownedCount(data, petName) do
			local index = table.find(data.EquippedPets, petName)
			if not swapped then
				data.EquippedPets[index] = result
				swapped = true
			else
				table.remove(data.EquippedPets, index)
			end
		end
		givePet(data, result)
		refreshStats(player)
		DataUpdatedRemote:FireClient(player, snapshot(data))
		addQuestProgress(player, "Merge", 1)
		return { Merged = result, Pets = data.Pets, EquippedPets = data.EquippedPets }
	end
	refreshStats(player)
	return { Pets = data.Pets, EquippedPets = data.EquippedPets }
end

---------------------------------------------------------------------
-- Cosmic Drop: the DropService tells us who grabbed the Cosmic Roll
---------------------------------------------------------------------
do
	local events = ServerStorage:FindFirstChild("CosmicServerEvents")
	if not events then
		events = Instance.new("Folder")
		events.Name = "CosmicServerEvents"
		events.Parent = ServerStorage
	end
	local grant = events:FindFirstChild("GrantBoostRoll")
	if not grant then
		grant = Instance.new("BindableEvent")
		grant.Name = "GrantBoostRoll"
		grant.Parent = events
	end
	grant.Event:Connect(function(player, amount)
		local data = sessions[player]
		if data then
			data.BoostRolls = (data.BoostRolls or 0) + (amount or 1)
			refreshStats(player)
		end
	end)
end

---------------------------------------------------------------------
-- LIMITED OFFER: when does the 7-day window end?
---------------------------------------------------------------------
task.spawn(function()
	local offer = Config.LimitedOffer
	local start = offer.StartTime
	if not start or start <= 0 then
		start = os.time()
		if store and not RunService:IsStudio() then
			-- the first live server ever remembers when the game launched
			local ok, result = pcall(function()
				local globalStore = DataStoreService:GetDataStore(Config.DataStoreName .. "_Global")
				return globalStore:UpdateAsync("LimitedOfferStart", function(old)
					return old or os.time()
				end)
			end)
			if ok and type(result) == "number" then
				start = result
			end
		end
	end
	ReplicatedStorage:SetAttribute("LimitedOfferEnds", start + offer.Days * 24 * 60 * 60)
end)

---------------------------------------------------------------------
-- Developer products (luck potions, server luck)
---------------------------------------------------------------------
local productIdToKey = {}
for key, id in pairs(Config.Products) do
	if id ~= 0 then
		productIdToKey[id] = key
	end
end

local function grantProduct(player, data, key)
	local now = Luck.Now()
	if key == "PersonalLuck" then
		local from = math.max(now, data.PersonalLuckEnd or 0)
		data.PersonalLuckEnd = from + Config.PersonalBoostMinutes * 60
		player:SetAttribute("PersonalLuckEnd", data.PersonalLuckEnd)
		return true
	elseif key == "ServerLuck" then
		local from = math.max(now, ReplicatedStorage:GetAttribute("ServerLuckEnd") or 0)
		ReplicatedStorage:SetAttribute("ServerLuckEnd", from + Config.ServerBoostMinutes * 60)
		AnnounceRemote:FireAllClients({
			Type = "ServerLuck",
			PlayerName = player.DisplayName,
			UserId = player.UserId,
		})
		return true
	elseif key == "LimitedAura" or key == "LimitedLuck" or key == "LimitedPet" then
		local function addPotion(minutes)
			local from = math.max(now, data.PersonalLuckEnd or 0)
			data.PersonalLuckEnd = from + minutes * 60
			player:SetAttribute("PersonalLuckEnd", data.PersonalLuckEnd)
		end
		if key == "LimitedAura" then
			for _, auraName in ipairs({ "Cosmic Rift", "Black Hole" }) do
				data.Inventory[auraName] = (data.Inventory[auraName] or 0) + 1
				local aura = AuraData.Get(auraName)
				if aura and aura.Chance > data.BestChance then
					data.BestChance = aura.Chance
				end
			end
			data.Equipped = "Cosmic Rift"
			applyAuraToCharacter(player)
			addPotion(120)
		elseif key == "LimitedLuck" then
			data.PermanentLuck = math.max(data.PermanentLuck or 1, 2)
			data.BoostRolls = (data.BoostRolls or 0) + 5
			addPotion(60)
		else
			givePet(data, "Cosmic Overlord")
			givePet(data, "Void Wisp")
			data.EquippedPets = data.EquippedPets or {}
			-- the new pets go straight into your best slots
			table.insert(data.EquippedPets, 1, "Void Wisp")
			table.insert(data.EquippedPets, 1, "Cosmic Overlord")
			while #data.EquippedPets > PetData.MaxEquipped do
				table.remove(data.EquippedPets)
			end
			data.BoostRolls = (data.BoostRolls or 0) + 3
		end
		data.LimitedBought = key
		refreshStats(player)
		DataUpdatedRemote:FireClient(player, snapshot(data))
		AnnounceRemote:FireAllClients({ Type = "Limited", PlayerName = player.DisplayName, UserId = player.UserId, Pack = key })
		return true
	end
	return false
end

MarketplaceService.ProcessReceipt = function(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and sessions[player]
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- try again when they rejoin
	end

	data.Receipts = data.Receipts or {}
	if table.find(data.Receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already given
	end

	local key = productIdToKey[receipt.ProductId]
	if not key or not grantProduct(player, data, key) then
		warn("[CosmicRNG] Unknown product bought:", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > 50 do
		table.remove(data.Receipts, 1)
	end
	-- Save right away so the purchase is never lost
	if canSave[player] and not saveData(player) then
		-- Roblox will retry later; undo nothing, the receipt check stops doubles
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Studio testing: products with ID 0 are granted for free so you can test
local TestProductRemote = getRemote("RemoteEvent", "TestProduct")
TestProductRemote.OnServerEvent:Connect(function(player, key)
	if not RunService:IsStudio() or not Config.FreePassesInStudio then
		return
	end
	if type(key) ~= "string" or Config.Products[key] ~= 0 then
		return
	end
	local data = sessions[player]
	if data then
		grantProduct(player, data, key)
	end
end)

---------------------------------------------------------------------
-- Duel wins (DuelService fires this when a player beats another player)
---------------------------------------------------------------------
task.spawn(function()
	local events = ServerStorage:WaitForChild("CosmicServerEvents", 30)
	local duelWin = events and events:WaitForChild("DuelWin", 30)
	if not duelWin then
		return
	end
	duelWin.Event:Connect(function(player)
		local data = sessions[player]
		if data then
			data.DuelWins = (data.DuelWins or 0) + 1
			refreshStats(player)
		end
	end)
end)

---------------------------------------------------------------------
-- Join / leave
---------------------------------------------------------------------
local function onPlayerAdded(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local rolls = Instance.new("IntValue")
	rolls.Name = "Rolls"
	rolls.Parent = stats
	local auraValue = Instance.new("StringValue")
	auraValue.Name = "Aura"
	auraValue.Value = "-"
	auraValue.Parent = stats
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	for key in pairs(Config.GamePasses) do
		task.spawn(function()
			local owns = checkPass(player, key)
			player:SetAttribute("Owns_" .. key, owns)
			-- a rebirth perk can give the same thing for free
			player:SetAttribute("Pass_" .. key, owns or rebirthGrants(player, key))
		end)
	end

	player.CharacterAdded:Connect(function()
		applyAuraToCharacter(player)
	end)

	local data, ok = loadData(player)
	if not player.Parent then
		return -- left while loading
	end
	sessions[player] = data
	canSave[player] = ok
	player:SetAttribute("PersonalLuckEnd", data.PersonalLuckEnd or 0)
	player:SetAttribute("DataLoaded", true)
	refreshStats(player)
	applyAuraToCharacter(player)
	DataUpdatedRemote:FireClient(player, snapshot(data))
	pushQuests(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	saveData(player)
	sessions[player] = nil
	canSave[player] = nil
	lastRollTime[player] = nil
	pendingReveal[player] = nil
	rebirthBusy[player] = nil
	hatchBusy[player] = nil
end)

game:BindToClose(function()
	local threads = {}
	for _, player in ipairs(Players:GetPlayers()) do
		table.insert(threads, task.spawn(saveData, player))
	end
	-- give saves up to ~20s to finish
	local start = os.clock()
	while os.clock() - start < 20 do
		local allDone = true
		for _, thread in ipairs(threads) do
			if coroutine.status(thread) ~= "dead" then
				allDone = false
			end
		end
		if allDone then
			break
		end
		task.wait(0.5)
	end
end)

task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(saveData, player)
		end
	end
end)
]]></string>
